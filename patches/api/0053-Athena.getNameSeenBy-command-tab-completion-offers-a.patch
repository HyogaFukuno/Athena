Subject: [PATCH] Athena.getNameSeenBy: command tab completion offers a
 disguised player's disguise

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/src/main/java/athena/api/Athena.java b/src/main/java/athena/api/Athena.java
index 146ba0a7f27ff22da01e9e277155a4aeb94cf6d5..7be552ae354dbb65cb8425da6351ffb002295e66 100644
--- a/src/main/java/athena/api/Athena.java
+++ b/src/main/java/athena/api/Athena.java
@@ -360,6 +360,20 @@ public final class Athena {
         return getServer().getDisguiseName(player);
     }
 
+    /**
+     * The name {@code viewer} knows {@code player} by: the disguise's for everyone else, the real one
+     * for the player themselves, for the console ({@code viewer} null) and on a server without the
+     * Athena API. For anything that offers player names to a player, such as tab completion: the
+     * real name of a disguised player there tells everyone who they are.
+     */
+    public static String getNameSeenBy(Player viewer, Player player) {
+        if (server == null || viewer == null || viewer.equals(player)) {
+            return player.getName();
+        }
+        String disguise = server.getDisguiseName(player);
+        return disguise != null ? disguise : player.getName();
+    }
+
     /**
      * Masks {@code player} as {@code mask}, or takes their mask off if it is null, without telling them
      * or calling {@link athena.api.event.PlayerMaskChangeEvent}: for a plugin giving back the mask it
