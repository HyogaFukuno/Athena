+        ((CraftWorld) world).getHandle().athenaRunOnTickThread(task);
+    }
 }
diff --git a/src/main/java/net/minecraft/server/AthenaWorldThread.java b/src/main/java/net/minecraft/server/AthenaWorldThread.java
new file mode 100644
index 0000000000000000000000000000000000000000..1b4f03e5a6a5ac4d8c28d415385a85fbe727d6f1
--- /dev/null
+++ b/src/main/java/net/minecraft/server/AthenaWorldThread.java
@@ -0,0 +1,151 @@
+package net.minecraft.server;
+
+import java.util.Queue;
+import java.util.concurrent.ConcurrentLinkedQueue;
+import java.util.concurrent.TimeUnit;
+import org.apache.logging.log4j.LogManager;
+import org.apache.logging.log4j.Logger;
+
+/**
+ * Athena - a world that ticks on its own thread instead of the server thread.
+ *
+ * The thread runs the same per-world tick the server thread runs for the other worlds
+ * (MinecraftServer.athenaTickWorld) every 50 ms, plus the tasks queued for the world
+ * (WorldServer.postToMainThread, Athena.runOnWorld). While it runs, only this thread may touch
+ * the world: AsyncCatcher.catchOp(reason, world) and WorldServer.isMainThread answer for it. A
+ * stall here (a slow plugin, a long chunk load) holds up this world alone; the server thread and
+ * the other worlds keep their 20 ticks a second. A throwable out of the tick stops this world's
+ * thread (the world then stops ticking) instead of the server.
+ *
+ * Players may not be in such a world yet: their packets and connection ticks still run on the
+ * server thread. Athena.setWorldThreaded refuses a world with players, and teleports into it are
+ * refused.
+ */
+public final class AthenaWorldThread extends Thread {
+
+    private static final Logger LOGGER = LogManager.getLogger();
+    private static final long TICK_NANOS = 50_000_000L;
+    /** How far behind the thread may fall before it stops trying to catch up, in ticks. */
+    private static final int MAX_CATCH_UP = 20;
+
+    final WorldServer world;
+    private final Queue<Runnable> tasks = new ConcurrentLinkedQueue<Runnable>();
+    private volatile boolean running = true;
+    /** System.nanoTime() when the last tick ended, for a watchdog and for tests. */
+    volatile long lastTickEnd = System.nanoTime();
+    /** Ticks this thread has run. */
+    volatile long ticks;
+    /** Set when a tick threw: the thread stopped and the world no longer ticks. */
+    volatile Throwable failure;
+
+    AthenaWorldThread(WorldServer world) {
+        super("World thread - " + world.getWorldData().getName());
+        this.world = world;
+        this.setDaemon(true);
+    }
+
+    private static volatile boolean started;
+
+    /**
+     * Before the first world thread starts: Aikar's timings keep one stack for the server thread and
+     * log an error for every timer stopped on another thread, so they are turned off.
+     */
+    static void beforeFirstStart() {
+        if (started) return;
+        started = true;
+        if (co.aikar.timings.Timings.isTimingsEnabled()) {
+            // what the server does when it stops: Timings.setTimingsEnabled only resets the data on the
+            // next tick, while this turns every timer off at once
+            co.aikar.timings.SpigotTimings.stopServer();
+            LOGGER.info("Timings turned off: worlds on their own threads cannot be timed");
+        }
+    }
+
+    /** Set once the thread has stopped and its leftover tasks went to the server thread. */
+    private volatile boolean handedBack;
+
+    /** Queues {@code task} to run on this thread before its next tick. */
+    void post(Runnable task) {
+        this.tasks.add(task);
+        if (this.handedBack) {
+            // posted by someone who still saw this thread after it stopped: the server thread runs it
+            this.handBack();
+        }
+    }
+
+    /** After the thread stopped: the tasks still queued go to the server thread, which owns the world again. */
+    void handBack() {
+        this.handedBack = true;
+        Runnable task;
+        while ((task = this.tasks.poll()) != null) {
+            MinecraftServer.getServer().processQueue.add(task);
+        }
+    }
+
+    @Override
+    public void run() {
+        long next = System.nanoTime();
+        try {
+            while (this.running) {
+                long now = System.nanoTime();
+                if (now < next) {
+                    java.util.concurrent.locks.LockSupport.parkNanos(next - now);
+                    continue;
+                }
+                // a long stall (a frozen tick, a debugger) is not made up with a burst of ticks
+                if (now - next > MAX_CATCH_UP * TICK_NANOS) {
+                    next = now;
+                }
+                next += TICK_NANOS;
+
+                this.runTasks();
+                ++this.world.athenaCurrentTick;
+                this.world.sendWorldTimeUpdate(false);
+                MinecraftServer.getServer().athenaTickWorld(this.world);
+                ++this.ticks;
+                this.lastTickEnd = System.nanoTime();
+            }
+            this.runTasks();
+        } catch (Throwable throwable) {
+            this.failure = throwable;
+            this.running = false;
+            LOGGER.error("World " + this.world.getWorldData().getName() + " stopped ticking: its thread threw", throwable);
+        }
+    }
+
+    private void runTasks() {
+        Runnable task;
+        while ((task = this.tasks.poll()) != null) {
+            try {
+                task.run();
+            } catch (Throwable throwable) {
+                LOGGER.error("A task for world " + this.world.getWorldData().getName() + " threw", throwable);
+            }
+        }
+    }
+
+    /**
+     * Asks the thread to finish its tick and stop, and waits for it.
+     *
+     * @return whether it stopped within {@code timeoutMillis}; if not, it still owns the world
+     */
+    boolean stopAndJoin(long timeoutMillis) {
+        this.running = false;
+        java.util.concurrent.locks.LockSupport.unpark(this);
+        try {
+            this.join(timeoutMillis);
+        } catch (InterruptedException e) {
+            Thread.currentThread().interrupt();
+        }
+        return !this.isAlive();
+    }
+
+    boolean failed() {
+        return this.failure != null;
+    }
+
+    /** Milliseconds since the last tick ended. */
+    long millisSinceTick() {
+        return TimeUnit.NANOSECONDS.toMillis(System.nanoTime() - this.lastTickEnd);
+    }
+}
