diff --git a/src/test/java/net/minecraft/server/AthenaDecorationCleanupTest.java b/src/test/java/net/minecraft/server/AthenaDecorationCleanupTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..fbfb9d23d4befd966825cf80cdfa8eee796f7f1f
--- /dev/null
+++ b/src/test/java/net/minecraft/server/AthenaDecorationCleanupTest.java
@@ -0,0 +1,132 @@
+package net.minecraft.server;
+
+import static org.junit.Assert.*;
+
+import java.lang.reflect.InvocationTargetException;
+import java.lang.reflect.Method;
+import java.util.List;
+import java.util.Random;
+import java.util.concurrent.*;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.function.Consumer;
+import org.bukkit.craftbukkit.CraftWorld;
+import org.bukkit.generator.BlockPopulator;
+import org.bukkit.support.AbstractTestingBase;
+import org.junit.Test;
+
+public class AthenaDecorationCleanupTest extends AbstractTestingBase {
+    private static final class Generator extends ChunkProviderGenerate {
+        Consumer<ChunkPopulateJob> decorate, finish;
+        private Generator() { super(null, 0, false, ""); }
+        @Override public void decorate(ChunkPopulateJob job) { decorate.accept(job); }
+        @Override public void finishPopulate(ChunkPopulateJob job) { finish.accept(job); }
+    }
+
+    private static Generator generator(Consumer<ChunkPopulateJob> decorate, Consumer<ChunkPopulateJob> finish) throws Exception {
+        Generator generator = AthenaAuditFixtures.allocate(Generator.class);
+        generator.decorate = decorate;
+        generator.finish = finish;
+        return generator;
+    }
+
+    private static WorldServer world() throws Exception {
+        WorldServer world = AthenaAuditFixtures.world();
+        AthenaAuditFixtures.set(world, World.class, "worldProvider", WorldProvider.byDimension(0));
+        return world;
+    }
+
+    private static ChunkPopulateJob job(WorldServer world, Generator generator, Runnable completion) {
+        ChunkPopulateJob job = new ChunkPopulateJob(generator, world, 0, 0, new SnapshotRandom(1), BiomeBase.PLAINS, BlockPosition.ZERO);
+        job.completion = completion;
+        return job;
+    }
+
+    @Test
+    public void pluginFailureReleasesAllFourHoldsAndRestoresPhysics() throws Exception {
+        WorldServer world = world();
+        world.worldData = new WorldData();
+        CraftWorld craft = AthenaAuditFixtures.allocate(CraftWorld.class);
+        RuntimeException failure = new RuntimeException("failing block populator");
+        BlockPopulator populator = new BlockPopulator() {
+            @Override public void populate(org.bukkit.World world, Random random, org.bukkit.Chunk chunk) { throw failure; }
+        };
+        AthenaAuditFixtures.set(craft, CraftWorld.class, "populators", List.of(populator));
+        AthenaAuditFixtures.set(world, World.class, "world", craft);
+        Chunk[] held = new Chunk[4];
+        for (int i = 0; i < held.length; ++i) {
+            held[i] = new Chunk(world, i & 1, i >> 1);
+            held[i].athenaDecorationHolds = 1;
+        }
+        held[0].decorationPending = true;
+        boolean before = BlockSand.instaFall;
+        BlockSand.instaFall = false;
+        try {
+            try { world.chunkProviderServer.finishDecoration(held[0], held); fail("plugin failure hidden"); }
+            catch (RuntimeException ex) { assertSame(failure, ex); }
+            for (Chunk chunk : held) assertEquals(0, chunk.athenaDecorationHolds);
+            assertFalse(held[0].decorationPending);
+            assertFalse(world.populating);
+            assertFalse(BlockSand.instaFall);
+        } finally { BlockSand.instaFall = before; }
+    }
+
+    @Test
+    public void generatorFailureStillRunsCleanupAndKeepsTheOriginalError() throws Exception {
+        Error fatal = new AssertionError("fatal generator error");
+        RuntimeException cleanup = new RuntimeException("cleanup also failed");
+        AtomicInteger calls = new AtomicInteger();
+        ChunkPopulateJob job = job(world(), generator(j -> {}, j -> { throw fatal; }), () -> {
+            calls.incrementAndGet();
+            throw cleanup;
+        });
+        Method complete = ChunkDecorationExecutor.class.getDeclaredMethod("complete", ChunkPopulateJob.class);
+        complete.setAccessible(true);
+        try { complete.invoke(null, job); fail("Error hidden"); }
+        catch (InvocationTargetException ex) { assertSame(fatal, ex.getCause()); }
+        assertEquals(1, calls.get());
+        assertArrayEquals(new Throwable[] {cleanup}, fatal.getSuppressed());
+    }
+
+    @Test(timeout = 10000)
+    public void workerErrorsReachTheServerThreadAndReleaseCleanup() throws Exception {
+        WorldServer world = world();
+        Error fatal = new AssertionError("worker failure");
+        AtomicInteger cleanup = new AtomicInteger();
+        ChunkDecorationExecutor.queue(job(world, generator(j -> { throw fatal; }, j -> {}), cleanup::incrementAndGet));
+        try { ChunkDecorationExecutor.flush(world); fail("worker Error hidden"); }
+        catch (Error ex) { assertSame(fatal, ex); }
+        assertEquals(1, cleanup.get());
+        assertNull(world.decorationThread);
+        assertNull(world.decorationBuffer);
+    }
+
+    @Test(timeout = 10000)
+    public void unloadingOneWorldDoesNotWaitForAnotherWorldsDecoration() throws Exception {
+        WorldServer first = world(), other = world();
+        CountDownLatch blocked = new CountDownLatch(1), release = new CountDownLatch(1);
+        AtomicInteger completions = new AtomicInteger();
+        Generator generator = generator(j -> {
+            if (j.world == other) {
+                blocked.countDown();
+                try { assertTrue(release.await(5, TimeUnit.SECONDS)); }
+                catch (InterruptedException ex) { throw new AssertionError(ex); }
+            }
+        }, j -> {});
+        ChunkDecorationExecutor.queue(job(first, generator, completions::incrementAndGet));
+        ChunkDecorationExecutor.queue(job(other, generator, completions::incrementAndGet));
+        ExecutorService flush = Executors.newSingleThreadExecutor();
+        Future<?> firstFlush = null;
+        try {
+            assertTrue(blocked.await(5, TimeUnit.SECONDS)); // first job is already in finished
+            firstFlush = flush.submit(() -> ChunkDecorationExecutor.flush(first));
+            firstFlush.get(1, TimeUnit.SECONDS);
+            assertEquals(1, completions.get());
+        } finally {
+            release.countDown();
+            if (firstFlush != null) firstFlush.get(5, TimeUnit.SECONDS);
+            flush.shutdownNow();
+            ChunkDecorationExecutor.flush(other);
+        }
+        assertEquals(2, completions.get());
+    }
+}
