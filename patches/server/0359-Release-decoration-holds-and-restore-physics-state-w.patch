 import java.util.concurrent.BlockingQueue;
@@ -33,6 +36,8 @@ public final class ChunkDecorationExecutor {
     private static final Object DECORATING = new Object();
     /** Jobs handed to the worker but not yet drained. Read on the server thread only. */
     private static int inFlight;
+    // Athena - unload without saving waits only for this world, not unrelated decoration.
+    private static final Map<WorldServer, Integer> inFlightByWorld = new IdentityHashMap<WorldServer, Integer>();
 
     private ChunkDecorationExecutor() {}
 
@@ -62,10 +67,13 @@ public final class ChunkDecorationExecutor {
                 return;
             }
 
