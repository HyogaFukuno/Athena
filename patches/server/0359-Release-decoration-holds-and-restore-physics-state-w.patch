             if (job != null) {
-                --ChunkDecorationExecutor.inFlight;
-                complete(job);
+                finish(job);
             } else {
                 Thread.yield();
             }
         }
     }
 
-    private static void complete(ChunkPopulateJob job) {
-        if (job.buffer.hasEscaped()) {
-            // Decoration is single threaded on purpose - BiomeDecorator, WorldGenBigTree and the
-            // flower generator all keep state on the biome singleton while they run. Doing one here
-            // means holding the lock the worker holds for each of its own.
-            synchronized (ChunkDecorationExecutor.DECORATING) {
-                // The sandbox could not finish it; do the whole decoration here, against the real
-                // world. The abandoned attempt drew from the sequence, so put it back first.
-                job.buffer.reset();
-                job.random.restore(job.randomAtDecoration);
-                job.generator.decorate(job);
+    /** Athena - finish only jobs belonging to a world being unloaded without a save. */
+    public static void flush(WorldServer world) {
+        while (inFlightByWorld.containsKey(world)) {
+            ChunkPopulateJob ready = null;
+            Iterator<ChunkPopulateJob> iterator = finished.iterator();
+            while (iterator.hasNext()) {
+                ChunkPopulateJob job = iterator.next();
+                if (job.world == world) {
+                    iterator.remove();
+                    ready = job;
+                    break;
+                }
+            }
+            if (ready != null) {
+                finish(ready);
+            } else {
+                Thread.yield();
             }
+        }
+    }
+
+    private static void finish(ChunkPopulateJob job) {
+        --inFlight;
+        int remaining = inFlightByWorld.get(job.world) - 1;
+        if (remaining == 0) {
+            inFlightByWorld.remove(job.world);
         } else {
-            BlockFalling.instaFall = true; // vanilla held this across the whole of populate
+            inFlightByWorld.put(job.world, remaining);
+        }
+        complete(job);
+    }
+
+    private static void complete(ChunkPopulateJob job) {
+        Throwable failure = null;
+        try {
+            if (job.failure != null) {
+                throw job.failure;
+            }
+            if (job.buffer.hasEscaped()) {
+                // Decoration is single threaded on purpose - BiomeDecorator, WorldGenBigTree and the
+                // flower generator all keep state on the biome singleton while they run. Doing one here
+                // means holding the lock the worker holds for each of its own.
+                synchronized (ChunkDecorationExecutor.DECORATING) {
+                    // The sandbox could not finish it; do the whole decoration here, against the real
+                    // world. The abandoned attempt drew from the sequence, so put it back first.
+                    job.buffer.reset();
+                    job.random.restore(job.randomAtDecoration);
+                    job.generator.decorate(job);
+                }
+            } else {
+                boolean previousInstaFall = BlockFalling.instaFall;
+                BlockFalling.instaFall = true; // vanilla held this across the whole of populate
+
+                try {
+                    job.buffer.apply();
+                } catch (Exception throwable) {
+                    // The replay runs inside the tick loop, so a single bad entry must not take the
+                    // server down with it. The chunk is left part decorated, which is visible and
+                    // reported, rather than the world being lost.
+                    ChunkDecorationExecutor.logger.error("[Athena] Replaying the decoration of chunk " + job.chunkX + ", " + job.chunkZ + " failed; that chunk is partly decorated", throwable);
+                } finally {
+                    BlockFalling.instaFall = previousInstaFall;
+                }
+            }
 
+            job.generator.finishPopulate(job);
+        } catch (RuntimeException | Error ex) {
+            failure = ex;
+            throw ex;
+        } finally {
             try {
-                job.buffer.apply();
-            } catch (Throwable throwable) {
-                // The replay runs inside the tick loop, so a single bad entry must not take the
-                // server down with it. The chunk is left part decorated, which is visible and
-                // reported, rather than the world being lost.
-                ChunkDecorationExecutor.logger.error("[Athena] Replaying the decoration of chunk " + job.chunkX + ", " + job.chunkZ + " failed; that chunk is partly decorated", throwable);
-            } finally {
-                BlockFalling.instaFall = false;
+                job.completion.run();
+            } catch (RuntimeException | Error cleanup) {
+                if (failure == null) {
+                    throw cleanup;
+                }
+                if (cleanup != failure) failure.addSuppressed(cleanup);
             }
         }
-
-        job.generator.finishPopulate(job);
-        job.completion.run();
     }
 }
 // Athena end
