     // Athena start - the tail of population: plugin block populators, then the event. Split out so
     // that the deferred path runs it at the same point in the sequence, just later in wall time.
+    // Athena - always drop all holds, even if plugin population stops the tick with an exception.
+    void finishDecoration(Chunk chunk, Chunk[] held) {
+        try {
+            this.finishPopulate(chunk);
+        } finally {
+            chunk.decorationPending = false;
+            for (Chunk c : held) {
+                if (c != null) this.releaseDecorationHold(c);
+            }
+        }
+    }
