From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: glacier <hyouga.dev@gmail.com>
Date: Tue, 10 Nov 2026 07:31:07 +0900
Subject: [PATCH] Template sections: read off the mapping in one copy, stores
 kept between matches, ticking bitmaps shared

A mapped section's ids were read from the mapping one at a time to count,
check and unpack them: a call through the segment's var handle each, which
costs C1 several times an array read. They are copied off in one call first,
and a packed section is counted from how often each palette entry occurs. A
template's 22,543 mapped sections count in 212 ms instead of 473 ms with C1
(9.4 and 21 us a section).

The stores of the last eight templates opened stay between their matches, so
a map whose last match ended is not mapped, checked and counted again for its
next one. Sections filled from a store share its ticking bitmap until a block
is written, instead of 512 bytes each per world.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>

diff --git a/src/main/java/net/minecraft/server/AthenaSectionStore.java b/src/main/java/net/minecraft/server/AthenaSectionStore.java
index 290250db0c58167f7c79af6f99d2e039fb001ae3..b04cb33a445d52fc7ae6698172ee90febc3ede07 100644
--- a/src/main/java/net/minecraft/server/AthenaSectionStore.java
+++ b/src/main/java/net/minecraft/server/AthenaSectionStore.java
@@ -138,12 +138,14 @@ final class AthenaSectionStore {
         AthenaSectionStore store = reference != null ? reference.get() : null;
 
         if (store != null && store.fingerprint() == fingerprint) {
+            keep(store);
             return store;
         }
 
         store = file.isFile() ? map(file, fingerprint) : null;
         if (store != null) {
             OPEN.put(path, new WeakReference<AthenaSectionStore>(store));
+            keep(store);
             return store;
         }
 
@@ -165,6 +167,38 @@ final class AthenaSectionStore {
         return null;
     }
 
+    // Athena start - the stores of the last few templates opened stay, between their matches too.
+    //
+    // A store was held by its worlds alone. When a map's last match ended and a GC ran - one does
+    // in every lobby - the store went, and the next match on that map mapped the file again,
+    // checked every packed section again and counted every section's blocks again: 22,543 sections
+    // for one arena, a quarter of a second of the chunk IO threads on a fast machine, at the moment
+    // the match starts. What a kept store holds on the heap is its keys and the counts; its
+    // mapping is address space, whose pages the kernel takes back as it likes.
+    private static final int KEPT = 8;
+    private static final java.util.ArrayDeque<AthenaSectionStore> RECENT = new java.util.ArrayDeque<AthenaSectionStore>();
+
+    private static void keep(AthenaSectionStore store) {
+        synchronized (RECENT) {
+            if (RECENT.peekFirst() == store) {
+                return;
+            }
+            RECENT.remove(store);
+            RECENT.addFirst(store);
+            while (RECENT.size() > KEPT) {
+                RECENT.removeLast();
+            }
+        }
+    }
+
+    /** A store that turned out unusable is not kept for the next world. */
+    void forget() {
+        synchronized (RECENT) {
+            RECENT.remove(this);
+        }
+    }
+    // Athena end
+
     /** Waits for any store being built; for tests. */
     static void awaitBuilds() throws InterruptedException {
         while (!BUILDING.isEmpty()) {
@@ -311,8 +345,12 @@ final class AthenaSectionStore {
         }
         int bit = 1 << sectionY;
         if ((validated.get(chunk) & bit) != 0) return true;
+        // Athena - off the mapping in one copy, then checked on the heap: see ChunkSection.recalcBlockCounts
+        byte[] bytes = ChunkSection.MAPPED_SCRATCH.get();
+
+        MemorySegment.copy(this.mapping, ValueLayout.JAVA_BYTE, offset + 32L, bytes, 0, 2048);
         for (int i = 0; i < 2048; ++i) {
-            int packed = this.mapping.get(ValueLayout.JAVA_BYTE, offset + 32L + i) & 255;
+            int packed = bytes[i] & 255;
             if ((packed & 15) >= paletteSize || (packed >>> 4) >= paletteSize) return false;
         }
         // Several IO threads may validate different sections of the same chunk concurrently.
diff --git a/src/main/java/net/minecraft/server/AthenaTemplateChunkLoader.java b/src/main/java/net/minecraft/server/AthenaTemplateChunkLoader.java
index 9d7f74505e8c5bbb2c6677149fa5cd97f7669204..28a807376f2bb171e7592cd21ef168540efd8344 100644
--- a/src/main/java/net/minecraft/server/AthenaTemplateChunkLoader.java
