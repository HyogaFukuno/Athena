+    // Athena start - a conservative answer to "could this box hold that liquid at all".
+    //
+    // Water and lava are the only materials the three box scans below are ever asked about, and a
+    // ChunkSection now counts how many blocks of each it holds, so a box that spans nothing but dry
+    // sections is decided by a handful of int loads instead of a block read per cubic metre. Every
+    // entity runs handleWaterMovement each tick and almost none of them are ever in water, so the
+    // scan that finds nothing is the common case, not the rare one.
+    //
+    // Anything this cannot answer from the counters - a chunk that is not loaded, decoration in
+    // flight, some other material - answers true, and the caller scans exactly as it did before.
+    // The bounds are inclusive block coordinates.
+    private boolean mayHoldLiquid(int minBlockX, int minBlockY, int minBlockZ, int maxBlockX, int maxBlockY, int maxBlockZ, Material material) {
+        boolean water = material == Material.WATER;
+
+        if (!water && material != Material.LAVA) {
+            return true;
+        }
+
+        if (this.decorating() || this.captureTreeGeneration) {
+            return true;
+        }
+
+        if (maxBlockY < 0) {
+            return false; // nothing but the void down there
+        }
+
+        int sectionMin = minBlockY < 0 ? 0 : minBlockY >> 4;
+        int sectionMax = maxBlockY >> 4;
+
+        for (int cx = minBlockX >> 4; cx <= (maxBlockX >> 4); ++cx) {
+            for (int cz = minBlockZ >> 4; cz <= (maxBlockZ >> 4); ++cz) {
+                Chunk chunk = this.getChunkIfLoaded(cx, cz);
+
+                if (chunk == null) {
+                    return true; // the scan itself may load it; do not change what it sees
+                }
+
+                ChunkSection[] sections = chunk.getSections();
+                int top = sectionMax < sections.length - 1 ? sectionMax : sections.length - 1;
+
+                for (int s = sectionMin; s <= top; ++s) {
+                    ChunkSection section = sections[s];
+
+                    if (section != null && (water ? section.hasWater() : section.hasLava())) {
+                        return true;
+                    }
+                }
+            }
+        }
+
+        return false;
+    }
+    // Athena end
+
     public boolean handleMaterialAcceleration(AxisAlignedBB axisalignedbb, Material material, Entity entity) { // Athena - delegate to the scalar overload
         return this.handleMaterialAcceleration(axisalignedbb.minX, axisalignedbb.minY, axisalignedbb.minZ, axisalignedbb.maxX, axisalignedbb.maxY, axisalignedbb.maxZ, material, entity);
