+    // ------------------------------------------------------------ section liquids
+
+    /**
+     * Verifies the per-section water and lava counts against a full recount of the section's
+     * blocks. The counts are maintained from ChunkSection.setType alone, which every write path
+     * funnels through, and World.mayHoldLiquid turns a zero into "the box holds no water" for the
+     * three material scans - so a count that drifts below the truth would silently stop an entity
+     * from noticing it is standing in water.
+     *
+     * Recounting every loaded section every tick would be 4096 block reads per section, so this
+     * takes one chunk per tick, round robin. Over a bench run that is thousands of chunks.
+     */
+    public static void auditSectionLiquids(WorldServer world) {
+        Object[] chunks = world.chunkProviderServer.chunks.values().toArray();
+
+        if (chunks.length == 0) {
+            return;
+        }
+
+        Chunk chunk = (Chunk) chunks[Math.floorMod(liquidCursor++, chunks.length)];
+        ChunkSection[] sections = chunk.getSections();
+
+        for (int i = 0; i < sections.length; ++i) {
+            ChunkSection section = sections[i];
+
+            if (section == null) {
+                continue;
+            }
+
+            ++liquidChecks;
+            int water = 0;
+            int lava = 0;
+
+            for (int x = 0; x < 16; ++x) {
+                for (int y = 0; y < 16; ++y) {
+                    for (int z = 0; z < 16; ++z) {
+                        Material material = section.getBlockByExtId(x, y, z).getMaterial();
+
+                        if (material == Material.WATER) {
+                            ++water;
+                        } else if (material == Material.LAVA) {
+                            ++lava;
+                        }
+                    }
+                }
+            }
+
+            if (water != 0 || lava != 0) {
+                ++liquidChecksNonEmpty;
+            }
+
+            if (water != section.auditLiquidCount(true)) {
+                report("section " + i + " of chunk " + chunk.locX + "," + chunk.locZ + " holds "
+                        + water + " water blocks but its count says " + section.auditLiquidCount(true));
+            }
+
+            if (lava != section.auditLiquidCount(false)) {
+                report("section " + i + " of chunk " + chunk.locX + "," + chunk.locZ + " holds "
+                        + lava + " lava blocks but its count says " + section.auditLiquidCount(false));
+            }
+        }
+    }
+
     // ------------------------------------------------------------------
 
     private static void report(String message) {
@@ -304,9 +372,10 @@ public final class AthenaIndexAudit {
         }
 
         lastSummaryTick = currentTick;
-        LOGGER.info("checks: census={} ({} non-empty), entityBuckets={} ({} indexed, {} entities) | mismatches={}",
