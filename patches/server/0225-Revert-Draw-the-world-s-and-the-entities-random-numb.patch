@@ -79,7 +79,7 @@ public abstract class World implements IBlockAccess {
     protected float prevThunderingStrength;
     protected float thunderingStrength;
     private int lastLightningBolt;
-    public final Random random = new FastRandom(); // Athena - same sequence, no compare-and-set
+    public final Random random = new Random();
     public WorldProvider worldProvider; // CraftBukkit - remove final
     protected List<IWorldAccess> worldAccesses = Lists.newArrayList();
     protected IChunkProvider chunkProvider;
