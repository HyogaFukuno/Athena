diff --git a/src/main/java/net/minecraft/server/FastRandom.java b/src/main/java/net/minecraft/server/FastRandom.java
deleted file mode 100644
index a1144580addee1b6325b46e4007e07281599ee1d..0000000000000000000000000000000000000000
--- a/src/main/java/net/minecraft/server/FastRandom.java
+++ /dev/null
@@ -1,85 +0,0 @@
-package net.minecraft.server;
-
-import java.util.Random;
-
-// Athena start - java.util.Random without the atomic.
-//
-// java.util.Random keeps its 48 bits of state in an AtomicLong and advances them with a
-// compare-and-set, so that two threads drawing at once cannot be handed the same number. The tick
-// loop does not need that. The world's generator and the entities' shared generator are drawn from
-// the server thread and from nowhere else, and every draw pays a read-modify-write with ordering on
-// a cache line that is private to that thread anyway. With one shared generator behind every mob -
-// PandaSpigot points all of them at Entity.SHARED_RANDOM - that line is one of the busiest in the
-// tick.
-//
-// The numbers do not change. This is the same 48-bit linear congruential generator, the same
-// scramble in setSeed and the same shift in next(bits) as java.util.Random, so a FastRandom and a
-// java.util.Random started from one seed walk the same sequence. Every other method - nextInt,
-// nextDouble, nextLong, nextBoolean, nextBytes - is inherited and is defined in terms of
-// next(bits), so they all follow.
-//
-// nextGaussian is the exception. It is synchronized in the superclass and caches the second value
-// of each pair in a field this class cannot see, so it keeps the monitor and its own state. Nothing
-// on a hot path draws one.
-//
-// What is given up is thread safety: a plugin drawing from World.random off the server thread used
-// to get a well-defined number and can now be handed a repeat. The state is a single long, so there
-// is nothing to corrupt - a racing draw returns a stale number, not a broken generator - and
-// nothing inside the server draws from either of these off the server thread.
-public class FastRandom extends Random {
-
-    protected static final long MULTIPLIER = 0x5DEECE66DL;
-    protected static final long ADDEND = 0xBL;
-    protected static final long MASK = (1L << 48) - 1;
-
-    private static final java.util.concurrent.atomic.AtomicLong SEED_UNIQUIFIER =
-            new java.util.concurrent.atomic.AtomicLong(8682522807148012L);
-
-    /**
-     * The generator's position in its sequence.
-     *
-     * <p>Deliberately declared without an initialiser. java.util.Random's {@code Random(long)}
-     * calls {@link #setSeed(long)} when it is constructing a subclass, which happens before this
-     * class's own initialisers would run; an initialiser here would overwrite the seed that call
-     * just installed.
-     */
-    protected long state;
-
-    public FastRandom() {
-        this(uniqueSeed());
-    }
-
-    public FastRandom(long seed) {
-        // Random(long) sees that this is a subclass and calls setSeed itself, exactly once. Seeding
-        // again in this constructor body would only move the sequence on for no reason.
-        super(seed);
-    }
-
-    private static long uniqueSeed() {
-        long current;
-        long next;
-
-        do {
-            current = FastRandom.SEED_UNIQUIFIER.get();
-            next = current * 1181783497276652981L;
-        } while (!FastRandom.SEED_UNIQUIFIER.compareAndSet(current, next));
-
-        return next ^ System.nanoTime();
-    }
-
-    @Override
-    public void setSeed(long seed) {
-        // Reached from the superclass constructor before this class is initialised, which is safe
-        // because the only field it touches is a long that the JVM has already zeroed.
-        this.state = (seed ^ FastRandom.MULTIPLIER) & FastRandom.MASK;
-    }
-
-    @Override
-    protected int next(int bits) {
-        long state = this.state * FastRandom.MULTIPLIER + FastRandom.ADDEND & FastRandom.MASK;
-
-        this.state = state;
-        return (int) (state >>> (48 - bits));
-    }
-}
-// Athena end
diff --git a/src/main/java/net/minecraft/server/SnapshotRandom.java b/src/main/java/net/minecraft/server/SnapshotRandom.java
index 10ee449dd42fecb96d48e31856bac5ba94ba3719..dd8269f8d37f12b334a3b482839bf9bd34fd72d8 100644
--- a/src/main/java/net/minecraft/server/SnapshotRandom.java
+++ b/src/main/java/net/minecraft/server/SnapshotRandom.java
@@ -1,23 +1,46 @@
 package net.minecraft.server;
 
-// Athena start - a generator whose position in the sequence can be taken and put back.
+import java.util.Random;
+
+// Athena start - a java.util.Random whose position in the sequence can be taken and put back.
 //
 // Decoration runs off the server thread against a sandbox, and if the sandbox hits something it
 // cannot model the job is thrown away and the server thread decorates instead. That only produces
 // the same world if the second attempt starts from the same place in the random sequence as the
 // first - and by then the abandoned attempt has already drawn from it.
 //
-// java.util.Random keeps its position in a private field, so the generator itself lives in
-// FastRandom, which reimplements java.util.Random's exact algorithm over a plain long. All this
-// class adds is read and write access to that long.
+// java.util.Random keeps its position in a private field, so it is reimplemented here. This is the
+// exact algorithm from java.util.Random: the same 48-bit linear congruential generator, the same
+// scramble in setSeed, the same shift in next(bits). Every other method - nextInt, nextDouble,
+// nextLong - is inherited and defined in terms of next(bits), so they all follow.
 //
-// nextGaussian is the one exception: it caches a second value in a superclass field neither class
-// can see, so a snapshot taken between the two draws of a pair would be incomplete. No decoration
-// draws one.
-public class SnapshotRandom extends FastRandom {
+// nextGaussian is the one exception: it caches a second value in a superclass field this class
+// cannot see, so a snapshot taken between the two draws of a pair would be incomplete. No
+// decoration draws one.
+public class SnapshotRandom extends Random {
+
+    private static final long MULTIPLIER = 0x5DEECE66DL;
+    private static final long ADDEND = 0xBL;
+    private static final long MASK = (1L << 48) - 1;
+
+    private long state;
 
     public SnapshotRandom(long seed) {
-        super(seed);
+        super(0L); // the superclass seed is never used; next(int) below is the only source
+        this.setSeed(seed);
+    }
+
+    @Override
+    public void setSeed(long seed) {
+        // Called from the superclass constructor before this class is initialised, which is safe
+        // here because the only field it touches is a long that is already zeroed.
+        this.state = (seed ^ SnapshotRandom.MULTIPLIER) & SnapshotRandom.MASK;
+    }
+
+    @Override
+    protected int next(int bits) {
+        this.state = (this.state * SnapshotRandom.MULTIPLIER + SnapshotRandom.ADDEND) & SnapshotRandom.MASK;
+        return (int) (this.state >>> (48 - bits));
     }
 
     /** The current position in the sequence. */
