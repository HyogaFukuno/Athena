-            EnumDirection[] aenumdirection = EnumDirection.values();
-            int i = aenumdirection.length;
+            // Athena - shared array and coordinate neighbours; values() copied six entries and each
+            // shift() built a position, on a path every lava placement and neighbour update walks
+            int x = blockposition.getX();
+            int y = blockposition.getY();
+            int z = blockposition.getZ();
 
-            for (int j = 0; j < i; ++j) {
-                EnumDirection enumdirection = aenumdirection[j];
+            for (int j = 0; j < EnumDirection.VALUES.length; ++j) {
+                EnumDirection enumdirection = EnumDirection.VALUES[j];
 
-                if (enumdirection != EnumDirection.DOWN && world.getType(blockposition.shift(enumdirection)).getBlock().getMaterial() == Material.WATER) {
