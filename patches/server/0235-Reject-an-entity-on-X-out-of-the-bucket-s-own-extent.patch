+    // a candidate that survives, rather than once per candidate. The rejected ones cost a load from
+    // a line that already holds several of them.
+    private void scanSliceForEntity(List<Entity> from, double[] xs, Entity entity, double minX, double minY, double minZ, double maxX, double maxY, double maxZ, List<Entity> list, Predicate<? super Entity> predicate) {
+        int size = from.size();
+
+        if (xs != null && (size << 1) <= xs.length) {
+            for (int idx = 0; idx < size; ++idx) {
