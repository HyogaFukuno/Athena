     private void scanSliceForEntity(List<Entity> from, Entity entity, double minX, double minY, double minZ, double maxX, double maxY, double maxZ, List<Entity> list, Predicate<? super Entity> predicate) {
+        this.scanSliceForEntity(from, null, entity, minX, minY, minZ, maxX, maxY, maxZ, list, predicate);
+    }
+
+    // Athena - `xs` holds the candidates' X extents interleaved minX,maxX, parallel to `from`, or
+    // null for a flat slice that has no bucket index.
+    //
+    // The X overlap test is the first two comparisons of the full intersection, and X is the axis
