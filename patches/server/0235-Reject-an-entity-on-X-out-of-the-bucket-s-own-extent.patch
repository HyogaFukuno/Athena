+                    this.acceptEntity(entity1, entity, minX, minY, minZ, maxX, maxY, maxZ, list, predicate);
+                }
+            }
+
+            return;
+        }
+
         for (int idx = 0; idx < from.size(); ++idx) {
             Entity entity1 = from.get(idx);
 
