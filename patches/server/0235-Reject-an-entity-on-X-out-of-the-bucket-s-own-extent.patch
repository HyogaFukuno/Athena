         }
 
-        this.bucketAdd(buckets, slice, entity);
+        List<Entity> bucket = buckets[b];
+        int slot = entity.athenaBucketSlot;
+
+        if (slot < 0 || slot >= bucket.size() || bucket.get(slot) != entity) {
+            slot = bucket.indexOf(entity); // the slot was stale; fall back to a scan
+            if (slot < 0) {
+                return;
+            }
+        }
+
+        bucket.remove(slot);
+
+        double[][] extents = this.bucketExtents[slice];
+        double[] xs = extents == null ? null : extents[b];
+        int size = bucket.size();
+
+        for (int i = slot; i < size; ++i) {
+            Entity moved = bucket.get(i);
+
+            moved.athenaBucketSlot = i;
+            if (xs != null) {
+                xs[i << 1] = moved.boundingBoxMinX;
+                xs[(i << 1) | 1] = moved.boundingBoxMaxX;
+            }
+        }
+
+        entity.athenaBucketSlot = -1;
     }
