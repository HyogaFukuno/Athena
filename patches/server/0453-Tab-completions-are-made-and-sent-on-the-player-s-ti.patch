+    /**
+     * Athena - whether a bot holds {@code name} (any case) now; if one does, it is asked to leave.
+     *
+     * A bot's name is made up, and the person whose name it is may log in while it plays: their UUIDs
+     * differ, so nothing stopped it, and two players had one name - two tab entries, and a name that
+     * found either. When one left, the name went from the name map with it, and the other could no
+     * longer be found by name at all. The person comes first: LoginListener asks this before it lets
+     * them in, and waits (as for a player of the same UUID) until it answers false. The bot leaves on
+     * the thread that ticks its world; if that thread is stuck, it is detached from here. Server thread.
+     */
+    public boolean athenaNameHeldByBot(String name) {
+        EntityPlayer named = this.getPlayer(name);
+        if (!(named instanceof AthenaBotPlayer)) {
+            return false;
+        }
+        final AthenaBotPlayer bot = (AthenaBotPlayer) named;
+        if (!bot.athenaLeaving) {
+            bot.athenaLeaving = true;
+            PlayerList.logger.info("Bot " + bot.getName() + " leaves: a player of that name is logging in");
+            if (bot.getServerForPlayer().athenaStalled()) {
+                this.athenaDetach(bot, "a player of that name is logging in");
+            } else {
+                WorldServer.athenaRunForEntity(bot, () -> {
+                    if (bot.api.isOnline()) bot.api.remove();
+                });
+            }
+        }
+        return true;
+    }
+
     /** The API's bot for {@code bot}. */
     public athena.api.bot.Bot athenaBotOf(AthenaBotPlayer bot) {
         return bot.api;
