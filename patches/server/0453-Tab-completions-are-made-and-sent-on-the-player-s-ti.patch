diff --git a/src/test/java/net/minecraft/server/AthenaNameMapTest.java b/src/test/java/net/minecraft/server/AthenaNameMapTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..02077149705f173e2b0606d318b4bf6d70e05aab
--- /dev/null
+++ b/src/test/java/net/minecraft/server/AthenaNameMapTest.java
@@ -0,0 +1,31 @@
+package net.minecraft.server;
+
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertSame;
+
+import java.util.Collections;
+import java.util.Map;
+import org.junit.Test;
+
+/**
+ * Athena - PlayerList's name map lets go of a name only for the player who holds it (remove(name,
+ * player)), whatever the case the name is spelt in: a bot that leaves after a player of its name came
+ * in must not take that player's entry with it (PlayerList.athenaNameHeldByBot).
+ */
+public class AthenaNameMapTest {
+
+    @Test
+    public void aNameGoesOnlyWithItsOwnHolder() {
+        Map<String, Object> names = Collections.synchronizedMap(new org.spigotmc.CaseInsensitiveMap<Object>());
+        Object bot = new Object();
+        Object person = new Object();
+
+        names.put("EpicFox", bot);
+        names.put("epicfox", person); // the person came in under the bot's name, in another case
+        names.remove("EpicFox", bot); // the bot leaves after them
+        assertSame("the person keeps the name", person, names.get("EPICFOX"));
+
+        names.remove("EPICFOX", person);
+        assertNull(names.get("EpicFox"));
+    }
+}
