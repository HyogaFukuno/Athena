+    @Test
+    public void aSpawnedPlayerCarriesTheNameAndSkinFromTheTabList() {
+        UUID uuid = UUID.fromString("069a79f4-44e9-4726-a5be-fca90e38aaf5");
+        PacketDataSerializer info = packet(0x38);
+
+        info.writeVarIntToBuffer(0);
+        info.writeVarIntToBuffer(1);
+        info.writeUuid(uuid);
+        info.writeString("Notch");
+        info.writeVarIntToBuffer(1);
+        info.writeString("textures");
+        info.writeString("dmFsdWU=");
+        info.writeBoolean(true);
+        info.writeString("c2ln");
+        info.writeVarIntToBuffer(0);      // game mode
+        info.writeVarIntToBuffer(42);     // ping
+        info.writeBoolean(false);
+        PacketDataSerializer spawn = packet(0x0C);
+
+        spawn.writeVarIntToBuffer(7);
+        spawn.writeUuid(uuid);
+        spawn.writeInt(32);
+        spawn.writeInt(64);
+        spawn.writeInt(96);
+        spawn.writeByte(1);
+        spawn.writeByte(2);
+        spawn.writeShort(0);
+        spawn.writeByte(0 << 5 | 10);     // skin parts: cape shown
+        spawn.writeByte(0x7F);
+        spawn.writeByte(3 << 5 | 6);      // health
+        spawn.writeFloat(20F);
+        spawn.writeByte(127);
+        List<PacketDataSerializer> sent = sent(this.out(), info, spawn);
+
+        assertEquals(2, sent.size());
+        PacketDataSerializer tab = sent.get(0);
+
+        assertEquals(0x38, tab.readVarIntFromBuffer());
+        assertEquals("Notch", tab.readStringFromBuffer(16));
+        assertTrue(tab.readBoolean());
+        assertEquals(42, tab.readShort());
+        PacketDataSerializer player = sent.get(1);
+
+        assertEquals(0x0C, player.readVarIntFromBuffer());
+        assertEquals(7, player.readVarIntFromBuffer());
+        assertEquals(uuid.toString(), player.readStringFromBuffer(36));
+        assertEquals("Notch", player.readStringFromBuffer(16));
+        assertEquals(1, player.readVarIntFromBuffer());
+        assertEquals("textures", player.readStringFromBuffer(32767));
+        assertEquals("dmFsdWU=", player.readStringFromBuffer(32767));
+        assertEquals("c2ln", player.readStringFromBuffer(32767));
+        assertEquals(32, player.readInt());
+        assertEquals(64, player.readInt());
+        assertEquals(96, player.readInt());
+        player.skipBytes(1 + 1 + 2);
+        assertEquals("skin parts become 1.7's cape flag at 16", 0 << 5 | 16, player.readUnsignedByte());
+        assertEquals("cape shown", 0, player.readByte());
+        assertEquals(3 << 5 | 6, player.readUnsignedByte());
+        assertEquals(20F, player.readFloat(), 0F);
+        assertEquals(127, player.readUnsignedByte());
+        assertFalse(player.isReadable());
+    }
+
+    @Test
+    public void aReplacedItemComesBackAsItself() {
+        PacketDataSerializer slot = packet(0x2F);
+
+        slot.writeByte(0);
+        slot.writeShort(36);
+        slot.writeShort(416);             // armor stand
+        slot.writeByte(3);
+        slot.writeShort(0);
+        slot.writeByte(0);                // no NBT
+        PacketDataSerializer sent = sent(this.out(), slot).get(0);
+
+        assertEquals(0x2F, sent.readVarIntFromBuffer());
+        sent.skipBytes(1 + 2);
+        assertEquals("shown as a stick", 280, sent.readShort());
+        assertEquals(3, sent.readByte());
+        assertEquals(0, sent.readShort());
+        int nbtLength = sent.readShort();
+
+        assertTrue(nbtLength > 0);
+        byte[] nbt = new byte[nbtLength];
+
+        sent.readBytes(nbt);
+        // the 1.7 client puts it back in creative mode: the server gets the armor stand again
+        PacketDataSerializer creative = packet(0x10);
+
+        creative.writeShort(36);
+        creative.writeShort(280);
+        creative.writeByte(3);
+        creative.writeShort(0);
+        creative.writeShort(nbtLength);
+        creative.writeBytes(nbt);
+        PacketDataSerializer received = received(this.in(), creative).get(0);
+
+        assertEquals(0x10, received.readVarIntFromBuffer());
+        assertEquals(36, received.readShort());
+        assertEquals(416, received.readShort());
+        assertEquals(3, received.readByte());
+        assertEquals(0, received.readShort());
+        assertEquals("and no tag left over", 0, received.readByte());
+        assertFalse(received.isReadable());
+    }
