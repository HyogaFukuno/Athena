+    @Test
+    public void armorStandsAreNeverShown() {
+        PacketDataSerializer spawn = packet(0x0E);
+
+        spawn.writeVarIntToBuffer(9);
+        spawn.writeByte(78);
+        spawn.writeInt(0);
+        spawn.writeInt(0);
+        spawn.writeInt(0);
+        spawn.writeByte(0);
+        spawn.writeByte(0);
+        spawn.writeInt(0);
+        PacketDataSerializer meta = packet(0x1C);
+
+        meta.writeVarIntToBuffer(9);
+        meta.writeByte(0 << 5 | 10);
+        meta.writeByte(1);
