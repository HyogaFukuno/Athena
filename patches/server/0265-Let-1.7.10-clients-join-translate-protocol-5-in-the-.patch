+    @Test
+    public void relativeTeleportsAreMadeAbsoluteAtEyeHeight() {
+        PacketDataSerializer move = packet(0x04);
+
+        move.writeDouble(10.5);
+        move.writeDouble(64);
+        move.writeDouble(65.62);          // 1.7's eye height
+        move.writeDouble(-3.5);
+        move.writeBoolean(true);
+        PacketDataSerializer received = received(this.in(), move).get(0);
+
+        assertEquals(0x04, received.readVarIntFromBuffer());
+        assertEquals(10.5, received.readDouble(), 0);
+        assertEquals(64, received.readDouble(), 0);
+        assertEquals(-3.5, received.readDouble(), 0);
+        assertTrue(received.readBoolean());
+        assertFalse(received.isReadable());
+
+        PacketDataSerializer teleport = packet(0x08);
+
+        teleport.writeDouble(1);
+        teleport.writeDouble(0);
+        teleport.writeDouble(100);
+        teleport.writeFloat(90F);
+        teleport.writeFloat(0F);
+        teleport.writeByte(0x01 | 0x02);  // x and y relative
+        PacketDataSerializer sent = sent(this.out(), teleport).get(0);
+
+        assertEquals(0x08, sent.readVarIntFromBuffer());
+        assertEquals(11.5, sent.readDouble(), 1e-9);
+        assertEquals(64 + 1.62, sent.readDouble(), 1e-9);
+        assertEquals(100, sent.readDouble(), 0);
+        assertEquals(90F, sent.readFloat(), 0);
+        assertEquals(0F, sent.readFloat(), 0);
+        assertTrue("on the ground, as last reported", sent.readBoolean());
+        assertFalse(sent.isReadable());
+    }
