index 0000000000000000000000000000000000000000..bc16120d626df1b4edfe0aa0e20478345797b5c1
--- /dev/null
+++ b/src/main/java/net/minecraft/server/AthenaLegacy17Encoder.java
@@ -0,0 +1,1337 @@
+package net.minecraft.server;
+
+import io.netty.buffer.ByteBuf;
+import io.netty.channel.ChannelHandlerContext;
+import io.netty.channel.ChannelOutboundHandlerAdapter;
+import io.netty.channel.ChannelPromise;
+import io.netty.util.concurrent.FastThreadLocal;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.UUID;
+import java.util.zip.Deflater;
+import org.apache.logging.log4j.LogManager;
+import org.apache.logging.log4j.Logger;
+import org.bukkit.craftbukkit.util.CraftChatMessage;
+
+// Athena - turns the 1.8 packets the server writes into the 1.7 packets a 1.7.10 client reads (see
+// AthenaLegacy17). It sits between the packet encoder and the length prepender, so it sees each
+// packet as its id and body, and may write it on as it is, rewrite it, split it into several
+// packets or drop it.
+//
+// Packet ids 0x00-0x40 mean the same in both versions; 1.8 added 0x41-0x49, which 1.7 has no use
+// for. Most of the rewriting is field formats: 1.8 made entity ids and many counts VarInts and
+// packed block positions into a long, and 1.7 gzips item NBT.
+final class AthenaLegacy17Encoder extends ChannelOutboundHandlerAdapter {
+
+    private static final Logger LOGGER = LogManager.getLogger();
+    private static final FastThreadLocal<Deflater> DEFLATER = new FastThreadLocal<Deflater>() {
+        @Override
+        protected Deflater initialValue() {
+            return new Deflater(4);
+        }
+    };
+
+    private final AthenaLegacy17.Session session;
+    /** Set by PacketEncoder when it wrote a packet already in 1.7's format (a cached chunk). */
+    boolean passThroughNext;
+    /** The packet being translated, for the packets that go out as they came. */
+    private ByteBuf current;
+    private boolean loggedFailure;
+
+    AthenaLegacy17Encoder(AthenaLegacy17.Session session) {
+        this.session = session;
+    }
+
+    @Override
+    public void write(ChannelHandlerContext ctx, Object msg, ChannelPromise promise) throws Exception {
+        if (!(msg instanceof ByteBuf) || !((ByteBuf) msg).isReadable()) {
+            ctx.write(msg, promise);
+            return;
+        }
+        if (this.passThroughNext) {
+            this.passThroughNext = false;
+            ctx.write(msg, promise);
+            return;
+        }
+        ByteBuf in = (ByteBuf) msg;
+        List<ByteBuf> out = new ArrayList<ByteBuf>(2);
+
+        this.current = in;
+        try {
+            EnumProtocol state = ctx.channel().attr(NetworkManager.attrKeyConnectionState).get();
+            PacketDataSerializer packet = new PacketDataSerializer(in);
+            int id = packet.readVarIntFromBuffer();
+
+            if (state == EnumProtocol.PLAY) {
+                this.play(ctx, id, packet, out);
+            } else if (state == EnumProtocol.LOGIN) {
+                this.login(ctx, id, packet, out);
+            } else {
+                in.readerIndex(0);
+                out.add(in.retain());
+            }
+        } catch (Exception e) {
+            for (ByteBuf buf : out) {
+                buf.release();
+            }
+            out.clear();
+            if (!this.loggedFailure) {
+                this.loggedFailure = true;
+                LOGGER.warn("Could not translate a packet for a 1.7 client; dropping it", e);
+            }
+        } finally {
+            this.current = null;
+            in.release();
+        }
+
+        if (out.isEmpty()) {
+            promise.trySuccess();
+            return;
+        }
+        for (int i = 0; i < out.size() - 1; ++i) {
+            ctx.write(out.get(i), ctx.voidPromise());
+        }
+        ctx.write(out.get(out.size() - 1), promise);
+    }
+
+    private static PacketDataSerializer packet(ChannelHandlerContext ctx, int id, List<ByteBuf> out) {
+        ByteBuf buf = ctx.alloc().buffer();
+        PacketDataSerializer packet = new PacketDataSerializer(buf);
+
+        out.add(buf);
+        packet.writeVarIntToBuffer(id);
+        return packet;
+    }
+
+    /** The packet as it came: the 1.7 packet with this id is the same. */
+    private void same(PacketDataSerializer in, List<ByteBuf> out) {
+        this.current.readerIndex(0);
+        out.add(this.current.retain());
+    }
+
+    private static void rest(PacketDataSerializer in, PacketDataSerializer out) {
+        out.writeBytes(in, in.readableBytes());
+    }
+
+    private void login(ChannelHandlerContext ctx, int id, PacketDataSerializer in, List<ByteBuf> out) {
+        switch (id) {
+            case 0x01: { // encryption request: 1.7 prefixes the arrays with shorts
+                PacketDataSerializer p = packet(ctx, id, out);
+
+                p.writeString(in.readStringFromBuffer(20));
+                for (int i = 0; i < 2; ++i) {
+                    byte[] bytes = in.readByteArray();
+
+                    p.writeShort(bytes.length);
+                    p.writeBytes(bytes);
+                }
+                break;
+            }
+            case 0x03: // set compression: never enabled for 1.7
+                break;
+            default:
+                same(in, out);
+        }
+    }
+
+    private void play(ChannelHandlerContext ctx, int id, PacketDataSerializer in, List<ByteBuf> out) throws IOException {
+        AthenaLegacy17.Session s = this.session;
+        PacketDataSerializer p;
+
+        switch (id) {
+            case 0x00: // keep alive
+                packet(ctx, id, out).writeInt(in.readVarIntFromBuffer());
+                break;
+            case 0x01: { // join game: 1.8 added reduced debug info
+                p = packet(ctx, id, out);
+                int entityId = in.readInt();
+
+                s.ownEntityId = entityId;
+                s.kinds.clear();
+                s.hidden.clear();
+                s.kinds.put(entityId, AthenaLegacy17Data.Kind.PLAYER);
+                p.writeInt(entityId);
+                p.writeByte(in.readUnsignedByte());
+                p.writeByte(in.readByte());
+                p.writeByte(in.readUnsignedByte());
+                p.writeByte(in.readUnsignedByte());
+                p.writeString(in.readStringFromBuffer(16));
+                break;
+            }
+            case 0x02: { // chat: no action bar in 1.7, and no line breaks
+                String json = in.readStringFromBuffer(32767);
+                int position = in.readByte();
+
+                if (position == 2) {
+                    break;
+                }
+                if (json.indexOf("\\n") < 0) {
+                    packet(ctx, id, out).writeString(json);
+                    break;
+                }
+                String text = AthenaLegacy17.legacyText(json, EnumChatFormat.WHITE);
+
+                for (IChatBaseComponent line : CraftChatMessage.fromString(text)) {
+                    packet(ctx, id, out).writeString(IChatBaseComponent.ChatSerializer.componentToJson(line));
+                }
+                break;
+            }
+            case 0x04: { // entity equipment
+                int entityId = in.readVarIntFromBuffer();
+                short slot = in.readShort();
+
+                if (s.hidden.contains(entityId) || slot > (entityId == s.ownEntityId ? 3 : 4)) {
+                    break;
+                }
+                p = packet(ctx, id, out);
+                p.writeInt(entityId);
+                p.writeShort(slot);
+                AthenaLegacy17.item(in, p);
+                break;
+            }
+            case 0x05: // spawn position
+            case 0x36: // sign editor
+                p = packet(ctx, id, out);
+                writeIntPosition(p, in.readBlockPos());
+                break;
+            case 0x06: // health
+                p = packet(ctx, id, out);
+                p.writeFloat(in.readFloat());
+                p.writeShort(clampShort(in.readVarIntFromBuffer()));
+                p.writeFloat(in.readFloat());
+                break;
+            case 0x07: // respawn: a new world, a new set of entities
+                s.kinds.clear();
+                s.hidden.clear();
+                s.kinds.put(s.ownEntityId, AthenaLegacy17Data.Kind.PLAYER);
+                same(in, out);
+                break;
+            case 0x08: { // position and look: 1.7 has no relative flags and takes the eye height
+                double x = in.readDouble();
+                double y = in.readDouble();
+                double z = in.readDouble();
+                float yaw = in.readFloat();
+                float pitch = in.readFloat();
+                int flags = in.readByte();
+
+                if ((flags & 0x01) != 0) x += s.x;
+                if ((flags & 0x02) != 0) y += s.y;
+                if ((flags & 0x04) != 0) z += s.z;
+                if ((flags & 0x08) != 0) yaw += s.yaw;
+                if ((flags & 0x10) != 0) pitch += s.pitch;
+                p = packet(ctx, id, out);
+                p.writeDouble(x);
+                p.writeDouble(y + 1.62D);
+                p.writeDouble(z);
+                p.writeFloat(yaw);
+                p.writeFloat(pitch);
+                p.writeBoolean(s.onGround);
+                break;
+            }
+            case 0x0A: { // use bed
+                int entityId = in.readVarIntFromBuffer();
+                BlockPosition pos = in.readBlockPos();
+
+                p = packet(ctx, id, out);
+                p.writeInt(entityId);
+                p.writeInt(pos.getX());
+                p.writeByte(pos.getY());
+                p.writeInt(pos.getZ());
+                break;
+            }
+            case 0x0B: // animation
+            case 0x19: // head look
+            case 0x1E: // remove effect
+                entityIdToInt(ctx, id, in, out, id == 0x0B);
+                break;
+            case 0x0C: // spawn player: 1.7 takes the name and skin here, 1.8 from the tab list
+                this.spawnPlayer(ctx, id, in, out);
+                break;
+            case 0x0D: { // collect item
+                int collected = in.readVarIntFromBuffer();
+                int collector = in.readVarIntFromBuffer();
+
+                p = packet(ctx, id, out);
+                p.writeInt(collected);
+                p.writeInt(collector);
+                break;
+            }
+            case 0x0E: // spawn object
+                this.spawnObject(ctx, id, in, out);
+                break;
+            case 0x0F: // spawn mob
+                this.spawnMob(ctx, id, in, out);
+                break;
+            case 0x10: { // spawn painting: the position of the painting, not of the block behind it
+                int entityId = in.readVarIntFromBuffer();
+                String title = in.readStringFromBuffer(13);
+                BlockPosition pos = in.readBlockPos();
+                int direction = in.readUnsignedByte();
+                int dx = direction == 1 ? 1 : direction == 3 ? -1 : 0;
+                int dz = direction == 0 ? -1 : direction == 2 ? 1 : 0;
+
+                s.kinds.put(entityId, AthenaLegacy17Data.Kind.PAINTING);
+                p = packet(ctx, id, out);
+                p.writeVarIntToBuffer(entityId);
+                p.writeString(title);
+                p.writeInt(pos.getX() + dx);
+                p.writeInt(pos.getY());
+                p.writeInt(pos.getZ() + dz);
+                p.writeInt(direction);
+                break;
+            }
+            case 0x11: { // spawn experience orb
+                int start = in.readerIndex();
+
+                s.kinds.put(in.readVarIntFromBuffer(), AthenaLegacy17Data.Kind.EXPERIENCE_ORB);
+                in.readerIndex(start);
+                same(in, out);
+                break;
+            }
+            case 0x12: // velocity
+            case 0x14: // entity
+            case 0x20: // properties
+                if (id == 0x20) {
+                    this.properties(ctx, id, in, out);
+                } else {
+                    entityIdToInt(ctx, id, in, out, false);
+                }
+                break;
+            case 0x13: // destroy entities: 1.7 counts them in a byte
+                this.destroy(ctx, id, in, out);
+                break;
+            case 0x15: // relative move
+            case 0x16: // look
+            case 0x17: { // relative move and look: 1.8 added on-ground
+                int entityId = in.readVarIntFromBuffer();
+
+                if (s.hidden.contains(entityId)) {
+                    break;
+                }
+                p = packet(ctx, id, out);
+                p.writeInt(entityId);
+                p.writeBytes(in, id == 0x17 ? 5 : id == 0x15 ? 3 : 2);
+                break;
+            }
+            case 0x18: { // teleport
+                int entityId = in.readVarIntFromBuffer();
+
+                if (s.hidden.contains(entityId)) {
+                    break;
+                }
+                int x = in.readInt();
+                int y = in.readInt();
+                int z = in.readInt();
+
+                if (s.kind(entityId) == AthenaLegacy17Data.Kind.MINECART || s.kind(entityId) == AthenaLegacy17Data.Kind.FURNACE_MINECART) {
+                    y += 12;    // 1.7 draws minecarts from a different origin
+                }
+                p = packet(ctx, id, out);
+                p.writeInt(entityId);
+                p.writeInt(x);
+                p.writeInt(y);
+                p.writeInt(z);
+                p.writeByte(in.readByte());
+                p.writeByte(in.readByte());
+                break;
+            }
+            case 0x1A: // entity status
+            case 0x1B: { // attach
+                int start = in.readerIndex();
+
+                if (s.hidden.contains(in.readInt())) {
+                    break;
+                }
+                in.readerIndex(start);
+                same(in, out);
+                break;
+            }
+            case 0x1C: { // metadata
+                int entityId = in.readVarIntFromBuffer();
+
+                if (s.hidden.contains(entityId)) {
+                    break;
+                }
+                p = packet(ctx, id, out);
+                p.writeInt(entityId);
+                metadata(s.kind(entityId), in, p);
+                break;
+            }
+            case 0x1D: { // effect
+                int entityId = in.readVarIntFromBuffer();
+
+                if (s.hidden.contains(entityId)) {
+                    break;
+                }
+                p = packet(ctx, id, out);
+                p.writeInt(entityId);
+                p.writeByte(in.readByte());
+                p.writeByte(in.readByte());
+                p.writeShort(clampShort(in.readVarIntFromBuffer()));
+                break;
+            }
+            case 0x1F: // experience
+                p = packet(ctx, id, out);
+                p.writeFloat(in.readFloat());
+                p.writeShort(clampShort(in.readVarIntFromBuffer()));
+                p.writeShort(clampShort(in.readVarIntFromBuffer()));
+                break;
+            case 0x21: // chunk
+                this.chunk(ctx, id, in, out);
+                break;
+            case 0x22: // multi block change
+                this.multiBlockChange(ctx, id, in, out);
+                break;
+            case 0x23: { // block change
+                BlockPosition pos = in.readBlockPos();
+                int state = AthenaLegacy17Data.block(in.readVarIntFromBuffer());
+
+                p = packet(ctx, id, out);
+                p.writeInt(pos.getX());
+                p.writeByte(pos.getY());
+                p.writeInt(pos.getZ());
+                p.writeVarIntToBuffer(state >> 4);
+                p.writeByte(state & 15);
+                break;
+            }
+            case 0x24: { // block action
+                BlockPosition pos = in.readBlockPos();
+
+                p = packet(ctx, id, out);
+                p.writeInt(pos.getX());
+                p.writeShort(pos.getY());
+                p.writeInt(pos.getZ());
+                rest(in, p);
+                break;
+            }
+            case 0x25: { // block break animation
+                int entityId = in.readVarIntFromBuffer();
+
+                p = packet(ctx, id, out);
+                p.writeVarIntToBuffer(entityId);
+                writeIntPosition(p, in.readBlockPos());
+                p.writeByte(in.readByte());
+                break;
+            }
+            case 0x26: // chunk bulk
+                this.chunkBulk(ctx, id, in, out);
+                break;
+            case 0x28: { // world event
+                int effect = in.readInt();
+                BlockPosition pos = in.readBlockPos();
+                int data = in.readInt();
+
+                if (effect == 2001) {   // block break: the block's id and meta
+                    int state = AthenaLegacy17Data.block((data & 4095) << 4 | data >> 12 & 15);
+
+                    data = state >> 4 | (state & 15) << 12;
+                }
+                p = packet(ctx, id, out);
+                p.writeInt(effect);
+                p.writeInt(pos.getX());
+                p.writeByte(pos.getY());
+                p.writeInt(pos.getZ());
+                p.writeInt(data);
+                p.writeBoolean(in.readBoolean());
+                break;
+            }
+            case 0x2A: // particles
+                this.particles(ctx, id, in, out);
+                break;
+            case 0x2D: // open window
+                this.openWindow(ctx, id, in, out);
+                break;
+            case 0x2E: // close window
+                s.windowTypes.remove(in.readUnsignedByte());
+                same(in, out);
+                break;
+            case 0x2F: { // set slot
+                int window = in.readByte();
+                int slot = in.readShort();
+
+                if (s.windowTypes.get(window) == 4 && window != 0) {    // enchanting table: no lapis slot
+                    if (slot == 1) {
+                        break;
+                    }
+                    if (slot > 1) {
+                        --slot;
+                    }
+                }
+                p = packet(ctx, id, out);
+                p.writeByte(window);
+                p.writeShort(slot);
+                AthenaLegacy17.item(in, p);
+                break;
+            }
+            case 0x30: { // window items
+                int window = in.readUnsignedByte();
+                int count = in.readShort();
+                boolean enchanting = window != 0 && s.windowTypes.get(window) == 4;
+
+                p = packet(ctx, id, out);
+                p.writeByte(window);
+                p.writeShort(enchanting ? count - 1 : count);
+                for (int i = 0; i < count; ++i) {
+                    if (enchanting && i == 1) {
+                        AthenaLegacy17.item(in, new PacketDataSerializer(io.netty.buffer.Unpooled.buffer()));
+                        continue;
+                    }
+                    AthenaLegacy17.item(in, p);
+                }
+                break;
+            }
+            case 0x31: // window property
+                this.windowProperty(ctx, id, in, out);
+                break;
+            case 0x33: { // update sign: plain text, at most 15 characters a line
+                BlockPosition pos = in.readBlockPos();
+
+                p = packet(ctx, id, out);
+                p.writeInt(pos.getX());
+                p.writeShort(pos.getY());
+                p.writeInt(pos.getZ());
+                for (int i = 0; i < 4; ++i) {
+                    String line = AthenaLegacy17.legacyText(in.readStringFromBuffer(32767), EnumChatFormat.BLACK);
+
+                    if (line.length() > 15) {
+                        line = org.bukkit.ChatColor.stripColor(line);
+                    }
+                    p.writeString(AthenaLegacy17.truncate(line, 15));
+                }
+                break;
+            }
+            case 0x34: // map
+                this.map(ctx, id, in, out);
+                break;
+            case 0x35: { // tile entity data: gzipped NBT
+                BlockPosition pos = in.readBlockPos();
+                int action = in.readUnsignedByte();
+                NBTTagCompound tag = AthenaLegacy17.readNbt(in);
+
+                p = packet(ctx, id, out);
+                p.writeInt(pos.getX());
+                p.writeShort(pos.getY());
+                p.writeInt(pos.getZ());
+                p.writeByte(action);
+                AthenaLegacy17.writeCompressedNbt(p, tag);
+                break;
+            }
+            case 0x38: // player list item
+                this.playerInfo(ctx, id, in, out);
+                break;
+            case 0x3B: // scoreboard objective
+                this.objective(ctx, id, in, out);
+                break;
+            case 0x3C: { // update score
+                String name = in.readStringFromBuffer(40);
+                int action = in.readByte();
+                String objective = in.readStringFromBuffer(16);
+
+                if (name.length() > 16) {
+                    name = AthenaLegacy17.truncate(org.bukkit.ChatColor.stripColor(name), 16);
+                }
+                p = packet(ctx, id, out);
+                p.writeString(name);
+                p.writeByte(action);
+                if (action != 1) {
+                    p.writeString(objective);
+                    p.writeInt(in.readVarIntFromBuffer());
+                }
+                break;
+            }
+            case 0x3D: { // display scoreboard: no per-team sidebars in 1.7
+                int start = in.readerIndex();
+
+                if (in.readByte() > 2) {
+                    break;
+                }
+                in.readerIndex(start);
+                same(in, out);
+                break;
+            }
+            case 0x3E: // teams
+                this.team(ctx, id, in, out);
+                break;
+            case 0x3F: // plugin message
+                this.pluginMessage(ctx, id, in, out);
+                break;
+            case 0x48: { // resource pack: 1.7 took the URL in a plugin message
+                byte[] url = in.readStringFromBuffer(32767).getBytes(StandardCharsets.UTF_8);
+
+                p = packet(ctx, 0x3F, out);
+                p.writeString("MC|RPack");
+                p.writeShort(url.length);
+                p.writeBytes(url);
+                break;
+            }
+            case 0x41: // difficulty
+            case 0x42: // combat
+            case 0x43: // camera
+            case 0x44: // world border
+            case 0x45: // title
+            case 0x46: // set compression
+            case 0x47: // tab list header and footer
+            case 0x49: // update entity NBT
+                break;
+            default:
+                same(in, out);
+        }
+    }
+
+    // --- entities -------------------------------------------------------------------------------
+
+    private void entityIdToInt(ChannelHandlerContext ctx, int id, PacketDataSerializer in, List<ByteBuf> out, boolean keepVarInt) {
+        int entityId = in.readVarIntFromBuffer();
+
+        if (this.session.hidden.contains(entityId)) {
+            return;
+        }
+        PacketDataSerializer p = packet(ctx, id, out);
+
+        if (keepVarInt) {
+            p.writeVarIntToBuffer(entityId);
+        } else {
+            p.writeInt(entityId);
+        }
+        rest(in, p);
+    }
+
+    private void spawnPlayer(ChannelHandlerContext ctx, int id, PacketDataSerializer in, List<ByteBuf> out) throws IOException {
+        int entityId = in.readVarIntFromBuffer();
+        UUID uuid = in.readUuid();
+        AthenaLegacy17.Profile profile = this.session.profiles.get(uuid);
+        PacketDataSerializer p = packet(ctx, id, out);
+
+        this.session.kinds.put(entityId, AthenaLegacy17Data.Kind.PLAYER);
+        p.writeVarIntToBuffer(entityId);
+        p.writeString(uuid.toString());
+        if (profile == null) {
+            p.writeString("");
+            p.writeVarIntToBuffer(0);
+        } else {
+            p.writeString(AthenaLegacy17.truncate(profile.name, 16));
+            p.writeVarIntToBuffer(profile.properties.size());
+            for (String[] property : profile.properties) {
+                p.writeString(property[0]);
+                p.writeString(property[1]);
+                p.writeString(property[2] == null ? "" : property[2]);
+            }
+        }
+        p.writeBytes(in, 4 + 4 + 4 + 1 + 1 + 2); // position, rotation, held item
+        metadata(AthenaLegacy17Data.Kind.PLAYER, in, p);
+    }
+
+    private void spawnObject(ChannelHandlerContext ctx, int id, PacketDataSerializer in, List<ByteBuf> out) {
+        int entityId = in.readVarIntFromBuffer();
+        int type = in.readByte();
+        int x = in.readInt();
+        int y = in.readInt();
+        int z = in.readInt();
+        int pitch = in.readByte();
+        int yaw = in.readByte();
+        int data = in.readInt();
+        AthenaLegacy17Data.Kind kind = AthenaLegacy17Data.object(type);
+
+        if (kind == AthenaLegacy17Data.Kind.ARMOR_STAND) {
+            this.session.hidden.add(entityId);
+            return;
+        }
+        this.session.kinds.put(entityId, kind);
+        if (kind == AthenaLegacy17Data.Kind.ITEM_FRAME) {
+            // 1.7 places an item frame by the block it hangs on
+            switch (yaw) {
+                case -128: z += 32; yaw = 0; break;
+                case -64: x -= 32; break;
+                case 0: z -= 32; yaw = -128; break;
+                case 64: x += 32; break;
+                default: break;
+            }
+        } else if (kind == AthenaLegacy17Data.Kind.FALLING_BLOCK) {
+            // 1.8: id | meta << 12; 1.7: id | meta << 16
+            int state = AthenaLegacy17Data.block((data & 4095) << 4 | data >> 12 & 15);
+
+            data = state >> 4 | (state & 15) << 16;
+        }
+        PacketDataSerializer p = packet(ctx, id, out);
+
+        p.writeVarIntToBuffer(entityId);
+        p.writeByte(type);
+        p.writeInt(x);
+        p.writeInt(y);
+        p.writeInt(z);
+        p.writeByte(pitch);
+        p.writeByte(yaw);
+        p.writeInt(data);
+        rest(in, p); // the velocity, when data > 0
+    }
+
+    private void spawnMob(ChannelHandlerContext ctx, int id, PacketDataSerializer in, List<ByteBuf> out) throws IOException {
+        int entityId = in.readVarIntFromBuffer();
+        int type = in.readUnsignedByte();
+        int type17 = AthenaLegacy17Data.mobType17(type);
+
+        if (type17 == -1) {
+            this.session.hidden.add(entityId);
+            return;
+        }
+        // metadata is laid out by the mob the client is shown, not the one it replaces
+        AthenaLegacy17Data.Kind kind = AthenaLegacy17Data.mob(type17);
+        PacketDataSerializer p = packet(ctx, id, out);
+
+        this.session.kinds.put(entityId, kind);
+        p.writeVarIntToBuffer(entityId);
+        p.writeByte(type17);
+        p.writeBytes(in, 4 + 4 + 4 + 1 + 1 + 1 + 2 + 2 + 2); // position, rotation, head, velocity
+        metadata(kind, in, p);
+    }
+
+    private void destroy(ChannelHandlerContext ctx, int id, PacketDataSerializer in, List<ByteBuf> out) {
+        int count = in.readVarIntFromBuffer();
+        int[] ids = new int[count];
+        int kept = 0;
+
+        for (int i = 0; i < count; ++i) {
+            int entityId = in.readVarIntFromBuffer();
+
+            this.session.kinds.remove(entityId);
+            if (!this.session.hidden.remove(entityId)) {
+                ids[kept++] = entityId;
+            }
+        }
+        for (int from = 0; from < kept; from += 127) {
+            int n = Math.min(127, kept - from);
+            PacketDataSerializer p = packet(ctx, id, out);
+
+            p.writeByte(n);
+            for (int i = from; i < from + n; ++i) {
+                p.writeInt(ids[i]);
+            }
+        }
+    }
+
+    private void properties(ChannelHandlerContext ctx, int id, PacketDataSerializer in, List<ByteBuf> out) {
+        int entityId = in.readVarIntFromBuffer();
+
+        if (this.session.hidden.contains(entityId)) {
+            return;
+        }
+        PacketDataSerializer p = packet(ctx, id, out);
+        int count = in.readInt();
+
+        p.writeInt(entityId);
+        p.writeInt(count);
+        for (int i = 0; i < count; ++i) {
+            p.writeString(in.readStringFromBuffer(64));
+            p.writeDouble(in.readDouble());
+            int modifiers = in.readVarIntFromBuffer();
+
+            p.writeShort(modifiers);
+            p.writeBytes(in, modifiers * (16 + 8 + 1));
+        }
+    }
+
+    /** Rewrites a 1.8 metadata list for a 1.7 client: entries move, change type or go. */
+    static void metadata(AthenaLegacy17Data.Kind kind, PacketDataSerializer in, PacketDataSerializer out) throws IOException {
+        while (true) {
+            int header = in.readUnsignedByte();
+
+            if (header == 127) {
+                break;
+            }
+            int type = header >> 5;
+            int index = header & 31;
+            AthenaLegacy17Data.Meta meta = AthenaLegacy17Data.meta(kind, index);
+
+            switch (type) {
+                case AthenaLegacy17Data.BYTE: {
+                    byte value = in.readByte();
+
+                    if (meta == null) {
+                        break;
+                    }
+                    if (meta.convert == AthenaLegacy17Data.BYTE_TO_INT_AGE) {
+                        out.writeByte(AthenaLegacy17Data.INT << 5 | meta.index);
+                        out.writeInt(value < 0 ? -25000 : value);
+                    } else if (meta.type == AthenaLegacy17Data.BYTE) {
+                        if (meta.convert == AthenaLegacy17Data.FRAME_ROTATION) {
+                            value = (byte) (value % 4);
+                        } else if (meta.convert == AthenaLegacy17Data.SKIN_TO_CAPE) {
+                            value = (byte) ((value & 0x01) != 0 ? 0 : 2);
+                        }
+                        out.writeByte(AthenaLegacy17Data.BYTE << 5 | meta.index);
+                        out.writeByte(value);
+                    }
+                    break;
+                }
+                case AthenaLegacy17Data.SHORT: {
+                    short value = in.readShort();
+
+                    if (meta != null && meta.type == AthenaLegacy17Data.SHORT) {
+                        out.writeByte(AthenaLegacy17Data.SHORT << 5 | meta.index);
+                        out.writeShort(value);
+                    }
+                    break;
+                }
+                case AthenaLegacy17Data.INT: {
+                    int value = in.readInt();
+
+                    if (meta != null && meta.type == AthenaLegacy17Data.INT) {
+                        out.writeByte(AthenaLegacy17Data.INT << 5 | meta.index);
+                        out.writeInt(value);
+                    }
+                    break;
+                }
+                case AthenaLegacy17Data.FLOAT: {
+                    float value = in.readFloat();
+
+                    if (meta != null && meta.type == AthenaLegacy17Data.FLOAT) {
+                        out.writeByte(AthenaLegacy17Data.FLOAT << 5 | meta.index);
+                        out.writeFloat(value);
+                    }
+                    break;
+                }
+                case AthenaLegacy17Data.STRING: {
+                    String value = in.readStringFromBuffer(32767);
+
+                    if (meta != null && meta.type == AthenaLegacy17Data.STRING) {
+                        out.writeByte(AthenaLegacy17Data.STRING << 5 | meta.index);
+                        out.writeString(value);
+                    }
+                    break;
+                }
+                case AthenaLegacy17Data.ITEM_STACK:
+                    if (meta != null && meta.type == AthenaLegacy17Data.ITEM_STACK) {
+                        out.writeByte(AthenaLegacy17Data.ITEM_STACK << 5 | meta.index);
+                        AthenaLegacy17.item(in, out);
+                    } else {
+                        AthenaLegacy17.item(in, new PacketDataSerializer(io.netty.buffer.Unpooled.buffer()));
+                    }
+                    break;
+                case AthenaLegacy17Data.POSITION: {
+                    int x = in.readInt();
+                    int y = in.readInt();
+                    int z = in.readInt();
+
+                    if (meta != null && meta.type == AthenaLegacy17Data.POSITION) {
+                        out.writeByte(AthenaLegacy17Data.POSITION << 5 | meta.index);
+                        out.writeInt(x);
+                        out.writeInt(y);
+                        out.writeInt(z);
+                    }
+                    break;
+                }
+                case AthenaLegacy17Data.ROTATION:
+                    in.skipBytes(12);   // armor stand poses: nothing in 1.7 has them
+                    break;
+                default:
+                    throw new IOException("Unknown metadata type " + type);
+            }
+        }
+        out.writeByte(127);
+    }
+
+    // --- the tab list and scoreboards -----------------------------------------------------------
+
+    private void playerInfo(ChannelHandlerContext ctx, int id, PacketDataSerializer in, List<ByteBuf> out) {
+        int action = in.readVarIntFromBuffer();
+        int count = in.readVarIntFromBuffer();
+
+        for (int i = 0; i < count; ++i) {
+            UUID uuid = in.readUuid();
+            AthenaLegacy17.Profile profile;
+
+            switch (action) {
+                case 0: { // add
+                    profile = new AthenaLegacy17.Profile(in.readStringFromBuffer(16));
+                    int properties = in.readVarIntFromBuffer();
+
+                    for (int j = 0; j < properties; ++j) {
+                        String name = in.readStringFromBuffer(32767);
+                        String value = in.readStringFromBuffer(32767);
+                        String signature = in.readBoolean() ? in.readStringFromBuffer(32767) : null;
+
+                        profile.properties.add(new String[] {name, value, signature});
+                    }
+                    profile.gamemode = in.readVarIntFromBuffer();
+                    profile.ping = in.readVarIntFromBuffer();
+                    if (in.readBoolean()) {
+                        profile.displayName = AthenaLegacy17.legacyText(in.readStringFromBuffer(32767), EnumChatFormat.WHITE);
+                    }
+                    AthenaLegacy17.Profile old = this.session.profiles.put(uuid, profile);
+
+                    if (old != null && !old.listName().equals(profile.listName())) {
+                        listEntry(ctx, id, out, old.listName(), false, 0);
+                    }
+                    listEntry(ctx, id, out, profile.listName(), true, profile.ping);
+                    break;
+                }
+                case 1: // game mode
+                    profile = this.session.profiles.get(uuid);
+                    int gamemode = in.readVarIntFromBuffer();
+
+                    if (profile != null) {
+                        profile.gamemode = gamemode;
+                    }
+                    break;
+                case 2: // latency
+                    profile = this.session.profiles.get(uuid);
+                    int ping = in.readVarIntFromBuffer();
+
+                    if (profile != null && profile.ping != ping) {
+                        profile.ping = ping;
+                        listEntry(ctx, id, out, profile.listName(), true, ping);
+                    }
+                    break;
+                case 3: { // display name
+                    profile = this.session.profiles.get(uuid);
+                    String displayName = in.readBoolean() ? AthenaLegacy17.legacyText(in.readStringFromBuffer(32767), EnumChatFormat.WHITE) : null;
+
+                    if (profile != null) {
+                        String before = profile.listName();
+
+                        profile.displayName = displayName;
+                        if (!before.equals(profile.listName())) {
+                            listEntry(ctx, id, out, before, false, 0);
+                            listEntry(ctx, id, out, profile.listName(), true, profile.ping);
+                        }
+                    }
+                    break;
+                }
+                case 4: // remove
+                    profile = this.session.profiles.remove(uuid);
+                    if (profile != null) {
+                        listEntry(ctx, id, out, profile.listName(), false, 0);
+                    }
+                    break;
+                default:
+                    return;
+            }
+        }
+    }
+
+    private static void listEntry(ChannelHandlerContext ctx, int id, List<ByteBuf> out, String name, boolean online, int ping) {
+        PacketDataSerializer p = packet(ctx, id, out);
+
+        p.writeString(name);
+        p.writeBoolean(online);
+        p.writeShort(clampShort(ping));
+    }
+
+    private void objective(ChannelHandlerContext ctx, int id, PacketDataSerializer in, List<ByteBuf> out) {
+        String name = in.readStringFromBuffer(16);
+        int mode = in.readByte();
+        String displayName = "";
+
+        if (mode == 0 || mode == 2) {
+            displayName = in.readStringFromBuffer(32);
+            in.readStringFromBuffer(16); // how to display the score: 1.7 has only numbers
+        }
+        // a 1.7 client disconnects on an objective it already has, or on one it does not
+        if (mode == 0 ? !this.session.objectives.add(name) : !this.session.objectives.contains(name)) {
+            return;
+        }
+        if (mode == 1) {
+            this.session.objectives.remove(name);
+        }
+        PacketDataSerializer p = packet(ctx, id, out);
+
+        p.writeString(name);
+        p.writeString(displayName);
+        p.writeByte(mode);
+    }
+
+    private void team(ChannelHandlerContext ctx, int id, PacketDataSerializer in, List<ByteBuf> out) {
+        String name = in.readStringFromBuffer(16);
+        int mode = in.readByte();
+
+        // as with objectives, a duplicate or unknown team disconnects a 1.7 client
+        if (mode == 0) {
+            if (!this.session.teams.add(name)) {
+                PacketDataSerializer remove = packet(ctx, id, out);
+
+                remove.writeString(name);
+                remove.writeByte(1);
+            }
+        } else if (!this.session.teams.contains(name)) {
+            return;
+        } else if (mode == 1) {
+            this.session.teams.remove(name);
+        }
+        PacketDataSerializer p = packet(ctx, id, out);
+
+        p.writeString(name);
+        p.writeByte(mode);
+        if (mode == 0 || mode == 2) {
+            p.writeString(in.readStringFromBuffer(32));   // display name
+            p.writeString(in.readStringFromBuffer(16));   // prefix
+            p.writeString(in.readStringFromBuffer(16));   // suffix
+            p.writeByte(in.readByte());                   // friendly fire
+            in.readStringFromBuffer(32);                  // name tag visibility: 1.8's
+            in.readByte();                                // colour: 1.8's
+        }
+        if (mode == 0 || mode == 3 || mode == 4) {
+            int count = in.readVarIntFromBuffer();
+
+            p.writeShort(count);
+            for (int i = 0; i < count; ++i) {
+                p.writeString(in.readStringFromBuffer(40));
+            }
+        }
+    }
+
+    // --- windows --------------------------------------------------------------------------------
+
+    private void openWindow(ChannelHandlerContext ctx, int id, PacketDataSerializer in, List<ByteBuf> out) {
+        int window = in.readUnsignedByte();
+        int type = AthenaLegacy17Data.windowType(in.readStringFromBuffer(32));
+        String title = AthenaLegacy17.legacyText(in.readStringFromBuffer(32767), EnumChatFormat.DARK_GRAY);
+        int slots = in.readUnsignedByte();
+
+        if (type == -1) {
+            type = 0;
+        }
+        this.session.windowTypes.put(window, type);
+        this.session.furnaces.remove(window);
+        PacketDataSerializer p = packet(ctx, id, out);
+
+        p.writeByte(window);
+        p.writeByte(type);
+        p.writeString(AthenaLegacy17.truncate(title, 32));
+        p.writeByte(type == 4 ? Math.max(0, slots - 1) : slots);
+        p.writeBoolean(true);
+        if (type == 11) {
+            p.writeInt(in.readInt());
+        }
+    }
+
+    private void windowProperty(ChannelHandlerContext ctx, int id, PacketDataSerializer in, List<ByteBuf> out) {
+        int window = in.readUnsignedByte();
+        int property = in.readShort();
+        int value = in.readShort();
+        int type = this.session.windowTypes.get(window);
+
+        if (type == 2) {
+            // 1.8 sends the furnace's fuel and progress with their totals; 1.7 wants each out of 200
+            int[] furnace = this.session.furnaces.get(window);
+
+            if (furnace == null) {
+                this.session.furnaces.put(window, furnace = new int[4]);
+            }
+            furnace[property & 3] = value;
+            if (property == 0 || property == 1) {
+                if (furnace[1] == 0) {
+                    return;
+                }
+                property = 1;
+                value = 200 * furnace[0] / furnace[1];
+            } else {
+                if (furnace[3] == 0) {
+                    return;
+                }
+                property = 0;
+                value = 200 * furnace[2] / furnace[3];
+            }
+        } else if (type == 4 && property > 2) {
+            return;
+        }
+        PacketDataSerializer p = packet(ctx, id, out);
+
+        p.writeByte(window);
+        p.writeShort(property);
+        p.writeShort(value);
+    }
+
+    private void pluginMessage(ChannelHandlerContext ctx, int id, PacketDataSerializer in, List<ByteBuf> out) throws IOException {
+        String channel = in.readStringFromBuffer(20);
+        PacketDataSerializer data = new PacketDataSerializer(ctx.alloc().buffer());
+
+        try {
+            if (channel.equals("MC|Brand")) {
+                data.writeBytes(in.readStringFromBuffer(32767).getBytes(StandardCharsets.UTF_8));
+            } else if (channel.equals("MC|TrList")) {
+                // villager trades: items in 1.7's format, and no use counts
+                data.writeInt(in.readInt());
+                int count = in.readUnsignedByte();
+
+                data.writeByte(count);
+                for (int i = 0; i < count; ++i) {
+                    AthenaLegacy17.item(in, data);
+                    AthenaLegacy17.item(in, data);
+                    boolean third = in.readBoolean();
+
+                    data.writeBoolean(third);
+                    if (third) {
+                        AthenaLegacy17.item(in, data);
+                    }
+                    data.writeBoolean(in.readBoolean());
+                    in.readInt();
+                    in.readInt();
+                }
+            } else {
+                rest(in, data);
+            }
+            if (data.readableBytes() > Short.MAX_VALUE) {
+                return;
+            }
+            PacketDataSerializer p = packet(ctx, id, out);
+
+            p.writeString(channel);
+            p.writeShort(data.readableBytes());
+            p.writeBytes(data);
+        } finally {
+            data.release();
+        }
+    }
+
+    // --- world ----------------------------------------------------------------------------------
+
+    private void multiBlockChange(ChannelHandlerContext ctx, int id, PacketDataSerializer in, List<ByteBuf> out) {
+        int chunkX = in.readInt();
+        int chunkZ = in.readInt();
+        int count = in.readVarIntFromBuffer();
+        PacketDataSerializer p = packet(ctx, id, out);
+
+        p.writeInt(chunkX);
+        p.writeInt(chunkZ);
+        p.writeShort(count);
+        p.writeInt(count * 4);
+        for (int i = 0; i < count; ++i) {
+            int xz = in.readUnsignedByte();
+            int y = in.readUnsignedByte();
+
+            p.writeShort(xz << 8 | y);
+            p.writeShort(AthenaLegacy17Data.block(in.readVarIntFromBuffer()));
+        }
+    }
+
+    private void chunk(ChannelHandlerContext ctx, int id, PacketDataSerializer in, List<ByteBuf> out) throws IOException {
+        int chunkX = in.readInt();
+        int chunkZ = in.readInt();
+        boolean groundUp = in.readBoolean();
+        int mask = in.readUnsignedShort();
+        int size = in.readVarIntFromBuffer();
+        int sections = Integer.bitCount(mask);
+        boolean sky = size == sections * (8192 + 2048 + 2048) + (groundUp ? 256 : 0);
+        byte[] data = convertChunk(in, sections, sky, groundUp);
+        PacketDataSerializer p = packet(ctx, id, out);
+
+        p.writeInt(chunkX);
+        p.writeInt(chunkZ);
+        p.writeBoolean(groundUp);
+        p.writeShort(mask);
+        p.writeShort(0);        // no block ids above 255
+        writeDeflated(p, data, data.length);
+    }
+
+    private void chunkBulk(ChannelHandlerContext ctx, int id, PacketDataSerializer in, List<ByteBuf> out) throws IOException {
+        boolean sky = in.readBoolean();
+        int count = in.readVarIntFromBuffer();
+        int[] xs = new int[count];
+        int[] zs = new int[count];
+        int[] masks = new int[count];
+        int total = 0;
+
+        for (int i = 0; i < count; ++i) {
+            xs[i] = in.readInt();
+            zs[i] = in.readInt();
+            masks[i] = in.readUnsignedShort();
+            total += Integer.bitCount(masks[i]) * (4096 + 2048 + 2048 + (sky ? 2048 : 0)) + 256;
+        }
+        byte[] all = new byte[total];
+        int at = 0;
+
+        for (int i = 0; i < count; ++i) {
+            byte[] data = convertChunk(in, Integer.bitCount(masks[i]), sky, true);
+
+            System.arraycopy(data, 0, all, at, data.length);
+            at += data.length;
+        }
+        PacketDataSerializer p = packet(ctx, id, out);
+
+        p.writeShort(count);
+        int lengthAt = p.writerIndex();
+
+        p.writeInt(0);
+        p.writeBoolean(sky);
+        int start = p.writerIndex();
+
+        deflate(p, all, at);
+        p.setInt(lengthAt, p.writerIndex() - start);
+        for (int i = 0; i < count; ++i) {
+            p.writeInt(xs[i]);
+            p.writeInt(zs[i]);
+            p.writeShort(masks[i]);
+            p.writeShort(0);
+        }
+    }
+
+    /** A whole 1.7 chunk packet, id first, from a full chunk's 1.8 data: see AthenaChunkPacketCache. */
+    static byte[] fullChunk(int packetId, int chunkX, int chunkZ, int mask, byte[] data18) {
+        int sections = Integer.bitCount(mask);
+        boolean sky = data18.length == sections * (8192 + 2048 + 2048) + 256;
+        byte[] data = convertChunk(new PacketDataSerializer(io.netty.buffer.Unpooled.wrappedBuffer(data18)), sections, sky, true);
+        PacketDataSerializer p = new PacketDataSerializer(io.netty.buffer.Unpooled.buffer(data.length / 4 + 64));
+
+        p.writeVarIntToBuffer(packetId);
+        p.writeInt(chunkX);
+        p.writeInt(chunkZ);
+        p.writeBoolean(true);
+        p.writeShort(mask);
+        p.writeShort(0);
+        writeDeflated(p, data, data.length);
+        byte[] bytes = new byte[p.readableBytes()];
+
+        p.readBytes(bytes);
+        return bytes;
+    }
+
+    /**
+     * One chunk's 1.8 data - per section 4096 little-endian chars of id << 4 | meta, then the
+     * light - as 1.7's: the ids as bytes, then the metas as nibbles, then the same light.
+     */
+    static byte[] convertChunk(PacketDataSerializer in, int sections, boolean sky, boolean biomes) {
+        int blocks = sections * 4096;
+        int light = sections * 2048 * (sky ? 2 : 1);
+        byte[] data = new byte[blocks + blocks / 2 + light + (biomes ? 256 : 0)];
+
+        for (int i = 0; i < blocks; ++i) {
+            int state = AthenaLegacy17Data.block(in.readUnsignedByte() | in.readUnsignedByte() << 8);
+
+            data[i] = (byte) (state >> 4);
+            int meta = state & 15;
+            int at = blocks + (i >> 1);
+
+            data[at] = (byte) ((i & 1) == 0 ? data[at] & 0xF0 | meta : data[at] & 0x0F | meta << 4);
+        }
+        in.readBytes(data, blocks + blocks / 2, light + (biomes ? 256 : 0));
+        return data;
+    }
+
+    private static void writeDeflated(PacketDataSerializer p, byte[] data, int length) {
+        int lengthAt = p.writerIndex();
+
+        p.writeInt(0);
+        int start = p.writerIndex();
+
+        deflate(p, data, length);
+        p.setInt(lengthAt, p.writerIndex() - start);
+    }
+
+    private static void deflate(PacketDataSerializer p, byte[] data, int length) {
+        Deflater deflater = DEFLATER.get();
+        byte[] chunk = new byte[8192];
+
+        deflater.reset();
+        deflater.setInput(data, 0, length);
+        deflater.finish();
+        while (!deflater.finished()) {
+            int n = deflater.deflate(chunk);
+
+            p.writeBytes(chunk, 0, n);
+        }
+    }
+
+    private void particles(ChannelHandlerContext ctx, int id, PacketDataSerializer in, List<ByteBuf> out) {
+        int particle = in.readInt();
+
+        in.readBoolean(); // long distance: 1.8's
+        float[] floats = new float[7];
+
+        for (int i = 0; i < floats.length; ++i) {
+            floats[i] = in.readFloat();
+        }
+        int count = in.readInt();
+        String name = particle >= 0 && particle < AthenaLegacy17Data.PARTICLES.length ? AthenaLegacy17Data.PARTICLES[particle] : "crit";
+
+        if (particle == AthenaLegacy17Data.PARTICLE_ICON_CRACK) {
+            int item = in.readVarIntFromBuffer();
+            int damage = in.readVarIntFromBuffer();
+            int to = AthenaLegacy17Data.item(item, damage);
+
+            if (to != -1) {
+                item = to >>> 16;
+                damage = to & 0xFFFF;
+            }
+            name = name + "_" + item + "_" + damage;
+        } else if (particle == AthenaLegacy17Data.PARTICLE_BLOCK_CRACK || particle == AthenaLegacy17Data.PARTICLE_BLOCK_DUST) {
+            int arg = in.readVarIntFromBuffer();
+            int state = AthenaLegacy17Data.block((arg & 4095) << 4 | arg >> 12 & 15);
+
+            // blockdust is 1.8's; 1.7 only knows the cracks
+            name = "blockcrack_" + (state >> 4) + "_" + (state & 15);
+        }
+        PacketDataSerializer p = packet(ctx, id, out);
+
+        p.writeString(name);
+        for (float f : floats) {
+            p.writeFloat(f);
+        }
+        p.writeInt(count);
+    }
+
+    private void map(ChannelHandlerContext ctx, int id, PacketDataSerializer in, List<ByteBuf> out) {
+        // 1.8 sends a map's icons and a rectangle of its colours in one packet; 1.7 took one
+        // column of colours per packet, the icons in another and the scale in a third
+        int map = in.readVarIntFromBuffer();
+        int scale = in.readByte();
+        int icons = in.readVarIntFromBuffer();
+        byte[] iconData = new byte[icons * 3 + 1];
+
+        iconData[0] = 1;
+        for (int i = 0; i < icons; ++i) {
+            int directionAndType = in.readByte();
+
+            iconData[i * 3 + 1] = (byte) directionAndType;
+            iconData[i * 3 + 2] = in.readByte();
+            iconData[i * 3 + 3] = in.readByte();
+        }
+        int columns = in.readUnsignedByte();
+
+        if (columns > 0) {
+            int rows = in.readUnsignedByte();
+            int x = in.readUnsignedByte();
+            int z = in.readUnsignedByte();
+            byte[] colours = in.readByteArray();
+
+            for (int column = 0; column < columns; ++column) {
+                PacketDataSerializer p = packet(ctx, id, out);
+
+                p.writeVarIntToBuffer(map);
+                p.writeShort(rows + 3);
+                p.writeByte(0);
+                p.writeByte(x + column);
+                p.writeByte(z);
+                for (int row = 0; row < rows; ++row) {
+                    p.writeByte(colours[column + row * columns]);
+                }
+            }
+        }
+        if (icons > 0) {
+            PacketDataSerializer p = packet(ctx, id, out);
+
+            p.writeVarIntToBuffer(map);
+            p.writeShort(iconData.length);
+            p.writeBytes(iconData);
+        }
+        PacketDataSerializer p = packet(ctx, id, out);
+
+        p.writeVarIntToBuffer(map);
+        p.writeShort(2);
+        p.writeByte(2);
+        p.writeByte(scale);
+    }
+
+    // --- formats --------------------------------------------------------------------------------
+
+    private static void writeIntPosition(PacketDataSerializer p, BlockPosition pos) {
+        p.writeInt(pos.getX());
+        p.writeInt(pos.getY());
+        p.writeInt(pos.getZ());
+    }
+
+    private static int clampShort(int value) {
+        return Math.max(Short.MIN_VALUE, Math.min(Short.MAX_VALUE, value));
+    }
+}
