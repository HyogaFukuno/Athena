+    @Test
+    public void digAndUseInTheAirAreRead() {
+        PacketDataSerializer dig = packet(0x07);
+
+        dig.writeByte(5);                 // release use item
+        dig.writeInt(0);
+        dig.writeByte(0);
+        dig.writeInt(0);
+        dig.writeByte(255);               // no face
+        PacketDataSerializer received = received(this.in(), dig).get(0);
+
+        assertEquals(0x07, received.readVarIntFromBuffer());
+        assertEquals(5, received.readVarIntFromBuffer());
+        assertEquals(new BlockPosition(0, 0, 0), received.readBlockPos());
+        assertEquals("a face 1.8 knows", 0, received.readUnsignedByte());
+
+        PacketDataSerializer use = packet(0x08);
+
+        use.writeInt(-1);
+        use.writeByte(255);
+        use.writeInt(-1);
+        use.writeByte(-1);
+        use.writeShort(-1);               // empty hand
+        use.writeByte(0);
+        use.writeByte(0);
+        use.writeByte(0);
+        received = received(this.in(), use).get(0);
+        assertEquals(0x08, received.readVarIntFromBuffer());
+        assertEquals(new BlockPosition(-1, -1, -1), received.readBlockPos());
+        assertEquals(255, received.readUnsignedByte());
+        assertEquals(-1, received.readShort());
+        received.skipBytes(3);
+        assertFalse(received.isReadable());
+    }
+
+    private static byte[] inflate(byte[] compressed, int length) throws Exception {
+        Inflater inflater = new Inflater();
+        byte[] out = new byte[length + 1];
+
+        inflater.setInput(compressed);
+        int n = inflater.inflate(out);
+
+        inflater.end();
+        assertEquals(length, n);
+        byte[] exact = new byte[n];
+
+        System.arraycopy(out, 0, exact, 0, n);
+        return exact;
+    }
