+    @Test
+    public void aDuplicateTeamIsRemovedFirst() {
+        EmbeddedChannel channel = this.out();
+        PacketDataSerializer first = team("red");
+        PacketDataSerializer second = team("red");
+
+        assertEquals(1, sent(channel, first).size());
+        List<PacketDataSerializer> sent = sent(channel, second);
+
+        assertEquals(2, sent.size());
+        PacketDataSerializer remove = sent.get(0);
+
+        assertEquals(0x3E, remove.readVarIntFromBuffer());
+        assertEquals("red", remove.readStringFromBuffer(16));
+        assertEquals(1, remove.readByte());
+        PacketDataSerializer create = sent.get(1);
+
+        create.readVarIntFromBuffer();
+        assertEquals("red", create.readStringFromBuffer(16));
+        assertEquals(0, create.readByte());
+        assertEquals("Red", create.readStringFromBuffer(32));
+        assertEquals("[R]", create.readStringFromBuffer(16));
+        assertEquals("", create.readStringFromBuffer(16));
+        assertEquals(1, create.readByte());
+        assertEquals("members counted in a short", 1, create.readShort());
+        assertEquals("Steve", create.readStringFromBuffer(40));
+        assertFalse(create.isReadable());
+    }
+
+    private static PacketDataSerializer team(String name) {
+        PacketDataSerializer p = packet(0x3E);
+
+        p.writeString(name);
+        p.writeByte(0);
+        p.writeString("Red");
+        p.writeString("[R]");
+        p.writeString("");
+        p.writeByte(1);
+        p.writeString("always");
+        p.writeByte(12);
+        p.writeVarIntToBuffer(1);
+        p.writeString("Steve");
+        return p;
+    }
