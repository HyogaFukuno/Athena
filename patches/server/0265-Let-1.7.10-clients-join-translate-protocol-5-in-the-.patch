+package net.minecraft.server;
+
+import static org.junit.Assert.assertArrayEquals;
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+
+import io.netty.buffer.ByteBuf;
+import io.netty.buffer.Unpooled;
+import io.netty.channel.embedded.EmbeddedChannel;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.UUID;
+import java.util.zip.Inflater;
+import org.bukkit.support.AbstractTestingBase;
+import org.junit.Test;
+
+/**
+ * Athena - 1.7.10 client support: the translating handlers turn 1.8 packets into exactly the bytes
+ * a 1.7 client reads, and back.
+ */
+public class AthenaLegacy17Test extends AbstractTestingBase {
+
+    private final AthenaLegacy17.Session session = new AthenaLegacy17.Session();
+
+    private EmbeddedChannel out() {
+        EmbeddedChannel channel = new EmbeddedChannel(new AthenaLegacy17Encoder(this.session));
+
+        channel.attr(NetworkManager.attrKeyConnectionState).set(EnumProtocol.PLAY);
+        return channel;
+    }
+
+    private EmbeddedChannel in() {
+        EmbeddedChannel channel = new EmbeddedChannel(new AthenaLegacy17Decoder(this.session));
+
+        channel.attr(NetworkManager.attrKeyConnectionState).set(EnumProtocol.PLAY);
+        return channel;
+    }
+
+    private static PacketDataSerializer packet(int id) {
+        PacketDataSerializer p = new PacketDataSerializer(Unpooled.buffer());
+
+        p.writeVarIntToBuffer(id);
+        return p;
+    }
+
+    /** Every packet the channel wrote, id read off. */
+    private static List<PacketDataSerializer> sent(EmbeddedChannel channel, PacketDataSerializer... packets) {
+        for (PacketDataSerializer p : packets) {
+            channel.writeOutbound(p);
+        }
+        List<PacketDataSerializer> result = new ArrayList<PacketDataSerializer>();
+        Object o;
+
+        while ((o = channel.readOutbound()) != null) {
+            result.add(new PacketDataSerializer((ByteBuf) o));
+        }
+        return result;
+    }
+
+    private static List<PacketDataSerializer> received(EmbeddedChannel channel, PacketDataSerializer packet) {
+        channel.writeInbound(packet);
+        List<PacketDataSerializer> result = new ArrayList<PacketDataSerializer>();
+        Object o;
+
+        while ((o = channel.readInbound()) != null) {
+            result.add(new PacketDataSerializer((ByteBuf) o));
+        }
+        return result;
+    }
+
+    @Test
+    public void keepAliveIdIsAnInt() {
+        PacketDataSerializer p = packet(0x00);
+
+        p.writeVarIntToBuffer(300);
+        PacketDataSerializer sent = sent(this.out(), p).get(0);
+
+        assertEquals(0x00, sent.readVarIntFromBuffer());
+        assertEquals(300, sent.readInt());
+        assertFalse(sent.isReadable());
+    }
+
+    @Test
+    public void chunkIdsAndMetasSplitAnd18OnlyBlocksAreReplaced() throws Exception {
+        // one section at y 0: granite, lime wool, a slime block, then air; light and biomes as given
+        byte[] data = new byte[8192 + 2048 + 2048 + 256];
+        int[] states = {1 << 4 | 1, 35 << 4 | 5, 165 << 4};
+
+        for (int i = 0; i < states.length; ++i) {
+            data[i * 2] = (byte) states[i];
+            data[i * 2 + 1] = (byte) (states[i] >> 8);
+        }
+        data[8192] = 0x5A;              // block light
+        data[8192 + 2048] = 0x3C;       // sky light
+        data[data.length - 1] = 7;      // a biome
+        PacketDataSerializer p = packet(0x21);
+
+        p.writeInt(3);
+        p.writeInt(-4);
+        p.writeBoolean(true);
+        p.writeShort(1);
+        p.writeVarIntToBuffer(data.length);
+        p.writeBytes(data);
+        PacketDataSerializer sent = sent(this.out(), p).get(0);
+
+        assertEquals(0x21, sent.readVarIntFromBuffer());
+        assertEquals(3, sent.readInt());
+        assertEquals(-4, sent.readInt());
+        assertTrue(sent.readBoolean());
+        assertEquals(1, sent.readUnsignedShort());
+        assertEquals("no add mask", 0, sent.readUnsignedShort());
+        byte[] compressed = new byte[sent.readInt()];
+
+        sent.readBytes(compressed);
+        assertFalse(sent.isReadable());
+        byte[] data17 = inflate(compressed, 4096 + 2048 + 2048 + 2048 + 256);
+
+        assertEquals("granite is stone", 1, data17[0]);
+        assertEquals(35, data17[1]);
+        assertEquals("slime is stained glass", 95, data17[2]);
+        assertEquals(0, data17[3]);
+        assertEquals("granite's meta 1 becomes 0, wool's 5 stays", 0x50, data17[4096] & 0xFF);
+        assertEquals("stained glass is lime", 5, data17[4096 + 1] & 0x0F);
+        assertEquals(0x5A, data17[4096 + 2048]);
+        assertEquals(0x3C, data17[4096 + 2048 + 2048]);
+        assertEquals(7, data17[data17.length - 1]);
+    }
+
+    @Test
+    public void theCachedChunkIsTheSameAsATranslatedOne() {
+        byte[] data = new byte[8192 + 4096 + 256];
+
+        for (int i = 0; i < 4096; ++i) {
+            int state = (i % 200) << 4 | i % 16;
+
+            data[i * 2] = (byte) state;
+            data[i * 2 + 1] = (byte) (state >> 8);
+        }
+        PacketPlayOutMapChunk.ChunkMap map = new PacketPlayOutMapChunk.ChunkMap();
+
+        map.data = data;
+        map.dataSize = 1;
+        byte[] beforeFrame = new AthenaChunkPacketCache(5, 6, map).legacy17(0x21);
+        AthenaChunkPacketCache compressed = new AthenaChunkPacketCache(5, 6, map);
+
+        assertTrue(compressed.frame(0x21, 256) != null);
+        assertNull("the uncompressed data is gone", compressed.map());
+        assertArrayEquals("built from the 1.8 frame, the same bytes", beforeFrame, compressed.legacy17(0x21));
+
+        PacketDataSerializer p = packet(0x21);
+
+        p.writeInt(5);
+        p.writeInt(6);
+        p.writeBoolean(true);
+        p.writeShort(1);
+        p.writeVarIntToBuffer(data.length);
+        p.writeBytes(data);
+        PacketDataSerializer sent = sent(this.out(), p).get(0);
+        byte[] translated = new byte[sent.readableBytes()];
+
+        sent.readBytes(translated);
+        assertArrayEquals(beforeFrame, translated);
+    }
+
+    @Test
+    public void destroyingManyEntitiesSplitsIntoBytesWorth() {
+        PacketDataSerializer p = packet(0x13);
+
+        p.writeVarIntToBuffer(300);
+        for (int i = 0; i < 300; ++i) {
+            p.writeVarIntToBuffer(i);
+        }
+        List<PacketDataSerializer> sent = sent(this.out(), p);
+
+        assertEquals(3, sent.size());
+        int next = 0;
+
+        for (PacketDataSerializer packet : sent) {
+            assertEquals(0x13, packet.readVarIntFromBuffer());
+            int count = packet.readUnsignedByte();
+
+            assertTrue(count <= 127);
+            for (int i = 0; i < count; ++i) {
+                assertEquals(next++, packet.readInt());
+            }
+            assertFalse(packet.isReadable());
+        }
+        assertEquals(300, next);
+    }
