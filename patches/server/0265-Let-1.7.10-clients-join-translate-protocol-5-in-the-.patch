diff --git a/src/main/java/net/minecraft/server/AthenaChunkPacketCache.java b/src/main/java/net/minecraft/server/AthenaChunkPacketCache.java
index accc24ab3614d8a9ccf86cf6251981feba255845..ee0c0072c0ecd6f39dbda055650b2f17dbc80707 100644
--- a/src/main/java/net/minecraft/server/AthenaChunkPacketCache.java
+++ b/src/main/java/net/minecraft/server/AthenaChunkPacketCache.java
@@ -160,6 +160,71 @@ final class AthenaChunkPacketCache {
         }
     }
 
+    // Athena start - 1.7.10 clients (AthenaLegacy17)
+    private volatile byte[] legacy17;
+
+    /**
+     * The whole 1.7 packet - id and body - for this chunk, built the first time a 1.7 client needs
+     * it. Its chunk data is deflated inside the packet, so it too is built once and sent as it is.
+     * It is made from the uncompressed data while that is held, and from the 1.8 frame after.
+     */
+    byte[] legacy17(int packetId) {
+        byte[] result = this.legacy17;
+
+        if (result != null) {
+            return result;
+        }
+        synchronized (this) {
+            if (this.legacy17 == null) {
+                PacketPlayOutMapChunk.ChunkMap data = this.map;
+                byte[] data18;
+                int mask;
+
+                if (data != null) {
+                    data18 = data.data;
+                    mask = data.dataSize & 0xFFFF;
+                } else {
+                    // frame is set before map is cleared: map gone means frame is there
+                    PacketDataSerializer body = new PacketDataSerializer(Unpooled.wrappedBuffer(inflateFrame(this.frame)));
+
+                    body.readVarIntFromBuffer();    // packet id
+                    body.skipBytes(4 + 4 + 1);      // x, z, full chunk
+                    mask = body.readUnsignedShort();
+                    data18 = new byte[body.readVarIntFromBuffer()];
+                    body.readBytes(data18);
+                }
+                this.legacy17 = AthenaLegacy17Encoder.fullChunk(packetId, this.chunkX, this.chunkZ, mask, data18);
+            }
+            return this.legacy17;
+        }
+    }
+
+    private static byte[] inflateFrame(byte[] frame) {
+        PacketDataSerializer in = new PacketDataSerializer(Unpooled.wrappedBuffer(frame));
+        byte[] raw = new byte[in.readVarIntFromBuffer()];
+        java.util.zip.Inflater inflater = new java.util.zip.Inflater();
+
+        try {
+            inflater.setInput(frame, in.readerIndex(), frame.length - in.readerIndex());
+            int at = 0;
+
+            while (at < raw.length) {
+                int n = inflater.inflate(raw, at, raw.length - at);
+
+                if (n == 0 && (inflater.finished() || inflater.needsInput())) {
+                    throw new IllegalStateException("A cached chunk frame is shorter than it says");
+                }
+                at += n;
+            }
+        } catch (java.util.zip.DataFormatException e) {
+            throw new IllegalStateException(e);
+        } finally {
+            inflater.end();
+        }
+        return raw;
+    }
+    // Athena end
+
     static long checksum(byte[] data) {
         CRC32 crc = new CRC32();
 
diff --git a/src/main/java/net/minecraft/server/AthenaLegacy17.java b/src/main/java/net/minecraft/server/AthenaLegacy17.java
new file mode 100644
index 0000000000000000000000000000000000000000..25f94cbe860fff77acd878941742f16cfd7367a2
--- /dev/null
+++ b/src/main/java/net/minecraft/server/AthenaLegacy17.java
@@ -0,0 +1,248 @@
+package net.minecraft.server;
+
+import io.netty.buffer.ByteBufInputStream;
+import io.netty.channel.Channel;
+import io.netty.channel.ChannelPipeline;
+import io.netty.util.AttributeKey;
+import it.unimi.dsi.fastutil.ints.Int2IntOpenHashMap;
+import it.unimi.dsi.fastutil.ints.Int2ObjectOpenHashMap;
+import it.unimi.dsi.fastutil.ints.IntOpenHashSet;
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.DataInput;
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.UUID;
+import org.bukkit.craftbukkit.util.CraftChatMessage;
+
+// Athena - 1.7.10 clients (protocol 5) on this 1.8.8 server.
+//
+// A client that says protocol 5 in its handshake gets two more handlers in its pipeline, and
+// nothing else about the connection changes: the server builds and reads 1.8 packets as it always
+// does. AthenaLegacy17Encoder sits between the packet encoder and the length prepender and turns
+// each 1.8 packet into what a 1.7 client expects - or into several, or none - and
+// AthenaLegacy17Decoder sits between the frame splitter and the packet decoder and turns 1.7
+// packets into 1.8 ones. Compression is never enabled for such a connection: 1.7 has none.
+//
+// The ViaVersion/ViaBackwards/ViaRewind plugins do the same from outside the server, at ~65 MB a
+// server (they load every protocol's mapping tables whatever clients connect). This needs a few
+// kilobytes of tables (AthenaLegacy17Data) and, per 1.7 connection, the little state below.
+//
+// A 1.8 client's connection never meets any of this.
+public final class AthenaLegacy17 {
+
+    public static final int PROTOCOL = 5;
+
+    static final AttributeKey<Session> SESSION = AttributeKey.valueOf("athena_legacy17");
+
+    private AthenaLegacy17() {}
+
+    /** Adds the translation handlers to a connection whose handshake said protocol 5. */
+    static void install(NetworkManager networkManager) {
+        Channel channel = networkManager.channel;
+        Session session = new Session();
+        ChannelPipeline pipeline = channel.pipeline();
+
+        channel.attr(SESSION).set(session);
+        pipeline.addAfter("splitter", "athena_legacy17_in", new AthenaLegacy17Decoder(session));
+        pipeline.addAfter("prepender", "athena_legacy17_out", new AthenaLegacy17Encoder(session));
+    }
+
+    /** Whether this connection is a 1.7 client's. */
+    public static boolean isLegacy(NetworkManager networkManager) {
+        return networkManager.channel != null && networkManager.channel.attr(SESSION).get() != null;
+    }
+
+    /**
+     * What one 1.7 connection has to remember to translate the next packet: things 1.8 packets
+     * leave to the client that a 1.7 packet has to spell out. Only the connection's event loop
+     * touches it - both handlers run there.
+     */
+    static final class Session {
+
+        int ownEntityId = Integer.MIN_VALUE;
+        /** Every entity the client has been shown, by kind, for its metadata. */
+        final Int2ObjectOpenHashMap<AthenaLegacy17Data.Kind> kinds = new Int2ObjectOpenHashMap<AthenaLegacy17Data.Kind>();
+        /** Entities a 1.7 client cannot be shown (armor stands): every packet about them is dropped. */
+        final IntOpenHashSet hidden = new IntOpenHashSet();
+        /** The tab list, which 1.7 keys by name and 1.8 by UUID. */
+        final Map<UUID, Profile> profiles = new HashMap<UUID, Profile>();
+        /** Objectives and teams the client knows: a 1.7 client disconnects on a duplicate. */
+        final Set<String> objectives = new HashSet<String>();
+        final Set<String> teams = new HashSet<String>();
+        /** Open windows' 1.7 types, for the enchanting table's missing lapis slot and the furnace bars. */
+        final Int2IntOpenHashMap windowTypes = new Int2IntOpenHashMap();
+        final Int2ObjectOpenHashMap<int[]> furnaces = new Int2ObjectOpenHashMap<int[]>();
+        /** The player's own position as they last reported it, for relative teleports. */
+        double x;
+        double y;
+        double z;
+        float yaw;
+        float pitch;
+        boolean onGround;
+
+        AthenaLegacy17Data.Kind kind(int entityId) {
+            AthenaLegacy17Data.Kind kind = this.kinds.get(entityId);
+
+            return kind == null ? AthenaLegacy17Data.Kind.ENTITY : kind;
+        }
+    }
+
+    static final class Profile {
+        final String name;
+        final List<String[]> properties = new ArrayList<String[]>();
+        String displayName;
+        int ping;
+        int gamemode;
+
+        Profile(String name) {
+            this.name = name;
+        }
+
+        /** The name the 1.7 tab list knows this entry by: at most 16 characters. */
+        String listName() {
+            String name = this.displayName == null ? this.name : this.displayName;
+
+            if (name.length() > 16) {
+                name = org.bukkit.ChatColor.stripColor(name);
+            }
+            return name.length() > 16 ? name.substring(0, 16) : name;
+        }
+    }
+
+    // --- items ----------------------------------------------------------------------------------
+
+    /** The tag an item replaced for a 1.7 client keeps its real id and damage under. */
+    private static final String ORIGINAL = "AthenaLegacy17";
+
+    /** Copies a 1.8 item from in to out as a 1.7 item: gzipped NBT, and 1.8-only items replaced. */
+    static void item(PacketDataSerializer in, PacketDataSerializer out) throws IOException {
+        short id = in.readShort();
+
+        if (id < 0) {
+            out.writeShort(-1);
+            return;
+        }
+        byte count = in.readByte();
+        short damage = in.readShort();
+        NBTTagCompound tag = readNbt(in);
+        int to = AthenaLegacy17Data.item(id, damage);
+
+        if (to != -1) {
+            NBTTagCompound original = new NBTTagCompound();
+
+            original.setShort("id", id);
+            original.setShort("Damage", damage);
+            if (tag == null) {
+                tag = new NBTTagCompound();
+            }
+            tag.set(ORIGINAL, original);
+            id = (short) (to >>> 16);
+            damage = (short) to;
+        }
+        out.writeShort(id);
+        out.writeByte(count);
+        out.writeShort(damage);
+        writeCompressedNbt(out, tag);
+    }
+
+    /** Copies a 1.7 item from in to out as a 1.8 item, putting back what item() replaced. */
+    static void itemToServer(PacketDataSerializer in, PacketDataSerializer out) throws IOException {
+        short id = in.readShort();
+
+        if (id < 0) {
+            out.writeShort(-1);
+            return;
+        }
+        byte count = in.readByte();
+        short damage = in.readShort();
+        NBTTagCompound tag = readCompressedNbt(in);
+
+        if (tag != null && tag.hasKeyOfType(ORIGINAL, 10)) {
+            NBTTagCompound original = tag.getCompound(ORIGINAL);
+
+            id = original.getShort("id");
+            damage = original.getShort("Damage");
+            tag.remove(ORIGINAL);
+            if (tag.isEmpty()) {
+                tag = null;
+            }
+        }
+        out.writeShort(id);
+        out.writeByte(count);
+        out.writeShort(damage);
+        out.writeNBTTagCompoundToBuffer(tag);
+    }
+
+    /** A 1.8 NBT compound as the server wrote it: TAG_End alone for none. */
+    static NBTTagCompound readNbt(PacketDataSerializer in) throws IOException {
+        int start = in.readerIndex();
+
+        if (in.readByte() == 0) {
+            return null;
+        }
+        in.readerIndex(start);
+        // the server wrote it, so no read limit beyond a sanity bound
+        return NBTCompressedStreamTools.read((DataInput) new ByteBufInputStream(in), new NBTReadLimiter(2097152L));
+    }
+
+    /** 1.7's NBT: a short length, then the gzipped compound; -1 for none. */
+    static void writeCompressedNbt(PacketDataSerializer out, NBTTagCompound tag) throws IOException {
+        if (tag == null) {
+            out.writeShort(-1);
+            return;
+        }
+        ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+
+        NBTCompressedStreamTools.writeCompressed(tag, bytes);
+        out.writeShort(bytes.size());
+        out.writeBytes(bytes.toByteArray());
+    }
+
+    static NBTTagCompound readCompressedNbt(PacketDataSerializer in) throws IOException {
+        short length = in.readShort();
+
+        if (length < 0) {
+            return null;
+        }
+        byte[] bytes = new byte[length];
+
+        in.readBytes(bytes);
+        return NBTCompressedStreamTools.readCompressed(new ByteArrayInputStream(bytes));
+    }
+
+    // --- chat -----------------------------------------------------------------------------------
+
+    /** A 1.8 JSON component as 1.7 legacy text, for the places 1.7 takes plain strings. */
+    static String legacyText(String json, EnumChatFormat defaultColor) {
+        IChatBaseComponent component;
+
+        try {
+            component = IChatBaseComponent.ChatSerializer.jsonToComponent(json);
+        } catch (RuntimeException e) {
+            return json;
+        }
+        return legacyText(component, defaultColor);
+    }
+
+    static String legacyText(IChatBaseComponent component, EnumChatFormat defaultColor) {
+        // fromComponent spells the default colour out wherever a part has none; a 1.7 string
+        // shows its own default there anyway, and the codes only eat into the length limits
+        String text = CraftChatMessage.fromComponent(component, defaultColor);
+        String code = defaultColor.toString();
+
+        while (text.startsWith(code)) {
+            text = text.substring(code.length());
+        }
+        return text.replace(code, EnumChatFormat.RESET.toString());
+    }
+
+    static String truncate(String s, int length) {
+        return s.length() > length ? s.substring(0, length) : s;
+    }
+}
diff --git a/src/main/java/net/minecraft/server/AthenaLegacy17Data.java b/src/main/java/net/minecraft/server/AthenaLegacy17Data.java
new file mode 100644
index 0000000000000000000000000000000000000000..098bf1d09f33d2cc96d038677a80c26215caf1be
--- /dev/null
+++ b/src/main/java/net/minecraft/server/AthenaLegacy17Data.java
@@ -0,0 +1,370 @@
+package net.minecraft.server;
+
+import java.util.HashMap;
+import java.util.Map;
+
+// Athena - the fixed tables behind 1.7.10 client support (see AthenaLegacy17): which 1.8 blocks,
+// items and entities a 1.7 client has no idea of and what it is shown instead, and where each
+// piece of 1.8 entity metadata lives in 1.7.
+//
+// The replacements and the metadata layout follow ViaRewind's 1.8 -> 1.7.6-1.7.10 protocol
+// (github.com/ViaVersion/ViaRewind, GPL-3.0, as this server is), so a 1.7 player sees here what
+// they would see on a server running that plugin.
+final class AthenaLegacy17Data {
+
+    private AthenaLegacy17Data() {}
+
+    // --- blocks ---------------------------------------------------------------------------------
+
+    /** 1.8 block state (id << 4 | meta) -> the 1.7 one; ids above 255 do not exist in either. */
+    private static final char[] BLOCKS = new char[256 << 4];
+    /** The same for items: key id << 16 | damage, or id << 16 | 0xFFFF for "any damage". */
+    private static final Map<Integer, Integer> ITEMS = new HashMap<Integer, Integer>();
+
+    static {
+        for (int i = 0; i < BLOCKS.length; ++i) {
+            BLOCKS[i] = (char) i;
+        }
+        // both placed blocks and their items; a replacement meta of -1 keeps the meta
+        blockAndItem(157, -1, 28, -1);      // activator rail
+        blockAndItem(165, -1, 95, 5);       // slime block -> lime stained glass
+        blockAndItem(166, -1, 20, 0);       // barrier -> glass
+        blockAndItem(167, -1, 96, -1);      // iron trapdoor -> trapdoor
+        blockAndItem(169, -1, 89, 0);       // sea lantern -> glowstone
+        blockAndItem(180, -1, 128, -1);     // red sandstone stairs
+        blockAndItem(181, -1, 43, 1);       // double red sandstone slab
+        for (int id = 183; id <= 187; ++id) {
+            blockAndItem(id, -1, 107, -1);  // fence gates
+        }
+        for (int id = 188; id <= 192; ++id) {
+            blockAndItem(id, -1, 85, -1);   // fences
+        }
+        for (int meta = 1; meta <= 6; ++meta) {
+            blockAndItem(1, meta, 1, 0);    // granite, diorite, andesite and their polished forms
+        }
+        blockAndItem(168, 0, 1, 0);         // prismarine
+        blockAndItem(168, 1, 98, 0);        // prismarine bricks
+        blockAndItem(168, 2, 98, 1);        // dark prismarine
+        blockAndItem(179, -1, 24, -1);      // red sandstone
+        blockAndItem(19, 1, 19, 0);         // wet sponge
+        // placed blocks only
+        block(176, -1, 63, -1);             // standing banner -> sign post
+        block(177, -1, 68, -1);             // wall banner -> wall sign
+        for (int id = 193; id <= 197; ++id) {
+            block(id, -1, 64, -1);          // doors
+        }
+        block(178, -1, 151, -1);            // inverted daylight sensor
+        block(182, 0, 44, 1);               // red sandstone slab
+        block(182, 8, 44, 9);
+        for (int button : new int[] {77, 143}) {
+            // buttons facing up or down are 1.8's; 1.7 only has levers there
+            block(button, 0, 69, 0);
+            block(button, 8, 69, 8);
+            block(button, 5, 69, 6);
+            block(button, 13, 69, 14);
+        }
+        // items only
+        item(182, -1, 44, 1);               // red sandstone slab
+        item(409, -1, 406, 0);              // prismarine shard -> quartz
+        item(410, -1, 406, 0);              // prismarine crystals
+        item(411, -1, 365, 0);              // raw rabbit -> raw chicken
+        item(412, -1, 366, 0);              // cooked rabbit
+        item(413, -1, 282, 0);              // rabbit stew -> mushroom stew
+        item(414, -1, 375, 0);              // rabbit's foot -> spider eye
+        item(415, -1, 334, 0);              // rabbit hide -> leather
+        item(416, -1, 280, 0);              // armor stand -> stick
+        item(423, -1, 363, 0);              // raw mutton -> raw beef
+        item(424, -1, 364, 0);              // cooked mutton
+        item(425, -1, 323, 0);              // banner -> sign
+        for (int id = 427; id <= 431; ++id) {
+            item(id, -1, 324, 0);           // doors
+        }
+        for (int potion : new int[] {8203, 8235, 8267, 16395, 16427, 16459}) {
+            item(373, potion, 373, 0);      // potions of leaping
+        }
+        for (int egg : new int[] {30, 67, 68, 101}) {
+            item(383, egg, 383, 0);         // spawn eggs of 1.8 mobs
+        }
+    }
+
+    private static void blockAndItem(int id, int meta, int toId, int toMeta) {
+        block(id, meta, toId, toMeta);
+        item(id, meta, toId, toMeta);
+    }
+
+    private static void block(int id, int meta, int toId, int toMeta) {
+        for (int m = 0; m < 16; ++m) {
+            if (meta == -1 || meta == m) {
+                BLOCKS[id << 4 | m] = (char) (toId << 4 | (toMeta == -1 ? m : toMeta));
+            }
+        }
+    }
+
+    private static void item(int id, int damage, int toId, int toDamage) {
+        ITEMS.put(id << 16 | (damage & 0xFFFF), toId << 16 | (toDamage & 0xFFFF));
+    }
+
+    /** The 1.7 block state for a 1.8 one. */
+    static int block(int state) {
+        return state >= 0 && state < BLOCKS.length ? BLOCKS[state] : 0;
+    }
+
+    /**
+     * The 1.7 id << 16 | damage for a 1.8 item, or -1 if the item is shown as it is. A replacement
+     * damage of 0xFFFF keeps the damage.
+     */
+    static int item(int id, int damage) {
+        Integer to = ITEMS.get(id << 16 | (damage & 0xFFFF));
+
+        if (to == null) {
+            to = ITEMS.get(id << 16 | 0xFFFF);
+            if (to != null && (to & 0xFFFF) == 0xFFFF) {
+                to = to & 0xFFFF0000 | damage & 0xFFFF;
+            }
+        }
+        return to == null ? -1 : to;
+    }
+
+    // --- entities -------------------------------------------------------------------------------
+
+    /** 1.8's entity hierarchy, as far as metadata cares: each kind's parent owns the lower indices. */
+    enum Kind {
+        ENTITY(null),
+        HANGING(ENTITY), ITEM_FRAME(HANGING), PAINTING(HANGING), LEASH_KNOT(HANGING),
+        ITEM(ENTITY), EXPERIENCE_ORB(ENTITY), FALLING_BLOCK(ENTITY), TNT(ENTITY), END_CRYSTAL(ENTITY),
+        ARROW(ENTITY), FIREWORK(ENTITY), FISHING_HOOK(ENTITY), PROJECTILE(ENTITY), FIREBALL(ENTITY), BOAT(ENTITY),
+        MINECART(ENTITY), FURNACE_MINECART(MINECART),
+        LIVING_BASE(ENTITY), ARMOR_STAND(LIVING_BASE), PLAYER(LIVING_BASE),
+        LIVING(LIVING_BASE), ENDER_DRAGON(LIVING), SLIME(LIVING), GHAST(LIVING), BAT(LIVING), SQUID(LIVING),
+        CREATURE(LIVING), GOLEM(CREATURE), IRON_GOLEM(GOLEM),
+        AGEABLE(CREATURE), VILLAGER(AGEABLE), ANIMAL(AGEABLE), PIG(ANIMAL), SHEEP(ANIMAL), HORSE(ANIMAL),
+        TAMEABLE(ANIMAL), OCELOT(TAMEABLE), WOLF(TAMEABLE),
+        MONSTER(CREATURE), BLAZE(MONSTER), CREEPER(MONSTER), ENDERMAN(MONSTER), WITCH(MONSTER), WITHER(MONSTER),
+        SKELETON(MONSTER), ZOMBIE(MONSTER), SPIDER(MONSTER), GUARDIAN(MONSTER);
+
+        final Kind parent;
+
+        Kind(Kind parent) {
+            this.parent = parent;
+        }
+    }
+
+    /** The kind of a mob by its 1.8 spawn-mob type id. */
+    static Kind mob(int type) {
+        switch (type) {
+            case 30: return Kind.ARMOR_STAND;
+            case 53: case 60: case 67: return Kind.MONSTER;             // giant, silverfish, endermite
+            case 50: return Kind.CREEPER;
+            case 51: return Kind.SKELETON;
+            case 52: case 59: return Kind.SPIDER;
+            case 54: case 57: return Kind.ZOMBIE;
+            case 55: case 62: return Kind.SLIME;
+            case 56: return Kind.GHAST;
+            case 58: return Kind.ENDERMAN;
+            case 61: return Kind.BLAZE;
+            case 63: return Kind.ENDER_DRAGON;
+            case 64: return Kind.WITHER;
+            case 65: return Kind.BAT;
+            case 66: return Kind.WITCH;
+            case 68: return Kind.GUARDIAN;
+            case 90: return Kind.PIG;
+            case 91: return Kind.SHEEP;
+            case 92: case 93: case 96: case 101: return Kind.ANIMAL;    // cow, chicken, mooshroom, rabbit
+            case 94: return Kind.SQUID;
+            case 95: return Kind.WOLF;
+            case 97: return Kind.GOLEM;
+            case 98: return Kind.OCELOT;
+            case 99: return Kind.IRON_GOLEM;
+            case 100: return Kind.HORSE;
+            case 120: return Kind.VILLAGER;
+            default: return Kind.LIVING;
+        }
+    }
+
+    /** The 1.7 spawn-mob type a 1.7 client is shown for a 1.8 one, or -1 for none (armor stands). */
+    static int mobType17(int type) {
+        switch (type) {
+            case 30: return -1;         // armor stand
+            case 67: return 60;         // endermite -> silverfish
+            case 68: return 94;         // guardian -> squid
+            case 101: return 93;        // rabbit -> chicken
+            default: return type;
+        }
+    }
+
+    /** The kind of an object by its 1.8 spawn-object type id. */
+    static Kind object(int type) {
+        switch (type) {
+            case 1: return Kind.BOAT;
+            case 2: return Kind.ITEM;
+            case 10: return Kind.MINECART;
+            case 50: return Kind.TNT;
+            case 51: return Kind.END_CRYSTAL;
+            case 60: return Kind.ARROW;
+            case 63: case 64: case 66: return Kind.FIREBALL;
+            case 70: return Kind.FALLING_BLOCK;
+            case 71: return Kind.ITEM_FRAME;
+            case 76: return Kind.FIREWORK;
+            case 77: return Kind.LEASH_KNOT;
+            case 78: return Kind.ARMOR_STAND;
+            case 90: return Kind.FISHING_HOOK;
+            default: return Kind.PROJECTILE;
+        }
+    }
+
+    // --- entity metadata ------------------------------------------------------------------------
+
+    static final int BYTE = 0, SHORT = 1, INT = 2, FLOAT = 3, STRING = 4, ITEM_STACK = 5, POSITION = 6, ROTATION = 7;
+
+    /** Where a 1.8 metadata entry goes in 1.7: index and type, and what is done to the value. */
+    static final class Meta {
+        final int index;
+        final int type;        // 1.7 type, or -1: 1.7 has no such entry and it is dropped
+        final int convert;
+
+        Meta(int index, int type, int convert) {
+            this.index = index;
+            this.type = type;
+            this.convert = convert;
+        }
+    }
+
+    static final int SAME = 0, BYTE_TO_INT_AGE = 1, FRAME_ROTATION = 2, SKIN_TO_CAPE = 3;
+
+    private static final Map<Integer, Meta> META = new HashMap<Integer, Meta>();
+
+    static {
+        meta(Kind.ENTITY, 0, 0, BYTE);
+        meta(Kind.ENTITY, 1, 1, SHORT);
+        drop(Kind.ENTITY, 2);                               // name tags of non-living entities
+        drop(Kind.ENTITY, 3);
+        drop(Kind.ENTITY, 4);                               // silent
+        meta(Kind.LIVING_BASE, 6, 6, FLOAT);
+        meta(Kind.LIVING_BASE, 7, 7, INT);
+        meta(Kind.LIVING_BASE, 8, 8, BYTE);
+        meta(Kind.LIVING_BASE, 9, 9, BYTE);
+        meta(Kind.LIVING_BASE, 2, 10, STRING);              // name tag
+        meta(Kind.LIVING_BASE, 3, 11, BYTE);                // name tag always shown
+        drop(Kind.LIVING, 15);                              // no AI
+        META.put(key(Kind.AGEABLE, 12), new Meta(12, INT, BYTE_TO_INT_AGE));
+        for (int i = 10; i <= 16; ++i) {
+            drop(Kind.ARMOR_STAND, i);
+        }
+        META.put(key(Kind.PLAYER, 10), new Meta(16, BYTE, SKIN_TO_CAPE));
+        drop(Kind.PLAYER, 16);
+        meta(Kind.PLAYER, 17, 17, FLOAT);
+        meta(Kind.PLAYER, 18, 18, INT);
+        meta(Kind.HORSE, 16, 16, INT);
+        meta(Kind.HORSE, 19, 19, BYTE);
+        meta(Kind.HORSE, 20, 20, INT);
+        meta(Kind.HORSE, 21, 21, STRING);
+        meta(Kind.HORSE, 22, 22, INT);
+        meta(Kind.BAT, 16, 16, BYTE);
+        meta(Kind.TAMEABLE, 16, 16, BYTE);
+        meta(Kind.TAMEABLE, 17, 17, STRING);
+        meta(Kind.OCELOT, 18, 18, BYTE);
+        meta(Kind.WOLF, 16, 16, BYTE);
+        meta(Kind.WOLF, 18, 18, FLOAT);
+        meta(Kind.WOLF, 19, 19, BYTE);
+        meta(Kind.WOLF, 20, 20, BYTE);
+        meta(Kind.PIG, 16, 16, BYTE);
+        meta(Kind.SHEEP, 16, 16, BYTE);
+        meta(Kind.VILLAGER, 16, 16, INT);
+        drop(Kind.ENDERMAN, 16);
+        drop(Kind.ENDERMAN, 17);
+        meta(Kind.ENDERMAN, 18, 18, BYTE);
+        meta(Kind.ZOMBIE, 12, 12, BYTE);
+        meta(Kind.ZOMBIE, 13, 13, BYTE);
+        meta(Kind.ZOMBIE, 14, 14, BYTE);
+        meta(Kind.BLAZE, 16, 16, BYTE);
+        meta(Kind.SPIDER, 16, 16, BYTE);
+        meta(Kind.CREEPER, 16, 16, BYTE);
+        meta(Kind.CREEPER, 17, 17, BYTE);
+        meta(Kind.CREEPER, 18, 18, BYTE);
+        meta(Kind.GHAST, 16, 16, BYTE);
+        drop(Kind.GHAST, 17);
+        meta(Kind.SLIME, 16, 16, BYTE);
+        meta(Kind.SKELETON, 13, 13, BYTE);
+        meta(Kind.WITCH, 21, 21, BYTE);
+        meta(Kind.IRON_GOLEM, 16, 16, BYTE);
+        for (int i = 17; i <= 19; ++i) {
+            meta(Kind.WITHER, i, i, INT);
+        }
+        meta(Kind.WITHER, 20, 20, INT);
+        drop(Kind.GUARDIAN, 16);
+        drop(Kind.GUARDIAN, 17);
+        meta(Kind.BOAT, 17, 17, INT);
+        meta(Kind.BOAT, 18, 18, INT);
+        meta(Kind.BOAT, 19, 19, FLOAT);
+        meta(Kind.MINECART, 17, 17, INT);
+        meta(Kind.MINECART, 18, 18, INT);
+        meta(Kind.MINECART, 19, 19, FLOAT);
+        meta(Kind.MINECART, 20, 20, INT);
+        meta(Kind.MINECART, 21, 21, INT);
+        meta(Kind.MINECART, 22, 22, BYTE);
+        meta(Kind.FURNACE_MINECART, 16, 16, BYTE);
+        meta(Kind.ITEM, 10, 10, ITEM_STACK);
+        meta(Kind.ARROW, 16, 16, BYTE);
+        meta(Kind.FIREWORK, 8, 8, ITEM_STACK);
+        meta(Kind.ITEM_FRAME, 8, 2, ITEM_STACK);
+        META.put(key(Kind.ITEM_FRAME, 9), new Meta(3, BYTE, FRAME_ROTATION));
+        meta(Kind.END_CRYSTAL, 9, 8, INT);
+    }
+
+    private static int key(Kind kind, int index) {
+        return kind.ordinal() << 8 | index;
+    }
+
+    private static void meta(Kind kind, int index18, int index17, int type17) {
+        META.put(key(kind, index18), new Meta(index17, type17, SAME));
+    }
+
+    private static void drop(Kind kind, int index18) {
+        META.put(key(kind, index18), new Meta(-1, -1, SAME));
+    }
+
+    /** Where a 1.8 entry of an entity of this kind goes in 1.7, or null if 1.7 has no such entry. */
+    static Meta meta(Kind kind, int index18) {
+        for (Kind k = kind; k != null; k = k.parent) {
+            Meta meta = META.get(key(k, index18));
+
+            if (meta != null) {
+                return meta.type == -1 ? null : meta;
+            }
+        }
+        return null;
+    }
+
+    // --- particles and windows ------------------------------------------------------------------
+
+    /** 1.7's particle names, indexed by 1.8's particle ids. */
+    static final String[] PARTICLES = {
+        "explode", "largeexplode", "hugeexplosion", "fireworksSpark", "bubble", "splash", "wake",
+        "suspended", "depthsuspend", "crit", "magicCrit", "smoke", "largesmoke", "spell", "instantSpell",
+        "mobSpell", "mobSpellAmbient", "witchMagic", "dripWater", "dripLava", "angryVillager",
+        "happyVillager", "townaura", "note", "portal", "enchantmenttable", "flame", "lava", "footstep",
+        "cloud", "reddust", "snowballpoof", "snowshovel", "slime", "heart", "barrier", "iconcrack",
+        "blockcrack", "blockdust", "droplet", "take", "mobappearance"
+    };
+
+    static final int PARTICLE_ICON_CRACK = 36, PARTICLE_BLOCK_CRACK = 37, PARTICLE_BLOCK_DUST = 38;
+
+    /** 1.7's window type ids by 1.8's window type names; -1 for anything else. */
+    static int windowType(String name) {
+        switch (name) {
+            case "minecraft:container": case "minecraft:chest": return 0;
+            case "minecraft:crafting_table": return 1;
+            case "minecraft:furnace": return 2;
+            case "minecraft:dispenser": return 3;
+            case "minecraft:enchanting_table": return 4;
+            case "minecraft:brewing_stand": return 5;
+            case "minecraft:villager": return 6;
+            case "minecraft:beacon": return 7;
+            case "minecraft:anvil": return 8;
+            case "minecraft:hopper": return 9;
+            case "minecraft:dropper": return 10;
+            case "EntityHorse": return 11;
+            default: return -1;
+        }
+    }
+}
diff --git a/src/main/java/net/minecraft/server/AthenaLegacy17Decoder.java b/src/main/java/net/minecraft/server/AthenaLegacy17Decoder.java
new file mode 100644
index 0000000000000000000000000000000000000000..4510830aaf7f8ac8b36f0d175730a2bc03f25892
--- /dev/null
+++ b/src/main/java/net/minecraft/server/AthenaLegacy17Decoder.java
@@ -0,0 +1,285 @@
+package net.minecraft.server;
+
+import io.netty.buffer.ByteBuf;
+import io.netty.channel.ChannelHandlerContext;
+import io.netty.handler.codec.MessageToMessageDecoder;
+import java.nio.charset.StandardCharsets;
+import java.util.List;
+
+// Athena - turns what a 1.7.10 client sends into the 1.8 packets the server reads (see
+// AthenaLegacy17). It sits between the frame splitter and the packet decoder: each frame in is
+// one 1.7 packet, each frame out one 1.8 packet, or nothing.
+//
+// Serverbound ids 0x00-0x17 mean the same in both versions. The differences are field formats -
+// 1.7 sends entity ids and block positions as plain ints, gzips item NBT and length-prefixes
+// plugin messages - and a few fields one side has and the other has not.
+final class AthenaLegacy17Decoder extends MessageToMessageDecoder<ByteBuf> {
+
+    private final AthenaLegacy17.Session session;
+
+    AthenaLegacy17Decoder(AthenaLegacy17.Session session) {
+        this.session = session;
+    }
+
+    @Override
+    protected void decode(ChannelHandlerContext ctx, ByteBuf msg, List<Object> out) throws Exception {
+        if (!msg.isReadable()) {
+            return;
+        }
+        EnumProtocol state = ctx.channel().attr(NetworkManager.attrKeyConnectionState).get();
+        PacketDataSerializer in = new PacketDataSerializer(msg);
+        int id = in.readVarIntFromBuffer();
+
+        if (state == EnumProtocol.LOGIN && id == 0x01) {
+            // encryption response: 1.7 prefixes the arrays with shorts
+            PacketDataSerializer p = packet(ctx, id, out);
+
+            for (int i = 0; i < 2; ++i) {
+                byte[] bytes = new byte[in.readShort()];
+
+                in.readBytes(bytes);
+                p.writeByteArray(bytes);
+            }
+        } else if (state == EnumProtocol.PLAY) {
+            this.play(ctx, id, in, msg, out);
+        } else {
+            msg.readerIndex(0);
+            out.add(msg.retain());
+        }
+    }
+
+    private static PacketDataSerializer packet(ChannelHandlerContext ctx, int id, List<Object> out) {
+        ByteBuf buf = ctx.alloc().buffer();
+        PacketDataSerializer packet = new PacketDataSerializer(buf);
+
+        out.add(buf);
+        packet.writeVarIntToBuffer(id);
+        return packet;
+    }
+
+    private void play(ChannelHandlerContext ctx, int id, PacketDataSerializer in, ByteBuf raw, List<Object> out) throws Exception {
+        AthenaLegacy17.Session s = this.session;
+        PacketDataSerializer p;
+
+        switch (id) {
+            case 0x00: // keep alive
+                packet(ctx, id, out).writeVarIntToBuffer(in.readInt());
+                break;
+            case 0x02: { // use entity: 1.7's mouse button is 1.8's action, 0 interact and 1 attack
+                int target = in.readInt();
+                int action = in.readByte();
+
+                p = packet(ctx, id, out);
+                p.writeVarIntToBuffer(target);
+                p.writeVarIntToBuffer(action == 1 ? 1 : 0);
+                break;
+            }
+            case 0x03: // on ground
+                s.onGround = in.readBoolean();
+                raw.readerIndex(0);
+                out.add(raw.retain());
+                break;
+            case 0x04: // position: 1.7 also sends the eye height
+            case 0x06: { // position and look
+                double x = in.readDouble();
+                double y = in.readDouble();
+
+                in.readDouble();
+                double z = in.readDouble();
+
+                p = packet(ctx, id, out);
+                p.writeDouble(x);
+                p.writeDouble(y);
+                p.writeDouble(z);
+                if (id == 0x06) {
+                    s.yaw = in.readFloat();
+                    s.pitch = in.readFloat();
+                    p.writeFloat(s.yaw);
+                    p.writeFloat(s.pitch);
+                }
+                s.onGround = in.readBoolean();
+                p.writeBoolean(s.onGround);
+                // -999 is "riding: no position", not a place
+                if (y != -999.0D) {
+                    s.x = x;
+                    s.y = y;
+                    s.z = z;
+                }
+                break;
+            }
+            case 0x05: // look
+                s.yaw = in.readFloat();
+                s.pitch = in.readFloat();
+                s.onGround = in.readBoolean();
+                raw.readerIndex(0);
+                out.add(raw.retain());
+                break;
+            case 0x07: { // dig: 1.7 says 255 for "no face", 1.8 has only the six faces
+                int status = in.readUnsignedByte();
+                int x = in.readInt();
+                int y = in.readUnsignedByte();
+                int z = in.readInt();
+                int face = in.readUnsignedByte();
+
+                p = packet(ctx, id, out);
+                p.writeVarIntToBuffer(status);
+                p.writeBlockPos(new BlockPosition(x, y, z));
+                p.writeByte(face > 5 ? 0 : face);
+                break;
+            }
+            case 0x08: { // block placement
+                int x = in.readInt();
+                int y = in.readUnsignedByte();
+                int z = in.readInt();
+                int direction = in.readByte();
+
+                // a use in the air is (-1, -1, -1), which 1.7's unsigned y turned into 255
+                if (x == -1 && y == 255 && z == -1 && direction == -1) {
+                    y = -1;
+                }
+                p = packet(ctx, id, out);
+                p.writeBlockPos(new BlockPosition(x, y, z));
+                p.writeByte(direction);
+                AthenaLegacy17.itemToServer(in, p);
+                p.writeBytes(in, 3); // cursor position
+                break;
+            }
+            case 0x0A: { // animation: 1.8's arm swing has no fields, and is all 1.7 sends here in play
+                in.readInt();
+                if (in.readByte() == 1) {
+                    packet(ctx, id, out);
+                }
+                break;
+            }
+            case 0x0B: { // entity action: 1.7 counts the actions from 1
+                int entityId = in.readInt();
+                int action = in.readByte();
+                int jumpBoost = in.readInt();
+
+                p = packet(ctx, id, out);
+                p.writeVarIntToBuffer(entityId);
+                p.writeVarIntToBuffer(action - 1);
+                p.writeVarIntToBuffer(jumpBoost);
+                break;
+            }
+            case 0x0C: { // steer vehicle: two booleans become flags
+                float sideways = in.readFloat();
+                float forward = in.readFloat();
+                boolean jump = in.readBoolean();
+                boolean unmount = in.readBoolean();
+
+                p = packet(ctx, id, out);
+                p.writeFloat(sideways);
+                p.writeFloat(forward);
+                p.writeByte((jump ? 1 : 0) | (unmount ? 2 : 0));
+                break;
+            }
+            case 0x0D: // close window
+                s.windowTypes.remove(in.readByte() & 0xFF);
+                raw.readerIndex(0);
+                out.add(raw.retain());
+                break;
+            case 0x0E: { // click window
+                int window = in.readByte();
+                int slot = in.readShort();
+
+                if (window != 0 && s.windowTypes.get(window & 0xFF) == 4 && slot > 0) {
+                    ++slot;     // 1.8's enchanting table has the lapis slot at 1
+                }
+                p = packet(ctx, id, out);
+                p.writeByte(window);
+                p.writeShort(slot);
+                p.writeBytes(in, 1 + 2 + 1); // button, action number, mode
+                AthenaLegacy17.itemToServer(in, p);
+                break;
+            }
+            case 0x10: // creative inventory action
+                p = packet(ctx, id, out);
+                p.writeShort(in.readShort());
+                AthenaLegacy17.itemToServer(in, p);
+                break;
+            case 0x12: { // update sign: plain text becomes components
+                int x = in.readInt();
+                int y = in.readShort();
+                int z = in.readInt();
+
+                p = packet(ctx, id, out);
+                p.writeBlockPos(new BlockPosition(x, y, z));
+                for (int i = 0; i < 4; ++i) {
+                    p.writeString(IChatBaseComponent.ChatSerializer.componentToJson(new ChatComponentText(in.readStringFromBuffer(15))));
+                }
+                break;
+            }
+            case 0x14: // tab complete: 1.8 may say which block is looked at
+                p = packet(ctx, id, out);
+                p.writeString(in.readStringFromBuffer(32767));
+                p.writeBoolean(false);
+                break;
+            case 0x15: { // client settings: 1.7's difficulty and cape become 1.8's skin parts
+                p = packet(ctx, id, out);
+                p.writeString(in.readStringFromBuffer(7));
+                p.writeByte(in.readByte());     // view distance
+                p.writeByte(in.readByte());     // chat visibility
+                p.writeBoolean(in.readBoolean());
+                in.readByte();                  // difficulty
+                p.writeByte(in.readBoolean() ? 127 : 126);
+                break;
+            }
+            case 0x16: // client status
+                packet(ctx, id, out).writeVarIntToBuffer(in.readByte());
+                break;
+            case 0x17: // plugin message
+                this.pluginMessage(ctx, id, in, out);
+                break;
+            default:
+                raw.readerIndex(0);
+                out.add(raw.retain());
+        }
+    }
+
+    private void pluginMessage(ChannelHandlerContext ctx, int id, PacketDataSerializer in, List<Object> out) throws Exception {
+        String channel = in.readStringFromBuffer(20);
+        int length = in.readShort();
+        PacketDataSerializer p = packet(ctx, id, out);
+
+        p.writeString(channel);
+        // 1.7 sends a whole backing array for some channels: read what the channel holds and
+        // drop the rest
+        switch (channel) {
+            case "MC|Brand":
+            case "MC|ItemName": {
+                byte[] bytes = new byte[Math.min(length, in.readableBytes())];
+
+                in.readBytes(bytes);
+                p.writeString(new String(bytes, StandardCharsets.UTF_8));
+                break;
+            }
+            case "MC|BEdit":
+            case "MC|BSign":
+                AthenaLegacy17.itemToServer(in, p);
+                break;
+            case "MC|AdvCdm": {
+                int type = in.readByte();
+
+                p.writeByte(type);
+                if (type == 0) {
+                    p.writeBytes(in, 12);
+                } else if (type == 1) {
+                    p.writeInt(in.readInt());
+                }
+                p.writeString(in.readStringFromBuffer(32767));
+                p.writeBoolean(true);   // track output: 1.8's, and on by default
+                break;
+            }
+            case "MC|TrSel":
+                p.writeInt(in.readInt());
+                break;
+            case "MC|Beacon":
+                p.writeInt(in.readInt());
+                p.writeInt(in.readInt());
+                break;
+            default:
+                p.writeBytes(in, Math.min(length, in.readableBytes()));
+        }
+    }
+}
diff --git a/src/main/java/net/minecraft/server/AthenaLegacy17Encoder.java b/src/main/java/net/minecraft/server/AthenaLegacy17Encoder.java
