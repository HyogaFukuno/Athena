+package net.minecraft.server;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNull;
+
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.atomic.AtomicReference;
+
+import org.bukkit.support.AbstractTestingBase;
+import org.junit.Test;
+
+/**
+ * A block is one object for every world, and the shaped ones (slabs, stairs, ...) write their bounds
+ * and read them back. Worlds on their own threads do that at the same time; each thread must read
+ * back what it wrote (Block.bounds).
+ */
+public class AthenaBlockBoundsThreadsTest extends AbstractTestingBase {
+
+    @Test
+    public void eachThreadReadsItsOwnBounds() throws InterruptedException {
+        final Block slab = Blocks.STONE_SLAB;
+        final AtomicReference<String> failure = new AtomicReference<String>();
+        final CountDownLatch go = new CountDownLatch(1);
+        Thread[] threads = new Thread[4];
+        for (int n = 0; n < threads.length; n++) {
+            final float top = 0.25F + 0.125F * n; // every thread its own shape
+            threads[n] = new Thread(() -> {
+                try {
+                    go.await();
+                    for (int i = 0; i < 200000 && failure.get() == null; i++) {
+                        slab.setBlockBounds(0.0F, 0.0F, 0.0F, 1.0F, top, 1.0F);
+                        Thread.yield();
+                        if (slab.getBlockBoundsMaxY() != (double) top) {
+                            failure.compareAndSet(null, "read " + slab.getBlockBoundsMaxY() + " after setting " + top);
+                        }
+                    }
+                } catch (InterruptedException e) {
+                    Thread.currentThread().interrupt();
+                }
+            });
+            threads[n].start();
+        }
+        go.countDown();
+        for (Thread thread : threads) thread.join();
+        assertNull(failure.get());
+    }
+
+    @Test
+    public void aNewThreadSeesTheRegisteredBounds() throws InterruptedException {
+        final Block snow = Blocks.SNOW_LAYER;
+        final double[] seen = new double[2];
+        Thread before = new Thread(() -> seen[0] = snow.getBlockBoundsMaxY());
+        before.start();
+        before.join();
+        snow.setBlockBounds(0.0F, 0.0F, 0.0F, 1.0F, 0.75F, 1.0F); // this thread only
+        Thread after = new Thread(() -> seen[1] = snow.getBlockBoundsMaxY());
+        after.start();
+        after.join();
+        assertEquals(seen[0], seen[1], 0.0D);
+        assertEquals(0.75D, snow.getBlockBoundsMaxY(), 0.0D);
+    }
+}
