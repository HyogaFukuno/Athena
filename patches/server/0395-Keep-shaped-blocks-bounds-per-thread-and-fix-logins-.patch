             net.minecraft.server.WorldServer.athenaRunForEntity(handle, () -> {
                 try {
                     boolean present = entity instanceof Player ? ((Player) entity).isOnline() : entity.isValid();
-
-                    future.complete(present && entity.teleport(to, PlayerTeleportEvent.TeleportCause.PLUGIN));
+                    boolean moved = present && entity.teleport(to, PlayerTeleportEvent.TeleportCause.PLUGIN);
+
+                    // Athena - a player handed to another world's thread completes once it is in that world,
+                    // on that thread; true only if it got there (a world that went meanwhile sends it to the main world)
+                    if (moved && handle instanceof net.minecraft.server.EntityPlayer
+                            && ((net.minecraft.server.EntityPlayer) handle).athenaRunWhenLanded(() -> future.complete(handle.world == target))) {
+                        return;
+                    }
+                    future.complete(moved);
                 } catch (Throwable throwable) {
                     future.completeExceptionally(throwable);
                 }
