+    // Athena start - the bounds: minX, minY, minZ, maxX, maxY, maxZ. Vanilla kept them in six fields
+    // of the one Block that every world shares, and the blocks whose shape depends on the spot
+    // (stairs, slabs, fences, doors, ...) write them in updateShape and read them back a moment
+    // later. Worlds ticking on their own threads would read each other's shapes: wrong collisions,
+    // ray traces and movement checks. The bounds set while blocks are registered stay here for every
+    // thread; once registration is over (athenaFreezeBounds), a block that changes them writes a copy
+    // of its own for the calling thread, and every read of that block takes that thread's copy.
+    private final double[] athenaBounds = new double[6];
+    private final int athenaBoundsSlot = Block.athenaBoundsSlots.getAndIncrement();
+    /** Set once this block's bounds have changed after registration: from then on they are per thread. */
+    private volatile boolean athenaBoundsVary;
+
+    /** The bounds the calling thread sees, as minX, minY, minZ, maxX, maxY, maxZ. Do not keep the array. */
+    protected final double[] bounds() {
+        return this.athenaBoundsVary ? this.athenaThreadBounds() : this.athenaBounds;
+    }
+
+    private double[] athenaThreadBounds() {
+        double[][] all = ATHENA_THREAD_BOUNDS.get();
+        if (this.athenaBoundsSlot >= all.length) {
+            all = java.util.Arrays.copyOf(all, Block.athenaBoundsSlots.get());
+            ATHENA_THREAD_BOUNDS.set(all);
+        }
+        double[] mine = all[this.athenaBoundsSlot];
+        if (mine == null) {
+            mine = this.athenaBounds.clone(); // the registered bounds, which no longer change
+            all[this.athenaBoundsSlot] = mine;
+        }
+        return mine;
+    }
+
+    /** At the end of DispenserRegistry.register: bounds set from now on belong to the thread that sets them. */
+    static void athenaFreezeBounds() {
+        Block.athenaBoundsFrozen = true;
+    }
