diff --git a/src/test/java/net/minecraft/server/AthenaLoadExceptionsTest.java b/src/test/java/net/minecraft/server/AthenaLoadExceptionsTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..f3b64a943635543f443b2bf15004bd0d19fbd8ea
--- /dev/null
+++ b/src/test/java/net/minecraft/server/AthenaLoadExceptionsTest.java
@@ -0,0 +1,86 @@
+package net.minecraft.server;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertSame;
+import static org.junit.Assert.assertTrue;
+
+import com.mojang.authlib.GameProfile;
+import org.bukkit.support.AbstractTestingBase;
+import org.junit.Test;
+
+/**
+ * Athena - what a world and its chunks read as they load used to find out by exception: that "true"
+ * is no number (game rules), that an empty sign line is no JSON, that a head has no id and a flower
+ * pot no item. The answers are the same without the exceptions.
+ */
+public class AthenaLoadExceptionsTest extends AbstractTestingBase {
+
+    @Test
+    public void gameRulesReadAsBefore() {
+        GameRules rules = new GameRules();
+
+        assertTrue(rules.getBoolean("doDaylightCycle"));
+        assertEquals(1, rules.getInt("doDaylightCycle"));
+        rules.set("doDaylightCycle", "false");
+        assertFalse(rules.getBoolean("doDaylightCycle"));
+        assertEquals(0, rules.getInt("doDaylightCycle"));
+        assertEquals("false", rules.get("doDaylightCycle"));
+        rules.set("randomTickSpeed", "7");
+        assertEquals(7, rules.getInt("randomTickSpeed"));
+        assertFalse(rules.getBoolean("randomTickSpeed"));
+        rules.set("randomTickSpeed", "true"); // a number rule given a truth value: 1, as before
+        assertEquals(1, rules.getInt("randomTickSpeed"));
+        rules.set("randomTickSpeed", "2.5"); // no integer: what the truth value gives
+        assertEquals(0, rules.getInt("randomTickSpeed"));
+
+        NBTTagCompound saved = rules.writeToNBT();
+        GameRules read = new GameRules();
+
+        read.readFromNBT(saved);
+        assertFalse(read.getBoolean("doDaylightCycle"));
+        assertEquals("2.5", read.get("randomTickSpeed"));
+    }
+
+    @Test
+    public void anEmptySignLineIsNoComponent() {
+        assertNull(IChatBaseComponent.ChatSerializer.jsonToComponent(""));
+        assertEquals("a", IChatBaseComponent.ChatSerializer.jsonToComponent("\"a\"").getText());
+    }
+
+    @Test
+    public void aHeadWithANameOnlyHasNoId() {
+        NBTTagCompound named = new NBTTagCompound();
+
+        named.setString("Name", "Notch");
+        GameProfile profile = GameProfileSerializer.deserialize(named);
+
+        assertEquals("Notch", profile.getName());
+        assertNull(profile.getId());
+
+        named.setString("Id", "");
+        assertNull(GameProfileSerializer.deserialize(named).getId());
+        named.setString("Id", "not a uuid");
+        assertNull(GameProfileSerializer.deserialize(named).getId());
+        named.setString("Id", "069a79f4-44e9-4726-a5be-fca90e38aaf5");
+        assertEquals(java.util.UUID.fromString("069a79f4-44e9-4726-a5be-fca90e38aaf5"), GameProfileSerializer.deserialize(named).getId());
+    }
+
+    @Test
+    public void anEmptyFlowerPotHoldsNoItem() {
+        assertNull(Item.getByNameOrId(""));
+        assertSame(Items.DIAMOND, Item.getByNameOrId("minecraft:diamond"));
+        assertSame(Items.DIAMOND, Item.getByNameOrId("264"));
+        assertNull(Item.getByNameOrId("no such item"));
+    }
+
+    @Test
+    public void noObjectivesIsAnEmptyList() {
+        Scoreboard scoreboard = new Scoreboard();
+
+        assertTrue(scoreboard.getObjectivesForCriteria(IScoreboardCriteria.health).isEmpty());
+        scoreboard.registerObjective("hp", IScoreboardCriteria.health);
+        assertEquals(1, scoreboard.getObjectivesForCriteria(IScoreboardCriteria.health).size());
+    }
+}
