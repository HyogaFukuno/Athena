From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: glacier <hyouga.dev@gmail.com>
Date: Sun, 30 Aug 2026 11:45:45 +0900
Subject: [PATCH] Remember the chunk between blocks of the same box scan

handleMaterialAcceleration, isMaterialInBB and isFlammableWithin each walk an entity's
bounding box a block at a time and ask World.getType for every one, and getType resolves
the chunk out of the chunk provider's long-keyed hash map each time. A profile of the
saturating bench put that resolution at 9.4% of the server thread, two thirds of
everything getType cost, with these three the largest callers. The box spans one or two
chunks, so the lookup answers the same thing a dozen times in a row.

The memo is a pair of locals in each loop - no shared state for the decoration thread to
race on. The fast path is only taken when neither the decoration buffer nor tree capture
is in play, and isValidLocation is still asked per block, so an out-of-range y answers
air without touching a chunk; the miss path calls exactly what getType would have.

Measured +0.96% TPS, 5/6 pairwise wins, which is the harness's noise floor rather than a
result: the profile's 9.4% was mostly the inlined block read attributed to the lookup
frame, not the lookup. Kept because the mechanism only removes work, not because the
number stands on its own.

diff --git a/src/main/java/net/minecraft/server/World.java b/src/main/java/net/minecraft/server/World.java
index 5c83b5b829463b974e361dd59ce1ad68b8cf3700..15f45eb73bea9b5a550247b0183541517182c65f 100644
--- a/src/main/java/net/minecraft/server/World.java
+++ b/src/main/java/net/minecraft/server/World.java
@@ -1750,6 +1750,19 @@ public abstract class World implements IBlockAccess {
     // showed that costing ~14 MB/min, because the collision and material queries run several times
     // per entity per tick. Each call site owns a fixed slot, so a nested query can never scribble
     // over the position another one is still iterating with.
+    // Athena start - the box scans below walk an entity's bounding box a block at a time, and
+    // World.getType resolves the chunk out of the chunk provider's long-keyed hash map for every
+    // one of them. A profile of the saturating bench put that resolution at 9.4% of the server
+    // thread - two thirds of everything getType costs - with these three methods the largest
+    // callers. The box is one or two chunks wide, so remembering the chunk the last block came
+    // from turns a dozen map lookups into one or two.
+    //
+    // The memo is a pair of locals in each loop, so there is no state for the decoration thread to
+    // race on, and the miss path calls exactly what getType would have: the loop is only taken
+    // when neither the decoration buffer nor tree-capture is in play, and isValidLocation is still
+    // asked per block, so an out-of-range y still answers air rather than touching a chunk.
+    // Athena end
+
     private static final int SCRATCH_POS_SLOTS = 16; // Athena - 14 is isBlockFullCube's, 15 the weather checks'
     private static final ThreadLocal<BlockPosition.MutableBlockPosition[]> SCRATCH_POSITIONS = new ThreadLocal<BlockPosition.MutableBlockPosition[]>() {
         protected BlockPosition.MutableBlockPosition[] initialValue() {
@@ -2386,11 +2399,34 @@ public abstract class World implements IBlockAccess {
 
         if (this.isAreaLoaded(i, k, i1, j, l, j1, true)) {
             BlockPosition.MutableBlockPosition blockposition_mutableblockposition = scratchPos(5); // Athena - reuse a per-thread scratch position
+            // Athena start - remember the chunk the last block came from
+            boolean memo = !this.decorating() && !this.captureTreeGeneration;
+            Chunk memoChunk = null;
+            int memoX = Integer.MIN_VALUE;
+            int memoZ = Integer.MIN_VALUE;
+            // Athena end
 
             for (int k1 = i; k1 < j; ++k1) {
                 for (int l1 = k; l1 < l; ++l1) {
                     for (int i2 = i1; i2 < j1; ++i2) {
-                        Block block = this.getType(blockposition_mutableblockposition.set(k1, l1, i2)).getBlock();
+                        // Athena start
+                        Block block;
+
+                        if (memo && this.isValidLocation(k1, l1, i2)) {
+                            int cx = k1 >> 4;
+                            int cz = i2 >> 4;
+
+                            if (cx != memoX || cz != memoZ) {
+                                memoChunk = this.chunkProvider.getOrCreateChunk(cx, cz);
+                                memoX = cx;
+                                memoZ = cz;
+                            }
+
+                            block = memoChunk.getBlockData(k1, l1, i2).getBlock();
+                        } else {
+                            block = this.getType(blockposition_mutableblockposition.set(k1, l1, i2)).getBlock();
+                        }
+                        // Athena end
 
                         if (block == Blocks.FIRE || block == Blocks.FLOWING_LAVA || block == Blocks.LAVA) {
                             return true;
@@ -2422,12 +2458,35 @@ public abstract class World implements IBlockAccess {
             boolean flag = false;
             Vec3D vec3d = new Vec3D(0.0D, 0.0D, 0.0D);
             BlockPosition.MutableBlockPosition blockposition_mutableblockposition = scratchPos(6); // Athena - reuse a per-thread scratch position
+            // Athena start - remember the chunk the last block came from
+            boolean memo = !this.decorating() && !this.captureTreeGeneration;
+            Chunk memoChunk = null;
+            int memoX = Integer.MIN_VALUE;
+            int memoZ = Integer.MIN_VALUE;
+            // Athena end
 
             for (int k1 = i; k1 < j; ++k1) {
                 for (int l1 = k; l1 < l; ++l1) {
                     for (int i2 = i1; i2 < j1; ++i2) {
                         blockposition_mutableblockposition.set(k1, l1, i2);
-                        IBlockData iblockdata = this.getType(blockposition_mutableblockposition);
+                        // Athena start
+                        IBlockData iblockdata;
+
+                        if (memo && this.isValidLocation(k1, l1, i2)) {
+                            int cx = k1 >> 4;
+                            int cz = i2 >> 4;
+
+                            if (cx != memoX || cz != memoZ) {
+                                memoChunk = this.chunkProvider.getOrCreateChunk(cx, cz);
+                                memoX = cx;
+                                memoZ = cz;
+                            }
+
+                            iblockdata = memoChunk.getBlockData(k1, l1, i2);
+                        } else {
+                            iblockdata = this.getType(blockposition_mutableblockposition);
+                        }
+                        // Athena end
                         Block block = iblockdata.getBlock();
 
                         if (block.getMaterial() == material) {
@@ -2468,13 +2527,38 @@ public abstract class World implements IBlockAccess {
         int i1 = MathHelper.floor(minZ);
         int j1 = MathHelper.floor(maxZ + 1.0D);
         BlockPosition.MutableBlockPosition blockposition_mutableblockposition = scratchPos(7); // Athena - reuse a per-thread scratch position
+        // Athena start - remember the chunk the last block came from
+        boolean memo = !this.decorating() && !this.captureTreeGeneration;
+        Chunk memoChunk = null;
+        int memoX = Integer.MIN_VALUE;
+        int memoZ = Integer.MIN_VALUE;
+        // Athena end
 
         for (int k1 = i; k1 < j; ++k1) {
             for (int l1 = k; l1 < l; ++l1) {
                 for (int i2 = i1; i2 < j1; ++i2) {
-                    if (this.getType(blockposition_mutableblockposition.set(k1, l1, i2)).getBlock().getMaterial() == material) {
+                    // Athena start
+                    IBlockData iblockdata;
+
+                    if (memo && this.isValidLocation(k1, l1, i2)) {
+                        int cx = k1 >> 4;
+                        int cz = i2 >> 4;
+
+                        if (cx != memoX || cz != memoZ) {
+                            memoChunk = this.chunkProvider.getOrCreateChunk(cx, cz);
+                            memoX = cx;
+                            memoZ = cz;
+                        }
+
+                        iblockdata = memoChunk.getBlockData(k1, l1, i2);
+                    } else {
+                        iblockdata = this.getType(blockposition_mutableblockposition.set(k1, l1, i2));
+                    }
+
+                    if (iblockdata.getBlock().getMaterial() == material) {
                         return true;
                     }
+                    // Athena end
                 }
             }
         }
