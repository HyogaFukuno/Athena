         protected BlockPosition.MutableBlockPosition[] initialValue() {
             BlockPosition.MutableBlockPosition[] slots = new BlockPosition.MutableBlockPosition[SCRATCH_POS_SLOTS];
@@ -1778,6 +1778,11 @@ public abstract class World implements IBlockAccess {
         return this.getChunkAtWorldCoords(blockposition).getPrecipitationHeight(blockposition);
     }
 
+    // Athena - coordinate form, so the weather ticks never build a position for the common case
+    public int getPrecipitationHeightY(int x, int z) {
+        return this.getChunkAtWorldCoords(x, z).getPrecipitationHeightY(x, z);
+    }
+
     public BlockPosition getTopSolidOrLiquidBlock(BlockPosition blockposition) {
         Chunk chunk = this.getChunkAtWorldCoords(blockposition);
 
@@ -2830,14 +2835,28 @@ public abstract class World implements IBlockAccess {
     }
 
     public boolean canBlockFreeze(BlockPosition blockposition, boolean flag) {
-        BiomeBase biomebase = this.getBiome(blockposition);
-        float f = biomebase.getFloatTemperature(blockposition);
+        return this.canBlockFreeze(blockposition.getX(), blockposition.getY(), blockposition.getZ(), flag);
+    }
+
+    // Athena start - coordinate forms of the freeze and snow checks.
+    //
+    // Both bail on the temperature test before touching anything else, so on a map with no cold
+    // biomes every position the caller built beforehand was wasted. The scratch position is only
+    // handed to the APIs that still require one (biome lookup, temperature, snow placement check),
+    // none of which retain it.
+    public boolean canBlockFreeze(int x, int y, int z, boolean flag) {
+        BlockPosition.MutableBlockPosition pos = scratchPos(15);
+
+        pos.set(x, y, z);
+
+        BiomeBase biomebase = this.getBiome(pos);
+        float f = biomebase.getFloatTemperature(pos);
 
         if (f > 0.15F) {
             return false;
         } else {
-            if (blockposition.getY() >= 0 && blockposition.getY() < 256 && this.getLightFor(EnumSkyBlock.BLOCK, blockposition) < 10) {
-                IBlockData iblockdata = this.getType(blockposition);
+            if (y >= 0 && y < 256 && this.getLightFor(EnumSkyBlock.BLOCK, x, y, z) < 10) {
+                IBlockData iblockdata = this.getType(x, y, z);
                 Block block = iblockdata.getBlock();
 
                 if ((block == Blocks.WATER || block == Blocks.FLOWING_WATER) && ((Integer) iblockdata.get(BlockFluids.LEVEL)).intValue() == 0) {
@@ -2845,7 +2864,7 @@ public abstract class World implements IBlockAccess {
                         return true;
                     }
 
-                    boolean flag1 = this.isWater(blockposition.west()) && this.isWater(blockposition.east()) && this.isWater(blockposition.north()) && this.isWater(blockposition.south());
+                    boolean flag1 = this.isWater(x - 1, y, z) && this.isWater(x + 1, y, z) && this.isWater(x, y, z - 1) && this.isWater(x, y, z + 1);
 
                     if (!flag1) {
                         return true;
@@ -2857,23 +2876,31 @@ public abstract class World implements IBlockAccess {
         }
     }
 
-    private boolean isWater(BlockPosition blockposition) {
-        return this.getType(blockposition).getBlock().getMaterial() == Material.WATER;
+    private boolean isWater(int x, int y, int z) {
+        return this.getType(x, y, z).getBlock().getMaterial() == Material.WATER;
     }
 
     public boolean canSnowAt(BlockPosition blockposition, boolean flag) {
-        BiomeBase biomebase = this.getBiome(blockposition);
-        float f = biomebase.getFloatTemperature(blockposition);
+        return this.canSnowAt(blockposition.getX(), blockposition.getY(), blockposition.getZ(), flag);
+    }
+
+    public boolean canSnowAt(int x, int y, int z, boolean flag) {
+        BlockPosition.MutableBlockPosition pos = scratchPos(15);
+
+        pos.set(x, y, z);
+
+        BiomeBase biomebase = this.getBiome(pos);
+        float f = biomebase.getFloatTemperature(pos);
 
         if (f > 0.15F) {
             return false;
         } else if (!flag) {
             return true;
         } else {
-            if (blockposition.getY() >= 0 && blockposition.getY() < 256 && this.getLightFor(EnumSkyBlock.BLOCK, blockposition) < 10) {
-                Block block = this.getType(blockposition).getBlock();
+            if (y >= 0 && y < 256 && this.getLightFor(EnumSkyBlock.BLOCK, x, y, z) < 10) {
+                Block block = this.getType(x, y, z).getBlock();
 
-                if (block.getMaterial() == Material.AIR && Blocks.SNOW_LAYER.canPlace(this, blockposition)) {
+                if (block.getMaterial() == Material.AIR && Blocks.SNOW_LAYER.canPlace(this, pos)) {
                     return true;
                 }
             }
@@ -2881,6 +2908,7 @@ public abstract class World implements IBlockAccess {
             return false;
         }
     }
+    // Athena end
 
     public boolean checkLight(BlockPosition blockposition) {
         boolean flag = false;
