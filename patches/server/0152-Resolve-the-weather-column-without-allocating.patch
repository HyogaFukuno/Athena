From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: glacier <hyouga.dev@gmail.com>
Date: Mon, 24 Aug 2026 07:20:33 +0900
Subject: [PATCH] Resolve the weather column without allocating

The precipitation height is already an int in precipitationHeightMap, but
getPrecipitationHeight built a BlockPosition just to read getY() off it and
compare against -999, a second one to return, and one per Y level on the rare
cache miss. tickIceAndSnow asks for it on a random column of every ticked
chunk, so on a fixed map it was the largest remaining allocation site outside
chunk loading - 23 MB/min.

canBlockFreeze and canSnowAt both bail on the biome temperature before touching
anything else, so on a map with no cold biomes every position built ahead of
them was thrown away. Both get coordinate forms, and tickIceAndSnow only
materializes a position inside the branches that actually form ice or snow.

The down-walk uses getTypeAbs rather than the private getType(int,int,int),
which takes chunk-local coordinates and would silently have read a different
column.

updateBlocks held a verbatim copy of tickIceAndSnow, guard and all, for the
non-PandaSpigot chunk-selection path; it now calls the method. Two copies would
only drift, and this rewrite would otherwise have applied to just one of the
two paths depending on configuration.

diff --git a/src/main/java/net/minecraft/server/Chunk.java b/src/main/java/net/minecraft/server/Chunk.java
index baf05b1df2f154b82e13831418cd93986ee5a89e..59b07a522268332c261840a76c9a4fa17784b41c 100644
--- a/src/main/java/net/minecraft/server/Chunk.java
+++ b/src/main/java/net/minecraft/server/Chunk.java
@@ -1149,32 +1149,42 @@ public class Chunk {
     }
 
     public BlockPosition getPrecipitationHeight(BlockPosition blockposition) {
-        int i = blockposition.getX() & 15;
-        int j = blockposition.getZ() & 15;
+        return new BlockPosition(blockposition.getX(), this.getPrecipitationHeightY(blockposition.getX(), blockposition.getZ()), blockposition.getZ());
+    }
+
+    // Athena - the height is an int in precipitationHeightMap; hand it back as one.
+    //
+    // The old shape built a BlockPosition just to read getY() off it and compare against -999, a
+    // second one to return, and one per Y level on the rare cache miss. WorldServer.tickIceAndSnow
+    // asks for this on a random column of every ticked chunk, so on the cached path - which is
+    // almost always - those two were pure waste.
+    public int getPrecipitationHeightY(int x, int z) {
+        int i = x & 15;
+        int j = z & 15;
         int k = i | j << 4;
-        BlockPosition blockposition1 = new BlockPosition(blockposition.getX(), this.precipitationHeightMap[k], blockposition.getZ());
 
-        if (blockposition1.getY() == -999) {
+        if (this.precipitationHeightMap[k] == -999) {
             int l = this.getTopFilledSegment() + 15;
-
-            blockposition1 = new BlockPosition(blockposition.getX(), l, blockposition.getZ());
             int i1 = -1;
+            int y = l;
 
-            while (blockposition1.getY() > 0 && i1 == -1) {
-                Block block = this.getType(blockposition1);
+            while (y > 0 && i1 == -1) {
+                // getTypeAbs, not getType(int,int,int): the latter is private and takes chunk-local
+                // coordinates, so world x/z would silently read a different column
+                Block block = this.getTypeAbs(x, y, z);
                 Material material = block.getMaterial();
 
                 if (!material.isSolid() && !material.isLiquid()) {
-                    blockposition1 = blockposition1.down();
+                    --y;
                 } else {
-                    i1 = blockposition1.getY() + 1;
+                    i1 = y + 1;
                 }
             }
 
             this.precipitationHeightMap[k] = i1;
         }
 
-        return new BlockPosition(blockposition.getX(), this.precipitationHeightMap[k], blockposition.getZ());
+        return this.precipitationHeightMap[k];
     }
 
     public void b(boolean flag) {
diff --git a/src/main/java/net/minecraft/server/World.java b/src/main/java/net/minecraft/server/World.java
