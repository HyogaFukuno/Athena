             AthenaTemplateRegion region = this.region(i, j);
 
@@ -68,6 +80,15 @@ final class AthenaTemplateChunkLoader extends ChunkRegionLoader {
 
     @Override
     public Object[] loadChunk(World world, int i, int j) throws IOException {
+        this.lifecycle.readLock().lock();
+        try {
+            return this.closed ? null : this.loadChunkOpen(world, i, j);
+        } finally {
+            this.lifecycle.readLock().unlock();
+        }
+    }
+
+    private Object[] loadChunkOpen(World world, int i, int j) throws IOException {
         // Athena - the slim NBT from the store when it has one: the section arrays it leaves out come
         // from the store anyway (see AthenaSectionStore). Not while the audit runs, which compares
         // each stored section with the region file's.
@@ -90,16 +111,21 @@ final class AthenaTemplateChunkLoader extends ChunkRegionLoader {
     public void saveExtraData() {}
 
     /** Closes the template's region files. Called when the world unloads. */
-    synchronized void close() {
-        this.closed = true;
-        for (AthenaTemplateRegion region : this.regions.values()) {
-            if (region != null) {
-                try {
-                    region.close();
-                } catch (IOException ignored) {
+    void close() {
+        this.lifecycle.writeLock().lock();
+        try {
+            this.closed = true;
+            for (AthenaTemplateRegion region : this.regions.values()) {
+                if (region != null) {
+                    try {
+                        region.close();
+                    } catch (IOException ignored) {
+                    }
                 }
             }
+            this.regions.clear();
+        } finally {
+            this.lifecycle.writeLock().unlock();
         }
-        this.regions.clear();
     }
 }
diff --git a/src/main/java/net/minecraft/server/AthenaTemplateRegion.java b/src/main/java/net/minecraft/server/AthenaTemplateRegion.java
index 798501fcf4c8a12df6063597de07b8562130b67f..2e1bbd36b802017530b7e53394bb223b9300ab51 100644
--- a/src/main/java/net/minecraft/server/AthenaTemplateRegion.java
+++ b/src/main/java/net/minecraft/server/AthenaTemplateRegion.java
@@ -7,6 +7,7 @@ import java.io.DataInputStream;
 import java.io.EOFException;
 import java.io.File;
 import java.io.IOException;
+import java.util.concurrent.locks.ReentrantReadWriteLock;
 import java.io.InputStream;
 import java.nio.ByteBuffer;
 import java.nio.channels.FileChannel;
@@ -25,9 +26,12 @@ final class AthenaTemplateRegion implements Closeable {
 
     private static final int SECTOR = 4096;
 
+    // Athena - closing waits for readers; a reader starting after close sees no data.
+    private final ReentrantReadWriteLock lifecycle = new ReentrantReadWriteLock(true);
     private final FileChannel channel;
     private final int[] offsets = new int[1024];
     private final long size;
+    private boolean closed;
 
     private AthenaTemplateRegion(FileChannel channel) throws IOException {
         this.channel = channel;
@@ -59,6 +63,15 @@ final class AthenaTemplateRegion implements Closeable {
      * the server generates the chunk instead, as it does for one that is not there.
      */
     boolean has(int x, int z) {
+        this.lifecycle.readLock().lock();
+        try {
+            return this.closed ? false : this.hasOpen(x, z);
+        } finally {
+            this.lifecycle.readLock().unlock();
+        }
+    }
+
+    private boolean hasOpen(int x, int z) {
         if ((x | z) < 0 || x >= 32 || z >= 32) {
             return false;
         }
@@ -70,6 +83,15 @@ final class AthenaTemplateRegion implements Closeable {
 
     /** The chunk's NBT, or null if it is not stored. */
     NBTTagCompound read(int x, int z) throws IOException {
+        this.lifecycle.readLock().lock();
+        try {
+            return this.closed ? null : this.readOpen(x, z);
+        } finally {
+            this.lifecycle.readLock().unlock();
+        }
+    }
+
+    private NBTTagCompound readOpen(int x, int z) throws IOException {
         int[] header = this.header(x, z);
 
         if (header == null) {
@@ -142,6 +164,12 @@ final class AthenaTemplateRegion implements Closeable {
 
     @Override
     public void close() throws IOException {
-        this.channel.close();
+        this.lifecycle.writeLock().lock();
+        try {
+            this.closed = true;
+            this.channel.close();
+        } finally {
+            this.lifecycle.writeLock().unlock();
+        }
     }
 }
