@@ -32,6 +32,11 @@ class ChunkIOProvider implements AsynchronousExecutor.CallBackProvider<QueuedChu
 
             return null;
         } catch (IOException ex) {
+            // Athena - only an unloaded world may abandon a failed read; never regenerate a live
+            // world silently after an IO error. Errors still propagate through the executor.
+            if (queuedChunk.provider.world.athenaUnloaded) {
+                return null;
+            }
