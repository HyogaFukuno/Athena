From: glacier <hyouga.dev@gmail.com>
Date: Thu, 29 Oct 2026 20:45:14 +0900
Subject: [PATCH] Wait for template reads before close and discard unloaded
 chunk results


diff --git a/src/main/java/net/minecraft/server/AthenaChunkPreloader.java b/src/main/java/net/minecraft/server/AthenaChunkPreloader.java
index 0669c9e03104ee7e864dd1ae6c8879ff2cfca33d..e56292f1c4bae7a947afb9d0e67ed2c2a1c1caf4 100644
--- a/src/main/java/net/minecraft/server/AthenaChunkPreloader.java
+++ b/src/main/java/net/minecraft/server/AthenaChunkPreloader.java
@@ -107,11 +107,14 @@ public final class AthenaChunkPreloader {
                         @Override
                         public void run() {
                             --owner.pending;
-                            ++owner.loaded;
+                            if (owner.world.athenaUnloaded) {
+                                return; // Athena - a discarded Stage2 load is not a loaded chunk
+                            }
                             // the players this preload is for will be sent it: build its packet now,
                             // spread over the preload, rather than all at once when they arrive
                             Chunk chunk = owner.world.chunkProviderServer.getChunkIfLoaded(chunkX, chunkZ);
                             if (chunk != null) {
+                                ++owner.loaded;
                                 chunk.athenaWarmPacketCache();
                             }
                         }
