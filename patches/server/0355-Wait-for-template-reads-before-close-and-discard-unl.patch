@@ -0,0 +1,26 @@
+package net.minecraft.server;
+
+import java.lang.reflect.Field;
+
+/** Small lifecycle fixtures without starting a MinecraftServer or its background services. */
+public final class AthenaAuditFixtures {
+    private AthenaAuditFixtures() {}
+
+    public static <T> T allocate(Class<T> type) throws Exception {
+        Field field = sun.misc.Unsafe.class.getDeclaredField("theUnsafe");
+        field.setAccessible(true);
+        return type.cast(((sun.misc.Unsafe) field.get(null)).allocateInstance(type));
+    }
+
+    public static void set(Object object, Class<?> owner, String name, Object value) throws Exception {
+        Field field = owner.getDeclaredField(name);
+        field.setAccessible(true);
+        field.set(object, value);
+    }
+
+    public static WorldServer world() throws Exception {
+        WorldServer world = allocate(WorldServer.class);
+        world.chunkProviderServer = new ChunkProviderServer(world, null, null);
+        return world;
+    }
+}
diff --git a/src/test/java/net/minecraft/server/AthenaChunkLifecycleTest.java b/src/test/java/net/minecraft/server/AthenaChunkLifecycleTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..1468198c2809cb98db0ecfa09559abf0b1e1c632
--- /dev/null
+++ b/src/test/java/net/minecraft/server/AthenaChunkLifecycleTest.java
@@ -0,0 +1,118 @@
+package net.minecraft.server;
+
+import static org.junit.Assert.*;
+
+import java.io.File;
+import java.io.IOException;
+import java.lang.reflect.Constructor;
+import java.lang.reflect.Field;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.ThreadPoolExecutor;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicInteger;
+import org.bukkit.craftbukkit.CraftWorld;
+import org.bukkit.craftbukkit.util.AsynchronousExecutor;
+import org.bukkit.support.AbstractTestingBase;
+import org.junit.Test;
+
+public class AthenaChunkLifecycleTest extends AbstractTestingBase {
+    @SuppressWarnings("unchecked")
+    private static AsynchronousExecutor<Object, Chunk, Runnable, RuntimeException> executor() throws Exception {
+        Constructor<?> constructor = Class.forName("org.bukkit.craftbukkit.chunkio.ChunkIOProvider").getDeclaredConstructor();
+        constructor.setAccessible(true);
+        return new AsynchronousExecutor<>((AsynchronousExecutor.CallBackProvider<Object, Chunk, Runnable, RuntimeException>) constructor.newInstance(), 1);
+    }
+
+    private static Object request(WorldServer world, ChunkRegionLoader loader) throws Exception {
+        Constructor<?> constructor = Class.forName("org.bukkit.craftbukkit.chunkio.QueuedChunk").getDeclaredConstructors()[0];
+        constructor.setAccessible(true);
+        return constructor.newInstance(0, 0, loader, world, world.chunkProviderServer);
+    }
+
+    private static void stop(AsynchronousExecutor<?, ?, ?, ?> executor) throws Exception {
+        Field field = AsynchronousExecutor.class.getDeclaredField("pool");
+        field.setAccessible(true);
+        ((ThreadPoolExecutor) field.get(executor)).shutdownNow();
+    }
+
+    @Test(timeout = 10000)
+    public void anIoFailureDuringUnloadFinishesWithoutThrowing() throws Exception {
+        WorldServer world = AthenaAuditFixtures.world();
+        CountDownLatch reading = new CountDownLatch(1), release = new CountDownLatch(1);
+        ChunkRegionLoader loader = new ChunkRegionLoader(new File("unused-audit-world")) {
+            @Override public Object[] loadChunk(World ignored, int x, int z) throws IOException {
+                reading.countDown();
+                try { assertTrue(release.await(5, TimeUnit.SECONDS)); }
+                catch (InterruptedException ex) { throw new IOException(ex); }
+                throw new IOException("closed while unloading");
+            }
+        };
+        AsynchronousExecutor<Object, Chunk, Runnable, RuntimeException> executor = executor();
+        AtomicInteger callbacks = new AtomicInteger();
+        Object request = request(world, loader);
+        try {
+            executor.add(request, callbacks::incrementAndGet);
+            assertTrue(reading.await(5, TimeUnit.SECONDS));
+            world.athenaUnloaded = true;
+            release.countDown();
+            assertNull(executor.get(request)); // finish() of the queued task, not a direct loader call
+            executor.finishActive();
+            assertEquals(1, callbacks.get());
+            assertTrue(world.chunkProviderServer.chunks.isEmpty());
+        } finally {
+            release.countDown();
+            stop(executor);
+        }
+    }
+
+    @Test(timeout = 10000)
+    public void aLiveWorldIoFailureStillPropagates() throws Exception {
+        WorldServer world = AthenaAuditFixtures.world();
+        IOException failure = new IOException("broken live region");
+        ChunkRegionLoader loader = new ChunkRegionLoader(new File("unused-audit-world")) {
+            @Override public Object[] loadChunk(World ignored, int x, int z) throws IOException { throw failure; }
+        };
+        AsynchronousExecutor<Object, Chunk, Runnable, RuntimeException> executor = executor();
+        Object request = request(world, loader);
+        try {
+            executor.add(request, () -> fail("failed reads must not report success"));
+            try { executor.get(request); fail("live IO failure was hidden"); }
+            catch (RuntimeException ex) { assertSame(failure, ex.getCause()); }
+        } finally { stop(executor); }
+    }
+
+    @Test(timeout = 10000)
+    public void vmErrorsAreNeverHiddenEvenAfterUnload() throws Exception {
+        WorldServer world = AthenaAuditFixtures.world();
+        world.athenaUnloaded = true;
+        Error failure = new AssertionError("simulated VM failure");
+        ChunkRegionLoader loader = new ChunkRegionLoader(new File("unused-audit-world")) {
+            @Override public Object[] loadChunk(World ignored, int x, int z) { throw failure; }
+        };
+        AsynchronousExecutor<Object, Chunk, Runnable, RuntimeException> executor = executor();
+        Object request = request(world, loader);
+        try {
+            executor.add(request, () -> fail("Error must propagate"));
+            try { executor.get(request); fail("Error was hidden"); }
+            catch (Error ex) { assertSame(failure, ex); }
+        } finally { stop(executor); }
+    }
+
+    @Test
+    public void asyncPinnedChunksHaveCoordinatesAndUnloadedWorldsDoNotCallback() throws Exception {
+        WorldServer world = AthenaAuditFixtures.world();
+        world.chunkProviderServer.pin(0, 0, 0, 0);
+        CraftWorld craft = AthenaAuditFixtures.allocate(CraftWorld.class);
+        AthenaAuditFixtures.set(craft, CraftWorld.class, "world", world);
+        AtomicInteger calls = new AtomicInteger();
+        craft.getChunkAtAsync(7, -9, chunk -> {
+            assertNotNull(chunk);
+            assertEquals(7, chunk.getX());
+            assertEquals(-9, chunk.getZ());
+            calls.incrementAndGet();
+        });
+        assertEquals(1, calls.get());
+        world.athenaUnloaded = true;
+        craft.getChunkAtAsync(7, -9, chunk -> fail("unloaded world called back"));
+    }
+}
diff --git a/src/test/java/net/minecraft/server/AthenaTemplateCloseTest.java b/src/test/java/net/minecraft/server/AthenaTemplateCloseTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..bf3b22e3c91cbe42c8f47fb91c0b4d59803dbcf8
--- /dev/null
+++ b/src/test/java/net/minecraft/server/AthenaTemplateCloseTest.java
@@ -0,0 +1,86 @@
+package net.minecraft.server;
+
+import static org.junit.Assert.*;
+
+import java.io.DataOutputStream;
+import java.io.IOException;
+import java.lang.reflect.Constructor;
+import java.nio.ByteBuffer;
+import java.nio.MappedByteBuffer;
+import java.nio.channels.*;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.Random;
+import java.util.concurrent.*;
+import org.junit.Test;
+
+public class AthenaTemplateCloseTest {
+    @Test(timeout = 10000)
+    public void closeWaitsUntilTheActiveReadFinishes() throws Exception {
+        Path dir = Files.createTempDirectory("athena-close-test");
+        Path file = dir.resolve("r.0.0.mca");
+        NBTTagCompound nbt = new NBTTagCompound();
+        byte[] bytes = new byte[512 * 1024];
+        new Random(7).nextBytes(bytes);
+        nbt.setByteArray("payload", bytes);
+        RegionFile writer = new RegionFile(file.toFile());
+        try (DataOutputStream stream = writer.getChunkDataOutputStream(0, 0)) {
+            NBTCompressedStreamTools.write(nbt, (java.io.DataOutput) stream);
+        } finally { writer.close(); }
+        BlockingChannel channel = new BlockingChannel(FileChannel.open(file));
+        Constructor<AthenaTemplateRegion> constructor = AthenaTemplateRegion.class.getDeclaredConstructor(FileChannel.class);
+        constructor.setAccessible(true);
+        AthenaTemplateRegion region = constructor.newInstance(channel);
+        ExecutorService pool = Executors.newFixedThreadPool(2);
+        try {
+            channel.armed = true;
+            Future<NBTTagCompound> read = pool.submit(() -> region.read(0, 0));
+            assertTrue(channel.reading.await(5, TimeUnit.SECONDS));
+            CountDownLatch closing = new CountDownLatch(1);
+            Future<?> close = pool.submit(() -> { closing.countDown(); region.close(); return null; });
+            assertTrue(closing.await(5, TimeUnit.SECONDS));
+            try { close.get(100, TimeUnit.MILLISECONDS); fail("close interrupted an active read"); }
+            catch (TimeoutException expected) {}
+            channel.release.countDown();
+            assertEquals(nbt, read.get(5, TimeUnit.SECONDS));
+            close.get(5, TimeUnit.SECONDS);
+            assertNull(region.read(0, 0));
+            assertFalse(region.has(0, 0));
+        } finally {
+            channel.release.countDown();
+            pool.shutdownNow();
+            region.close();
+        }
+    }
+
+    private static final class BlockingChannel extends FileChannel {
+        final FileChannel delegate;
+        final CountDownLatch reading = new CountDownLatch(1), release = new CountDownLatch(1);
+        volatile boolean armed;
+        BlockingChannel(FileChannel delegate) { this.delegate = delegate; }
+        @Override public int read(ByteBuffer dst, long position) throws IOException {
+            if (armed) {
+                reading.countDown();
+                try { if (!release.await(5, TimeUnit.SECONDS)) throw new IOException("test read timeout"); }
+                catch (InterruptedException ex) { Thread.currentThread().interrupt(); throw new IOException(ex); }
+            }
+            return delegate.read(dst, position);
+        }
+        @Override public long size() throws IOException { return delegate.size(); }
+        @Override protected void implCloseChannel() throws IOException { delegate.close(); }
+        @Override public int read(ByteBuffer dst) { throw new UnsupportedOperationException(); }
+        @Override public long read(ByteBuffer[] d, int o, int n) { throw new UnsupportedOperationException(); }
+        @Override public int write(ByteBuffer src) { throw new UnsupportedOperationException(); }
+        @Override public long write(ByteBuffer[] s, int o, int n) { throw new UnsupportedOperationException(); }
+        @Override public int write(ByteBuffer src, long pos) { throw new UnsupportedOperationException(); }
+        @Override public long position() { throw new UnsupportedOperationException(); }
+        @Override public FileChannel position(long p) { throw new UnsupportedOperationException(); }
+        @Override public FileChannel truncate(long s) { throw new UnsupportedOperationException(); }
+        @Override public void force(boolean metadata) { throw new UnsupportedOperationException(); }
+        @Override public long transferTo(long p, long n, WritableByteChannel c) { throw new UnsupportedOperationException(); }
+        @Override public long transferFrom(ReadableByteChannel c, long p, long n) { throw new UnsupportedOperationException(); }
+        @Override public MappedByteBuffer map(MapMode m, long p, long n) { throw new UnsupportedOperationException(); }
+        @Override public FileLock lock(long p, long n, boolean shared) { throw new UnsupportedOperationException(); }
+        @Override public FileLock tryLock(long p, long n, boolean shared) { throw new UnsupportedOperationException(); }
+    }
+}
