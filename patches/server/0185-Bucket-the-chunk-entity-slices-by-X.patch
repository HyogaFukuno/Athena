+    // Athena start - bucket index maintenance
+    /** The bucket a world X coordinate falls in, clamped to this chunk. */
+    private int bucketOf(double x) {
+        int b = MathHelper.floor(x) - (this.locX << 4);
+        return b < 0 ? 0 : (b > 15 ? 15 : b);
+    }
+
+    private void bucketAdd(List<Entity>[] buckets, int slice, Entity entity) {
+        int b = this.bucketOf(entity.boundingBoxMinX);
+        List<Entity> bucket = buckets[b];
+
+        if (bucket == null) {
+            bucket = new org.bukkit.craftbukkit.util.UnsafeList<Entity>(4);
+            buckets[b] = bucket;
+        }
+
+        bucket.add(entity);
+        entity.athenaBucket = b;
+        // The query widens its bucket range by this much on the low side, so it has to cover the
+        // widest entity the slice has held: an entity is bucketed by its minimum corner, but it
+        // matches a box that only its maximum corner reaches.
+        int width = MathHelper.floor(entity.boundingBoxMaxX - entity.boundingBoxMinX) + 1;
+
+        if (width > this.bucketPad[slice]) {
+            this.bucketPad[slice] = width;
+        }
+    }
+
+    /** Builds (or rebuilds) the bucket index of one slice from the slice itself. */
+    private void buildBuckets(int slice) {
+        List<Entity>[] buckets = (List<Entity>[]) new List[16];
+
+        this.entityBuckets[slice] = buckets;
+        this.bucketPad[slice] = 1;
+        List<Entity> flat = this.entitySlices[slice];
+
+        for (int i = 0; i < flat.size(); ++i) {
+            this.bucketAdd(buckets, slice, flat.get(i));
+        }
+    }
+
+    /** Called from {@link Entity#setEntityBoundingBox} when a registered entity's box moves. */
+    void updateEntityBucket(Entity entity) {
+        int slice = entity.chunkCoordY;
+
+        if (slice < 0 || slice >= this.entityBuckets.length) {
+            return;
+        }
+
+        List<Entity>[] buckets = this.entityBuckets[slice];
+
+        if (buckets == null) {
+            return;
+        }
+
+        int b = this.bucketOf(entity.boundingBoxMinX);
+
+        if (b == entity.athenaBucket) {
+            int width = MathHelper.floor(entity.boundingBoxMaxX - entity.boundingBoxMinX) + 1;
+
+            if (width > this.bucketPad[slice]) {
+                this.bucketPad[slice] = width;
+            }
+
+            return;
+        }
+
+        if (entity.athenaBucket >= 0 && buckets[entity.athenaBucket] != null) {
+            buckets[entity.athenaBucket].remove(entity);
+        }
+
+        this.bucketAdd(buckets, slice, entity);
+    }
+    // Athena end
+
+    // Athena - accessors for AthenaIndexAudit only
+    List<Entity>[] auditBuckets(int slice) { return this.entityBuckets[slice]; }
+    int auditBucketOf(double x) { return this.bucketOf(x); }
+    int auditBucketPad(int slice) { return this.bucketPad[slice]; }
+
