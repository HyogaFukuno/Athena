+    /**
+     * Verifies Chunk's X bucket index against the entity slice it is derived from. The index is
+     * maintained from five places - addEntity, removeEntityAtIndex, addEntities, removeEntities and
+     * the setEntityBoundingBox callback - and a query that reads it must return exactly what a flat
+     * walk of the slice would have returned, so every entity has to be in the one bucket its
+     * minimum X corner puts it in, and the pad has to cover the widest entity present.
+     */
+    public static void auditEntityBuckets(WorldServer world) {
+        for (Object o : world.chunkProviderServer.chunks.values()) {
+            Chunk chunk = (Chunk) o;
+
+            for (int slice = 0; slice < chunk.entitySlices.length; ++slice) {
+                ++bucketChecks;
+                java.util.List<Entity> flat = chunk.entitySlices[slice];
+                java.util.List<Entity>[] buckets = chunk.auditBuckets(slice);
+
+                if (buckets == null) {
+                    continue;
+                }
+
+                ++bucketChecksIndexed;
+                bucketEntities += flat.size();
+                int found = 0;
+
+                for (int b = 0; b < buckets.length; ++b) {
+                    if (buckets[b] == null) {
+                        continue;
+                    }
+
+                    for (Entity entity : buckets[b]) {
+                        ++found;
+
+                        if (entity.athenaBucket != b) {
+                            report("entity " + entity.getId() + " is in bucket " + b + " but records " + entity.athenaBucket);
+                        }
+
+                        if (chunk.auditBucketOf(entity.boundingBoxMinX) != b) {
+                            report("entity " + entity.getId() + " is in bucket " + b + " but its minX "
+                                    + entity.boundingBoxMinX + " belongs in " + chunk.auditBucketOf(entity.boundingBoxMinX));
+                        }
+
+                        if (entity.athenaChunk != chunk) {
+                            report("entity " + entity.getId() + " is bucketed in " + chunk.locX + "," + chunk.locZ
+                                    + " but points at " + (entity.athenaChunk == null ? "null" : entity.athenaChunk.locX + "," + entity.athenaChunk.locZ));
+                        }
+
+                        if (!flat.contains(entity)) {
+                            report("entity " + entity.getId() + " is bucketed but not in slice " + slice);
+                        }
+
+                        if (entity.boundingBoxMaxX - entity.boundingBoxMinX > chunk.auditBucketPad(slice)) {
+                            report("entity " + entity.getId() + " is wider than the pad of slice " + slice);
+                        }
+                    }
+                }
+
+                if (found != flat.size()) {
+                    report("slice " + slice + " of chunk " + chunk.locX + "," + chunk.locZ + " holds "
+                            + flat.size() + " entities but its buckets hold " + found);
+                }
+            }
+        }
+    }
