diff --git a/src/test/java/net/minecraft/server/AthenaWorldThreadRecheckTest.java b/src/test/java/net/minecraft/server/AthenaWorldThreadRecheckTest.java
index aafd94c0643bc624f182341ffa32bb321a95bcaf..140b445b8b1bb0c2ad17aaf0309ee0cd99c8fb26 100644
--- a/src/test/java/net/minecraft/server/AthenaWorldThreadRecheckTest.java
+++ b/src/test/java/net/minecraft/server/AthenaWorldThreadRecheckTest.java
@@ -352,4 +352,131 @@ public class AthenaWorldThreadRecheckTest extends org.bukkit.support.AbstractTes
     @org.junit.Test public void unboundedFinishNoBudget() throws Exception { unboundedFinish(0); }
     @org.junit.Test public void unboundedFinishZeroBudget() throws Exception { unboundedFinish(1); }
     @org.junit.Test public void budgetedFinish() throws Exception { unboundedFinish(2); }
+
+    // The follow-up review of 2026-11-06 (audit/2026-11-06/opus-world-thread-review)
+
+    public static final class ChatConnection extends PlayerConnection {
+        AtomicReference<Boolean> owned;
+        CountDownLatch called;
+        private ChatConnection() { super(null, null, null); }
+        @Override public void disconnect(String reason) {
+            owned.set(this.player.getServerForPlayer().isMainThread());
+            called.countDown();
+        }
+    }
+
+    @org.junit.Test public void movedChatKick() throws Exception {
+        Server s = server(); WorldServer a = world(s), b = world(s);
+        EntityPlayer player = allocate(EntityPlayer.class); player.world = a;
+        ChatConnection connection = allocate(ChatConnection.class);
+        connection.player = player; connection.owned = new AtomicReference<>(); connection.called = new CountDownLatch(1);
+        AthenaWorldThread first = new AthenaWorldThread(a), second = new AthenaWorldThread(b);
+        a.athenaThread = first; b.athenaThread = second;
+        CountDownLatch entered = new CountDownLatch(1), release = new CountDownLatch(1);
+        first.post(a, () -> { entered.countDown(); await(release); });
+        first.start(); second.start();
+        AtomicReference<Throwable> failure = new AtomicReference<>();
+        Thread chat = new Thread(() -> {
+            try { connection.processChatMessage(new PacketPlayInChat("\u00a7")); }
+            catch (Throwable t) { failure.set(t); }
+        }, "async-chat");
+        try {
+            await(entered); chat.start();
+            Queue<?> tasks = (Queue<?>) get(first, AthenaWorldThread.class, "tasks");
+            long end = System.nanoTime() + TimeUnit.SECONDS.toNanos(5);
+            while (tasks.isEmpty() && System.nanoTime() < end && failure.get() == null) Thread.onSpinWait();
+            check(!tasks.isEmpty(), "chat was not queued: " + failure.get());
+            player.world = b;
+            release.countDown(); await(connection.called); chat.join(5000);
+            check(failure.get() == null && !chat.isAlive(), "chat failed: " + failure.get());
+            check(Boolean.TRUE.equals(connection.owned.get()), "the kick ran on a thread that does not own the player");
+        } finally {
+            release.countDown(); check(first.stopAndJoin(2000) && second.stopAndJoin(2000), "thread did not stop");
+            a.athenaThread = null; b.athenaThread = null; first.handBack(); second.handBack();
+        }
+    }
+
+    public static final class MapPlayer extends org.bukkit.craftbukkit.entity.CraftPlayer {
+        EntityPlayer handle;
+        private MapPlayer() { super(null, null); }
+        @Override public EntityPlayer getHandle() { return handle; }
+    }
+
+    private static final class PausedCursors extends ArrayList<org.bukkit.map.MapCursor> {
+        Thread sender;
+        final CountDownLatch iterating = new CountDownLatch(1), renderedAgain = new CountDownLatch(1);
+        @Override public java.util.Iterator<org.bukkit.map.MapCursor> iterator() {
+            java.util.Iterator<org.bukkit.map.MapCursor> it = super.iterator();
+            if (Thread.currentThread() == sender) { iterating.countDown(); await(renderedAgain); }
+            return it;
+        }
+    }
+
+    @org.junit.Test public void sendMapBesideARender() throws Exception {
+        Object previousBukkit = get(null, org.bukkit.Bukkit.class, "server");
+        org.bukkit.craftbukkit.CraftServer craft = allocate(org.bukkit.craftbukkit.CraftServer.class);
+        set(craft, org.bukkit.craftbukkit.CraftServer.class, "pluginManager", new org.bukkit.plugin.SimplePluginManager(craft, null));
+        set(null, org.bukkit.Bukkit.class, "server", craft);
+        try {
+            sendMapBesideARender0();
+        } finally {
+            set(null, org.bukkit.Bukkit.class, "server", previousBukkit);
+        }
+    }
+
+    private void sendMapBesideARender0() throws Exception {
+        WorldMap map = new WorldMap("map_0");
+        for (org.bukkit.map.MapRenderer renderer : map.mapView.getRenderers()) map.mapView.removeRenderer(renderer);
+        map.mapView.addRenderer(new org.bukkit.map.MapRenderer(false) {
+            @Override public void render(org.bukkit.map.MapView view, org.bukkit.map.MapCanvas canvas, org.bukkit.entity.Player player) {
+                if (canvas.getCursors().size() == 0) canvas.getCursors().addCursor(0, 0, (byte) 0);
+            }
+        });
+        MapPlayer player = allocate(MapPlayer.class);
+        player.handle = allocate(EntityPlayer.class);
+        final AtomicReference<Object> sent = new AtomicReference<>();
+        player.handle.playerConnection = allocate(SendingConnection.class);
+        ((SendingConnection) player.handle.playerConnection).sent = sent;
+        org.bukkit.craftbukkit.map.RenderData data = map.mapView.render(player);
+        PausedCursors cursors = new PausedCursors(); cursors.addAll(data.cursors);
+        set(data, org.bukkit.craftbukkit.map.RenderData.class, "cursors", cursors);
+        AtomicReference<Throwable> failure = new AtomicReference<>();
+        Thread sender = new Thread(() -> {
+            try { player.sendMap(map.mapView); } catch (Throwable t) { failure.set(t); }
+        }, "map-sender");
+        cursors.sender = sender;
+        sender.start(); await(cursors.iterating);
+        Thread other = new Thread(() -> map.mapView.render(player), "other-world");
+        other.start();
+        other.join(200);
+        check(other.isAlive(), "a render ran while sendMap read the last one");
+        cursors.renderedAgain.countDown();
+        sender.join(5000); other.join(5000);
+        check(failure.get() == null, "sendMap failed: " + failure.get());
+        check(sent.get() != null, "nothing was sent");
+    }
+
+    public static final class SendingConnection extends PlayerConnection {
+        AtomicReference<Object> sent;
+        private SendingConnection() { super(null, null, null); }
+        @Override public void sendPacket(Packet packet) { sent.set(packet); }
+    }
+
+    @org.junit.Test public void statsFileFailure() throws Exception {
+        java.io.File notADirectory = java.io.File.createTempFile("athena", ".stats");
+        notADirectory.deleteOnExit();
+        String previous = AthenaThreadStats.file;
+        AthenaThreadStats.file = new java.io.File(notADirectory, "stats.csv").getPath();
+        try {
+            AthenaThreadStats stats = new AthenaThreadStats();
+            for (int tick = 0; tick < 300; ++tick) {
+                stats.begin(0);
+                stats.mark(AthenaThreadStats.TASKS);
+                stats.end("world", 1, 0);
+            }
+        } finally {
+            AthenaThreadStats.file = previous;
+            set(null, AthenaThreadStats.class, "failed", false);
+        }
+    }
 }
