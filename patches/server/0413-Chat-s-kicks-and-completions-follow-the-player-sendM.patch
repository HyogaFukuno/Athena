From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: glacier <hyouga.dev@gmail.com>
Date: Fri, 6 Nov 2026 18:05:14 +0900
Subject: [PATCH] Chat's kicks and completions follow the player; sendMap holds
 the map; stats failures stop only the stats

Follow-up review of 2026-11-06, R1, R3, R4: every Waitable in PlayerConnection runs for the player, on whichever thread owns it by then; sendMap renders and copies under the map's lock; a stats file that cannot be written is logged and given up.

diff --git a/src/main/java/net/minecraft/server/AthenaThreadStats.java b/src/main/java/net/minecraft/server/AthenaThreadStats.java
index 4fe8014161d71c51517703e220dc5acbc304ab8e..a4612cbece0a61870cde59520b49f67cebad899d 100644
--- a/src/main/java/net/minecraft/server/AthenaThreadStats.java
+++ b/src/main/java/net/minecraft/server/AthenaThreadStats.java
@@ -16,8 +16,11 @@ import java.util.Arrays;
  * the largest of each window.
  */
 final class AthenaThreadStats {
-    static final String FILE = System.getProperty("athena.threadStats");
-    static final boolean ENABLED = FILE != null;
+    private static final org.apache.logging.log4j.Logger LOGGER = org.apache.logging.log4j.LogManager.getLogger();
+    static volatile String file = System.getProperty("athena.threadStats");
+    static final boolean ENABLED = file != null;
+    /** The file could not be written: measuring stops, and the worlds go on. */
+    private static volatile boolean failed;
 
     static final int TASKS = 0, CHUNK_IO = 1, CHUNK_GEN = 2, PRELOAD = 3, WORLDS = 4, CONNECTIONS = 5;
     private static final String[] PHASES = {"tasks", "io", "gen", "preload", "worlds", "conn"};
@@ -77,11 +80,14 @@ final class AthenaThreadStats {
     }
 
     private static synchronized void write(String line) {
+        if (failed) return;
         if (out == null) {
             try {
-                out = new PrintWriter(new FileWriter(FILE));
-            } catch (IOException e) {
-                throw new IllegalStateException(e);
+                out = new PrintWriter(new FileWriter(file));
+            } catch (IOException | RuntimeException e) {
+                failed = true;
+                LOGGER.warn("Not recording world thread stats: cannot write " + file, e);
+                return;
             }
             StringBuilder header = new StringBuilder("millis,worlds,world_count,tasks_queued,ticks,busy_us,cpu_us,max_busy_us,late_us,max_late_us");
             for (String phase : PHASES) header.append(',').append(phase).append("_us,").append(phase).append("_max_us");
@@ -89,6 +95,9 @@ final class AthenaThreadStats {
             out.println(header.append(",longer"));
         }
         out.println(line);
-        out.flush();
+        if (out.checkError()) { // flushes; a PrintWriter does not throw
+            failed = true;
+            LOGGER.warn("Not recording world thread stats any more: writing " + file + " failed");
+        }
     }
 }
