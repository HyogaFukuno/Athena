Subject: [PATCH] Teleport groups of players gradually from the tick loop


diff --git a/src/main/java/net/minecraft/server/AthenaTeleportQueue.java b/src/main/java/net/minecraft/server/AthenaTeleportQueue.java
new file mode 100644
index 0000000000000000000000000000000000000000..16d45cd56f46c998ac098974bee49453c1fb0c28
--- /dev/null
+++ b/src/main/java/net/minecraft/server/AthenaTeleportQueue.java
@@ -0,0 +1,100 @@
+package net.minecraft.server;
+
+import athena.api.AthenaTeleports;
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.List;
+import java.util.concurrent.CompletableFuture;
+import java.util.function.Function;
+import org.apache.logging.log4j.LogManager;
+import org.apache.logging.log4j.Logger;
+import org.bukkit.Location;
+import org.bukkit.entity.Player;
+import org.bukkit.event.player.PlayerTeleportEvent;
+
+// Athena - the server side of athena.api.AthenaTeleports: groups of players teleported a few per
+// tick. Drained once per tick from the tick loop, next to the other hand-back queues, so every
+// teleport happens at the same point of a tick a plugin's scheduled task would run at.
+public final class AthenaTeleportQueue implements AthenaTeleports.Teleporter {
+
+    public static final AthenaTeleportQueue INSTANCE = new AthenaTeleportQueue();
+    private static final Logger LOGGER = LogManager.getLogger();
+
+    private final List<Batch> batches = new ArrayList<Batch>();
+
+    private AthenaTeleportQueue() {}
+
+    private static final class Batch {
+
+        final List<Player> players;
+        final Function<? super Player, ? extends Location> destination;
+        final int perTick;
+        final CompletableFuture<Integer> future = new CompletableFuture<Integer>();
+        int next;
+        int teleported;
+
+        Batch(Collection<? extends Player> players, Function<? super Player, ? extends Location> destination, int perTick) {
+            this.players = new ArrayList<Player>(players);
+            this.destination = destination;
+            this.perTick = perTick;
+        }
+    }
+
+    @Override
+    public CompletableFuture<Integer> teleportGradually(Collection<? extends Player> players, Function<? super Player, ? extends Location> destination, int perTick) {
+        Batch batch = new Batch(players, destination, perTick);
+
+        if (batch.players.isEmpty()) {
+            batch.future.complete(0);
+        } else {
+            this.batches.add(batch);
+        }
+        return batch.future;
+    }
+
+    /** Moves the next players of every pending group. Server thread, once per tick. */
+    public void tick() {
+        if (this.batches.isEmpty()) {
+            return;
+        }
+
+        List<Batch> finished = null;
+
+        // over a copy: a teleport fires events, and a handler may queue another group
+        for (Batch batch : this.batches.toArray(new Batch[0])) {
+
+            for (int moved = 0; moved < batch.perTick && batch.next < batch.players.size(); ++moved) {
+                Player player = batch.players.get(batch.next++);
+
+                try {
+                    if (!player.isOnline()) {
+                        continue;
+                    }
+
+                    Location to = batch.destination.apply(player);
+
+                    if (to != null && player.teleport(to, PlayerTeleportEvent.TeleportCause.PLUGIN)) {
+                        ++batch.teleported;
+                    }
+                } catch (Throwable throwable) {
+                    LOGGER.warn("[Athena] Teleporting " + player.getName() + " failed", throwable);
+                }
+            }
+
+            if (batch.next >= batch.players.size()) {
+                this.batches.remove(batch);
+                if (finished == null) {
+                    finished = new ArrayList<Batch>();
+                }
+                finished.add(batch);
+            }
+        }
+
+        // after the loop: a completion callback may well queue the next group
+        if (finished != null) {
+            for (Batch batch : finished) {
+                batch.future.complete(batch.teleported);
+            }
+        }
+    }
+}
