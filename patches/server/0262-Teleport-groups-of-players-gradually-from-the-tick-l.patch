diff --git a/src/test/java/net/minecraft/server/AthenaTeleportQueueTest.java b/src/test/java/net/minecraft/server/AthenaTeleportQueueTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..799314907341d6b68107d2843ed8324e14558894
--- /dev/null
+++ b/src/test/java/net/minecraft/server/AthenaTeleportQueueTest.java
@@ -0,0 +1,101 @@
+package net.minecraft.server;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import java.lang.reflect.Proxy;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.atomic.AtomicInteger;
+import org.bukkit.Location;
+import org.bukkit.entity.Player;
+import org.junit.Test;
+
+/**
+ * Athena - AthenaTeleportQueue moves a group a few players per tick, in order, skips players who
+ * left or have nowhere to go, and survives groups queued from inside its own callbacks.
+ */
+public class AthenaTeleportQueueTest {
+
+    private final List<String> log = new ArrayList<String>();
+
+    /** A Player that only answers the calls the queue makes. */
+    private Player player(final String name, final boolean online, final Runnable onTeleport) {
+        return (Player) Proxy.newProxyInstance(Player.class.getClassLoader(), new Class<?>[] {Player.class}, (proxy, method, args) -> {
+            switch (method.getName()) {
+                case "isOnline":
+                    return online;
+                case "getName":
+                    return name;
+                case "teleport":
+                    this.log.add(name);
+                    if (onTeleport != null) {
+                        onTeleport.run();
+                    }
+                    return Boolean.TRUE;
+                case "hashCode":
+                    return System.identityHashCode(proxy);
+                case "equals":
+                    return proxy == args[0];
+                default:
+                    throw new UnsupportedOperationException(method.getName());
+            }
+        });
+    }
+
+    private static void drain(int ticks) {
+        for (int i = 0; i < ticks; ++i) {
+            AthenaTeleportQueue.INSTANCE.tick();
+        }
+    }
+
+    @Test
+    public void movesAFewPerTickInOrder() {
+        List<Player> players = new ArrayList<Player>();
+
+        for (int i = 0; i < 11; ++i) {
+            players.add(this.player("p" + i, i != 5, null));
+        }
+
+        CompletableFuture<Integer> done = AthenaTeleportQueue.INSTANCE.teleportGradually(players,
+                p -> p.getName().equals("p7") ? null : new Location(null, 0, 64, 0), 4);
+
+        assertTrue("nothing moves before the next tick", this.log.isEmpty());
+        drain(1);
+        assertEquals(Arrays.asList("p0", "p1", "p2", "p3"), this.log);
+        drain(1);
+        // p5 is offline, p7 has no destination: both use up their turn
+        assertEquals(Arrays.asList("p0", "p1", "p2", "p3", "p4", "p6"), this.log);
+        assertFalse(done.isDone());
+        drain(1);
+        assertEquals(Arrays.asList("p0", "p1", "p2", "p3", "p4", "p6", "p8", "p9", "p10"), this.log);
+        assertTrue(done.isDone());
+        assertEquals(Integer.valueOf(9), done.join());
+    }
+
+    @Test
+    public void callbacksMayQueueMore() {
+        final AtomicInteger second = new AtomicInteger();
+        final Player late = this.player("late", true, null);
+        // a teleport handler queuing another group while the queue is mid-tick
+        Player first = this.player("first", true, () -> AthenaTeleportQueue.INSTANCE.teleportGradually(
+                Arrays.asList(late), p -> new Location(null, 0, 64, 0), 1));
+
+        AthenaTeleportQueue.INSTANCE.teleportGradually(Arrays.asList(first), p -> new Location(null, 0, 64, 0), 1)
+                // and a completion callback queuing one more
+                .thenRun(() -> AthenaTeleportQueue.INSTANCE.teleportGradually(Arrays.asList(this.player("third", true, null)),
+                        p -> new Location(null, 0, 64, 0), 1).thenAccept(second::set));
+
+        drain(3);
+        assertEquals(Arrays.asList("first", "late", "third"), this.log);
+        assertEquals(1, second.get());
+    }
+
+    @Test
+    public void anEmptyGroupIsDoneAtOnce() {
+        assertTrue(AthenaTeleportQueue.INSTANCE.teleportGradually(new ArrayList<Player>(), p -> null, 5).isDone());
+    }
+}
