From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: glacier <hyouga.dev@gmail.com>
Date: Thu, 5 Nov 2026 04:09:28 +0900
Subject: [PATCH] Show the boss bar with an invisible ender dragon, not a
 wither

A wither at half its health or less wears its armour, and the client draws the armour even on an invisible wither: below half, the bar showed a ghostly shape ahead of the player whenever they looked around. An invisible ender dragon draws nothing but its bar.

diff --git a/src/main/java/net/minecraft/server/AthenaBossBar.java b/src/main/java/net/minecraft/server/AthenaBossBar.java
index 600862f1e3f86523548db3e0ffbe354f0758b098..afaab4133590bd94950d393ac58cfc9deb27fe94 100644
--- a/src/main/java/net/minecraft/server/AthenaBossBar.java
+++ b/src/main/java/net/minecraft/server/AthenaBossBar.java
@@ -3,23 +3,27 @@ package net.minecraft.server;
 /**
  * Athena - a boss bar shown to one player (athena.api.Athena.setBossBar). Neither 1.7 nor 1.8 has a
  * boss bar of its own: the client draws one for a boss it is rendering, with the boss's name and
- * health. So this tells only this player about an invisible, silent wither that exists nowhere
+ * health. So this tells only this player about an invisible, silent ender dragon that exists nowhere
  * else (not in the world, not tracked), and keeps it {@value #DISTANCE} blocks ahead of their eyes:
- * 1.8 renders entities by the chunk sections in view, so a wither behind the player or under the
+ * 1.8 renders entities by the chunk sections in view, so a boss behind the player or under the
  * world would drop the bar. It is too far away to be hit, and 1.7 gets it through the usual
- * translation (a wither, with its name).
+ * translation (a dragon, with its name).
+ * <p>
+ * A dragon, not a wither: a wither at half its health or less wears its armour, which the client
+ * draws even on an invisible wither, so a bar below half showed a ghostly shape ahead of the player
+ * whenever they looked around. An invisible dragon draws nothing.
  */
 public final class AthenaBossBar {
-    /** How far ahead of the player's eyes the wither is kept. */
+    /** How far ahead of the player's eyes the dragon is kept. */
     private static final double DISTANCE = 30.0D;
     /** Boss bar names longer than this are cut (the name tag's limit). */
     private static final int MAX_TITLE = 64;
-    /** The wither is moved once it is this far (1 block, in 1/32 blocks, squared) from where the client has it. */
+    /** The dragon is moved once it is this far (1 block, in 1/32 blocks, squared) from where the client has it. */
     private static final long MOVE_THRESHOLD_SQUARED = 32L * 32L;
 
     private final EntityPlayer player;
-    private final EntityWither wither;
-    /** The world the client was told about the wither in; null until then. A new world forgets it. */
+    private final EntityEnderDragon boss;
+    /** The world the client was told about the dragon in; null until then. A new world forgets it. */
     private World spawnedIn;
     private int lastX, lastY, lastZ;
 
@@ -30,19 +34,19 @@ public final class AthenaBossBar {
 
     private AthenaBossBar(EntityPlayer player) {
         this.player = player;
-        this.wither = new EntityWither(player.world);
-        this.wither.setInvisible(true);
-        this.wither.setSilent(true);
+        this.boss = new EntityEnderDragon(player.world);
+        this.boss.setInvisible(true);
+        this.boss.setSilent(true);
     }
 
     /** Shows {@code title} over a bar {@code progress} (0 to 1) full; sent at once. */
     public void set(String title, float progress) {
-        this.wither.setCustomName(title.length() > MAX_TITLE ? title.substring(0, MAX_TITLE) : title);
+        this.boss.setCustomName(title.length() > MAX_TITLE ? title.substring(0, MAX_TITLE) : title);
         // A boss at 0 health plays its death on the client; the emptiest bar is 1 point of health
-        float health = Math.max(0.0F, Math.min(1.0F, progress)) * this.wither.getMaxHealth();
-        this.wither.setHealth(Math.max(1.0F, health));
+        float health = Math.max(0.0F, Math.min(1.0F, progress)) * this.boss.getMaxHealth();
+        this.boss.setHealth(Math.max(1.0F, health));
         if (this.spawnedIn == this.player.world) {
-            this.player.playerConnection.sendPacket(new PacketPlayOutEntityMetadata(this.wither.getId(), this.wither.getDataWatcher(), true));
+            this.player.playerConnection.sendPacket(new PacketPlayOutEntityMetadata(this.boss.getId(), this.boss.getDataWatcher(), true));
         } else {
             this.spawn();
         }
@@ -59,32 +63,32 @@ public final class AthenaBossBar {
         int y = MathHelper.floor(at[1] * 32.0D);
         int z = MathHelper.floor(at[2] * 32.0D);
         // Moved only once it is a block from where the client has it: 30 blocks ahead that is about
-        // 2 degrees of looking around, and the wither stays in view, without a packet every tick
+        // 2 degrees of looking around, and the dragon stays in view, without a packet every tick
         long dx = x - this.lastX, dy = y - this.lastY, dz = z - this.lastZ;
         if (dx * dx + dy * dy + dz * dz >= MOVE_THRESHOLD_SQUARED) {
             this.lastX = x;
             this.lastY = y;
             this.lastZ = z;
-            this.player.playerConnection.sendPacket(new PacketPlayOutEntityTeleport(this.wither.getId(), x, y, z, (byte) 0, (byte) 0, false));
+            this.player.playerConnection.sendPacket(new PacketPlayOutEntityTeleport(this.boss.getId(), x, y, z, (byte) 0, (byte) 0, false));
         }
     }
 
     /** Takes the bar away. */
     public void remove() {
         if (this.spawnedIn != null && this.spawnedIn == this.player.world) {
-            this.player.playerConnection.sendPacket(new PacketPlayOutEntityDestroy(this.wither.getId()));
+            this.player.playerConnection.sendPacket(new PacketPlayOutEntityDestroy(this.boss.getId()));
         }
         this.spawnedIn = null;
     }
 
     private void spawn() {
         double[] at = this.target();
-        this.wither.world = this.player.world;
-        this.wither.setPosition(at[0], at[1], at[2]);
+        this.boss.world = this.player.world;
+        this.boss.setPosition(at[0], at[1], at[2]);
         this.lastX = MathHelper.floor(at[0] * 32.0D);
         this.lastY = MathHelper.floor(at[1] * 32.0D);
         this.lastZ = MathHelper.floor(at[2] * 32.0D);
-        this.player.playerConnection.sendPacket(new PacketPlayOutSpawnEntityLiving(this.wither));
+        this.player.playerConnection.sendPacket(new PacketPlayOutSpawnEntityLiving(this.boss));
         this.spawnedIn = this.player.world;
     }
 
diff --git a/src/main/java/net/minecraft/server/EntityPlayer.java b/src/main/java/net/minecraft/server/EntityPlayer.java
index 3c27e72111e3e2b05115ebf004828ee829c202f0..2311fc322cbd88c3835901c4632bd725f8acff0a 100644
--- a/src/main/java/net/minecraft/server/EntityPlayer.java
+++ b/src/main/java/net/minecraft/server/EntityPlayer.java
@@ -355,7 +355,7 @@ public class EntityPlayer extends EntityHuman implements ICrafting {
 
     public void onUpdate() {
         this.athenaRecordBox(); // Athena
-        if (this.athenaBossBar != null) this.athenaBossBar.tick(); // Athena - keep the boss bar's wither in view
+        if (this.athenaBossBar != null) this.athenaBossBar.tick(); // Athena - keep the boss bar's dragon in view
         // CraftBukkit start
         if (this.joining) {
             this.joining = false;
