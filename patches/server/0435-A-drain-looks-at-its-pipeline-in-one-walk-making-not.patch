+    // The same checks as above in one walk of the contexts, with nothing made: the names list and the
+    // lookups by name cost 4% of the event loop in a live match (VPS-B, 104 players over the network).
+    private boolean athenaCanFrameWalking(io.netty.channel.ChannelPipeline pipeline) {
+        ChannelHandlerContext from;
+        int threshold = -1;
+
+        synchronized (pipeline) { // as names() walks
+            final ChannelHandlerContext end = io.netty.channel.AthenaPipelineWalk.end(pipeline);
+            ChannelHandlerContext at = io.netty.channel.AthenaPipelineWalk.first(pipeline);
+
+            while (at != end && !"prepender".equals(at.name())) {
+                at = io.netty.channel.AthenaPipelineWalk.next(at);
+            }
+            if (at == end || at.handler() != PacketPrepender.INSTANCE) {
+                return false;
+            }
+            from = at;
+            at = io.netty.channel.AthenaPipelineWalk.next(at);
+            if (at != end && "compress".equals(at.name())) {
+                io.netty.channel.ChannelHandler compressor = at.handler();
+
+                if (compressor == null || compressor.getClass() != PacketCompressor.class) {
+                    return false;
+                }
+                threshold = ((PacketCompressor) compressor).getThreshold();
+                if (threshold < 0) {
+                    return false;
+                }
+                at = io.netty.channel.AthenaPipelineWalk.next(at);
+            }
+            if (at == end || !"encoder".equals(at.name())) {
+                return false;
+            }
+
+            io.netty.channel.ChannelHandler encoder = at.handler();
+
+            at = io.netty.channel.AthenaPipelineWalk.next(at);
+            if (at == end || !"packet_handler".equals(at.name())) {
+                return false;
+            }
+            if (encoder == null || encoder.getClass() != PacketEncoder.class || at.handler() != this) {
+                return false;
+            }
+            // behind this handler a write passes nothing that looks at outgoing messages
+            for (at = io.netty.channel.AthenaPipelineWalk.next(at); at != end; at = io.netty.channel.AthenaPipelineWalk.next(at)) {
+                if (at.handler() instanceof io.netty.channel.ChannelOutboundHandler) {
+                    return false;
+                }
+            }
+        }
+        this.athenaFramesFrom = from;
+        this.athenaFramesThreshold = threshold;
+        return true;
+    }
+
