+    @Test
+    public void aHandlerAmongTheServersOwnKeepsSeeingThem() throws Exception {
+        // a plugin's handler put between the encoder and packet_handler, or between the compressor and
+        // the encoder: the walk of the contexts must find it as the list of names did
+        for (String[] place : new String[][] { { "packet_handler", "before" }, { "encoder", "before" }, { "compress", "after" } }) {
+            EmbeddedChannel channel = new EmbeddedChannel();
+            NetworkManager manager = connected(channel, 256);
+            final int[] seen = new int[1];
+            ChannelOutboundHandlerAdapter plugin = new ChannelOutboundHandlerAdapter() {
+                @Override
+                public void write(ChannelHandlerContext ctx, Object msg, ChannelPromise promise) throws Exception {
+                    ++seen[0];
+                    super.write(ctx, msg, promise);
+                }
+            };
+
+            if (place[1].equals("before")) {
+                channel.pipeline().addBefore(place[0], "plugin", plugin);
+            } else {
+                channel.pipeline().addAfter(place[0], "plugin", plugin);
+            }
+
+            long before = NetworkManager.athenaFramed;
+            List<Packet> packets = packets();
+            byte[] wire = drained(channel, manager, packets);
+
+            assertEquals("nothing framed around a handler " + place[1] + " " + place[0], before, NetworkManager.athenaFramed);
+            assertTrue("the plugin's handler saw the writes", seen[0] > 0);
+            assertEquals(packets.size() - 1, frames(wire).size());
+            channel.finishAndReleaseAll();
+        }
+    }
+
+    @Test
+    public void aDrainFramesAgainOnceThePluginsHandlerIsGone() throws Exception {
+        EmbeddedChannel channel = new EmbeddedChannel();
+        NetworkManager manager = connected(channel, 256);
+
+        channel.pipeline().addBefore("packet_handler", "plugin", new ChannelOutboundHandlerAdapter());
+        long before = NetworkManager.athenaFramed;
+        drained(channel, manager, packets());
+        assertEquals(before, NetworkManager.athenaFramed);
+
+        channel.pipeline().remove("plugin");
+        drained(channel, manager, packets());
+        assertTrue("framed again", NetworkManager.athenaFramed - before > 100);
+        channel.finishAndReleaseAll();
+    }
+
