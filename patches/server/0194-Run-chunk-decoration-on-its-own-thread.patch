diff --git a/src/main/java/net/minecraft/server/ChunkDecorationBuffer.java b/src/main/java/net/minecraft/server/ChunkDecorationBuffer.java
index 9eb45f556783beed51190ffef4b3304c5d6fe643..afa1c3bbeab126a920f99a311a7ddbc6bd17aca1 100644
--- a/src/main/java/net/minecraft/server/ChunkDecorationBuffer.java
+++ b/src/main/java/net/minecraft/server/ChunkDecorationBuffer.java
@@ -34,10 +34,11 @@ public class ChunkDecorationBuffer {
     private final Long2ObjectOpenHashMap<Chunk> captured = new Long2ObjectOpenHashMap<Chunk>();
     /** Latest state written at a position, for reads. */
     private final Long2ObjectOpenHashMap<IBlockData> overlay = new Long2ObjectOpenHashMap<IBlockData>();
-    /** Every write, in order, for the replay. */
+    /** Every write, in order, for the replay. A null state marks an update tick rather than a write. */
     private final LongArrayList logPositions = new LongArrayList();
     private final List<IBlockData> logStates = new ArrayList<IBlockData>();
     private final IntArrayList logFlags = new IntArrayList();
+    private final List<Block> logTickBlocks = new ArrayList<Block>();
 
     /** Highest y written in a column, keyed by packed (x, z). Keeps the height lookups off a scan. */
     private final Long2IntOpenHashMap columnTop = new Long2IntOpenHashMap();
@@ -62,6 +63,7 @@ public class ChunkDecorationBuffer {
         this.logPositions.clear();
         this.logStates.clear();
         this.logFlags.clear();
+        this.logTickBlocks.clear();
         this.columnTop.clear();
         this.escaped = false;
     }
@@ -125,9 +127,30 @@ public class ChunkDecorationBuffer {
         this.logPositions.add(blockposition.asLong());
         this.logStates.add(iblockdata);
         this.logFlags.add(flags);
+        this.logTickBlocks.add(null);
         return true;
     }
 
+    /**
+     * Records a forced block update - what WorldGenLiquids does after placing a spring, to make the
+     * liquid start flowing.
+     *
+     * It is recorded rather than run. Running it means driving the liquid's own update logic, which
+     * reaches into the world's scheduled tick list and flips a field on the World itself; none of
+     * that is safe from here. Replayed on the server thread it does the real thing, with real
+     * physics, just after the rest of the chunk's decoration instead of in the middle of it.
+     */
+    public void recordUpdateTick(Block block, BlockPosition blockposition) {
+        if (this.captured.get(ChunkCoordIntPair.chunkXZ2Int(blockposition.getX() >> 4, blockposition.getZ() >> 4)) == null) {
+            return;
+        }
+
+        this.logPositions.add(blockposition.asLong());
+        this.logStates.add(null);
+        this.logFlags.add(0);
+        this.logTickBlocks.add(block);
+    }
+
     /**
      * The height map value, derived instead of maintained. Starts above anything written or already
      * standing in the column and walks down while the block below is transparent - the same loop
@@ -216,7 +239,14 @@ public class ChunkDecorationBuffer {
             long packed = this.logPositions.getLong(i);
 
             position.set(BlockPosition.unpackX(packed), BlockPosition.unpackY(packed), BlockPosition.unpackZ(packed));
-            this.world.setTypeAndData(new BlockPosition(position), this.logStates.get(i), this.logFlags.getInt(i));
+
+            IBlockData iblockdata = this.logStates.get(i);
+
+            if (iblockdata != null) {
+                this.world.setTypeAndData(new BlockPosition(position), iblockdata, this.logFlags.getInt(i));
+            } else {
+                this.world.forceBlockUpdateTick(this.logTickBlocks.get(i), new BlockPosition(position), this.world.random);
+            }
         }
     }
 }
diff --git a/src/main/java/net/minecraft/server/ChunkDecorationExecutor.java b/src/main/java/net/minecraft/server/ChunkDecorationExecutor.java
index b0196e4f83647fc49e7d6d8dbdff5fbfad75d41e..4e1018e34ef9978a51bb97ffad1e8069617e45de 100644
--- a/src/main/java/net/minecraft/server/ChunkDecorationExecutor.java
+++ b/src/main/java/net/minecraft/server/ChunkDecorationExecutor.java
@@ -25,6 +25,7 @@ public final class ChunkDecorationExecutor {
     private static final BlockingQueue<ChunkPopulateJob> pending = new LinkedBlockingQueue<ChunkPopulateJob>();
     private static final Queue<ChunkPopulateJob> finished = new ConcurrentLinkedQueue<ChunkPopulateJob>();
     private static volatile Thread worker;
+    private static final java.util.concurrent.atomic.AtomicBoolean busy = new java.util.concurrent.atomic.AtomicBoolean();
     /** Jobs handed to the worker but not yet drained. Read on the server thread only. */
     private static int inFlight;
 
@@ -56,7 +57,14 @@ public final class ChunkDecorationExecutor {
                 return;
             }
 
-            run(job);
+            ChunkDecorationExecutor.busy.set(true);
+
+            try {
+                run(job);
+            } finally {
+                ChunkDecorationExecutor.busy.set(false);
+            }
+
             ChunkDecorationExecutor.finished.add(job);
         }
     }
@@ -120,8 +128,19 @@ public final class ChunkDecorationExecutor {
         }
     }
 
+    /** Blocks until the decoration thread is between jobs. Only used on the escape path. */
+    private static void waitForIdleWorker() {
+        while (ChunkDecorationExecutor.busy.get()) {
+            Thread.yield();
+        }
+    }
+
     private static void complete(ChunkPopulateJob job) {
         if (job.buffer.hasEscaped()) {
+            // Decoration is single threaded on purpose - BiomeDecorator, WorldGenBigTree and the
+            // flower generator all keep state on the biome singleton while they run. Doing one here
+            // means waiting until the worker is not doing one of its own.
+            waitForIdleWorker();
             // The sandbox could not finish it; do the whole decoration here, against the real world.
             // The abandoned attempt drew from the sequence, so put it back first.
             job.buffer.reset();
