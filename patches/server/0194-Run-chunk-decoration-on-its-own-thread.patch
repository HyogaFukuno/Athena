                 // Athena end
diff --git a/src/main/java/net/minecraft/server/World.java b/src/main/java/net/minecraft/server/World.java
index a8cfffc7b4a478bf519673fc23111e55df6ef137..20093c8122985acbe0a326c5e9ec6bd94ee26cef 100644
--- a/src/main/java/net/minecraft/server/World.java
+++ b/src/main/java/net/minecraft/server/World.java
@@ -2881,6 +2881,12 @@ public abstract class World implements IBlockAccess {
     }
 
     public void forceBlockUpdateTick(Block block, BlockPosition blockposition, Random random) {
+        // Athena - from the decoration thread this is recorded and replayed here later; driving a
+        // liquid's update logic touches the scheduled tick list and the field just below.
+        if (this.decorating()) {
+            this.decorationBuffer.recordUpdateTick(block, blockposition);
+            return;
+        }
         this.scheduledUpdatesAreImmediate = true;
         block.updateTick(this, blockposition, this.getType(blockposition), random);
         this.scheduledUpdatesAreImmediate = false;
