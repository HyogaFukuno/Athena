@@ -387,18 +387,27 @@ public class EntityBoat extends Entity {
 
             // CraftBukkit start
             org.bukkit.Server server = this.world.getServer();
-            org.bukkit.World bworld = this.world.getWorld();
+            // Athena start - the events and their two Locations are made for listeners only: a map's
+            // minecarts and boats, standing where they are, made all of them every tick for nobody
+            final double toX = this.locX, toY = this.locY, toZ = this.locZ; // where it is before a listener of the first event moves it
+            final float toYaw = this.yaw, toPitch = this.pitch;
 
-            Location from = new Location(bworld, prevX, prevY, prevZ, prevYaw, prevPitch);
-            Location to = new Location(bworld, this.locX, this.locY, this.locZ, this.yaw, this.pitch);
-            Vehicle vehicle = (Vehicle) this.getBukkitEntity();
+            if (org.bukkit.event.vehicle.VehicleUpdateEvent.getHandlerList().getRegisteredListeners().length != 0) {
+                server.getPluginManager().callEvent(new org.bukkit.event.vehicle.VehicleUpdateEvent((Vehicle) this.getBukkitEntity()));
+            }
 
-            server.getPluginManager().callEvent(new org.bukkit.event.vehicle.VehicleUpdateEvent(vehicle));
+            // what Location.equals compares, on the values themselves
+            if (VehicleMoveEvent.getHandlerList().getRegisteredListeners().length != 0
+                    && (Double.doubleToLongBits(prevX) != Double.doubleToLongBits(toX) || Double.doubleToLongBits(prevY) != Double.doubleToLongBits(toY)
+                    || Double.doubleToLongBits(prevZ) != Double.doubleToLongBits(toZ) || Float.floatToIntBits(prevYaw) != Float.floatToIntBits(toYaw)
+                    || Float.floatToIntBits(prevPitch) != Float.floatToIntBits(toPitch))) {
+                org.bukkit.World bworld = this.world.getWorld();
+                Location from = new Location(bworld, prevX, prevY, prevZ, prevYaw, prevPitch);
+                Location to = new Location(bworld, toX, toY, toZ, toYaw, toPitch);
 
-            if (!from.equals(to)) {
-                VehicleMoveEvent event = new VehicleMoveEvent(vehicle, from, to);
-                server.getPluginManager().callEvent(event);
+                server.getPluginManager().callEvent(new VehicleMoveEvent((Vehicle) this.getBukkitEntity(), from, to));
             }
+            // Athena end
             // CraftBukkit end
             if (!this.world.isClientSide) {
                 List list = this.world.getEntities(this, Math.min(this.boundingBoxMinX - 0.20000000298023224D, this.boundingBoxMaxX + 0.20000000298023224D), Math.min(this.boundingBoxMinY - 0.0D, this.boundingBoxMaxY + 0.0D), Math.min(this.boundingBoxMinZ - 0.20000000298023224D, this.boundingBoxMaxZ + 0.20000000298023224D), Math.max(this.boundingBoxMinX - 0.20000000298023224D, this.boundingBoxMaxX + 0.20000000298023224D), Math.max(this.boundingBoxMinY - 0.0D, this.boundingBoxMaxY + 0.0D), Math.max(this.boundingBoxMinZ - 0.20000000298023224D, this.boundingBoxMaxZ + 0.20000000298023224D));
