+++ b/src/main/java/net/minecraft/server/WorldGenBase.java
@@ -32,4 +32,25 @@ public class WorldGenBase {
     }
 
     protected void recursiveGenerate(World world, int i, int j, int k, int l, ChunkSnapshot chunksnapshot) {}
+
+    // Athena start - a biome source a worker is allowed to use.
+    //
+    // World.getBiome asks the chunk map whether the position is loaded and then reads the world's
+    // shared BiomeCache. Neither survives being touched from a shaping worker: the chunk map is a
+    // plain hash map the server thread is mutating, and BiomeCache is a bare LongHashMap.
+    //
+    // A shaping copy of the generator hands its own manager down to here. The answer is the same
+    // one the world would give, because every position asked about lies inside the chunk being
+    // carved, which is not in the chunk map yet - so the world's own lookup falls through to its
+    // WorldChunkManager too, and that manager was built from the same seed.
+    protected WorldChunkManager shapingChunkManager;
+
+    public void setShapingChunkManager(WorldChunkManager worldchunkmanager) {
+        this.shapingChunkManager = worldchunkmanager;
+    }
+
+    protected BiomeBase shapingBiome(BlockPosition blockposition) {
+        return this.shapingChunkManager != null ? this.shapingChunkManager.getBiome(blockposition, BiomeBase.PLAINS) : this.worldObj.getBiome(blockposition);
+    }
+    // Athena end
 }
