diff --git a/src/main/java/net/minecraft/server/ChunkProviderServer.java b/src/main/java/net/minecraft/server/ChunkProviderServer.java
index 82bd492e1abbfa3d07b6110c5aa8fe2f28033e99..b6965f1a1b1b09e68c8fc72c2cf4a6a0a5c6b254 100644
--- a/src/main/java/net/minecraft/server/ChunkProviderServer.java
+++ b/src/main/java/net/minecraft/server/ChunkProviderServer.java
@@ -15,6 +15,8 @@ import java.util.logging.Level;
 import org.bukkit.Bukkit;
 import org.bukkit.Server;
 import org.bukkit.craftbukkit.chunkio.ChunkIOExecutor;
+import org.bukkit.craftbukkit.chunkgen.ChunkGenExecutor; // Athena
+import java.util.concurrent.ConcurrentLinkedQueue; // Athena
 import org.bukkit.craftbukkit.util.LongHash;
 import org.bukkit.craftbukkit.util.LongHashSet;
 import org.bukkit.craftbukkit.util.LongObjectHashMap;
@@ -141,6 +143,127 @@ public class ChunkProviderServer implements IChunkProvider {
     }
     // Athena end
 
+    // Athena start - shaping brand new chunks off the server thread.
+    //
+    // Only the first half of generation moves: ChunkProviderGenerate.shapeChunk, which reads nothing
+    // from the World and writes only into a snapshot nobody can see yet. Everything with a side
+    // effect - structure starts, the chunk map, ChunkLoadEvent, population - still happens here, in
+    // the order it always did.
+    //
+    // The route in is the callback form of getChunkAt, which has been allowed to answer later ever
+    // since chunk loading went async; callers that need a chunk immediately still get one, shaped
+    // inline or by waiting on a worker that has already started it.
+    //
+    // Each thread that shapes gets its own copy of the generator, because its scratch fields cannot
+    // be entered twice at once.
+    private final ThreadLocal<ChunkProviderGenerate> shapingCopies = new ThreadLocal<ChunkProviderGenerate>();
+    private final ConcurrentLinkedQueue<ChunkProviderGenerate> spareShapingCopies = new ConcurrentLinkedQueue<ChunkProviderGenerate>();
+    private Boolean asyncShaping; // decided once, on the server thread
+
+    private boolean asyncShapingEnabled() {
+        if (this.asyncShaping == null) {
+            boolean enabled = this.world.pandaSpigotConfig.asyncChunkShaping
+                    && this.chunkProvider instanceof ChunkProviderGenerate
+                    && this.world.generator == null // a plugin generator keeps generating on the server thread
+                    && this.world.getWorldChunkManager().getClass() == WorldChunkManager.class;
+
+            if (enabled) {
+                // Built here, on the server thread, so that a worker never has to touch the world.
+                for (int i = 0; i < 3; ++i) {
+                    this.spareShapingCopies.add(((ChunkProviderGenerate) this.chunkProvider).createShapingCopy());
+                }
+            }
+
+            this.asyncShaping = enabled;
+        }
+
+        return this.asyncShaping;
+    }
+
+    /** Runs the pure half of generation on whichever thread calls this, using that thread's copy. */
+    public ChunkShape shapeChunkForWorker(int i, int j) {
+        ChunkProviderGenerate generator = this.shapingCopies.get();
+
+        if (generator == null) {
+            generator = this.spareShapingCopies.poll();
+            if (generator == null) {
+                generator = ((ChunkProviderGenerate) this.chunkProvider).createShapingCopy();
+            }
+
+            this.shapingCopies.set(generator);
+        }
+
+        return generator.shapeChunk(i, j);
+    }
+
+    /**
+     * The server-thread half, for a chunk whose shape a worker has finished. Everything below the
+     * first two guards is what originalGetChunkAt does once it has a Chunk.
+     */
+    public Chunk finishGeneratedChunk(int i, int j, ChunkShape chunkshape) {
+        long key = LongHash.toLong(i, j);
+
+        this.unloadQueue.remove(i, j);
+
+        Chunk chunk = this.chunks.get(key);
+
+        if (chunk != null) {
+            return chunk; // something needed it before the worker came back and generated it inline
+        }
+
+        this.world.timings.syncChunkLoadTimer.startTiming(); // Spigot
+        chunk = this.loadChunk(i, j); // the loader still wins if the chunk reached disk meanwhile
+        boolean newChunk = false;
+
+        if (chunk == null) {
+            try {
+                chunk = ((ChunkProviderGenerate) this.chunkProvider).finishChunk(i, j, chunkshape);
+            } catch (Throwable throwable) {
+                CrashReport crashreport = CrashReport.makeCrashReport(throwable, "Exception generating new chunk");
+                CrashReportSystemDetails crashreportsystemdetails = crashreport.makeCategory("Chunk to be generated");
+
+                crashreportsystemdetails.addCrashSection("Location", (Object) String.format("%d,%d", new Object[] { Integer.valueOf(i), Integer.valueOf(j)}));
+                crashreportsystemdetails.addCrashSection("Position hash", (Object) Long.valueOf(key));
+                crashreportsystemdetails.addCrashSection("Generator", (Object) this.chunkProvider.getName());
+                throw new ReportedException(crashreport);
+            }
+
+            newChunk = true;
+        }
+
+        this.chunks.put(key, chunk);
+        this.creatureCensus.chunkAdded(chunk);
+
+        chunk.addEntities();
+
+        Server server = this.world.getServer();
+
+        if (server != null) {
+            server.getPluginManager().callEvent(new org.bukkit.event.world.ChunkLoadEvent(chunk.bukkitChunk, newChunk));
+        }
+
+        // Update neighbor counts
+        for (int x = -2; x < 3; x++) {
+            for (int z = -2; z < 3; z++) {
+                if (x == 0 && z == 0) {
+                    continue;
+                }
+
+                Chunk neighbor = this.getChunkIfLoaded(chunk.locX + x, chunk.locZ + z);
+                if (neighbor != null) {
+                    neighbor.setNeighborLoaded(-x, -z);
+                    chunk.setNeighborLoaded(x, z);
+                }
+            }
+        }
+
+        chunk.loadNearby(this, this, i, j);
+        this.world.timings.syncChunkLoadTimer.stopTiming(); // Spigot
+
+        return chunk;
+    }
+    // Athena end
+
     public Chunk getChunkIfLoaded(int x, int z) {
         return chunks.get(LongHash.toLong(x, z));
     }
@@ -167,6 +290,26 @@ public class ChunkProviderServer implements IChunkProvider {
                 chunk = ChunkIOExecutor.syncChunkLoad(world, loader, this, i, j);
             }
         } else if (chunk == null) {
+            // Athena start - route brand new chunks through the shaping queue
+            if (this.asyncShapingEnabled()) {
+                if (runnable != null) {
+                    // This caller gave us a callback, so it has already agreed to be answered later.
+                    ChunkGenExecutor.queueChunkGen(this.world, this, i, j, runnable);
+                    return null;
+                }
+
+                // This one needs the chunk now - population of a neighbour, an entity moving, a
+                // block read. Going through the queue anyway means joining a worker that has
+                // already started this chunk rather than shaping it a second time; with no task
+                // queued it simply does both halves here, exactly as the line below would.
+                ChunkGenExecutor.syncChunkGen(this.world, this, i, j);
+                chunk = this.chunks.get(LongHash.toLong(i, j));
+
+                if (chunk != null) {
+                    return chunk;
+                }
+            }
+            // Athena end
             chunk = originalGetChunkAt(i, j);
         }
 
