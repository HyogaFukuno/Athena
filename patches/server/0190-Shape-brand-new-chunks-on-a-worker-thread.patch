diff --git a/src/main/java/org/bukkit/craftbukkit/chunkgen/ChunkGenExecutor.java b/src/main/java/org/bukkit/craftbukkit/chunkgen/ChunkGenExecutor.java
new file mode 100644
index 0000000000000000000000000000000000000000..72ae1660bcb7c38edf41c4864b71a56ca05471fa
--- /dev/null
+++ b/src/main/java/org/bukkit/craftbukkit/chunkgen/ChunkGenExecutor.java
@@ -0,0 +1,45 @@
+package org.bukkit.craftbukkit.chunkgen;
+
+import net.minecraft.server.ChunkProviderServer;
+import net.minecraft.server.ChunkShape;
+import net.minecraft.server.World;
+import org.bukkit.craftbukkit.util.AsynchronousExecutor;
+
+// Athena start - the queue that shapes new chunks off the server thread.
+//
+// Deliberately the same shape as ChunkIOExecutor, which has been deferring chunk *loads* this way
+// for years: callers that passed a Runnable already accept being answered later, so generation can
+// use the same contract without any of them noticing.
+public class ChunkGenExecutor {
+
+    private static final int BASE_THREADS = 2;
+
+    private static final AsynchronousExecutor<QueuedGen, ChunkShape, Runnable, RuntimeException> instance =
+            new AsynchronousExecutor<QueuedGen, ChunkShape, Runnable, RuntimeException>(new ChunkGenProvider(), BASE_THREADS);
+
+    public static void queueChunkGen(World world, ChunkProviderServer provider, int x, int z, Runnable runnable) {
+        instance.add(new QueuedGen(x, z, world, provider), runnable);
+    }
+
+    /**
+     * Shapes and finishes the chunk now, waiting on the worker if it has already started.
+     * For callers that cannot be answered later.
+     */
+    public static void syncChunkGen(World world, ChunkProviderServer provider, int x, int z) {
+        instance.getSkipQueue(new QueuedGen(x, z, world, provider));
+    }
+
+    /** Mirrors ChunkIOExecutor.dropQueuedChunkLoad; only world and coordinates are compared. */
+    public static void dropQueuedChunkGen(World world, int x, int z, Runnable runnable) {
+        instance.drop(new QueuedGen(x, z, world, null), runnable);
+    }
+
+    public static void tick() {
+        instance.finishActive();
+    }
+
+    public static void adjustPoolSize(int players) {
+        instance.setActiveThreads(Math.max(BASE_THREADS, Math.min(4, players / 25)));
+    }
+}
+// Athena end
diff --git a/src/main/java/org/bukkit/craftbukkit/chunkgen/ChunkGenProvider.java b/src/main/java/org/bukkit/craftbukkit/chunkgen/ChunkGenProvider.java
new file mode 100644
index 0000000000000000000000000000000000000000..a5965ecc7ea939719814ece906aa54d796278d7a
--- /dev/null
+++ b/src/main/java/org/bukkit/craftbukkit/chunkgen/ChunkGenProvider.java
@@ -0,0 +1,43 @@
+package org.bukkit.craftbukkit.chunkgen;
+
+import java.util.concurrent.atomic.AtomicInteger;
+import net.minecraft.server.ChunkShape;
+import org.bukkit.craftbukkit.util.AsynchronousExecutor;
+
+// Athena start - the two halves of generating a brand new chunk, split across threads.
+//
+// Stage 1 is ChunkProviderGenerate.shapeChunk on a copy of the world's generator: noise, biomes,
+// surface, caves, ravines, all into a snapshot nothing else can see. Stage 2 is everything that has
+// to stay on the server thread - structure starts, building the Chunk, lighting, the chunk map,
+// ChunkLoadEvent, and population through loadNearby.
+//
+// Stage 1 also runs on the server thread when AsynchronousExecutor.getSkipQueue is used, which is
+// what happens when someone needs the chunk before the worker has finished. The shaping copies are
+// handed out per thread, so that path is safe too.
+class ChunkGenProvider implements AsynchronousExecutor.CallBackProvider<QueuedGen, ChunkShape, Runnable, RuntimeException> {
+
+    private final AtomicInteger threadNumber = new AtomicInteger(1);
+
+    // async
+    public ChunkShape callStage1(QueuedGen queuedGen) throws RuntimeException {
+        return queuedGen.provider.shapeChunkForWorker(queuedGen.x, queuedGen.z);
+    }
+
+    // sync
+    public void callStage2(QueuedGen queuedGen, ChunkShape chunkShape) throws RuntimeException {
+        queuedGen.provider.finishGeneratedChunk(queuedGen.x, queuedGen.z, chunkShape);
+    }
+
+    public void callStage3(QueuedGen queuedGen, ChunkShape chunkShape, Runnable runnable) throws RuntimeException {
+        runnable.run();
+    }
+
+    public Thread newThread(Runnable runnable) {
+        Thread thread = new Thread(runnable, "Chunk Shaping Thread-" + this.threadNumber.getAndIncrement());
+
+        thread.setDaemon(true);
+        thread.setPriority(Thread.NORM_PRIORITY - 1); // the server thread must never wait behind these
+        return thread;
+    }
+}
+// Athena end
diff --git a/src/main/java/org/bukkit/craftbukkit/chunkgen/QueuedGen.java b/src/main/java/org/bukkit/craftbukkit/chunkgen/QueuedGen.java
new file mode 100644
index 0000000000000000000000000000000000000000..064ee37434cfa68c679d19a3d868ffe47fb667c5
--- /dev/null
+++ b/src/main/java/org/bukkit/craftbukkit/chunkgen/QueuedGen.java
@@ -0,0 +1,50 @@
+package org.bukkit.craftbukkit.chunkgen;
+
+import net.minecraft.server.ChunkProviderServer;
+import net.minecraft.server.World;
+
+// Athena start - the parameter identifying one chunk waiting to be shaped.
+//
+// hashCode and equals cover only the world and the coordinates, because AsynchronousExecutor keys
+// its task map on this object: a second request for the same chunk has to find the task already
+// queued rather than start a second one.
+class QueuedGen {
+
+    final int x;
+    final int z;
+    final World world;
+    final ChunkProviderServer provider;
+
+    QueuedGen(int x, int z, World world, ChunkProviderServer provider) {
+        this.x = x;
+        this.z = z;
+        this.world = world;
+        this.provider = provider;
+    }
+
+    @Override
+    public int hashCode() {
+        return (this.world.hashCode() * 31 + this.x) * 31 + this.z;
+    }
+
+    @Override
+    public boolean equals(Object object) {
+        if (this == object) {
+            return true;
+        }
+
+        if (!(object instanceof QueuedGen)) {
+            return false;
+        }
+
+        QueuedGen other = (QueuedGen) object;
+
+        return this.x == other.x && this.z == other.z && this.world == other.world;
+    }
+
+    @Override
+    public String toString() {
+        return "QueuedGen{" + this.x + ", " + this.z + " in " + this.world.getWorld().getName() + "}";
+    }
+}
+// Athena end
