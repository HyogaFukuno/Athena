+                            for (l1 = -b0; l1 <= b0; ++l1) {
+                                Block block = world.getTypeIfLoaded(x, k + l1, z, chunk).getBlock(); // PandaSpigot - Use getTypeIfLoaded // Athena - chunk resolved above
+                    // Athena end
 
                                 if (block != Blocks.LOG && block != Blocks.LOG2) {
                                     if (block.getMaterial() == Material.LEAVES) {
