diff --git a/src/test/java/net/minecraft/server/BlockLeavesScanOrderTest.java b/src/test/java/net/minecraft/server/BlockLeavesScanOrderTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..3d252c98ed486bfacd2e697c21204f93510771ce
--- /dev/null
+++ b/src/test/java/net/minecraft/server/BlockLeavesScanOrderTest.java
@@ -0,0 +1,97 @@
+package net.minecraft.server;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertTrue;
+
+import java.util.HashSet;
+import java.util.Set;
+import org.junit.Test;
+
+/**
+ * Athena - BlockLeaves.updateTick now walks its 9x9x9 scan z before y, so that the chunk stays the
+ * same for a whole inner run and can be resolved once instead of once per block.
+ *
+ * <p>That is only safe because the scan writes a distinct cell of {@code surroundings} for every
+ * (k1, l1, i2) and never reads one back, which makes the visit order unobservable. The index
+ * formula is duplicated here and checked to be injective over the whole cube - if it ever stops
+ * being, the reordering silently starts producing a different decay map.
+ */
+public class BlockLeavesScanOrderTest {
+
+    private static final int B0 = 4;    // scan radius
+    private static final int B1 = 32;   // side of the surroundings cube
+    private static final int I1 = B1 * B1;
+    private static final int J1 = B1 / 2;
+
+    private static int index(int k1, int l1, int i2) {
+        return (k1 + J1) * I1 + (l1 + J1) * B1 + i2 + J1;
+    }
+
+    @Test
+    public void everyScannedCellHasItsOwnIndex() {
+        Set<Integer> seen = new HashSet<Integer>();
+        int count = 0;
+
+        for (int k1 = -B0; k1 <= B0; ++k1) {
+            for (int l1 = -B0; l1 <= B0; ++l1) {
+                for (int i2 = -B0; i2 <= B0; ++i2) {
+                    int index = index(k1, l1, i2);
+
+                    assertTrue("index " + index + " written twice, at " + k1 + "," + l1 + "," + i2,
+                            seen.add(index));
+                    assertTrue("index " + index + " is outside the surroundings array",
+                            index >= 0 && index < B1 * B1 * B1);
+                    ++count;
+                }
+            }
+        }
+
+        assertEquals(9 * 9 * 9, count);
+    }
+
+    @Test
+    public void reorderingTheScanVisitsTheSameCells() {
+        // The order the production loop now uses: x, then z, then y.
+        Set<Integer> reordered = new HashSet<Integer>();
+
+        for (int k1 = -B0; k1 <= B0; ++k1) {
+            for (int i2 = -B0; i2 <= B0; ++i2) {
+                for (int l1 = -B0; l1 <= B0; ++l1) {
+                    reordered.add(index(k1, l1, i2));
+                }
+            }
+        }
+
+        Set<Integer> original = new HashSet<Integer>();
+
+        for (int k1 = -B0; k1 <= B0; ++k1) {
+            for (int l1 = -B0; l1 <= B0; ++l1) {
+                for (int i2 = -B0; i2 <= B0; ++i2) {
+                    original.add(index(k1, l1, i2));
+                }
+            }
+        }
+
+        assertEquals(original, reordered);
+    }
+
+    @Test
+    public void theScannedCubeStaysInsideFourChunks() {
+        // What lets the chunk be resolved once per inner run: the cube spans at most two chunk
+        // columns on each axis, whatever block it is centred on.
+        for (int cx = -40; cx <= 40; ++cx) {
+            for (int cz = -40; cz <= 40; ++cz) {
+                Set<Long> chunks = new HashSet<Long>();
+
+                for (int k1 = -B0; k1 <= B0; ++k1) {
+                    for (int i2 = -B0; i2 <= B0; ++i2) {
+                        chunks.add((long) ((cx + k1) >> 4) << 32 | (long) ((cz + i2) >> 4) & 0xffffffffL);
+                    }
+                }
+
+                assertTrue("centre " + cx + "," + cz + " touched " + chunks.size() + " chunks",
+                        chunks.size() <= 4);
+            }
+        }
+    }
+}
