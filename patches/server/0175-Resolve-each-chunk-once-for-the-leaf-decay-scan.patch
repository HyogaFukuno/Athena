+    // those reads. The cube spans at most four chunks, so the caller resolves each one once.
+    //
+    // This is getTypeIfLoaded's body with the chunk lookup lifted out, and has to stay in step
+    // with it.
+    public IBlockData getTypeIfLoaded(int x, int y, int z, Chunk chunk) {
