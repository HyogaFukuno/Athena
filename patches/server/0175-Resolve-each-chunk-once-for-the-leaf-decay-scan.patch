+++ b/src/main/java/net/minecraft/server/BlockLeaves.java
@@ -60,17 +60,36 @@ public abstract class BlockLeaves extends BlockTransparent {
                     this.surroundings = new int[b1 * b1 * b1];
                 }
 
-                if (world.areChunksLoadedBetween(new BlockPosition(j - i, k - i, l - i), new BlockPosition(j + i, k + i, l + i))) {
-                    BlockPosition.MutableBlockPosition blockposition_mutableblockposition = new BlockPosition.MutableBlockPosition();
-
+                if (world.isAreaLoaded(j - i, k - i, l - i, j + i, k + i, l + i, true)) { // Athena - scalar; this built two positions per decay check
                     int k1;
                     int l1;
                     int i2;
+                    // Athena start - resolve each chunk once instead of once per block.
+                    //
+                    // The scan below reads 729 blocks spanning at most four chunks, and every read
+                    // used to hash the chunk coordinates again. Walking z before y makes the chunk
+                    // constant for a whole inner run, so the cube costs on the order of twenty
+                    // lookups instead of 729. The scan writes a distinct cell of surroundings for
+                    // every (k1, l1, i2), so the order it visits them in is not observable.
+                    Chunk chunk = null;
+                    int chunkX = Integer.MIN_VALUE;
+                    int chunkZ = Integer.MIN_VALUE;
 
                     for (k1 = -b0; k1 <= b0; ++k1) {
-                        for (l1 = -b0; l1 <= b0; ++l1) {
-                            for (i2 = -b0; i2 <= b0; ++i2) {
-                                Block block = world.getTypeIfLoaded(blockposition_mutableblockposition.set(j + k1, k + l1, l + i2)).getBlock(); // PandaSpigot - Use getTypeIfLoaded
+                        int x = j + k1;
+
+                        for (i2 = -b0; i2 <= b0; ++i2) {
+                            int z = l + i2;
+
+                            if (x >> 4 != chunkX || z >> 4 != chunkZ) {
+                                chunkX = x >> 4;
+                                chunkZ = z >> 4;
+                                chunk = world.getChunkIfLoaded(chunkX, chunkZ);
+                            }
