     }
+
+    // ------------------------------------------------------------------ slim NBT
+
+    /** A chunk with everything a template chunk carries besides its sections. */
+    private static NBTTagCompound fullChunk(int x, int z, Random random, boolean missingSkyLight) {
+        NBTTagCompound root = chunk(x, z, random);
+        NBTTagCompound level = root.getCompound("Level");
+        int[] heights = new int[256];
+        byte[] biomes = new byte[256];
+
+        for (int i = 0; i < 256; ++i) {
+            heights[i] = random.nextInt(64);
+        }
+        random.nextBytes(biomes);
+        level.setIntArray("HeightMap", heights);
+        level.setByteArray("Biomes", biomes);
+        level.setBoolean("TerrainPopulated", true);
+        level.setBoolean("LightPopulated", true);
+        level.setLong("InhabitedTime", random.nextInt(100000));
+
+        NBTTagCompound sign = new NBTTagCompound();
+
+        sign.setString("id", "Sign");
+        sign.setInt("x", x * 16 + 3);
+        sign.setInt("y", 20);
+        sign.setInt("z", z * 16 + 4);
+        sign.setString("Text1", "{\"text\":\"chunk " + x + "," + z + "\"}");
+
+        NBTTagList tileEntities = new NBTTagList();
+
+        tileEntities.add(sign);
+        level.set("TileEntities", tileEntities);
+
+        NBTTagCompound item = new NBTTagCompound();
+
+        item.setString("id", "Item");
+        item.set("Pos", new NBTTagList());
+        level.set("Entities", new NBTTagList());
+        level.getList("Entities", 10).add(item);
+
+        NBTTagCompound tick = new NBTTagCompound();
+
+        tick.setString("i", "minecraft:water");
+        tick.setInt("x", x * 16);
+        tick.setInt("y", 10);
+        tick.setInt("z", z * 16);
+        tick.setInt("t", 5);
+        tick.setInt("p", 0);
+
+        NBTTagList ticks = new NBTTagList();
+
+        ticks.add(tick);
+        level.set("TileTicks", ticks);
+        if (missingSkyLight) {
+            level.getList("Sections", 10).get(1).remove("SkyLight");
+        }
+        return root;
+    }
+
+    /** The full NBT with each section cut down to its Y: what the slim NBT must equal. */
+    private static NBTTagCompound slimmed(NBTTagCompound full) {
+        NBTTagCompound copy = (NBTTagCompound) full.clone();
+        NBTTagList sections = copy.getCompound("Level").getList("Sections", 10);
+        NBTTagList ys = new NBTTagList();
+
+        for (int k = 0; k < sections.size(); ++k) {
+            NBTTagCompound y = new NBTTagCompound();
+
+            y.setByte("Y", sections.get(k).getByte("Y"));
+            ys.add(y);
+        }
+        copy.getCompound("Level").set("Sections", ys);
+        return copy;
+    }
+
+    private static File fullTemplate(long seed) throws Exception {
+        File dir = Files.createTempDirectory("athena-slim").toFile();
+        File regionDir = new File(dir, "region");
+
+        regionDir.mkdirs();
+        RegionFile region = new RegionFile(new File(regionDir, "r.-1.0.mca"));
+        Random random = new Random(seed);
+
+        for (int x = 0; x < 32; x += 7) {
+            for (int z = 0; z < 32; z += 9) {
+                try (DataOutputStream out = region.getChunkDataOutputStream(x, z)) {
+                    NBTCompressedStreamTools.write(fullChunk(-32 + x, z, random, x == 14), (java.io.DataOutput) out);
+                }
+            }
+        }
+        region.close();
+        return dir;
+    }
+
+    @Test
+    public void aVersionOneStoreIsLeftForTheServersStillReadingIt() throws Exception {
+        File dir = template(7L);
+        File old = new File(dir, String.format("athena-sections-%016x.bin", AthenaSectionStore.fingerprint(dir)));
+
+        assertTrue(old.createNewFile());
+        built(dir);
+        assertTrue("a version 1 server's file is not taken for a leftover", old.isFile());
+        assertTrue(AthenaSectionStore.file(dir, AthenaSectionStore.fingerprint(dir)).getName().startsWith("athena-sections2-"));
+    }
+
+    @Test
+    public void aSlimChunkIsTheRegionChunkWithoutItsSectionArrays() throws Exception {
+        File dir = fullTemplate(5L);
+        AthenaSectionStore store = built(dir);
+        AthenaTemplateRegion region = AthenaTemplateRegion.open(new File(dir, "region/r.-1.0.mca"));
+        int slim = 0;
+
+        for (int x = 0; x < 32; x += 7) {
+            for (int z = 0; z < 32; z += 9) {
+                NBTTagCompound full = region.read(x, z);
+                NBTTagCompound fromStore = store.chunk(-32 + x, z);
+
+                if (x == 14) {
+                    // one section has no sky light: the store cannot give a sky world all of it
+                    assertNull("a chunk the store does not hold whole loads from the region", fromStore);
+                    continue;
+                }
+                assertNotNull(fromStore);
+                assertEquals((-32 + x) + "," + z, slimmed(full), fromStore);
+                ++slim;
+
+                // and every section it lists is in the store, for a world with sky and without
+                NBTTagList sections = fromStore.getCompound("Level").getList("Sections", 10);
+
+                for (int k = 0; k < sections.size(); ++k) {
+                    int y = sections.get(k).getByte("Y");
+
+                    assertTrue(store.apply(-32 + x, z, y, new ChunkSection(y << 4, true), true));
+                    assertTrue(store.apply(-32 + x, z, y, new ChunkSection(y << 4, false), false));
+                }
+            }
+        }
+        region.close();
+        assertTrue(slim > 0);
+        assertNull("no chunk there", store.chunk(5, 5));
+    }
 }
