diff --git a/src/main/java/net/minecraft/server/ChunkDecorationBuffer.java b/src/main/java/net/minecraft/server/ChunkDecorationBuffer.java
new file mode 100644
index 0000000000000000000000000000000000000000..9eb45f556783beed51190ffef4b3304c5d6fe643
--- /dev/null
+++ b/src/main/java/net/minecraft/server/ChunkDecorationBuffer.java
@@ -0,0 +1,223 @@
+package net.minecraft.server;
+
+import it.unimi.dsi.fastutil.longs.Long2ObjectOpenHashMap;
+import it.unimi.dsi.fastutil.longs.LongArrayList;
+import it.unimi.dsi.fastutil.ints.IntArrayList;
+import it.unimi.dsi.fastutil.longs.Long2IntOpenHashMap;
+import java.util.ArrayList;
+import java.util.List;
+
+// Athena start - the sandbox a chunk's decoration runs in while it is off the server thread.
+//
+// Decoration - ores, trees, plants, the things BiomeBase.decorate places - is three quarters of
+// what populating a chunk costs, and unlike the rest of population it touches no entities and no
+// tile entities. That makes it the one part that can be lifted out whole.
+//
+// It still reads and writes the World, so those calls are redirected here for the decorating
+// thread. Reads come from the overlay first and the live chunk underneath it; writes go into the
+// overlay and into an ordered log, which the server thread later replays through the real
+// setTypeAndData so that lighting, client updates and everything else happen exactly where they
+// always did.
+//
+// Two things are deliberately recomputed rather than mirrored. The height map and the
+// precipitation height are maintained incrementally by Chunk as blocks are set; here they are
+// derived on demand from the overlay plus the chunk below it, which lands on the same answer
+// because the vanilla map is always exact - it is only ever updated in the cases that can change
+// it. Doing it this way avoids running Chunk.setBlockState off-thread, which would call back into
+// the World through onPlace, tile entity creation and skylight propagation.
+//
+// Anything this class cannot model exactly sets `escaped`. The job is then thrown away and the
+// server thread decorates inline, so an unmodelled call costs time and never correctness.
+public class ChunkDecorationBuffer {
+
+    /** Chunks this buffer may read. Captured on the server thread; only ever read from here. */
+    private final Long2ObjectOpenHashMap<Chunk> captured = new Long2ObjectOpenHashMap<Chunk>();
+    /** Latest state written at a position, for reads. */
+    private final Long2ObjectOpenHashMap<IBlockData> overlay = new Long2ObjectOpenHashMap<IBlockData>();
+    /** Every write, in order, for the replay. */
+    private final LongArrayList logPositions = new LongArrayList();
+    private final List<IBlockData> logStates = new ArrayList<IBlockData>();
+    private final IntArrayList logFlags = new IntArrayList();
+
+    /** Highest y written in a column, keyed by packed (x, z). Keeps the height lookups off a scan. */
+    private final Long2IntOpenHashMap columnTop = new Long2IntOpenHashMap();
+
+    private final WorldServer world;
+    private boolean escaped;
+
+    public ChunkDecorationBuffer(WorldServer worldserver) {
+        this.world = worldserver;
+        this.columnTop.defaultReturnValue(-1);
+    }
+
+    // ---- set up, on the server thread ----
+
+    public void capture(Chunk chunk) {
+        this.captured.put(ChunkCoordIntPair.chunkXZ2Int(chunk.locX, chunk.locZ), chunk);
+    }
+
+    public void reset() {
+        this.captured.clear();
+        this.overlay.clear();
+        this.logPositions.clear();
+        this.logStates.clear();
+        this.logFlags.clear();
+        this.columnTop.clear();
+        this.escaped = false;
+    }
+
+    public boolean hasEscaped() {
+        return this.escaped;
+    }
+
+    /** Marks the job unusable. Called wherever this buffer would have to guess. */
+    public void escape() {
+        this.escaped = true;
+    }
+
+    // ---- the redirected World calls ----
+
+    /**
+     * The chunk the World would have handed back. Never consults the live chunk map, which the
+     * server thread is busy mutating; a chunk that was not captured reads as empty, which is what
+     * the world does for an unloaded chunk during population anyway.
+     */
+    public Chunk chunkAt(int chunkX, int chunkZ) {
+        Chunk chunk = this.captured.get(ChunkCoordIntPair.chunkXZ2Int(chunkX, chunkZ));
+
+        return chunk != null ? chunk : this.world.chunkProviderServer.emptyChunk;
+    }
+
+    public IBlockData getType(int x, int y, int z) {
+        if (y < 0 || y >= 256) {
+            return Blocks.AIR.getBlockData();
+        }
+
+        IBlockData written = this.overlay.get(BlockPosition.pack(x, y, z));
+
+        if (written != null) {
+            return written;
+        }
+
+        return this.chunkAt(x >> 4, z >> 4).getBlockData(x, y, z);
+    }
+
+    public boolean setType(BlockPosition blockposition, IBlockData iblockdata, int flags) {
+        int y = blockposition.getY();
+
+        if (y < 0 || y >= 256) {
+            return false;
+        }
+
+        // A write outside everything we captured would have landed in the world's empty chunk and
+        // been dropped there; drop it here too rather than logging a write that cannot be replayed.
+        if (this.captured.get(ChunkCoordIntPair.chunkXZ2Int(blockposition.getX() >> 4, blockposition.getZ() >> 4)) == null) {
+            return false;
+        }
+
+        long column = ChunkCoordIntPair.chunkXZ2Int(blockposition.getX(), blockposition.getZ());
+
+        if (y > this.columnTop.get(column)) {
+            this.columnTop.put(column, y);
+        }
+
+        this.overlay.put(blockposition.asLong(), iblockdata);
+        this.logPositions.add(blockposition.asLong());
+        this.logStates.add(iblockdata);
+        this.logFlags.add(flags);
+        return true;
+    }
+
+    /**
+     * The height map value, derived instead of maintained. Starts above anything written or already
+     * standing in the column and walks down while the block below is transparent - the same loop
+     * Chunk.relightBlock runs.
+     */
+    public int highestBlockY(int x, int z) {
+        Chunk chunk = this.chunkAt(x >> 4, z >> 4);
+        int y = chunk.getHeightValue(x & 15, z & 15);
+        int overlayTop = this.overlayColumnTop(x, z);
+
+        if (overlayTop + 1 > y) {
+            y = overlayTop + 1;
+        }
+
+        while (y > 0 && this.getType(x, y - 1, z).getBlock().getLightOpacity() == 0) {
+            --y;
+        }
+
+        return y;
+    }
+
+    /** The highest y this buffer has written in the column, or -1. */
+    private int overlayColumnTop(int x, int z) {
+        return this.columnTop.get(ChunkCoordIntPair.chunkXZ2Int(x, z));
+    }
+
+    /** World.getTopSolidOrLiquidBlock, reading through the overlay. */
+    public BlockPosition topSolidOrLiquidBlock(BlockPosition blockposition) {
+        int x = blockposition.getX();
+        int z = blockposition.getZ();
+        int y = this.chunkAt(x >> 4, z >> 4).getTopFilledSegment() + 16;
+        int overlayTop = this.overlayColumnTop(x, z);
+
+        if (overlayTop + 16 > y) {
+            y = overlayTop + 16;
+        }
+
+        while (y >= 0) {
+            Material material = this.getType(x, y - 1, z).getBlock().getMaterial();
+
+            if (material.isSolid() && material != Material.LEAVES) {
+                break;
+            }
+
+            --y;
+        }
+
+        return new BlockPosition(x, y, z);
+    }
+
+    /** World.getPrecipitationHeight, reading through the overlay. */
+    public BlockPosition precipitationHeight(BlockPosition blockposition) {
+        int x = blockposition.getX();
+        int z = blockposition.getZ();
+        int y = this.highestBlockY(x, z);
+
+        while (y > 0) {
+            Block block = this.getType(x, y - 1, z).getBlock();
+            Material material = block.getMaterial();
+
+            if (material.isSolid() || material.isLiquid()) {
+                break;
+            }
+
+            --y;
+        }
+
+        return new BlockPosition(x, y, z);
+    }
+
+    // ---- the replay, on the server thread ----
+
+    public int writeCount() {
+        return this.logPositions.size();
+    }
+
+    /**
+     * Replays every write through the real World, in the order the decoration made them, so that
+     * lighting, height maps, client updates and physics all happen the way they would have if the
+     * decoration had never left the server thread.
+     */
+    public void apply() {
+        BlockPosition.MutableBlockPosition position = new BlockPosition.MutableBlockPosition();
+
+        for (int i = 0; i < this.logPositions.size(); ++i) {
+            long packed = this.logPositions.getLong(i);
+
+            position.set(BlockPosition.unpackX(packed), BlockPosition.unpackY(packed), BlockPosition.unpackZ(packed));
+            this.world.setTypeAndData(new BlockPosition(position), this.logStates.get(i), this.logFlags.getInt(i));
+        }
+    }
+}
+// Athena end
diff --git a/src/main/java/net/minecraft/server/ChunkDecorationExecutor.java b/src/main/java/net/minecraft/server/ChunkDecorationExecutor.java
new file mode 100644
index 0000000000000000000000000000000000000000..b0196e4f83647fc49e7d6d8dbdff5fbfad75d41e
--- /dev/null
+++ b/src/main/java/net/minecraft/server/ChunkDecorationExecutor.java
@@ -0,0 +1,144 @@
+package net.minecraft.server;
+
+import java.util.ArrayDeque;
+import java.util.Queue;
+import java.util.concurrent.ConcurrentLinkedQueue;
+import java.util.concurrent.LinkedBlockingQueue;
+import java.util.concurrent.BlockingQueue;
+import org.apache.logging.log4j.LogManager;
+import org.apache.logging.log4j.Logger;
+
+// Athena start - the single thread every chunk's decoration runs on.
+//
+// One thread for the whole server, not one per world. Decoration reaches through BiomeBase into the
+// biome's BiomeDecorator, which is a singleton holding the world, the Random and the position it is
+// working on, and into WorldGenerator instances that are configured mid-run. None of that can be
+// entered twice at once. One thread keeps decoration exactly as serial as it has always been, and
+// the ordering it produces is the ordering the server thread used to produce.
+//
+// The win is not parallelism. It is that the server thread stops waiting for the three quarters of
+// population that is search and decision work, and only pays for replaying the writes.
+public final class ChunkDecorationExecutor {
+
+    private static final Logger logger = LogManager.getLogger();
+
+    private static final BlockingQueue<ChunkPopulateJob> pending = new LinkedBlockingQueue<ChunkPopulateJob>();
+    private static final Queue<ChunkPopulateJob> finished = new ConcurrentLinkedQueue<ChunkPopulateJob>();
+    private static volatile Thread worker;
+    /** Jobs handed to the worker but not yet drained. Read on the server thread only. */
+    private static int inFlight;
+
+    private ChunkDecorationExecutor() {}
+
+    private static synchronized void start() {
+        if (ChunkDecorationExecutor.worker == null) {
+            Thread thread = new Thread(new Runnable() {
+                public void run() {
+                    ChunkDecorationExecutor.loop();
+                }
+            }, "Chunk Decoration Thread");
+
+            thread.setDaemon(true);
+            thread.setPriority(Thread.NORM_PRIORITY - 1);
+            thread.start();
+            ChunkDecorationExecutor.worker = thread;
+        }
+    }
+
+    private static void loop() {
+        while (true) {
+            ChunkPopulateJob job;
+
+            try {
+                job = ChunkDecorationExecutor.pending.take();
+            } catch (InterruptedException interruptedexception) {
+                Thread.currentThread().interrupt();
+                return;
+            }
+
+            run(job);
+            ChunkDecorationExecutor.finished.add(job);
+        }
+    }
+
+    /**
+     * Decorates one chunk with the world redirected into the job's buffer.
+     *
+     * Everything is caught. A call this sandbox does not model - anything that reaches the live
+     * chunk map, a tile entity, an entity - either escapes deliberately or throws, and either way
+     * the job is marked and the server thread does the whole decoration itself instead. An
+     * unmodelled call therefore costs time and never correctness.
+     */
+    private static void run(ChunkPopulateJob job) {
+        World world = job.world;
+
+        world.decorationBuffer = job.buffer;
+        world.decorationThread = Thread.currentThread();
+
+        try {
+            job.generator.decorate(job);
+        } catch (Throwable throwable) {
+            job.buffer.escape();
+            ChunkDecorationExecutor.logger.warn("[Athena] Chunk " + job.chunkX + ", " + job.chunkZ + " will be decorated on the server thread instead", throwable);
+        } finally {
+            world.decorationThread = null;
+            world.decorationBuffer = null;
+        }
+    }
+
+    /** Queues a chunk's decoration. Server thread only. */
+    public static void queue(ChunkPopulateJob job) {
+        ChunkDecorationExecutor.start();
+        ++ChunkDecorationExecutor.inFlight;
+        ChunkDecorationExecutor.pending.add(job);
+    }
+
+    /** Hands finished decorations back to the server thread. Called once per tick. */
+    public static void tick() {
+        ChunkPopulateJob job;
+
+        while ((job = ChunkDecorationExecutor.finished.poll()) != null) {
+            --ChunkDecorationExecutor.inFlight;
+            complete(job);
+        }
+    }
+
+    /**
+     * Runs every queued decoration to completion, now. Needed before anything that has to see a
+     * finished world - saving, unloading, shutdown.
+     */
+    public static void flush() {
+        while (ChunkDecorationExecutor.inFlight > 0) {
+            ChunkPopulateJob job = ChunkDecorationExecutor.finished.poll();
+
+            if (job != null) {
+                --ChunkDecorationExecutor.inFlight;
+                complete(job);
+            } else {
+                Thread.yield();
+            }
+        }
+    }
+
+    private static void complete(ChunkPopulateJob job) {
+        if (job.buffer.hasEscaped()) {
+            // The sandbox could not finish it; do the whole decoration here, against the real world.
+            // The abandoned attempt drew from the sequence, so put it back first.
+            job.buffer.reset();
+            job.random.restore(job.randomAtDecoration);
+            job.generator.decorate(job);
+        } else {
+            BlockFalling.instaFall = true; // vanilla held this across the whole of populate
+
+            try {
+                job.buffer.apply();
+            } finally {
+                BlockFalling.instaFall = false;
+            }
+        }
+
+        job.generator.finishPopulate(job);
+        job.completion.run();
+    }
+}
+// Athena end
diff --git a/src/main/java/net/minecraft/server/ChunkPopulateJob.java b/src/main/java/net/minecraft/server/ChunkPopulateJob.java
new file mode 100644
index 0000000000000000000000000000000000000000..3b5928fe1fe7bc18bff6fd24511f426d65ffa14c
--- /dev/null
+++ b/src/main/java/net/minecraft/server/ChunkPopulateJob.java
@@ -0,0 +1,62 @@
+package net.minecraft.server;
+
+import java.util.Random;
+
+// Athena start - one chunk's population, carried between the server thread and the decorating one.
+//
+// It exists because populate used to be a single call that kept all its state in locals and in the
+// generator's own Random. Splitting it in three means that state has to live somewhere; the Random
+// in particular has to be per-job, or a second chunk starting on the server thread would move the
+// sequence out from under a decoration still running.
+//
+// That is safe to do because vanilla reseeds the generator's Random from the chunk coordinates at
+// the top of every populate, so nothing was ever carried between chunks.
+public class ChunkPopulateJob {
+
+    public final ChunkProviderGenerate generator;
+    public final WorldServer world;
+    public final int chunkX;
+    public final int chunkZ;
+    public final int originX;
+    public final int originZ;
+    public final SnapshotRandom random;
+    /** Where the sequence stood when decoration began, so an abandoned attempt can be redone. */
+    public final long randomAtDecoration;
+    public final BiomeBase biome;
+    public final ChunkDecorationBuffer buffer;
+
+    /** What the server thread runs once the decoration has been replayed. */
+    public Runnable completion;
+
+    public ChunkPopulateJob(ChunkProviderGenerate generator, World world, int chunkX, int chunkZ, SnapshotRandom random, BiomeBase biome, BlockPosition origin) {
+        this.generator = generator;
+        this.world = (WorldServer) world;
+        this.chunkX = chunkX;
+        this.chunkZ = chunkZ;
+        this.originX = origin.getX();
+        this.originZ = origin.getZ();
+        this.random = random;
+        this.randomAtDecoration = random.snapshot();
+        this.biome = biome;
+        this.buffer = new ChunkDecorationBuffer(this.world);
+    }
+
+    /**
+     * Takes references to every chunk the decoration is allowed to touch. Decoration writes into the
+     * 2x2 of chunks starting at this one, and a feature at the far edge can reach a little past it,
+     * so a ring is taken as well. A chunk that is not loaded is left out, which is what the world
+     * itself does during population - it hands back the empty chunk and the write is dropped.
+     */
+    public void captureChunks(ChunkProviderServer provider) {
+        for (int x = this.chunkX - 1; x <= this.chunkX + 2; ++x) {
+            for (int z = this.chunkZ - 1; z <= this.chunkZ + 2; ++z) {
+                Chunk chunk = provider.getChunkIfLoaded(x, z);
+
+                if (chunk != null) {
+                    this.buffer.capture(chunk);
+                }
+            }
+        }
+    }
+}
+// Athena end
