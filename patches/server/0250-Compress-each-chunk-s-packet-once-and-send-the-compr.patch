+package net.minecraft.server;
+
+import static org.junit.Assert.assertArrayEquals;
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNull;
+
+import io.netty.buffer.ByteBuf;
+import io.netty.channel.embedded.EmbeddedChannel;
+import java.util.Random;
+import java.util.zip.Inflater;
+import org.bukkit.support.AbstractTestingBase;
+import org.junit.Test;
+
+/**
+ * Athena - a chunk packet sent from AthenaChunkPacketCache must put exactly the bytes on the wire
+ * that the ordinary path does, and must not disturb the packets around it. This builds the real
+ * outbound pipeline order - PacketEncoder, then PacketCompressor - on an EmbeddedChannel and
+ * compares the two paths frame for frame.
+ */
+public class AthenaChunkPacketCacheTest extends AbstractTestingBase {
+
+    private static final int THRESHOLD = 256;
+
+    private static EmbeddedChannel pipeline() {
+        EmbeddedChannel channel = new EmbeddedChannel();
+
+        channel.attr(NetworkManager.attrKeyConnectionState).set(EnumProtocol.PLAY);
+        channel.pipeline().addLast("compress", new PacketCompressor(THRESHOLD));
+        channel.pipeline().addLast("encoder", new PacketEncoder(EnumProtocolDirection.CLIENTBOUND));
+        return channel;
+    }
+
+    private static PacketPlayOutMapChunk.ChunkMap chunkData(long seed) {
+        Random random = new Random(seed);
+        PacketPlayOutMapChunk.ChunkMap map = new PacketPlayOutMapChunk.ChunkMap();
+
+        map.dataSize = 0x00FF;
+        map.data = new byte[40000];
+        // compressible, like a real chunk: long runs with some noise
+        for (int i = 0; i < map.data.length; ++i) {
+            map.data[i] = (byte) (random.nextInt(8) == 0 ? random.nextInt(256) : (i / 97));
+        }
+        return map;
+    }
+
+    /** The packet the ordinary path would send for the same chunk data. */
+    private static PacketPlayOutMapChunk uncached(PacketPlayOutMapChunk.ChunkMap map) {
+        PacketPlayOutMapChunk packet = new PacketPlayOutMapChunk(new AthenaChunkPacketCache(3, -7, map));
+
+        packet.athenaCache = null;
+        return packet;
+    }
+
+    private static byte[] written(EmbeddedChannel channel, Object packet) {
+        channel.writeOutbound(packet);
+        ByteBuf out = channel.readOutbound();
+        byte[] bytes = new byte[out.readableBytes()];
+
+        out.readBytes(bytes);
+        out.release();
+        return bytes;
+    }
+
+    /** Undoes PacketCompressor: the uncompressed length, then the zlib stream (or the raw packet). */
+    private static byte[] inflate(byte[] frame) throws Exception {
+        PacketDataSerializer in = new PacketDataSerializer(io.netty.buffer.Unpooled.wrappedBuffer(frame));
+        int length = in.readVarIntFromBuffer();
+        byte[] rest = new byte[in.readableBytes()];
+
+        in.readBytes(rest);
+        if (length == 0) {
+            return rest;
+        }
+
+        Inflater inflater = new Inflater();
+        byte[] out = new byte[length];
+
+        inflater.setInput(rest);
+        assertEquals("inflated length", length, inflater.inflate(out));
+        inflater.end();
+        return out;
+    }
+
+    @Test
+    public void aCachedChunkPutsTheSameBytesOnTheWire() throws Exception {
+        PacketPlayOutMapChunk.ChunkMap map = chunkData(1L);
+        EmbeddedChannel ordinary = pipeline();
+        EmbeddedChannel cached = pipeline();
+        AthenaChunkPacketCache cache = new AthenaChunkPacketCache(3, -7, chunkData(1L));
+
+        byte[] expected = written(ordinary, uncached(map));
+        byte[] first = written(cached, new PacketPlayOutMapChunk(cache));   // compresses and caches
+        byte[] second = written(cached, new PacketPlayOutMapChunk(cache));  // straight from the cache
+
+        assertArrayEquals("uncompressed packet, first send", inflate(expected), inflate(first));
+        assertArrayEquals("uncompressed packet, cached send", inflate(expected), inflate(second));
+        // zlib is deterministic for the same input and level, so the frames match byte for byte too
+        assertArrayEquals("frame, first send", expected, first);
+        assertArrayEquals("frame, cached send", expected, second);
+        assertNull("the uncompressed data is dropped once compressed", cache.map());
+    }
+
+    @Test
+    public void thePassThroughCoversOnlyTheCachedPacket() throws Exception {
+        EmbeddedChannel ordinary = pipeline();
+        EmbeddedChannel cached = pipeline();
+        AthenaChunkPacketCache cache = new AthenaChunkPacketCache(0, 0, chunkData(2L));
+        Packet small = new PacketPlayOutKeepAlive(42);
+        Packet large = uncached(chunkData(3L));
+
+        written(cached, new PacketPlayOutMapChunk(cache));
+
+        // the packets after it must be framed by the compressor as usual, small and large alike
+        assertArrayEquals(written(ordinary, small), written(cached, small));
+        assertArrayEquals(inflate(written(ordinary, large)), inflate(written(cached, large)));
+    }
+
+    @Test
+    public void belowTheThresholdTheOrdinaryPathIsUsed() throws Exception {
+        PacketPlayOutMapChunk.ChunkMap map = new PacketPlayOutMapChunk.ChunkMap();
+
+        map.data = new byte[16];
+        map.dataSize = 0;
+
+        AthenaChunkPacketCache cache = new AthenaChunkPacketCache(1, 1, map);
+        EmbeddedChannel channel = pipeline();
+        byte[] frame = written(channel, new PacketPlayOutMapChunk(cache));
+
+        assertEquals("sent uncompressed, as PacketCompressor does below its threshold", 0, frame[0]);
+        assertEquals("the data is kept for the next send", map, cache.map());
+    }
+}
