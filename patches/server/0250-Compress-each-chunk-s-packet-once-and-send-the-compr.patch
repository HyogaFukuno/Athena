@@ -385,6 +387,20 @@ public final class AthenaIndexAudit {
         }
     }
 
+    /**
+     * Athena - a hit in a chunk's compressed packet cache must carry what a fresh extraction would.
+     * Re-extracts the chunk and compares checksums of the uncompressed data.
+     */
+    public static void auditChunkPacketCache(Chunk chunk, AthenaChunkPacketCache cache) {
+        ++chunkPacketChecks;
+        long fresh = AthenaChunkPacketCache.checksum(PacketPlayOutMapChunk.getExtractedData(chunk, true,
+                !chunk.world.worldProvider.getHasNoSky(), AthenaChunkPacketCache.FULL_MASK).data);
+
+        if (fresh != cache.dataChecksum) {
+            report("chunk packet cache for " + chunk.locX + "," + chunk.locZ + " matched its key but its data differs from a fresh extraction");
+        }
+    }
+
     /** Athena - PlayerChunkMap.instanceChunks mirrors each instance's tombstone flag and loaded chunk. */
     public static void auditPlayerInstanceChunks(PlayerChunkMap map) {
         ++instanceChunkChecks;
