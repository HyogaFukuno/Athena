diff --git a/src/main/java/net/minecraft/server/AthenaChunkPacketCache.java b/src/main/java/net/minecraft/server/AthenaChunkPacketCache.java
new file mode 100644
index 0000000000000000000000000000000000000000..5b2da9f4e12ff448205ba6b7150369898d6d3988
--- /dev/null
+++ b/src/main/java/net/minecraft/server/AthenaChunkPacketCache.java
@@ -0,0 +1,168 @@
+package net.minecraft.server;
+
+import io.netty.buffer.ByteBuf;
+import io.netty.buffer.Unpooled;
+import java.util.Arrays;
+import java.util.zip.CRC32;
+import java.util.zip.Deflater;
+
+// Athena - one chunk's full-chunk packet, compressed once and sent to every player who needs it.
+//
+// On a small map players cross chunk borders all the time, and 1.8 answers each crossing by
+// unloading one row of chunks from the client and sending another: a 20-player arena sent the
+// same few hundred chunks 70,000 times in three minutes. Every one of those sends was compressed
+// afresh on a Netty thread, and zlib was 85% of the CPU the whole server used. The bytes of a
+// chunk packet do not depend on who receives it, so this keeps them compressed, keyed on the
+// state they were built from, and the encoder writes them out as they are.
+//
+// The key is what a full-chunk packet is made of: each section - the object, and its modCount,
+// which every write of ids or light bumps - and the biome array, compared byte for byte since
+// generators and plugins write into it directly. Anything else changes the packet only through
+// those. A key that no longer matches is simply replaced; nothing is invalidated eagerly.
+//
+// Lifecycle of the bytes: the uncompressed chunk data is extracted on the server thread, exactly
+// as PacketPlayOutMapChunk always did. The first Netty thread to encode the packet compresses it
+// into a frame - the uncompressed length and the zlib stream, the bytes PacketCompressor would
+// have produced - and drops the uncompressed data, so a cached chunk holds a few kilobytes.
+final class AthenaChunkPacketCache {
+
+    /** The primary bit mask of a full chunk packet: every section that holds something. */
+    static final int FULL_MASK = 0xFFFF;
+
+    private static final ThreadLocal<Deflater> DEFLATER = ThreadLocal.withInitial(Deflater::new);
+
+    final int chunkX;
+    final int chunkZ;
+    private final ChunkSection[] sections = new ChunkSection[16];
+    private final int[] modCounts = new int[16];
+    private final byte[] biomes;
+    /** CRC32 of the uncompressed chunk data, for the index audit. */
+    final long dataChecksum;
+
+    // Written in this order and read in the reverse: frame is set before map is cleared, so a
+    // reader that finds map gone always finds frame set.
+    private volatile PacketPlayOutMapChunk.ChunkMap map;
+    private volatile byte[] frame;
+
+    AthenaChunkPacketCache(Chunk chunk) {
+        this.chunkX = chunk.locX;
+        this.chunkZ = chunk.locZ;
+
+        // key first, then the data: a write racing the extraction leaves a key that is already
+        // stale, never data newer than its key
+        ChunkSection[] chunkSections = chunk.getSections();
+
+        for (int i = 0; i < 16; ++i) {
+            ChunkSection section = chunkSections[i];
+
+            this.sections[i] = section;
+            this.modCounts[i] = section == null ? 0 : section.modCount;
+        }
+
+        this.biomes = chunk.getBiomeIndex().clone();
+        this.map = PacketPlayOutMapChunk.getExtractedData(chunk, true, !chunk.world.worldProvider.getHasNoSky(), FULL_MASK);
+        this.dataChecksum = checksum(this.map.data);
+    }
+
+    /** For tests: a cache over given chunk data, with no chunk behind it (it never matches one). */
+    AthenaChunkPacketCache(int chunkX, int chunkZ, PacketPlayOutMapChunk.ChunkMap map) {
+        this.chunkX = chunkX;
+        this.chunkZ = chunkZ;
+        this.biomes = new byte[0];
+        this.map = map;
+        this.dataChecksum = checksum(map.data);
+    }
+
+    /** Whether this was built from exactly the chunk's current contents. */
+    boolean matches(Chunk chunk) {
+        ChunkSection[] chunkSections = chunk.getSections();
+
+        for (int i = 0; i < 16; ++i) {
+            ChunkSection section = chunkSections[i];
+
+            if (section != this.sections[i] || (section != null && section.modCount != this.modCounts[i])) {
+                return false;
+            }
+        }
+
+        return Arrays.equals(this.biomes, chunk.getBiomeIndex());
+    }
+
+    /** The uncompressed data while it is still held, for a packet that may have to fall back to it. */
+    PacketPlayOutMapChunk.ChunkMap map() {
+        return this.map;
+    }
+
+    /**
+     * The compressed frame body for this packet under the given packet id and compression
+     * threshold, compressing it now if no thread has yet. Null if the packet is below the
+     * threshold - it then goes out uncompressed through the ordinary path, and the uncompressed
+     * data is kept for it.
+     */
+    byte[] frame(int packetId, int threshold) {
+        byte[] result = this.frame;
+
+        if (result != null) {
+            return result;
+        }
+
+        PacketPlayOutMapChunk.ChunkMap data = this.map;
+
+        if (data == null) {
+            return this.frame; // another thread compressed it between our two reads
+        }
+
+        ByteBuf raw = Unpooled.buffer(data.data.length + 32);
+
+        try {
+            PacketDataSerializer serializer = new PacketDataSerializer(raw);
+
+            serializer.writeVarIntToBuffer(packetId);
+            serializer.writeInt(this.chunkX);
+            serializer.writeInt(this.chunkZ);
+            serializer.writeBoolean(true);
+            serializer.writeShort((short) (data.dataSize & 0xFFFF));
+            serializer.writeByteArray(data.data);
+
+            int rawLength = raw.readableBytes();
+
+            if (rawLength < threshold) {
+                return null;
+            }
+
+            Deflater deflater = DEFLATER.get();
+            ByteBuf out = Unpooled.buffer(rawLength / 4 + 64);
+            PacketDataSerializer outSerializer = new PacketDataSerializer(out);
+            byte[] chunk = new byte[8192];
+
+            outSerializer.writeVarIntToBuffer(rawLength);
+            try {
+                deflater.setInput(raw.array(), raw.arrayOffset() + raw.readerIndex(), rawLength);
+                deflater.finish();
+
+                while (!deflater.finished()) {
+                    int n = deflater.deflate(chunk);
+
+                    out.writeBytes(chunk, 0, n);
+                }
+            } finally {
+                deflater.reset();
+            }
+
+            result = new byte[out.readableBytes()];
+            out.readBytes(result);
+            this.frame = result;
+            this.map = null;
+            return result;
+        } finally {
+            raw.release();
+        }
+    }
+
+    static long checksum(byte[] data) {
+        CRC32 crc = new CRC32();
+
+        crc.update(data, 0, data.length);
+        return crc.getValue();
+    }
+}
