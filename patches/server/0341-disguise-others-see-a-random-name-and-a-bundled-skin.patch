diff --git a/src/main/java/athena/server/DisguiseCommand.java b/src/main/java/athena/server/DisguiseCommand.java
new file mode 100644
index 0000000000000000000000000000000000000000..cf7ffe9b6c52db18a11f2be8260a9f3c6f816eb9
--- /dev/null
+++ b/src/main/java/athena/server/DisguiseCommand.java
@@ -0,0 +1,139 @@
+package athena.server;
+
+import com.mojang.authlib.GameProfile;
+import com.mojang.authlib.properties.Property;
+import java.io.BufferedReader;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.InputStreamReader;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.ThreadLocalRandom;
+import net.minecraft.server.EntityPlayer;
+import net.minecraft.server.MinecraftServer;
+import org.bukkit.ChatColor;
+import org.bukkit.command.Command;
+import org.bukkit.command.CommandSender;
+import org.bukkit.craftbukkit.entity.CraftPlayer;
+import org.bukkit.entity.Player;
+
+/**
+ * Athena - {@code /disguise} and {@code /undisguise}: everyone else sees the player under a random
+ * name (over the head and in the tab list) and with one of the skins in
+ * {@code athena/disguise-skins.txt}; the player still sees their own. {@code /disguise} again picks
+ * a new name and skin. Lasts until {@code /undisguise} or until the player leaves the server.
+ * A plugin can stop players from disguising for a while with Athena.setAllowDisguise(false);
+ * that leaves existing disguises alone.
+ *
+ * <p>Nothing about it runs per packet: the server picks which tab list entry to build when it
+ * builds one (PacketPlayOutPlayerInfo.athenaSeenBy), which only happens when a player joins,
+ * becomes visible or changes list name. The skins come with the server, already signed by Mojang
+ * (a 1.8 client shows another player's skin only with Mojang's signature), so disguising asks
+ * nobody anything.
+ */
+public final class DisguiseCommand extends Command {
+
+    private static final String[] FIRST = {
+            "Swift", "Silent", "Lucky", "Brave", "Clever", "Rapid", "Crazy", "Happy", "Mighty", "Sneaky",
+            "Frosty", "Sunny", "Shady", "Wild", "Bold", "Quiet", "Hidden", "Golden", "Dark", "Lazy"};
+    private static final String[] SECOND = {
+            "Fox", "Wolf", "Bear", "Hawk", "Tiger", "Panda", "Otter", "Raven", "Shark", "Lynx",
+            "Badger", "Falcon", "Viper", "Moose", "Gecko", "Koala", "Bison", "Crow", "Owl", "Yeti"};
+    /** The skins to pick from: Mojang's signed textures properties. Read once, the first time someone disguises. */
+    private static List<Property> skins;
+    /** Whether /disguise may be used now (Athena.setAllowDisguise). /undisguise always may. */
+    static volatile boolean allowed = true;
+
+    private final boolean undisguise;
+
+    public DisguiseCommand(String name, boolean undisguise) {
+        super(name);
+        this.undisguise = undisguise;
+        this.description = undisguise ? "Shows your own name and skin to everyone again" : "Shows everyone else a random name and skin";
+        this.usageMessage = undisguise ? "/undisguise" : "/disguise";
+        this.setPermission("athena.command.disguise");
+    }
+
+    @Override
+    public boolean execute(CommandSender sender, String currentAlias, String[] args) {
+        if (!this.testPermission(sender)) {
+            return true;
+        }
+        if (!(sender instanceof Player)) {
+            sender.sendMessage(ChatColor.RED + "Only a player can disguise.");
+            return true;
+        }
+        CraftPlayer player = (CraftPlayer) sender;
+
+        if (this.undisguise) {
+            if (player.getHandle().athenaDisguise == null) {
+                sender.sendMessage(ChatColor.RED + "You are not disguised.");
+            } else {
+                player.athenaDisguise(null);
+                sender.sendMessage(ChatColor.GREEN + "You are no longer disguised.");
+            }
+            return true;
+        }
+
+        if (!allowed) {
+            sender.sendMessage(ChatColor.RED + "You cannot disguise right now.");
+            return true;
+        }
+
+        String name = randomName();
+        GameProfile disguise = new GameProfile(player.getUniqueId(), name); // the same UUID: the entity is still this player's
+        List<Property> skins = skins();
+        if (!skins.isEmpty()) {
+            disguise.getProperties().put("textures", skins.get(ThreadLocalRandom.current().nextInt(skins.size())));
+        }
+        player.athenaDisguise(disguise);
+        sender.sendMessage(ChatColor.GREEN + "Others now see you as " + name + ".");
+        return true;
+    }
+
+    /**
+     * A name like SwiftFox482 that no one on the server has, real or disguised: two tab list
+     * entries of one name confuse the clients' teams and name tags.
+     */
+    private static String randomName() {
+        ThreadLocalRandom random = ThreadLocalRandom.current();
+        while (true) {
+            String name = FIRST[random.nextInt(FIRST.length)] + SECOND[random.nextInt(SECOND.length)] + random.nextInt(1000);
+            if (!taken(name)) {
+                return name; // at most 16 characters: 6 + 6 + 3
+            }
+        }
+    }
+
+    private static boolean taken(String name) {
+        for (EntityPlayer player : MinecraftServer.getServer().getPlayerList().players) {
+            if (player.getName().equalsIgnoreCase(name)
+                    || player.athenaDisguise != null && player.athenaDisguise.getName().equalsIgnoreCase(name)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private static synchronized List<Property> skins() {
+        if (skins == null) {
+            List<Property> read = new ArrayList<>();
+            try (InputStream in = DisguiseCommand.class.getResourceAsStream("/athena/disguise-skins.txt")) {
+                if (in != null) {
+                    BufferedReader reader = new BufferedReader(new InputStreamReader(in, StandardCharsets.UTF_8));
+                    for (String line; (line = reader.readLine()) != null; ) {
+                        String[] parts = line.split("\t");
+                        if (!line.startsWith("#") && parts.length >= 2) {
+                            read.add(new Property("textures", parts[0], parts[1]));
+                        }
+                    }
+                }
+            } catch (IOException e) {
+                MinecraftServer.LOGGER.warn("Could not read the disguise skins; disguises get the default skin", e);
+            }
+            skins = read;
+        }
+        return skins;
+    }
+}
