         if (!onlinePlayers.isEmpty()) {
-            entityplayer.playerConnection.sendPacket(new PacketPlayOutPlayerInfo(PacketPlayOutPlayerInfo.EnumPlayerInfoAction.ADD_PLAYER, onlinePlayers.toArray(new EntityPlayer[0])));
+            entityplayer.playerConnection.sendPacket(PacketPlayOutPlayerInfo.athenaSeenBy(PacketPlayOutPlayerInfo.EnumPlayerInfoAction.ADD_PLAYER, entityplayer, onlinePlayers.toArray(new EntityPlayer[0]))); // Athena - /disguise
