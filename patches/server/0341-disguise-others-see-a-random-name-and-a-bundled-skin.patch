@@ -115,6 +115,24 @@ public class EntityPlayer extends EntityHuman implements ICrafting {
     public String displayName;
     public net.kyori.adventure.text.Component adventure$displayName; // PandaSpigot - Adventure
     public IChatBaseComponent listName;
+    // Athena start - /disguise: the profile everyone else sees (name and skin, same UUID); null = not disguised
+    public GameProfile athenaDisguise;
+    private IChatBaseComponent athenaListNameSource, athenaListNameDisguised;
+
+    /** The tab list name everyone else sees: the real list name with the real name swapped for the disguise's. */
+    IChatBaseComponent athenaDisguisedListName() {
+        IChatBaseComponent source = this.listName;
+        if (source == null) {
+            return null;
+        }
+        if (source != this.athenaListNameSource) { // worked out again only when a plugin sets a new list name
+            this.athenaListNameDisguised = org.bukkit.craftbukkit.util.CraftChatMessage.fromString(
+                    org.bukkit.craftbukkit.util.CraftChatMessage.fromComponent(source).replace(this.getName(), this.athenaDisguise.getName()))[0];
+            this.athenaListNameSource = source;
+        }
+        return this.athenaListNameDisguised;
+    }
+    // Athena end
     public org.bukkit.Location compassTarget;
     public int newExp = 0;
     public int newLevel = 0;
diff --git a/src/main/java/net/minecraft/server/PacketPlayOutPlayerInfo.java b/src/main/java/net/minecraft/server/PacketPlayOutPlayerInfo.java
index 0fb02de804d646b6009e45078dae71dbc1e2ab1a..e3e6efda1c8abddd804e65926c3f8f94b31a13e6 100644
--- a/src/main/java/net/minecraft/server/PacketPlayOutPlayerInfo.java
+++ b/src/main/java/net/minecraft/server/PacketPlayOutPlayerInfo.java
@@ -33,6 +33,24 @@ public class PacketPlayOutPlayerInfo implements Packet<PacketListenerPlayOut> {
 
     }
 
+    // Athena start - /disguise
+    /**
+     * The packet {@code viewer} should get about {@code players}: a disguised player's entry carries the
+     * disguise (name, skin, list name) for everyone but that player. Only ADD_PLAYER and
+     * UPDATE_DISPLAY_NAME carry a name; the other actions carry just the UUID, so they need none of this.
+     */
+    public static PacketPlayOutPlayerInfo athenaSeenBy(PacketPlayOutPlayerInfo.EnumPlayerInfoAction action, EntityPlayer viewer, EntityPlayer... players) {
+        PacketPlayOutPlayerInfo packet = new PacketPlayOutPlayerInfo();
+        packet.action = action;
+        for (EntityPlayer entityplayer : players) {
+            boolean disguised = entityplayer.athenaDisguise != null && entityplayer != viewer;
+            packet.players.add(packet.new PlayerInfoData(disguised ? entityplayer.athenaDisguise : entityplayer.getProfile(), entityplayer.ping,
+                    entityplayer.playerInteractManager.getGameMode(), disguised ? entityplayer.athenaDisguisedListName() : entityplayer.getPlayerListName()));
+        }
+        return packet;
+    }
+    // Athena end
+
     @Override
     public void readPacketData(PacketDataSerializer packetdataserializer) throws IOException {
         this.action = (PacketPlayOutPlayerInfo.EnumPlayerInfoAction) packetdataserializer.readEnumValue(PacketPlayOutPlayerInfo.EnumPlayerInfoAction.class);
