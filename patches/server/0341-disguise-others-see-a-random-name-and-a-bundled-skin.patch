             if (entityplayer1 == entityplayer || !entityplayer.getBukkitEntity().canSee(entityplayer1.getBukkitEntity())) { // PandaSpigot - don't include joining player
@@ -347,7 +349,7 @@ public abstract class PlayerList {
         }
