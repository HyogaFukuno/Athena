diff --git a/src/test/java/com/hpfxd/pandaspigot/config/PacketLimiterConfigTest.java b/src/test/java/com/hpfxd/pandaspigot/config/PacketLimiterConfigTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..88cb6759ec3cb0f1e9ab51e69aaa5bacbc2d27b1
--- /dev/null
+++ b/src/test/java/com/hpfxd/pandaspigot/config/PacketLimiterConfigTest.java
@@ -0,0 +1,57 @@
+package com.hpfxd.pandaspigot.config;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNotNull;
+
+import net.minecraft.server.PacketPlayInChat;
+import org.junit.Test;
+import org.spongepowered.configurate.BasicConfigurationNode;
+import org.spongepowered.configurate.ConfigurationNode;
+
+/**
+ * Athena - a packet's own limit survives being written back to pandaspigot.yml, and a limit without
+ * an action kicks.
+ */
+public class PacketLimiterConfigTest {
+
+    private static final PacketLimiterConfig.Serializer SERIALIZER = new PacketLimiterConfig.Serializer();
+
+    private static PacketLimiterConfig read(ConfigurationNode node) throws Exception {
+        return SERIALIZER.deserialize(PacketLimiterConfig.class, node);
+    }
+
+    private static ConfigurationNode written(PacketLimiterConfig config) throws Exception {
+        ConfigurationNode node = BasicConfigurationNode.root();
+        SERIALIZER.serialize(PacketLimiterConfig.class, config, node);
+        return node;
+    }
+
+    @Test
+    public void aPacketsLimitSurvivesBeingWrittenBack() throws Exception {
+        ConfigurationNode node = BasicConfigurationNode.root();
+        node.node("limits", "PacketPlayInChat", "interval").set(2.0);
+        node.node("limits", "PacketPlayInChat", "maxPacketRate").set(5.0);
+        node.node("limits", "PacketPlayInChat", "action").set("DROP");
+
+        // the file is read, written back, and read again at the next start
+        PacketLimiterConfig.PacketLimit limit = read(written(read(node))).getPacketSpecificLimits().get(PacketPlayInChat.class);
+
+        assertNotNull(limit);
+        assertEquals(2.0, limit.packetLimitInterval, 0.0);
+        assertEquals(5.0, limit.maxPacketRate, 0.0);
+        assertEquals(PacketLimiterConfig.PacketLimit.ViolateAction.DROP, limit.violateAction);
+    }
+
+    @Test
+    public void aLimitWithoutAnActionKicks() throws Exception {
+        ConfigurationNode node = BasicConfigurationNode.root();
+        node.node("limits", "PacketPlayInChat", "interval").set(1.0);
+        node.node("limits", "PacketPlayInChat", "maxPacketRate").set(5.0);
+
+        PacketLimiterConfig.PacketLimit limit = read(node).getPacketSpecificLimits().get(PacketPlayInChat.class);
+
+        assertEquals(PacketLimiterConfig.PacketLimit.ViolateAction.KICK, limit.violateAction);
+        // and it is written so: the next start reads the same
+        assertEquals(PacketLimiterConfig.PacketLimit.ViolateAction.KICK, read(written(read(node))).getPacketSpecificLimits().get(PacketPlayInChat.class).violateAction);
+    }
+}
