-            Class oclass = (Class) TileEntity.nameToClassMap.get(nbttagcompound.getString("id"));
+            Class<? extends TileEntity> oclass = TileEntity.nameToClassMap.get(nbttagcompound.getString("id"));
 
             if (oclass != null) {
-                tileentity = (TileEntity) oclass.newInstance();
+                tileentity = newInstance(oclass); // Athena - cached constructor
             }
         } catch (Exception exception) {
