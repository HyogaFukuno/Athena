diff --git a/src/main/java/net/minecraft/server/TileEntity.java b/src/main/java/net/minecraft/server/TileEntity.java
index d9af3a213775fb00f877e3a286a269c1944d003b..d6f60b3dc3f5613985db9e4baef6f2dc9765eab2 100644
--- a/src/main/java/net/minecraft/server/TileEntity.java
+++ b/src/main/java/net/minecraft/server/TileEntity.java
@@ -67,14 +67,32 @@ public abstract class TileEntity {
         }
     }
 
+    // Athena start - cache the no-arg constructor of each tile entity class; see
+    // EntityTypes.newInstance for the reasoning. This runs for every tile entity in a chunk when
+    // the chunk loads. It also drops Class.newInstance, which is deprecated for throwing the
+    // constructor's checked exceptions without declaring them.
+    private static final java.util.concurrent.ConcurrentMap<Class<?>, java.lang.reflect.Constructor<? extends TileEntity>> constructors = new java.util.concurrent.ConcurrentHashMap<Class<?>, java.lang.reflect.Constructor<? extends TileEntity>>();
+
+    public static TileEntity newInstance(Class<? extends TileEntity> oclass) throws Exception {
+        java.lang.reflect.Constructor<? extends TileEntity> constructor = TileEntity.constructors.get(oclass);
+
+        if (constructor == null) {
+            constructor = oclass.getConstructor();
+            TileEntity.constructors.put(oclass, constructor);
+        }
+
+        return constructor.newInstance();
+    }
+    // Athena end
+
     public static TileEntity createAndLoadEntity(NBTTagCompound nbttagcompound) {
