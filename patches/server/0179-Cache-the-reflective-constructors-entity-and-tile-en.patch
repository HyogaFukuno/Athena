diff --git a/src/main/java/net/minecraft/server/EntityTypes.java b/src/main/java/net/minecraft/server/EntityTypes.java
index ed80a67b405dd00e3be38ad31ca25bd191ac84db..2b9cec1414a7bd86536200045c7f235d7864daf4 100644
--- a/src/main/java/net/minecraft/server/EntityTypes.java
+++ b/src/main/java/net/minecraft/server/EntityTypes.java
@@ -2,6 +2,7 @@ package net.minecraft.server;
 
 import com.google.common.collect.Lists;
 import com.google.common.collect.Maps;
+import java.lang.reflect.Constructor;
 import java.util.ArrayList;
 import java.util.List;
 import java.util.Map;
@@ -20,6 +21,29 @@ public class EntityTypes {
     private static final Map<String, Integer> stringToIDMapping = Maps.newHashMap();
     public static final Map<Integer, EntityTypes.MonsterEggInfo> eggInfo = Maps.newLinkedHashMap();
 
+    // Athena start - cache the (World) constructor of each entity class.
+    //
+    // Class.getConstructor runs an access check and hands back a fresh copy of the Constructor on
+    // every call. Every entity in a chunk goes through here when the chunk loads, and so does every
+    // natural spawn attempt, for a set of classes that never changes after registration.
+    //
+    // A ConcurrentHashMap because entity construction is not strictly a server-thread affair, and
+    // because a Constructor is immutable once obtained - two threads racing to fill the same key
+    // only waste one lookup.
+    private static final java.util.concurrent.ConcurrentMap<Class<?>, Constructor<? extends Entity>> worldConstructors = new java.util.concurrent.ConcurrentHashMap<Class<?>, Constructor<? extends Entity>>();
+
+    public static Entity newInstance(Class<? extends Entity> oclass, World world) throws Exception {
+        Constructor<? extends Entity> constructor = EntityTypes.worldConstructors.get(oclass);
+
+        if (constructor == null) {
+            constructor = oclass.getConstructor(World.class);
+            EntityTypes.worldConstructors.put(oclass, constructor);
+        }
+
+        return constructor.newInstance(world);
+    }
+    // Athena end
+
     private static void addMapping(Class<? extends Entity> oclass, String s, int i) {
         if (EntityTypes.stringToClassMapping.containsKey(s)) {
             throw new IllegalArgumentException("ID is already registered: " + s);
@@ -47,10 +71,10 @@ public class EntityTypes {
         Entity entity = null;
 
         try {
-            Class oclass = (Class) EntityTypes.stringToClassMapping.get(s);
+            Class<? extends Entity> oclass = EntityTypes.stringToClassMapping.get(s);
 
             if (oclass != null) {
-                entity = (Entity) oclass.getConstructor(World.class).newInstance(world);
+                entity = newInstance(oclass, world); // Athena - cached constructor
             }
         } catch (Exception exception) {
             exception.printStackTrace();
@@ -68,10 +92,10 @@ public class EntityTypes {
         }
 
         try {
-            Class oclass = (Class) EntityTypes.stringToClassMapping.get(nbttagcompound.getString("id"));
+            Class<? extends Entity> oclass = EntityTypes.stringToClassMapping.get(nbttagcompound.getString("id"));
 
             if (oclass != null) {
-                entity = (Entity) oclass.getConstructor(World.class).newInstance(world);
+                entity = newInstance(oclass, world); // Athena - cached constructor
             }
         } catch (Exception exception) {
             exception.printStackTrace();
@@ -90,10 +114,10 @@ public class EntityTypes {
         Entity entity = null;
 
         try {
-            Class oclass = getClassFromID(i);
+            Class<? extends Entity> oclass = getClassFromID(i);
 
             if (oclass != null) {
-                entity = (Entity) oclass.getConstructor(World.class).newInstance(world);
