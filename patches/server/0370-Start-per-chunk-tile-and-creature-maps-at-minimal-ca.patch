From: glacier <hyouga.dev@gmail.com>
Date: Fri, 30 Oct 2026 08:44:06 +0900
Subject: [PATCH] Start per-chunk tile and creature maps at minimal capacity


diff --git a/src/main/java/net/minecraft/server/Chunk.java b/src/main/java/net/minecraft/server/Chunk.java
index cb47cdff284df317d1317948710eab39f0de986d..1459275e3833e814ff64bb347955d26c6594f3ca 100644
--- a/src/main/java/net/minecraft/server/Chunk.java
+++ b/src/main/java/net/minecraft/server/Chunk.java
@@ -137,7 +137,8 @@ public class Chunk {
     // question from the chunk itself. Volatile because a QUEUED lookup, if a plugin ever makes one,
     // may come from another thread, and the queue must be seen whole once the field is seen.
     private volatile ConcurrentLinkedQueue<BlockPosition> tileEntityPosQueue;
-    protected it.unimi.dsi.fastutil.objects.Object2IntOpenHashMap<Class> entityCount = new it.unimi.dsi.fastutil.objects.Object2IntOpenHashMap<Class>(); // Spigot // Athena - fastutil in place of trove
+    // Athena - most pinned chunks contain no creatures; grow the tally only when entries arrive.
+    protected it.unimi.dsi.fastutil.objects.Object2IntOpenHashMap<Class> entityCount = new it.unimi.dsi.fastutil.objects.Object2IntOpenHashMap<Class>(0); // Spigot
     // Athena - true while this chunk's tally is folded into the world's creature census. Set only
     // by ChunkCreatureCensus, at the points where the chunk enters or leaves the provider's map.
     boolean inCreatureCensus;
@@ -273,7 +274,7 @@ public class Chunk {
         this.blockBiomeArray = new byte[256];
         this.precipitationHeightMap = new int[256];
         this.updateSkylightColumns = new boolean[256];
-        this.tileEntities = new Long2ObjectOpenHashMap<TileEntity>(); // Athena
+        this.tileEntities = new Long2ObjectOpenHashMap<TileEntity>(0); // Athena - empty chunks need no default-size table
         this.queuedLightChecks = 4096;
         this.entitySlices = (List[]) (new List[16]); // Spigot
         this.world = world;
diff --git a/src/test/java/net/minecraft/server/AthenaSmallChunkMapsTest.java b/src/test/java/net/minecraft/server/AthenaSmallChunkMapsTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..0440e467e8cfe72e45ca821f69863065bec9c084
--- /dev/null
+++ b/src/test/java/net/minecraft/server/AthenaSmallChunkMapsTest.java
@@ -0,0 +1,52 @@
+package net.minecraft.server;
+
+import static org.junit.Assert.*;
+
+import it.unimi.dsi.fastutil.longs.Long2ObjectOpenHashMap;
+import it.unimi.dsi.fastutil.objects.Object2IntOpenHashMap;
+import org.bukkit.support.AbstractTestingBase;
+import org.junit.Test;
+
+public class AthenaSmallChunkMapsTest extends AbstractTestingBase {
+    @Test
+    public void tileEntriesSurviveGrowthRemovalAndReuse() {
+        Chunk chunk = new Chunk(null, 0, 0);
+        Long2ObjectOpenHashMap<TileEntity> previous = new Long2ObjectOpenHashMap<>();
+        assertTrue(chunk.tileEntities.isEmpty());
+        assertNull(chunk.tileEntities.get(0));
+        for (int i = -128; i <= 128; ++i) {
+            TileEntity tile = new TileEntityChest();
+            long key = (long) i << 32 | i & 0xFFFFFFFFL;
+            assertSame(previous.put(key, tile), chunk.tileEntities.put(key, tile));
+            assertEquals(previous, chunk.tileEntities);
+        }
+        for (long key : previous.keySet().toLongArray()) {
+            assertSame(previous.remove(key), chunk.tileEntities.remove(key));
+            assertEquals(previous, chunk.tileEntities);
+        }
+        TileEntity replacement = new TileEntityChest();
+        chunk.tileEntities.put(0, replacement);
+        assertSame(replacement, chunk.tileEntities.get(0));
+    }
+
+    @Test
+    public void creatureTalliesAndWorldCensusMatchDefaultCapacityMaps() {
+        Chunk chunk = new Chunk(null, 0, 0);
+        Object2IntOpenHashMap<Class> previous = new Object2IntOpenHashMap<>();
+        Class[] types = {EntityMonster.class, EntityAnimal.class, EntityWaterAnimal.class, EntityAmbient.class};
+        for (Class type : types) {
+            assertEquals(0, chunk.entityCount.getInt(type));
+            assertEquals(previous.addTo(type, 3), chunk.entityCount.addTo(type, 3));
+            assertEquals(previous.addTo(type, -1), chunk.entityCount.addTo(type, -1));
+        }
+        assertEquals(previous, chunk.entityCount);
+        ChunkCreatureCensus census = new ChunkCreatureCensus();
+        census.chunkAdded(chunk);
+        for (Class type : types) assertEquals(previous.getInt(type), census.count(type));
+        census.chunkRemoved(chunk);
+        for (Class type : types) assertEquals(0, census.count(type));
+        chunk.entityCount.clear();
+        census.chunkAdded(chunk);
+        for (Class type : types) assertEquals(0, census.count(type));
+    }
+}
