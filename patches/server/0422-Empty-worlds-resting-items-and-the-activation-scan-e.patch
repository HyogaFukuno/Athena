From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: glacier <hyouga.dev@gmail.com>
Date: Tue, 10 Nov 2026 07:41:25 +0900
Subject: [PATCH] Empty worlds, resting items and the activation scan every few
 ticks

athena.yml, per world: emptyWorldTickInterval (20) ticks a world that has had
no player for ten seconds every that many ticks, its clock and its timers
going on every tick; restingItemMoveInterval (4) moves a dropped item lying
still on the ground every that many ticks, as vanilla has since 1.13;
entityActivationCheckInterval (4) looks for the entities near players every
that many ticks, what it finds staying active until the next look. 1 is as
before for each.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>

diff --git a/src/main/java/athena/server/AthenaWorldConfig.java b/src/main/java/athena/server/AthenaWorldConfig.java
index 948ce043711a594d2a4e1fcb488bdc6ef7e924ba..573972df264e8d5b6edbf37e0e3f9699dc4a715b 100644
--- a/src/main/java/athena/server/AthenaWorldConfig.java
+++ b/src/main/java/athena/server/AthenaWorldConfig.java
@@ -79,4 +79,33 @@ public class AthenaWorldConfig {
             "switch their circuits on one tick when the time changes.\n" +
             "Default: true")
     public boolean staggerDaylightDetectors = true;
+
+    @Comment("Every how many ticks the entities near players are looked through to decide which are\n" +
+            "active (Spigot's entity activation range). Vanilla Spigot does it every tick, for every\n" +
+            "chunk near every player. With an interval, an entity found in range stays active until\n" +
+            "the next look, so one that leaves the range sleeps, and one that comes into it wakes,\n" +
+            "up to that many ticks later; asleep it is still ticked once a second, as before.\n" +
+            "1 is every tick.\n" +
+            "Default: 4")
+    public int entityActivationCheckInterval = 4;
+
+    @Comment("Every how many ticks a dropped item that lies still on the ground is moved. 1.8 runs\n" +
+            "the whole movement and collision of every item every tick, though one at rest ends up\n" +
+            "where it was; since 1.13 vanilla moves such an item every fourth tick, which is what 4\n" +
+            "gives here. An item that is falling, sliding or carried by water is moved every tick as\n" +
+            "before. One whose block is taken away starts falling up to that many ticks later.\n" +
+            "1 is every tick.\n" +
+            "Default: 4")
+    public int restingItemMoveInterval = 4;
+
+    @Comment("Every how many ticks a world with no player in it is ticked, once it has been empty for\n" +
+            "ten seconds. Its blocks, entities and tile entities then stand still in between - seen\n" +
+            "by nobody - while its time of day goes on as always, and so do Athena's world timers,\n" +
+            "the scheduler, chunk loading and everything plugins do. The first tick with a player in\n" +
+            "the world is a normal one again. A match's deathmatch arena waits empty for most of\n" +
+            "the match, with every hopper, furnace and minecart in it ticked twenty times a second.\n" +
+            "Set this to 1 for a world whose machines must run with nobody there.\n" +
+            "1 ticks an empty world like any other.\n" +
+            "Default: 20")
+    public int emptyWorldTickInterval = 20;
 }
diff --git a/src/main/java/net/minecraft/server/EntityItem.java b/src/main/java/net/minecraft/server/EntityItem.java
index e0c87f8ea2b6ca3d15d92853aa5a72c8ca9fa938..5805f4b7a46f47458ee78089256e027e124d1289 100644
--- a/src/main/java/net/minecraft/server/EntityItem.java
+++ b/src/main/java/net/minecraft/server/EntityItem.java
@@ -72,6 +72,16 @@ public class EntityItem extends Entity {
             this.lastZ = this.locZ;
             this.motY -= 0.03999999910593033D;
             this.noclip = this.pushOutOfBlocks(this.locX, (this.boundingBoxMinY + this.boundingBoxMaxY) / 2.0D, this.locZ);
+            // Athena start - an item at rest on the ground is moved every few ticks, as vanilla has
+            // done since 1.13 (athena.yml restingItemMoveInterval). Its move ends where it began; it
+            // was a collision query for every item lying about, every tick.
+            int restInterval = this.world.athenaConfig == null ? 1 : this.world.athenaConfig.restingItemMoveInterval;
+
+            if (restInterval > 1 && this.onGround && !this.noclip && this.motX * this.motX + this.motZ * this.motZ <= 1.0E-5D
+                    && (this.ticksLived + this.getId()) % restInterval != 0) {
+                this.motY = 0.0D; // what the move would leave of the tick's gravity
+            } else
+            // Athena end
             this.move(this.motX, this.motY, this.motZ);
             boolean flag = (int) this.lastX != (int) this.locX || (int) this.lastY != (int) this.locY || (int) this.lastZ != (int) this.locZ;
 
diff --git a/src/main/java/net/minecraft/server/MinecraftServer.java b/src/main/java/net/minecraft/server/MinecraftServer.java
index 8b6160ebbe674545bc42049b730bdd3d2dc0dad5..61c01ca3821420473ce3cab185ccf54634c4fb99 100644
