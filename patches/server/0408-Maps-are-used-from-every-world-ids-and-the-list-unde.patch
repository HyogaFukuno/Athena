-            PersistentBase persistentbase = (PersistentBase) this.loadedDataList.get(i);
+    // Athena - a copy to walk: other threads add to the list
+    public synchronized List<PersistentBase> athenaLoaded() {
+        return Lists.newArrayList(this.loadedDataList);
+    }
 
-            if (persistentbase.isDirty()) {
-                this.saveData(persistentbase);
-                persistentbase.setDirty(false);
+    public void saveAllData() {
+        // Athena - each entry under its own lock, the one that guards a map's contents; no other world
+        // waits for these files, unless it is using that map
+        for (PersistentBase persistentbase : this.athenaLoaded()) {
+            synchronized (persistentbase) {
+                if (persistentbase.isDirty()) {
+                    this.saveData(persistentbase);
+                    persistentbase.setDirty(false);
+                }
             }
         }
 
