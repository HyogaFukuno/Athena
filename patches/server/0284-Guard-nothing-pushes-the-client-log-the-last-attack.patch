                 this.ctxX, this.ctxY, this.ctxZ, this.ctxWorld.getWorld().getName(), this.legacy17 ? "1.7" : "1.8",
                 this.player.playerInteractManager.getGameMode(), this.player.abilities.canFly, this.player.abilities.isFlying,
                 this.player.abilities.walkSpeed, (this.ctxFlags & 1) != 0 ? "ground" : "air", (this.ctxFlags & 2) != 0 ? ", wall" : "",
                 (this.ctxFlags & 4) != 0 ? ", liquid" : "", (this.ctxFlags & 8) != 0 ? ", climbing" : "",
-                (this.ctxFlags & 16) != 0 ? ", knockback" : "", this.ctxPushers > 0 ? ", pushed by " + this.ctxPushers : "")
+                (this.ctxFlags & 16) != 0 ? ", knockback" : "")
                 + this.recent();
     }
 
@@ -698,6 +646,9 @@ public final class AthenaGuard {
         if (this.grantSentTick != Long.MIN_VALUE) {
             sb.append(String.format(java.util.Locale.ROOT, "; knockback sent %d ticks ago", MinecraftServer.currentTick - this.grantSentTick));
         }
+        if (this.lastAttackTick != Integer.MIN_VALUE) {
+            sb.append("; attacked ").append(MinecraftServer.currentTick - this.lastAttackTick).append(" ticks ago");
