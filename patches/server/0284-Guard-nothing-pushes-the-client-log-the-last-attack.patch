-        // a player the client overlaps pushes it sideways (EntityLivingBase.collideWithNearbyEntities):
-        // at most 0.05 on each axis per pusher per tick, added to the motion the next move carries
-        maxH += pushers * PUSH * ticks;
+        // nothing pushes the client: in 1.8 (and 1.7) living entities push each other on the server
+        // only (EntityLivingBase.onLivingUpdate), and the server never sends a player its own push
 
         if (h > maxH + EPS_H) {
             this.flag(1, "speed", "moved %.3f, at most %.3f (ticks %d, last %.3f, friction %.3f/%.3f, ground %b)", h, maxH, ticks, this.lastH, this.motionFriction, this.accelFriction, this.groundStart);
@@ -465,54 +461,6 @@ public final class AthenaGuard {
         return world.hasCubes(player, x - HALF, y - 0.001D, z - HALF, x + HALF, y, z + HALF);
     }
 
-    /**
-     * Entities overlapping the box the client pushes against (its own, grown by 0.2), who push it back.
-     * The client sees them where they were: another player a network trip and an interpolation behind
-     * where it says it is now, so any of its positions over that time counts; anything else is
-     * interpolated too, and gets a little room.
-     */
-    private int pushers(World world, double x, double y, double z) {
-        int lookback = Math.min(20, 4 + (this.player.ping + 49) / 50);
-        double reach = 0.5D + lookback * 0.4D; // how far another player can be from where it was then
-        java.util.List<Entity> near = world.getEntities(this.player, x - reach, y - 2.0D, z - reach, x + reach, y + 3.8D, z + reach);
-        double minX = x - 0.5D, minY = y, minZ = z - 0.5D, maxX = x + 0.5D, maxY = y + 1.8D, maxZ = z + 0.5D;
-        int tick = MinecraftServer.currentTick;
-        int count = 0;
-
-        for (int i = 0; i < near.size(); ++i) {
-            Entity entity = near.get(i);
-
-            if (!entity.canBePushed() || entity instanceof EntityPlayer && ((EntityPlayer) entity).isSpectator()) {
-                continue;
-            }
-            boolean touches = false;
-
-            if (entity instanceof EntityPlayer) {
-                EntityPlayer other = (EntityPlayer) entity;
-
-                for (int back = 0; back <= lookback && !touches; ++back) {
-                    double[] box = other.athenaBoxAt(tick - back);
-
-                    if (box == null) {
-                        if (back > 0) {
-                            break;
-                        }
-                        box = new double[] { entity.boundingBoxMinX, entity.boundingBoxMinY, entity.boundingBoxMinZ, entity.boundingBoxMaxX, entity.boundingBoxMaxY, entity.boundingBoxMaxZ };
-                    }
-                    touches = box[0] < maxX && box[3] > minX && box[1] < maxY && box[4] > minY && box[2] < maxZ && box[5] > minZ;
-                }
-            } else {
-                touches = entity.boundingBoxMinX < maxX + 0.3D && entity.boundingBoxMaxX > minX - 0.3D
-                        && entity.boundingBoxMinY < maxY + 0.3D && entity.boundingBoxMaxY > minY - 0.3D
-                        && entity.boundingBoxMinZ < maxZ + 0.3D && entity.boundingBoxMaxZ > minZ - 0.3D;
-            }
-            if (touches && ++count >= 8) {
-                break;
-            }
-        }
-        return count;
-    }
-
     /** Whether something under the feet at (x, y, z) is within depth below them. */
     private boolean groundBelow(World world, double x, double y, double z, double depth) {
         return world.hasCubes(this.player, x - HALF, y - depth, z - HALF, x + HALF, y, z + HALF);
@@ -661,12 +609,12 @@ public final class AthenaGuard {
         if (this.player == null || this.ctxWorld == null) {
             return "";
