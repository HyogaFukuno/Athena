@@ -778,14 +786,25 @@ public class Chunk {
     }
 
     // Athena start - bucket index maintenance
-    /** The bucket a world X coordinate falls in, clamped to this chunk. */
+    /** The bucket column a world X coordinate falls in, clamped to this chunk. */
     private int bucketOf(double x) {
         int b = MathHelper.floor(x) - (this.locX << 4);
         return b < 0 ? 0 : (b > 15 ? 15 : b);
     }
 
+    /** The bucket row a world Z coordinate falls in, clamped to this chunk. Four blocks deep. */
+    private int bucketOfZ(double z) {
+        int b = (MathHelper.floor(z) - (this.locZ << 4)) >> 2;
+        return b < 0 ? 0 : (b > 3 ? 3 : b);
+    }
+
+    /** The bucket an entity's minimum corner belongs in. */
+    private int bucketIndexOf(double x, double z) {
+        return (this.bucketOf(x) << 2) | this.bucketOfZ(z);
+    }
+
