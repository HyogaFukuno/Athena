diff --git a/src/main/java/net/minecraft/server/PacketPlayInCustomPayload.java b/src/main/java/net/minecraft/server/PacketPlayInCustomPayload.java
index 75799961151bb29aeeb8d9452e3fa9e2c1b86911..767ccc8d45fa876e407ef5b1d32cb9325f5e886b 100644
--- a/src/main/java/net/minecraft/server/PacketPlayInCustomPayload.java
+++ b/src/main/java/net/minecraft/server/PacketPlayInCustomPayload.java
@@ -17,7 +17,12 @@ public class PacketPlayInCustomPayload implements Packet<PacketListenerPlayIn> {
         int i = packetdataserializer.readableBytes();
 
         if (i >= 0 && i <= 32767) {
-            this.data = new PacketDataSerializer(packetdataserializer.readBytes(i));
+            // Athena - into a heap buffer of its own, not one from the channel's pool. readBytes(int) took a
+            // pooled buffer that only the handler's finally gave back: a packet dropped before it got there
+            // (the packet limiter, a closed connection, a player who left) kept it from the pool for good.
+            byte[] bytes = new byte[i];
+            packetdataserializer.readBytes(bytes);
+            this.data = new PacketDataSerializer(io.netty.buffer.Unpooled.wrappedBuffer(bytes));
         } else {
             throw new IOException("Payload may not be larger than 32767 bytes");
         }
