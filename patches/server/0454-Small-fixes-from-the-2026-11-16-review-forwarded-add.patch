diff --git a/src/test/java/net/minecraft/server/AthenaCustomPayloadCopyTest.java b/src/test/java/net/minecraft/server/AthenaCustomPayloadCopyTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..f1403d575f13f923c180e9c6d66d5169d632dd28
--- /dev/null
+++ b/src/test/java/net/minecraft/server/AthenaCustomPayloadCopyTest.java
@@ -0,0 +1,33 @@
+package net.minecraft.server;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+
+import io.netty.buffer.ByteBuf;
+import io.netty.buffer.PooledByteBufAllocator;
+import java.nio.charset.StandardCharsets;
+import org.junit.Test;
+
+/**
+ * Athena - a plugin message's data is a heap copy of its own, not a buffer from the frame's pool: a
+ * packet dropped before its handler (which gives the data back) leaves nothing taken from the pool.
+ */
+public class AthenaCustomPayloadCopyTest {
+
+    @Test
+    public void theDataOutlivesItsFrameAndIsNotPooled() throws Exception {
+        ByteBuf frame = PooledByteBufAllocator.DEFAULT.buffer();
+        PacketDataSerializer out = new PacketDataSerializer(frame);
+        out.writeString("MC|Brand");
+        out.writeBytes("vanilla".getBytes(StandardCharsets.UTF_8));
+
+        PacketPlayInCustomPayload packet = new PacketPlayInCustomPayload();
+        packet.readPacketData(new PacketDataSerializer(frame));
+        frame.release(); // the frame goes back to the pool as soon as the packet is read
+
+        ByteBuf data = packet.getBufferData();
+        assertFalse("not from the pool", data.alloc() instanceof PooledByteBufAllocator);
+        assertEquals("vanilla", data.toString(StandardCharsets.UTF_8));
+        assertEquals("MC|Brand", packet.getChannelName());
+    }
+}
