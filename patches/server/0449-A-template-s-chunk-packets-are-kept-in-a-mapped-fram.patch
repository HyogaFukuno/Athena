diff --git a/src/main/java/net/minecraft/server/AthenaFrameFile.java b/src/main/java/net/minecraft/server/AthenaFrameFile.java
new file mode 100644
index 0000000000000000000000000000000000000000..fbd5e1642fb6bdae88023297098990bcae22f565
--- /dev/null
+++ b/src/main/java/net/minecraft/server/AthenaFrameFile.java
@@ -0,0 +1,247 @@
+package net.minecraft.server;
+
+import java.io.File;
+import java.io.IOException;
+import java.lang.foreign.Arena;
+import java.lang.foreign.MemorySegment;
+import java.lang.foreign.ValueLayout;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.nio.channels.FileChannel;
+import java.nio.file.Files;
+import java.nio.file.StandardCopyOption;
+import java.nio.file.StandardOpenOption;
+import java.util.Arrays;
+import java.util.Map;
+import java.util.TreeMap;
+import org.apache.logging.log4j.LogManager;
+import org.apache.logging.log4j.Logger;
+
+// Athena - a template's compressed chunk packets, in a file mapped into memory beside its section store.
+//
+// Every world on a template sends the same full-chunk packets as long as its chunks are as the
+// template has them, and AthenaChunkPacketCache already shares one packet between the worlds on a
+// template at the same time. But those packets lived on the heap - 8 to 11 MB of compressed frames
+// for a map - and went with the last world on the map, so the next match extracted and deflated
+// every chunk again (3% of what a server of eight rooms allocated) and kept another 8 to 11 MB of
+// heap; and every server on the box held a copy of its own. Here the frames are written, once some
+// have been made, into a file that is mapped read only: the page cache holds them for every server
+// on the box, the garbage collector never sees them, and a match's chunk packets are copied out of
+// the mapping straight onto the wire.
+//
+// A frame depends on the template (the store's fingerprint), on the packet id, the compression level
+// and the compression threshold, and is only used for a chunk still as the template has it, with the
+// same sections present and the same biomes (both kept in the file). All four are in the file's name,
+// so a file is only ever replaced by a new one, renamed into place, never rewritten: a file mapped by
+// a running server keeps its pages until that server lets it go.
+//
+// File layout, little-endian:
+//   header   MAGIC (8), version (4), slots (4), store fingerprint (8), count (4), reserved (4)
+//   entries  count x 24 bytes, ascending slot: slot (4), present mask (4), frame length (4),
+//            reserved (4), offset of the biomes (8)
+//   data     at each offset: 256 bytes of biomes, then the frame
+final class AthenaFrameFile {
+
+    private static final Logger LOGGER = LogManager.getLogger("Athena/FrameFile");
+
+    static final String PREFIX = "athena-frames-";
+    private static final long MAGIC = 0x3130524D46485441L; // "ATHFRM01"
+    private static final int VERSION = 1;
+    private static final int HEADER = 32;
+    private static final int ENTRY = 24;
+    private static final int BIOMES = 256;
+    private static final ValueLayout.OfInt INT_LE = ValueLayout.JAVA_INT_UNALIGNED.withOrder(ByteOrder.LITTLE_ENDIAN);
+    private static final ValueLayout.OfLong LONG_LE = ValueLayout.JAVA_LONG_UNALIGNED.withOrder(ByteOrder.LITTLE_ENDIAN);
+
+    /** -Dathena.disableFrameFiles=true keeps every chunk packet on the heap, as before. */
+    static final boolean ENABLED = !Boolean.getBoolean("athena.disableFrameFiles");
+
+    private final MemorySegment mapping;
+    /** Entry index by slot, -1 for a slot with no frame. */
+    private final int[] index;
+    final int count;
+
+    private AthenaFrameFile(MemorySegment mapping, int[] index, int count) {
+        this.mapping = mapping;
+        this.index = index;
+        this.count = count;
+    }
+
+    static File file(File directory, long fingerprint, int packetId, int level, int threshold) {
+        return new File(directory, String.format("%s%016x-p%d-l%d-t%d.bin", PREFIX, fingerprint, packetId, level, threshold));
+    }
+
+    boolean has(int slot) {
+        return slot >= 0 && slot < this.index.length && this.index[slot] >= 0;
+    }
+
+    /** The packet in {@code slot} as a payload backed by the mapping, or null if the file has none for it. */
+    AthenaChunkPacketCache.Payload payload(int slot) {
+        if (!this.has(slot)) {
+            return null;
+        }
+        long entry = HEADER + (long) this.index[slot] * ENTRY;
+        int mask = this.mapping.get(INT_LE, entry + 4);
+        int length = this.mapping.get(INT_LE, entry + 8);
+        long at = this.mapping.get(LONG_LE, entry + 16);
+        byte[] biomes = this.mapping.asSlice(at, BIOMES).toArray(ValueLayout.JAVA_BYTE);
+
+        return AthenaChunkPacketCache.Payload.mapped(mask, biomes, this.mapping.asSlice(at + BIOMES, length));
+    }
+
+    /** Maps {@code file} if it is a frame file for a store of {@code slots} slots and this fingerprint; else null. */
+    static AthenaFrameFile map(File file, long fingerprint, int slots) {
+        if (!file.isFile()) {
+            return null;
+        }
+        try (FileChannel channel = FileChannel.open(file.toPath(), StandardOpenOption.READ)) {
+            long size = channel.size();
+
+            if (size < HEADER) {
+                return null;
+            }
+            MemorySegment mapping = channel.map(FileChannel.MapMode.READ_ONLY, 0L, size, Arena.ofAuto());
+
+            if (mapping.get(LONG_LE, 0L) != MAGIC || mapping.get(INT_LE, 8L) != VERSION || mapping.get(INT_LE, 12L) != slots
+                    || mapping.get(LONG_LE, 16L) != fingerprint) {
+                return null;
+            }
+            int count = mapping.get(INT_LE, 24L);
+
+            if (count < 0 || count > slots || HEADER + (long) count * ENTRY > size) {
+                return null;
+            }
+            int[] index = new int[slots];
+            Arrays.fill(index, -1);
+            int last = -1;
+
+            for (int i = 0; i < count; ++i) {
+                long entry = HEADER + (long) i * ENTRY;
+                int slot = mapping.get(INT_LE, entry);
+                int length = mapping.get(INT_LE, entry + 8);
+                long at = mapping.get(LONG_LE, entry + 16);
+
+                if (slot <= last || slot >= slots || length <= 0 || at < HEADER + (long) count * ENTRY || at + BIOMES + length > size) {
+                    return null;
+                }
+                index[slot] = i;
+                last = slot;
+            }
+            return new AthenaFrameFile(mapping, index, count);
+        } catch (IOException | RuntimeException e) {
+            LOGGER.warn("Could not map {}", file, e);
+            return null;
+        }
+    }
+
+    /** A frame made on the heap, waiting to be written. */
+    static final class Pending {
+        final int mask;
+        final byte[] biomes;
+        final byte[] frame;
+
+        Pending(int mask, byte[] biomes, byte[] frame) {
+            this.mask = mask;
+            this.biomes = biomes;
+            this.frame = frame;
+        }
+    }
+
+    /**
+     * Writes the frames of {@code old} (if any) and {@code added} into a new file, renamed onto
+     * {@code file}; answers the number written.
+     */
+    static int write(File file, long fingerprint, int slots, AthenaFrameFile old, Map<Integer, Pending> added) throws IOException {
+        TreeMap<Integer, Object> all = new TreeMap<Integer, Object>();
+
+        if (old != null) {
+            for (int slot = 0; slot < old.index.length; ++slot) {
+                if (old.index[slot] >= 0) all.put(slot, Integer.valueOf(old.index[slot]));
+            }
+        }
+        for (Map.Entry<Integer, Pending> entry : added.entrySet()) {
+            if (entry.getValue().biomes.length == BIOMES && entry.getKey() >= 0 && entry.getKey() < slots) {
+                all.put(entry.getKey(), entry.getValue());
+            }
+        }
+
+        File tmp = new File(file.getParentFile(), file.getName() + ".tmp" + ProcessHandle.current().pid());
+
+        try {
+            try (FileChannel out = FileChannel.open(tmp.toPath(), StandardOpenOption.CREATE, StandardOpenOption.TRUNCATE_EXISTING, StandardOpenOption.WRITE)) {
+                int count = all.size();
+                ByteBuffer head = ByteBuffer.allocate(HEADER + count * ENTRY).order(ByteOrder.LITTLE_ENDIAN);
+                long at = HEADER + (long) count * ENTRY;
+
+                head.putLong(MAGIC).putInt(VERSION).putInt(slots).putLong(fingerprint).putInt(count).putInt(0);
+                for (Map.Entry<Integer, Object> entry : all.entrySet()) {
+                    int mask;
+                    int length;
+
+                    if (entry.getValue() instanceof Pending) {
+                        Pending pending = (Pending) entry.getValue();
+                        mask = pending.mask;
+                        length = pending.frame.length;
+                    } else {
+                        long e = HEADER + (long) ((Integer) entry.getValue()) * ENTRY;
+                        mask = old.mapping.get(INT_LE, e + 4);
+                        length = old.mapping.get(INT_LE, e + 8);
+                    }
+                    head.putInt(entry.getKey()).putInt(mask).putInt(length).putInt(0).putLong(at);
+                    at += BIOMES + length;
+                }
+                head.flip();
+                while (head.hasRemaining()) out.write(head);
+                for (Map.Entry<Integer, Object> entry : all.entrySet()) {
+                    ByteBuffer data;
+
+                    if (entry.getValue() instanceof Pending) {
+                        Pending pending = (Pending) entry.getValue();
+                        data = ByteBuffer.allocate(BIOMES + pending.frame.length);
+                        data.put(pending.biomes).put(pending.frame).flip();
+                    } else {
+                        long e = HEADER + (long) ((Integer) entry.getValue()) * ENTRY;
+                        int length = old.mapping.get(INT_LE, e + 8);
+                        long from = old.mapping.get(LONG_LE, e + 16);
+                        data = old.mapping.asSlice(from, BIOMES + length).asByteBuffer();
+                    }
+                    while (data.hasRemaining()) out.write(data);
+                }
+                out.force(false);
+                Files.move(tmp.toPath(), file.toPath(), StandardCopyOption.ATOMIC_MOVE, StandardCopyOption.REPLACE_EXISTING);
+                return count;
+            }
+        } finally {
+            tmp.delete(); // gone already once moved
+        }
+    }
+
+    /** Frame files of other fingerprints in {@code directory}, and leftovers of writes whose process is gone. */
+    static void removeLeftovers(File directory, long fingerprint) {
+        File[] files = directory.listFiles((dir, name) -> name.startsWith(PREFIX));
+
+        if (files == null) {
+            return;
+        }
+        String current = String.format("%s%016x-", PREFIX, fingerprint);
+
+        for (File file : files) {
+            String name = file.getName();
+            int tmp = name.lastIndexOf(".tmp");
+
+            if (tmp >= 0) {
+                try {
+                    long pid = Long.parseLong(name.substring(tmp + 4));
+
+                    if (!ProcessHandle.of(pid).map(ProcessHandle::isAlive).orElse(false)) {
+                        file.delete();
+                    }
+                } catch (NumberFormatException ignored) {
+                    // not one of ours
+                }
+            } else if (!name.startsWith(current)) {
+                file.delete(); // an older template's; a server still mapping it keeps its pages
+            }
+        }
+    }
+}
