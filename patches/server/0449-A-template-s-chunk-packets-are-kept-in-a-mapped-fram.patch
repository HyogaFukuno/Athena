+    // Athena start - the template's frame file; see AthenaFrameFile.
+    //
+    // Looked for once, for the compression this server runs with, and replaced by a newer file each
+    // time enough frames made on the heap have been written to it (recordFrame). Kept by the store,
+    // so between matches too: what it holds on the heap is an index of a few kilobytes; the frames
+    // are address space, paged in as they are sent.
+    private File file; // the store's own file, set by map
+    private volatile boolean framesLooked;
+    private volatile AthenaFrameFile frames;
+    private int framesPacketId = -1, framesLevel, framesThreshold;
+    private final Map<Integer, AthenaFrameFile.Pending> pendingFrames = new ConcurrentHashMap<Integer, AthenaFrameFile.Pending>();
+    private final java.util.concurrent.atomic.AtomicBoolean framesWriting = new java.util.concurrent.atomic.AtomicBoolean();
+    /** How many frames made on the heap are written to the file together. */
+    static int FRAMES_WRITE_AT = 64;
+
+    private AthenaFrameFile frames() {
+        if (!this.framesLooked) {
+            synchronized (this) {
+                if (!this.framesLooked) {
+                    MinecraftServer server = MinecraftServer.getServer();
+                    int threshold = server != null ? server.aK() : framesThresholdForTest;
+
+                    if (AthenaFrameFile.ENABLED && this.file != null && threshold >= 0 && !AthenaIndexAudit.enabled()) {
+                        Integer id = EnumProtocol.PLAY.getPacketId(EnumProtocolDirection.CLIENTBOUND, new PacketPlayOutMapChunk());
+                        this.framesPacketId = id != null ? id : -1;
+                        this.framesLevel = PacketCompressor.level();
+                        this.framesThreshold = threshold;
+                        if (this.framesPacketId >= 0) {
+                            this.frames = AthenaFrameFile.map(this.framesFile(), this.fingerprint(), this.keys.length * 2);
+                        }
+                    }
+                    this.framesLooked = true;
+                }
+            }
+        }
+        return this.frames;
+    }
+
+    private File framesFile() {
+        return AthenaFrameFile.file(this.file.getParentFile(), this.fingerprint(), this.framesPacketId, this.framesLevel, this.framesThreshold);
+    }
+
+    /** A frame made on the heap for a packet shared under {@code slot}: written to the frame file with the next ones. */
+    void recordFrame(int slot, AthenaChunkPacketCache.Payload payload, int packetId, int threshold) {
+        this.frames();
+        if (this.framesPacketId < 0 || packetId != this.framesPacketId || threshold != this.framesThreshold) {
+            return; // not the compression the file is for
+        }
+        AthenaFrameFile frames = this.frames;
+        byte[] frame = payload.frame;
+
+        if (frame == null || slot < 0 || (frames != null && frames.has(slot)) || payload.biomes.length != 256) {
+            return;
+        }
+        this.pendingFrames.put(slot, new AthenaFrameFile.Pending(payload.presentMask, payload.biomes, frame));
+        if (this.pendingFrames.size() >= FRAMES_WRITE_AT && this.framesWriting.compareAndSet(false, true)) {
+            try {
+                BUILDER.execute(this::writeFrames);
+            } catch (RuntimeException e) {
+                this.framesWriting.set(false);
+            }
+        }
+    }
+
+    private void writeFrames() {
+        try {
+            Map<Integer, AthenaFrameFile.Pending> batch = new HashMap<Integer, AthenaFrameFile.Pending>(this.pendingFrames);
+            File target = this.framesFile();
+            int slots = this.keys.length * 2;
+            int written = AthenaFrameFile.write(target, this.fingerprint(), slots, this.frames, batch);
+            AthenaFrameFile mapped = AthenaFrameFile.map(target, this.fingerprint(), slots);
+
+            if (mapped != null) {
+                this.frames = mapped;
+                for (Integer slot : batch.keySet()) {
+                    this.pendingFrames.remove(slot, batch.get(slot));
+                }
+                AthenaFrameFile.removeLeftovers(target.getParentFile(), this.fingerprint());
+                LOGGER.info("Wrote {} chunk packets to {}", written, target.getName());
+            }
+        } catch (Throwable t) {
+            LOGGER.warn("Could not write the chunk packets of {}: they stay on the heap", this.file, t);
+            this.pendingFrames.clear();
+        } finally {
+            this.framesWriting.set(false);
+        }
+    }
+
+    /** For tests, which run with no server: the compression threshold frame files are for (-1: none). */
+    static volatile int framesThresholdForTest = -1;
+
+    /** Writes what is recorded now; for tests. */
+    void writeFramesForTest() {
+        this.writeFrames();
+    }
+
+    /** Forgets the packets the worlds share, as when the last of them unloads; for tests. */
+    void forgetPacketsForTest() {
+        this.packets = null;
+    }
+    // Athena end
