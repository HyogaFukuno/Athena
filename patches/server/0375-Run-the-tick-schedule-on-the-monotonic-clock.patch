@@ -578,14 +578,27 @@ public abstract class MinecraftServer implements Runnable, ICommandListener, IAs
 
     // PandaSpigot start - New Tick Loop System
     private boolean isAheadOfTime() {
-        return az() < this.ab;
+        return System.nanoTime() - this.athenaNextTick < 0L; // Athena
