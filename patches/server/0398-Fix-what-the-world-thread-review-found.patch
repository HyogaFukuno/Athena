index 0000000000000000000000000000000000000000..f80c1f40b5f0d81003006d8bc93e4ea138f18ca3
--- /dev/null
+++ b/src/test/java/net/minecraft/server/AthenaWorldThreadsReviewTest.java
@@ -0,0 +1,263 @@
+package net.minecraft.server;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+
+import java.lang.reflect.Field;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Random;
+import java.util.concurrent.ConcurrentLinkedQueue;
+import java.util.concurrent.CopyOnWriteArrayList;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.concurrent.atomic.AtomicReference;
+import org.bukkit.support.AbstractTestingBase;
+import org.junit.After;
+import org.junit.Before;
+import org.junit.Test;
+
+/** The world thread review of 2026-11-05 (audit/2026-11-05/world-threads-review): each finding, as a test. */
+public class AthenaWorldThreadsReviewTest extends AbstractTestingBase {
+
+    /** A server that is never started; only its per-world tick body is replaced. */
+    public static final class Server extends DedicatedServer {
+        private Server() { super(null); }
+        @Override public void athenaTickWorld(WorldServer world) { }
+    }
+
+    private Object previousServer;
+    private Object previousStarted;
+
+    private static Object get(Object target, Class<?> type, String name) throws Exception {
+        Field field = type.getDeclaredField(name);
+        field.setAccessible(true);
+        return field.get(target);
+    }
+
+    @Before
+    public void remember() throws Exception {
+        this.previousServer = get(null, MinecraftServer.class, "l");
+        this.previousStarted = get(null, AthenaWorldThread.class, "started");
+    }
+
+    @After
+    public void restore() throws Exception {
+        AthenaAuditFixtures.set(null, MinecraftServer.class, "l", this.previousServer);
+        AthenaAuditFixtures.set(null, AthenaWorldThread.class, "started", this.previousStarted);
+        org.spigotmc.AsyncCatcher.enabled = true;
+    }
+
+    private static Server server() throws Exception {
+        Server server = AthenaAuditFixtures.allocate(Server.class);
+        AthenaAuditFixtures.set(server, MinecraftServer.class, "primaryThread", Thread.currentThread());
+        AthenaAuditFixtures.set(server, MinecraftServer.class, "serverThread", Thread.currentThread());
+        AthenaAuditFixtures.set(server, MinecraftServer.class, "stopLock", new Object());
+        AthenaAuditFixtures.set(server, MinecraftServer.class, "athenaStopDone", new CountDownLatch(1));
+        AthenaAuditFixtures.set(null, MinecraftServer.class, "l", server);
+        server.worlds = new CopyOnWriteArrayList<>();
+        server.processQueue = new ConcurrentLinkedQueue<>();
+        return server;
+    }
+
+    private static WorldServer world(Server server) throws Exception {
+        WorldServer world = AthenaAuditFixtures.allocate(WorldServer.class);
+        AthenaAuditFixtures.set(world, WorldServer.class, "server", server);
+        AthenaAuditFixtures.set(world, World.class, "players", new ArrayList<>());
+        AthenaAuditFixtures.set(world, World.class, "seaLevel", 63);
+        world.worldData = new WorldData();
+        world.worldData.setWorldName("review");
+        server.worlds.add(world);
+        return world;
+    }
+
+    private static void await(CountDownLatch latch) {
+        try {
+            assertTrue("timed out", latch.await(10L, TimeUnit.SECONDS));
+        } catch (InterruptedException exception) {
+            throw new AssertionError(exception);
+        }
+    }
+
+    // 1: the JVM's shutdown hook
+    @Test
+    public void theShutdownHookStopsTheServerFromAnotherThread() throws Exception {
+        Server server = server();
+        world(server);
+        AthenaAuditFixtures.set(server, MinecraftServer.class, "N", true); // past the world threads, nothing to save in this fixture
+        AtomicReference<Throwable> failure = new AtomicReference<>();
+        Thread hook = new Thread(() -> {
+            try {
+                server.athenaStopFromShutdownHook(50L);
+            } catch (Throwable throwable) {
+                failure.set(throwable);
+            }
+        }, "shutdown-hook");
+        hook.start();
+        hook.join();
+        assertNull(failure.get());
+        assertEquals(true, get(server, MinecraftServer.class, "hasStopped"));
+        assertFalse("it asks the server thread first", server.isRunning());
+    }
+
+    @Test
+    public void aWorldsThreadStopsFromTheShutdownHook() throws Exception {
+        WorldServer world = world(server());
+        AtomicReference<Throwable> failure = new AtomicReference<>();
+        Thread hook = new Thread(() -> {
+            try {
+                assertTrue(world.athenaStopThreadForShutdown(100L));
+            } catch (Throwable throwable) {
+                failure.set(throwable);
+            }
+        }, "shutdown-hook");
+        hook.start();
+        hook.join();
+        assertNull(failure.get());
+    }
+
+    // 2: potions with no effects
+    @Test
+    public void aPotionWithNoEffectsHasNoneTwice() {
+        for (int data : new int[] {0, 16, 32, 64}) {
+            assertNull(Items.POTION.getEffects(data));
+            assertNull("from the cache", Items.POTION.getEffects(data));
+        }
+        assertNotNull(Items.POTION.getEffects(8193));
+    }
+
+    // 3: the online list, shrunk by other threads
+    private static final class SnapshotOnly extends CopyOnWriteArrayList<EntityPlayer> {
+        @Override public int size() { throw new AssertionError("size() and get(i) see different lists"); }
+        @Override public EntityPlayer get(int index) { throw new AssertionError("size() and get(i) see different lists"); }
+    }
+
+    @Test
+    public void theOnlineListIsReadFromOneSnapshot() throws Exception {
+        DedicatedPlayerList list = AthenaAuditFixtures.allocate(DedicatedPlayerList.class);
+        AthenaAuditFixtures.set(list, PlayerList.class, "players", new SnapshotOnly());
+        assertEquals(0, list.getAllUsernames().length);
+        assertEquals(0, list.getAllProfiles().length);
+        list.savePlayers();
+        list.sendAll(null);
+    }
+
+    // 4: strongholds generated at once
+    @Test
+    public void strongholdsStartInParallel() throws Exception {
+        Server server = server();
+        CountDownLatch go = new CountDownLatch(1);
+        AtomicReference<Throwable> failure = new AtomicReference<>();
+        AtomicInteger completed = new AtomicInteger();
+        List<Thread> threads = new ArrayList<>();
+        for (int n = 0; n < 4; ++n) {
+            final int seed = n;
+            final WorldServer own = world(server);
+            Thread thread = new Thread(() -> {
+                await(go);
+                for (int i = 0; i < 300 && failure.get() == null; ++i) {
+                    try {
+                        new WorldGenStronghold.WorldGenStronghold2Start(own, new Random(seed * 300L + i), 0, 0);
+                        completed.incrementAndGet();
+                    } catch (Throwable throwable) {
+                        failure.compareAndSet(null, throwable);
+                    }
+                }
+            }, "stronghold-" + n);
+            threads.add(thread);
+            thread.start();
+        }
+        go.countDown();
+        for (Thread thread : threads) thread.join();
+        assertNull(failure.get());
+        assertEquals(1200, completed.get());
+    }
+
+    // 5: a task queued before the world got its thread
+    @Test
+    public void aTaskQueuedBeforeAThreadRunsOnThatThread() throws Exception {
+        Server server = server();
+        world(server); // the main world cannot have a thread
+        WorldServer world = world(server);
+        CountDownLatch ran = new CountDownLatch(1);
+        AtomicReference<Boolean> owned = new AtomicReference<>();
+        world.athenaRunOnTickThread(() -> {
+            owned.set(world.isMainThread() && Thread.currentThread() != server.primaryThread);
+            ran.countDown();
+        });
+        AthenaAuditFixtures.set(null, AthenaWorldThread.class, "started", true);
+        world.athenaStartThread();
+        try {
+            server.processQueue.remove().run();
+            await(ran);
+            assertEquals(true, owned.get());
+        } finally {
+            world.athenaStopThread(2000L);
+        }
+    }
+
+    // 6: the world's clock through a change of thread
+    @Test
+    public void aWorldsClockSurvivesAThread() throws Exception {
+        Server server = server();
+        world(server);
+        WorldServer world = world(server);
+        world.athenaCurrentTick = 1000;
+        AthenaAuditFixtures.set(null, AthenaWorldThread.class, "started", true);
+        world.athenaStartThread();
+        assertTrue("not set to the server's clock", world.athenaCurrentTick >= 1000);
+        world.athenaStopThread(2000L);
+        int back = world.athenaCurrentTick;
+        assertTrue(back >= 1000);
+    }
+
+    // 7: crafting on two world threads at once
+    @Test
+    public void fireworksCraftOnTwoThreadsAtOnce() throws Exception {
+        RecipeFireworks recipe = (RecipeFireworks) CraftingManager.getInstance().getRecipes().stream()
+                .filter(r -> r instanceof RecipeFireworks).findFirst().get();
