     private final Object stopLock = new Object();
     // CraftBukkit end
 
+    // Athena start - the JVM's shutdown hook (SIGTERM, Ctrl+C). Everything the stop touches belongs to the
+    // server thread, which is still running, so it is asked to stop and does it itself, as for /stop.
+    // Only if it is stuck or gone does the hook stop the server from here, with thread checks off.
+    /** How long the shutdown hook waits for the server thread to stop the server. */
+    private static final long ATHENA_HOOK_WAIT_MILLIS = 30000L;
+    private final java.util.concurrent.CountDownLatch athenaStopDone = new java.util.concurrent.CountDownLatch(1);
+
+    public void athenaStopFromShutdownHook() throws ExceptionWorldConflict, InterruptedException {
+        this.athenaStopFromShutdownHook(ATHENA_HOOK_WAIT_MILLIS);
+    }
+
+    void athenaStopFromShutdownHook(long waitMillis) throws ExceptionWorldConflict, InterruptedException {
+        Thread main = this.primaryThread;
+        if (main != null && main.isAlive() && main != Thread.currentThread()) {
+            this.safeShutdown();
+            long end = System.currentTimeMillis() + waitMillis;
+            while (main.isAlive() && System.currentTimeMillis() < end) {
+                if (this.athenaStopDone.await(100L, java.util.concurrent.TimeUnit.MILLISECONDS)) return;
+            }
+            if (this.athenaStopDone.getCount() == 0L) return;
+            LOGGER.warn("The server thread did not stop the server: stopping from the shutdown hook");
+        }
+        org.spigotmc.AsyncCatcher.enabled = false; // no owner thread is left to run on
+        this.stop();
+    }
+    // Athena end
+
     public void stop() throws ExceptionWorldConflict { // CraftBukkit - added throws
         // CraftBukkit start - prevent double stopping on multiple threads
         synchronized(stopLock) {
