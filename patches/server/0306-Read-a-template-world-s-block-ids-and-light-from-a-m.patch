+import static org.junit.Assert.assertTrue;
+
+import java.io.DataOutputStream;
+import java.io.File;
+import java.nio.file.Files;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Random;
+import org.bukkit.support.AbstractTestingBase;
+import org.junit.Test;
+
+/**
+ * Athena - a template section read from its mapped store reads exactly as one loaded from NBT,
+ * and a write to it changes the section's own heap copy and nothing else.
+ */
+public class AthenaSectionStoreTest extends AbstractTestingBase {
+
+    private static final int STONE = Block.getStateId(Blocks.STONE.getBlockData());
+
+    /** Every state id the server knows, to build sections of many states from. */
+    private static List<Integer> states() {
+        List<Integer> states = new ArrayList<Integer>();
+
+        for (Object state : Block.BLOCK_STATE_IDS) {
+            states.add(Block.getStateId((IBlockData) state));
+        }
+        return states;
+    }
+
+    /** Blocks, Data and light for one section: the kinds of content the store tells apart. */
+    private static NBTTagCompound section(int y, int kind, Random random) {
+        List<Integer> states = states();
+        int[] palette;
+
+        switch (kind) {
+            case 0: palette = new int[] {STONE}; break;                              // uniform
+            case 1: palette = new int[] {0, STONE, states.get(40), states.get(90)}; break; // packed
+            default:                                                                  // raw
+                palette = new int[60];
+                for (int i = 0; i < palette.length; ++i) {
+                    palette[i] = states.get(random.nextInt(states.size()));
+                }
+        }
+
+        byte[] blocks = new byte[4096];
+        NibbleArray data = new NibbleArray();
+
+        for (int i = 0; i < 4096; ++i) {
+            int state = palette[random.nextInt(palette.length)];
+
+            blocks[i] = (byte) (state >> 4);
+            data.set(i & 15, i >> 8 & 15, i >> 4 & 15, state & 15);
+        }
+
+        byte[] blockLight = new byte[2048];
+        byte[] skyLight = new byte[2048];
+
+        if (kind == 2) {
+            random.nextBytes(blockLight);
+        }
+        if (kind == 1) {
+            java.util.Arrays.fill(skyLight, (byte) 0xFF);
+        } else if (kind == 2) {
+            random.nextBytes(skyLight);
+        }
+
+        NBTTagCompound section = new NBTTagCompound();
+
+        section.setByte("Y", (byte) y);
+        section.setByteArray("Blocks", blocks);
+        section.setByteArray("Data", data.getData());
+        section.setByteArray("BlockLight", blockLight);
+        section.setByteArray("SkyLight", skyLight);
+        return section;
+    }
+
+    private static NBTTagCompound chunk(int x, int z, Random random) {
+        NBTTagList sections = new NBTTagList();
+
+        for (int y = 0; y < 3; ++y) {
+            sections.add(section(y, Math.floorMod(x + z + y, 3), random));
+        }
+
+        NBTTagCompound level = new NBTTagCompound();
+
+        level.setInt("xPos", x);
+        level.setInt("zPos", z);
+        level.set("Sections", sections);
+
+        NBTTagCompound root = new NBTTagCompound();
+
+        root.set("Level", level);
+        return root;
+    }
+
+    private static File template(long seed) throws Exception {
+        File dir = Files.createTempDirectory("athena-store").toFile();
+        File regionDir = new File(dir, "region");
+
+        regionDir.mkdirs();
+        RegionFile region = new RegionFile(new File(regionDir, "r.-1.0.mca"));
+        Random random = new Random(seed);
+
+        for (int x = 0; x < 32; x += 7) {
+            for (int z = 0; z < 32; z += 9) {
+                try (DataOutputStream out = region.getChunkDataOutputStream(x, z)) {
+                    NBTCompressedStreamTools.write(chunk(-32 + x, z, random), (java.io.DataOutput) out);
+                }
+            }
+        }
+        region.close();
+        return dir;
+    }
+
+    private static AthenaSectionStore built(File dir) throws Exception {
+        assertNull("no store before one is built", AthenaSectionStore.open(dir));
+        AthenaSectionStore.awaitBuilds();
+
+        AthenaSectionStore store = AthenaSectionStore.open(dir);
+
+        assertNotNull(store);
+        return store;
+    }
+
+    private static ChunkSection fromNbt(NBTTagCompound nbt) {
+        ChunkSection section = new ChunkSection(nbt.getByte("Y") << 4, true);
+
+        section.setDataSharingUniform(ChunkRegionLoader.athenaSectionIds(nbt));
+        section.setBlocklightArray(NibbleArray.light(nbt.getByteArray("BlockLight")));
+        section.setSkylightArray(NibbleArray.light(nbt.getByteArray("SkyLight")));
+        section.recalcBlockCounts();
+        return section;
+    }
+
+    private static void assertSameContent(String where, ChunkSection expected, ChunkSection actual) {
+        for (int i = 0; i < 4096; ++i) {
+            int x = i & 15, y = i >> 8, z = i >> 4 & 15;
+
+            assertSame(where + " state at " + i, expected.getType(x, y, z), actual.getType(x, y, z));
+            assertEquals(where + " block light at " + i, expected.getExtBlocklightValue(x, y, z), actual.getExtBlocklightValue(x, y, z));
+            assertEquals(where + " sky light at " + i, expected.getExtSkylightValue(x, y, z), actual.getExtSkylightValue(x, y, z));
+        }
+        assertArrayEquals(where + " ids", expected.getIdArray(), actual.getIdArray());
+        assertArrayEquals(where + " block light", expected.getEmittedLightArray().getData(), actual.getEmittedLightArray().getData());
+        assertArrayEquals(where + " sky light", expected.getSkyLightArray().getData(), actual.getSkyLightArray().getData());
+        assertEquals(where + " empty", expected.isEmpty(), actual.isEmpty());
+        assertEquals(where + " ticks", expected.shouldTick(), actual.shouldTick());
+    }
+
+    @Test
+    public void aStoredSectionReadsAsItsNbt() throws Exception {
+        File dir = template(1L);
+        AthenaSectionStore store = built(dir);
+        AthenaTemplateRegion region = AthenaTemplateRegion.open(new File(dir, "region/r.-1.0.mca"));
+        int mapped = 0;
+
+        for (int x = 0; x < 32; x += 7) {
+            for (int z = 0; z < 32; z += 9) {
+                NBTTagList sections = region.read(x, z).getCompound("Level").getList("Sections", 10);
+
+                for (int k = 0; k < sections.size(); ++k) {
+                    NBTTagCompound nbt = sections.get(k);
+                    ChunkSection section = new ChunkSection(nbt.getByte("Y") << 4, true);
+
+                    assertTrue(store.apply(-32 + x, z, nbt.getByte("Y"), section, true));
+                    section.recalcBlockCounts();
+                    assertSameContent((-32 + x) + "," + nbt.getByte("Y") + "," + z, fromNbt(nbt), section);
+                    if (section.isMapped()) {
+                        ++mapped;
+                    }
+                }
+            }
+        }
+        region.close();
+        assertTrue("packed and raw sections are mapped", mapped > 0);
+
+        assertFalse("no chunk there", store.apply(5, 5, 0, new ChunkSection(0, true), true));
+    }
+
+    @Test
+    public void aWriteChangesOnlyTheSectionsOwnCopy() throws Exception {
+        File dir = template(2L);
+        AthenaSectionStore store = built(dir);
+
+        int checked = 0;
+
+        for (int y = 0; y < 3; ++y) {
+            ChunkSection first = new ChunkSection(y << 4, true);
+            ChunkSection second = new ChunkSection(y << 4, true);
+
+            assertTrue(store.apply(-32, 0, y, first, true));
+            assertTrue(store.apply(-32, 0, y, second, true));
+            first.recalcBlockCounts();
+            second.recalcBlockCounts();
+            if (!first.isMapped()) {
+                continue; // a uniform section shares its ids the way a load from NBT does
+            }
+            ++checked;
+
+            IBlockData before = first.getType(3, 4, 5);
+            IBlockData glass = Blocks.GLASS.getBlockData();
+
+            first.setType(3, 4, 5, glass);
+            assertFalse("written ids are on the heap", first.isMapped());
+            assertSame(glass, first.getType(3, 4, 5));
+            assertSame("the other loaded copy is untouched", before, second.getType(3, 4, 5));
+            assertSame(second.getType(4, 4, 5), first.getType(4, 4, 5));
+
+            // light: a write of the value already there copies nothing; any other value copies
+            NibbleArray light = first.getSkyLightArray();
+            int sky = first.getExtSkylightValue(1, 2, 3);
+            boolean wasMapped = light.isMapped();
+
+            first.setExtSkylightValue(1, 2, 3, sky);
+            assertEquals("an unchanged write copies nothing", wasMapped, light.isMapped());
+            first.setExtSkylightValue(1, 2, 3, (sky + 1) & 15);
+            assertFalse(light.isMapped());
+            assertEquals((sky + 1) & 15, first.getExtSkylightValue(1, 2, 3));
+            assertEquals("the other loaded copy is untouched", sky, second.getExtSkylightValue(1, 2, 3));
+            assertEquals(second.getExtSkylightValue(2, 2, 3), first.getExtSkylightValue(2, 2, 3));
+        }
+        assertTrue("a mapped section was written", checked > 0);
+    }
+
+    @Test
+    public void aChangedTemplateIsRebuilt() throws Exception {
+        File dir = template(3L);
+
+        built(dir);
+
+        File region = new File(dir, "region/r.-1.0.mca");
+
+        assertTrue(region.setLastModified(region.lastModified() - 60000L));
+        assertNull("the store no longer matches its region files", AthenaSectionStore.open(dir));
+        AthenaSectionStore.awaitBuilds();
+        assertNotNull("and is rebuilt", AthenaSectionStore.open(dir));
+    }
+}
