+            BlobWriter blobs = new BlobWriter(out, HEADER);
+            Map<Long, long[]> table = new HashMap<Long, long[]>();
+
+            for (Map.Entry<Long, List<SectionData>> chunk : chunks.entrySet()) {
+                table.put(chunk.getKey(), entries(blobs, chunk.getValue()));
+            }
