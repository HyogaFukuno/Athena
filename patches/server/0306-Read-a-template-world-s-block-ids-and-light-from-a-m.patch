+                hash = (hash ^ word) * 0x9E3779B97F4A7C15L;
+                hash ^= hash >>> 31;
+            }
+            return hash;
+        }
+    }
+
+    private static void writeFully(FileChannel out, ByteBuffer buffer, long position) throws IOException {
+        long at = position;
+
+        while (buffer.hasRemaining()) {
+            at += out.write(buffer, at);
+        }
+    }
+}
