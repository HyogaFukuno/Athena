+     * reused, so a hash collision can only cost a duplicate.
+     */
+    static final class BlobWriter {
+        private final FileChannel out;
+        private final Map<Long, long[]> written = new HashMap<Long, long[]>();
+        private long end;
+
+        BlobWriter(FileChannel out, long start) {
+            this.out = out;
+            this.end = start;
+        }
