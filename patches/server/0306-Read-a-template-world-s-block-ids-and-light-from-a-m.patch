diff --git a/src/main/java/net/minecraft/server/AthenaSectionStore.java b/src/main/java/net/minecraft/server/AthenaSectionStore.java
new file mode 100644
index 0000000000000000000000000000000000000000..e7b9ebc10bfd7d9e411ae433dd71dd01ca00b99d
--- /dev/null
+++ b/src/main/java/net/minecraft/server/AthenaSectionStore.java
@@ -0,0 +1,685 @@
+package net.minecraft.server;
+
+import java.io.File;
+import java.io.IOException;
+import java.lang.foreign.Arena;
+import java.lang.foreign.MemorySegment;
+import java.lang.foreign.ValueLayout;
+import java.lang.ref.WeakReference;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.nio.channels.FileChannel;
+import java.nio.file.Files;
+import java.nio.file.StandardCopyOption;
+import java.nio.file.StandardOpenOption;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import org.apache.logging.log4j.LogManager;
+import org.apache.logging.log4j.Logger;
+
+// Athena - a template world's block ids and light, read straight from a file mapped into memory.
+//
+// A match map is read only, and almost all of it stays as the template has it for the whole match.
+// Loading it the ordinary way put every section's ids and light on the Java heap - 25 to 48 MB for
+// the pinned square of a production map, about 85% of what a loaded map costs - so the heap had to
+// be sized for the largest map, and the largest map's square had to be cut to fit the heap.
+//
+// This keeps them in a file next to the template's region files instead, built once from those
+// files and mapped read only. A section loaded from it holds slices of the mapping and no arrays of
+// its own; the first write to its ids or to one of its light arrays copies that part onto the heap
+// (see ChunkSection and NibbleArray), so a match still changes its own copy and nothing else. The
+// mapped pages belong to the page cache: every server on the box that loads the same template reads
+// the same physical memory, the garbage collector never scans or copies them, and pages nobody
+// touches are never read in.
+//
+// The ids in the file are converted by ChunkRegionLoader.athenaSectionIds, the same conversion a
+// load from NBT uses, so a section reads the same through either path; the index audit compares
+// the two at load. The file records the size and modification time of every region file it was
+// built from and is rebuilt when they change.
+//
+// File layout, little-endian:
+//   header   MAGIC (8), version (4), chunk count (4), source fingerprint (8), key table offset (8)
+//   blobs    2048-byte packed ids (with a 16-char palette in front), 8192-byte raw ids, 2048-byte
+//            light arrays, each 64-byte aligned and stored once however many sections share it
+//   keys     chunk count longs, chunk x << 32 | z, ascending
+//   entries  per chunk, 16 sections x 3 longs: ids, block light, sky light (see the KIND_ codes)
+final class AthenaSectionStore {
+
+    private static final Logger LOGGER = LogManager.getLogger("Athena/SectionStore");
+
+    static final String FILE_PREFIX = "athena-sections-";
+    static final String FILE_SUFFIX = ".bin";
+    private static final long MAGIC = 0x3130434553485441L; // "ATHSEC01"
+    private static final int VERSION = 1;
+    private static final int HEADER = 32;
+
+    // an entry's kind is its top byte, its value the low 48 bits
+    static final int KIND_ABSENT = 0;     // no such section, or no sky light stored for it
+    static final int KIND_UNIFORM = 1;    // ids: one state everywhere, the state id in the value
+    static final int KIND_PACKED = 2;     // ids: <= 16 states; palette size in bits 48-55 is kept in the blob
+    static final int KIND_RAW = 3;        // ids: a char per block
+    static final int KIND_ZERO = 4;       // light: every nibble 0
+    static final int KIND_FULL = 5;       // light: every nibble 15
+    static final int KIND_LIGHT = 6;      // light: a 2048-byte array
+
+    static final ValueLayout.OfChar CHAR_LE = ValueLayout.JAVA_CHAR_UNALIGNED.withOrder(ByteOrder.LITTLE_ENDIAN);
+    private static final ValueLayout.OfLong LONG_LE = ValueLayout.JAVA_LONG_UNALIGNED.withOrder(ByteOrder.LITTLE_ENDIAN);
+
+    // one mapping per file per process: consecutive matches on a map share it while it is in use
+    private static final Map<String, WeakReference<AthenaSectionStore>> OPEN = new ConcurrentHashMap<String, WeakReference<AthenaSectionStore>>();
+    private static final Map<String, Boolean> BUILDING = new ConcurrentHashMap<String, Boolean>();
+    private static final ExecutorService BUILDER = Executors.newSingleThreadExecutor(runnable -> {
+        Thread thread = new Thread(runnable, "Athena Section Store Builder");
+
+        thread.setDaemon(true);
+        thread.setPriority(Thread.MIN_PRIORITY);
+        return thread;
+    });
+
+    private final MemorySegment mapping;
+    private final long[] keys;
+    private final long entries;
+
+    private AthenaSectionStore(MemorySegment mapping, long[] keys, long entries) {
+        this.mapping = mapping;
+        this.keys = keys;
+        this.entries = entries;
+    }
+
+    /**
+     * The store for this template directory (the one holding region/), or null if there is none
+     * that matches its region files yet - in which case one is built in the background, for the
+     * next time the template is loaded.
+     */
+    static AthenaSectionStore open(File directory) {
+        long fingerprint;
+
+        try {
+            fingerprint = fingerprint(directory);
+        } catch (IOException e) {
+            return null;
+        }
+
+        File file = file(directory, fingerprint);
+        String path = file.getAbsolutePath();
+
+        WeakReference<AthenaSectionStore> reference = OPEN.get(path);
+        AthenaSectionStore store = reference != null ? reference.get() : null;
+
+        if (store != null && store.fingerprint() == fingerprint) {
+            return store;
+        }
+
+        store = file.isFile() ? map(file, fingerprint) : null;
+        if (store != null) {
+            OPEN.put(path, new WeakReference<AthenaSectionStore>(store));
+            return store;
+        }
+
+        if (BUILDING.putIfAbsent(path, Boolean.TRUE) == null) {
+            BUILDER.execute(() -> {
+                try {
+                    long started = System.nanoTime();
+                    int chunks = build(directory, file, fingerprint);
+
+                    LOGGER.info("Built {} for {} chunks of {} in {} ms", file.getName(), chunks, directory.getName(), (System.nanoTime() - started) / 1000000L);
+                    removeLeftovers(directory, file);
+                } catch (Throwable t) {
+                    LOGGER.warn("Could not build {} for {}: the template keeps loading onto the heap", file.getName(), directory, t);
+                } finally {
+                    BUILDING.remove(path);
+                }
+            });
+        }
+        return null;
+    }
+
+    /** Waits for any store being built; for tests. */
+    static void awaitBuilds() throws InterruptedException {
+        while (!BUILDING.isEmpty()) {
+            Thread.sleep(10L);
+        }
+    }
+
+    /**
+     * The store for a template as of this fingerprint. The name carries the fingerprint so that a
+     * store is only ever replaced by a new file, never rewritten in place: a mapped file that is
+     * truncated or overwritten under a running server faults its reads. Keep it that way when
+     * copying maps around - rsync (which renames) is fine, cp or scp over a live file is not.
+     */
+    static File file(File directory, long fingerprint) {
+        return new File(directory, String.format("%s%016x%s", FILE_PREFIX, fingerprint, FILE_SUFFIX));
+    }
+
+    /**
+     * Stores built for older contents of the template, and temporary files of builds whose process
+     * is gone. Unlinking a store a running server still has mapped is harmless: the mapping keeps
+     * the old file's pages until it is let go.
+     */
+    private static void removeLeftovers(File directory, File current) {
+        File[] files = directory.listFiles((dir, name) -> name.startsWith(FILE_PREFIX));
+
+        if (files == null) {
+            return;
+        }
+        for (File file : files) {
+            String name = file.getName();
+            int tmp = name.lastIndexOf(".tmp");
+
+            if (tmp >= 0) {
+                try {
+                    long pid = Long.parseLong(name.substring(tmp + 4));
+
+                    if (ProcessHandle.of(pid).map(ProcessHandle::isAlive).orElse(false)) {
+                        continue; // another server is building it right now
+                    }
+                } catch (NumberFormatException ignored) {
+                    // not one of ours: leave it alone
+                    continue;
+                }
+                file.delete();
+            } else if (name.endsWith(FILE_SUFFIX) && !file.equals(current)) {
+                file.delete();
+            }
+        }
+    }
+
+    private long fingerprint() {
+        return this.mapping.get(LONG_LE, 16L);
+    }
+
+    private static AthenaSectionStore map(File file, long fingerprint) {
+        try (FileChannel channel = FileChannel.open(file.toPath(), StandardOpenOption.READ)) {
+            long size = channel.size();
+
+            if (size < HEADER) {
+                return null;
+            }
+            // an automatic arena: the mapping lives exactly as long as some section still holds a
+            // slice of it, so a world that unloads lets it go with no close to forget
+            MemorySegment mapping = channel.map(FileChannel.MapMode.READ_ONLY, 0L, size, Arena.ofAuto());
+
+            if (mapping.get(LONG_LE, 0L) != MAGIC || mapping.get(ValueLayout.JAVA_INT_UNALIGNED.withOrder(ByteOrder.LITTLE_ENDIAN), 8L) != VERSION
+                    || mapping.get(LONG_LE, 16L) != fingerprint) {
+                return null;
+            }
+
+            int count = mapping.get(ValueLayout.JAVA_INT_UNALIGNED.withOrder(ByteOrder.LITTLE_ENDIAN), 12L);
+            long keysAt = mapping.get(LONG_LE, 24L);
+
+            if (count < 0 || keysAt < HEADER || keysAt + (long) count * 8L * (1L + 48L) > size) {
+                return null;
+            }
+
+            long[] keys = new long[count];
+
+            for (int i = 0; i < count; ++i) {
+                keys[i] = mapping.get(LONG_LE, keysAt + (long) i * 8L);
+            }
+            return new AthenaSectionStore(mapping, keys, keysAt + (long) count * 8L);
+        } catch (IOException | RuntimeException e) {
+            LOGGER.warn("Could not map {}", file, e);
+            return null;
+        }
+    }
+
+    static long key(int chunkX, int chunkZ) {
+        return (long) chunkX << 32 | chunkZ & 0xFFFFFFFFL;
+    }
+
+    /**
+     * Fills a freshly constructed section from the store: its ids and light, as a load from NBT
+     * would have set them. False if the store has nothing for it (or no sky light where the world
+     * has sky); the caller then loads the section from NBT as before.
+     */
+    boolean apply(int chunkX, int chunkZ, int sectionY, ChunkSection section, boolean sky) {
+        int index = Arrays.binarySearch(this.keys, key(chunkX, chunkZ));
+
+        if (index < 0 || sectionY < 0 || sectionY >= 16) {
+            return false;
+        }
+
+        long at = this.entries + ((long) index * 16L + sectionY) * 24L;
+        long ids = this.mapping.get(LONG_LE, at);
+        long blockLight = this.mapping.get(LONG_LE, at + 8L);
+        long skyLight = this.mapping.get(LONG_LE, at + 16L);
+
+        if (kind(ids) == KIND_ABSENT || kind(blockLight) == KIND_ABSENT || sky && kind(skyLight) == KIND_ABSENT) {
+            return false;
+        }
+
+        switch (kind(ids)) {
+            case KIND_UNIFORM:
+                section.athenaSetUniformIds((char) value(ids));
+                break;
+            case KIND_PACKED: {
+                long offset = value(ids);
+                int paletteSize = (int) (ids >>> 48 & 0xFF);
+                char[] palette = new char[16];
+
+                for (int i = 0; i < paletteSize; ++i) {
+                    palette[i] = this.mapping.get(CHAR_LE, offset + i * 2L);
+                }
+                section.athenaMapPackedIds(palette, paletteSize, this.mapping, offset + 32L);
+                break;
+            }
+            case KIND_RAW:
+                section.athenaMapRawIds(this.mapping, value(ids));
+                break;
+            default:
+                return false;
+        }
+
+        section.setBlocklightArray(this.light(blockLight));
+        if (sky) {
+            section.setSkylightArray(this.light(skyLight));
+        }
+        return true;
+    }
+
+    private NibbleArray light(long entry) {
+        switch (kind(entry)) {
+            case KIND_ZERO:
+                return NibbleArray.light();
+            case KIND_FULL:
+                return NibbleArray.lightFull();
+            default:
+                return NibbleArray.mapped(this.mapping, value(entry));
+        }
+    }
+
+    private static int kind(long entry) {
+        return (int) (entry >>> 56);
+    }
+
+    private static long value(long entry) {
+        return entry & 0xFFFFFFFFFFFFL;
+    }
+
+    private static long entry(int kind, long value) {
+        return (long) kind << 56 | value;
+    }
+
+    /** Size and modification time of every region file: what the store was built from. */
+    static long fingerprint(File directory) throws IOException {
+        File[] files = new File(directory, "region").listFiles((dir, name) -> name.endsWith(".mca"));
+
+        if (files == null) {
+            throw new IOException("no region directory in " + directory);
+        }
+        Arrays.sort(files);
+
+        long hash = 0xcbf29ce484222325L;
+
+        for (File file : files) {
+            hash = mix(hash, file.getName().hashCode());
+            hash = mix(hash, file.length());
+            hash = mix(hash, file.lastModified());
+        }
+        return hash;
+    }
+
+    private static long mix(long hash, long value) {
+        hash ^= value;
+        hash *= 0x100000001b3L;
+        return hash ^ hash >>> 29;
+    }
+
+    /**
+     * Builds the stores of the given template folders, or of every folder holding a region/ directory
+     * under them, so that the first match on a map does not have to:
+     * {@code java -cp <patched jar> net.minecraft.server.AthenaSectionStore /opt/mc/maps}.
+     * A store that already matches its region files is left alone.
+     */
+    public static void main(String[] args) throws IOException {
+        DispenserRegistry.register(); // the block registry the id conversion reads
+
+        List<File> templates = new ArrayList<File>();
+
+        for (String arg : args) {
+            File dir = new File(arg);
+
+            if (new File(dir, "region").isDirectory()) {
+                templates.add(dir);
+            } else {
+                File[] children = dir.listFiles(child -> new File(child, "region").isDirectory());
+
+                if (children != null) {
+                    Arrays.sort(children);
+                    templates.addAll(Arrays.asList(children));
+                }
+            }
+        }
+
+        for (File template : templates) {
+            long fingerprint = fingerprint(template);
+            File file = file(template, fingerprint);
+
+            if (file.isFile() && map(file, fingerprint) != null) {
+                System.out.println(template.getName() + ": up to date");
+                continue;
+            }
+
+            long started = System.nanoTime();
+            int chunks = build(template, file, fingerprint);
+
+            removeLeftovers(template, file);
+            System.out.println(template.getName() + ": " + chunks + " chunks, " + file.length() / 1000000L + " MB in " + (System.nanoTime() - started) / 1000000L + " ms");
+        }
+    }
+
+    // ------------------------------------------------------------------ building
+
+    /** One section's data as a load from NBT produces it, before it is classified. */
+    static final class SectionData {
+        final int y;
+        final char[] ids;
+        final byte[] blockLight;
+        final byte[] skyLight; // null where the NBT has none
+
+        SectionData(int y, char[] ids, byte[] blockLight, byte[] skyLight) {
+            this.y = y;
+            this.ids = ids;
+            this.blockLight = blockLight;
+            this.skyLight = skyLight;
+        }
+    }
+
+    /**
+     * Builds the store from every chunk of the template's region files; returns the chunk count.
+     * Streams: one chunk's NBT is in memory at a time, and what is kept per chunk is its 48 entries,
+     * so building a large map fits in a small heap.
+     */
+    static int build(File directory, File file, long fingerprint) throws IOException {
+        File[] regions = new File(directory, "region").listFiles((dir, name) -> name.matches("r\\.-?\\d+\\.-?\\d+\\.mca"));
+
+        if (regions == null) {
+            throw new IOException("no region directory in " + directory);
+        }
+
+        File temporary = new File(file.getParentFile(), file.getName() + ".tmp" + ProcessHandle.current().pid());
+
+        try (FileChannel out = FileChannel.open(temporary.toPath(), StandardOpenOption.CREATE, StandardOpenOption.TRUNCATE_EXISTING, StandardOpenOption.READ, StandardOpenOption.WRITE)) {
+            BlobWriter blobs = new BlobWriter(out, HEADER);
+            Map<Long, long[]> table = new HashMap<Long, long[]>();
+
+            for (File region : regions) {
+                try (AthenaTemplateRegion reader = AthenaTemplateRegion.open(region)) {
+                    for (int z = 0; z < 32 && reader != null; ++z) {
+                        for (int x = 0; x < 32; ++x) {
+                            if (!reader.has(x, z)) {
+                                continue;
+                            }
+                            NBTTagCompound root;
+
+                            try {
+                                root = reader.read(x, z);
+                            } catch (IOException e) {
+                                continue; // the server will not load it either
+                            }
+                            if (root == null || !root.hasKeyOfType("Level", 10)) {
+                                continue;
+                            }
+                            NBTTagCompound level = root.getCompound("Level");
+
+                            if (level.hasKeyOfType("Sections", 9)) {
+                                // keyed on the chunk's own coordinates, which is what the loader asks for
+                                table.put(key(level.getInt("xPos"), level.getInt("zPos")), entries(blobs, sections(level)));
+                            }
+                        }
+                    }
+                }
+            }
+
+            finish(out, blobs, fingerprint, table);
+        } catch (IOException | RuntimeException e) {
+            temporary.delete();
+            throw e;
+        }
+        Files.move(temporary.toPath(), file.toPath(), StandardCopyOption.REPLACE_EXISTING, StandardCopyOption.ATOMIC_MOVE);
+        return countChunks(file);
+    }
+
+    private static int countChunks(File file) throws IOException {
+        try (FileChannel in = FileChannel.open(file.toPath(), StandardOpenOption.READ)) {
+            ByteBuffer header = ByteBuffer.allocate(HEADER).order(ByteOrder.LITTLE_ENDIAN);
+
+            in.read(header, 0L);
+            return header.getInt(12);
+        }
+    }
+
+    static List<SectionData> sections(NBTTagCompound level) {
+        NBTTagList list = level.getList("Sections", 10);
+        List<SectionData> sections = new ArrayList<SectionData>(list.size());
+
+        for (int k = 0; k < list.size(); ++k) {
+            NBTTagCompound section = list.get(k);
+            byte[] skyLight = section.hasKeyOfType("SkyLight", 7) ? section.getByteArray("SkyLight") : null;
+
+            sections.add(new SectionData(section.getByte("Y"), ChunkRegionLoader.athenaSectionIds(section), section.getByteArray("BlockLight"), skyLight));
+        }
+        return sections;
+    }
+
+    /** One chunk's 16 x 3 entries, its blobs written as they are met. */
+    static long[] entries(BlobWriter blobs, List<SectionData> sections) throws IOException {
+        long[] entries = new long[48];
+
+        for (SectionData section : sections) {
+            if (section.y < 0 || section.y >= 16) {
+                continue;
+            }
+            int at = section.y * 3;
+
+            entries[at] = ids(blobs, section.ids);
+            entries[at + 1] = light(blobs, section.blockLight);
+            entries[at + 2] = section.skyLight == null ? entry(KIND_ABSENT, 0L) : light(blobs, section.skyLight);
+        }
+        return entries;
+    }
+
+    /** Writes the key table, the entries and the header after the blobs. */
+    static void finish(FileChannel out, BlobWriter blobs, long fingerprint, Map<Long, long[]> table) throws IOException {
+        long[] keys = new long[table.size()];
+        int n = 0;
+
+        for (Long key : table.keySet()) {
+            keys[n++] = key;
+        }
+        Arrays.sort(keys);
+
+        long keysAt = blobs.align();
+        ByteBuffer tail = ByteBuffer.allocate(keys.length * 8 * 49).order(ByteOrder.LITTLE_ENDIAN);
+
+        for (long key : keys) {
+            tail.putLong(key);
+        }
+        for (long key : keys) {
+            for (long value : table.get(key)) {
+                tail.putLong(value);
+            }
+        }
+        tail.flip();
