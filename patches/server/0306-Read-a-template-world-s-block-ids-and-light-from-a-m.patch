+        long align() {
+            this.end = this.end + 63L & ~63L;
+            return this.end;
+        }
+
+        long put(byte[] data) throws IOException {
+            long hash = hash(data);
+            long[] offsets = this.written.get(hash);
+
+            if (offsets != null) {
+                for (long offset : offsets) {
+                    if (this.same(offset, data)) {
+                        return offset;
+                    }
+                }
+            }
