diff --git a/src/main/java/net/minecraft/server/TileEntityLightDetector.java b/src/main/java/net/minecraft/server/TileEntityLightDetector.java
index 2b9cb0f68aa05396c710d72d8dc0deb9f04da1bc..78a436dc50f9c333f0204e88cce13cc3b74b19a1 100644
--- a/src/main/java/net/minecraft/server/TileEntityLightDetector.java
+++ b/src/main/java/net/minecraft/server/TileEntityLightDetector.java
@@ -6,7 +6,7 @@ public class TileEntityLightDetector extends TileEntity implements IUpdatePlayer
     public TileEntityLightDetector() {}
 
     public void c() {
-        if (this.world != null && !this.world.isClientSide && this.world.getTime() % 20L == 0L) {
+        if (this.world != null && !this.world.isClientSide && (this.world.getTime() + this.athenaPhase()) % 20L == 0L) { // Athena - staggered
             this.blockType = this.getBlockType();
             if (this.blockType instanceof BlockDaylightDetector) {
                 ((BlockDaylightDetector) this.blockType).updatePower(this.world, this.position);
@@ -14,4 +14,22 @@ public class TileEntityLightDetector extends TileEntity implements IUpdatePlayer
         }
 
     }
+
+    // Athena start - which tick of the second this detector checks on; see AthenaWorldConfig.staggerDaylightDetectors
+    private int athenaPhase() {
+        if (!this.world.athenaConfig.staggerDaylightDetectors) {
+            return 0;
+        }
+        BlockPosition position = this.position;
+        return athenaPhase(position.getX(), position.getY(), position.getZ());
+    }
+
+    static int athenaPhase(int x, int y, int z) {
+        // mixed, so detectors set out at an even spacing do not fall on a few shared ticks
+        long h = x * 0x9E3779B97F4A7C15L ^ z * 0xC2B2AE3D27D4EB4FL ^ y * 0x165667B19E3779F9L;
+        h = (h ^ (h >>> 31)) * 0xBF58476D1CE4E5B9L;
+        h ^= h >>> 29;
+        return (int) Math.floorMod(h, 20L);
+    }
+    // Athena end
 }
diff --git a/src/main/java/net/minecraft/server/World.java b/src/main/java/net/minecraft/server/World.java
index d7ce8ef96373c316b33c1c0db766a01bb259d83b..41e14d436afc3b83a55d513558373b8337f638fd 100644
--- a/src/main/java/net/minecraft/server/World.java
+++ b/src/main/java/net/minecraft/server/World.java
@@ -4008,6 +4008,58 @@ public abstract class World implements IBlockAccess {
         return this.isBlockIndirectlyGettingPowered(blockposition.getX(), blockposition.getY(), blockposition.getZ());
     }
 
+    // Athena start - redstone lamps switch a few per tick; see athena.server.RedstoneLampQueue
+    public final athena.server.RedstoneLampQueue athenaLampQueue = new athena.server.RedstoneLampQueue();
+
+    /**
+     * Called where a lamp would switch on, or off once its four-tick delay is up. Returns true if
+     * the lamp was queued and the caller must leave it as it is; false (redstoneLampsPerTick is 0)
+     * to switch it now, as vanilla does.
+     */
+    public boolean athenaQueueLamp(BlockPosition blockposition) {
+        if (this.athenaConfig.redstoneLampsPerTick <= 0) {
+            return false;
+        }
+        this.athenaLampQueue.offer(blockposition.asLong());
+        return true;
+    }
+
+    /** Switches up to redstoneLampsPerTick queued lamps. Called once a tick on the world's thread. */
+    public void athenaSwitchLamps() {
+        if (this.athenaLampQueue.isEmpty()) {
+            return;
+        }
+        int budget = this.athenaConfig.redstoneLampsPerTick;
+        this.athenaLampQueue.drain(budget > 0 ? budget : Integer.MAX_VALUE, this::athenaSwitchLamp);
+    }
+
+    /** Puts the lamp at a packed position in the state its power asks for. True if it changed. */
+    private boolean athenaSwitchLamp(long packed) {
+        BlockPosition blockposition = BlockPosition.fromLong(packed);
+        if (!this.isLoaded(blockposition)) {
+            return false; // its chunk is gone; the lamp is saved as it was and checked again when it next updates
+        }
+        Block block = this.getType(blockposition).getBlock();
+        if (block == Blocks.REDSTONE_LAMP) {
+            if (!this.isBlockIndirectlyPowered(blockposition)
+                    || CraftEventFactory.callRedstoneChange(this, blockposition.getX(), blockposition.getY(), blockposition.getZ(), 0, 15).getNewCurrent() != 15) {
+                return false;
+            }
+            this.setTypeAndData(blockposition, Blocks.LIT_REDSTONE_LAMP.getBlockData(), 2);
+            return true;
+        }
+        if (block == Blocks.LIT_REDSTONE_LAMP) {
+            if (this.isBlockIndirectlyPowered(blockposition)
+                    || CraftEventFactory.callRedstoneChange(this, blockposition.getX(), blockposition.getY(), blockposition.getZ(), 15, 0).getNewCurrent() != 0) {
+                return false;
+            }
+            this.setTypeAndData(blockposition, Blocks.REDSTONE_LAMP.getBlockData(), 2);
+            return true;
+        }
+        return false; // no longer a lamp
+    }
+    // Athena end
+
     public EntityHuman findNearbyPlayer(Entity entity, double d0) {
         return this.findNearbyPlayer(entity.locX, entity.locY, entity.locZ, d0);
     }
