diff --git a/src/main/java/athena/server/RedstoneLampQueue.java b/src/main/java/athena/server/RedstoneLampQueue.java
new file mode 100644
index 0000000000000000000000000000000000000000..ca2e589f6de9b3346e3e3f3d16994c5bedb58338
--- /dev/null
+++ b/src/main/java/athena/server/RedstoneLampQueue.java
@@ -0,0 +1,55 @@
+package athena.server;
+
+import it.unimi.dsi.fastutil.longs.LongLinkedOpenHashSet;
+import java.util.function.LongPredicate;
+
+/**
+ * Athena - redstone lamps waiting to be switched on or off, for one world.
+ * <p>
+ * A lamp carries no signal: whether it is lit changes nothing a circuit can see. What it costs is
+ * the light around it, and a whole map of street lamps wired to one daylight detector all switch
+ * on the same tick, so the world stalls for that tick relighting them. Instead the lamp is queued
+ * where vanilla would switch it, and the world switches a few per tick
+ * ({@link AthenaWorldConfig#redstoneLampsPerTick}). Whether a lamp should be lit is checked again
+ * when it is switched, so a lamp ends up in the state its power asks for, only a little later.
+ * <p>
+ * Positions are kept in the order they were queued, once each. Used only from the world's own
+ * thread.
+ */
+public final class RedstoneLampQueue {
+
+    private final LongLinkedOpenHashSet queued = new LongLinkedOpenHashSet();
+
+    /** Queues a packed block position. Returns false if it was already waiting. */
+    public boolean offer(long position) {
+        return this.queued.add(position);
+    }
+
+    public boolean isEmpty() {
+        return this.queued.isEmpty();
+    }
+
+    public int size() {
+        return this.queued.size();
+    }
+
+    public void clear() {
+        this.queued.clear();
+    }
+
+    /**
+     * Takes positions off the front of the queue and hands each to {@code apply}, until {@code budget}
+     * of them changed a lamp (apply returned true) or the queue is empty. Positions whose lamp had
+     * nothing to do are cheap and do not count. Returns the number that changed.
+     */
+    public int drain(int budget, LongPredicate apply) {
+        int changed = 0;
+
+        while (changed < budget && !this.queued.isEmpty()) {
+            if (apply.test(this.queued.removeFirstLong())) {
+                ++changed;
+            }
+        }
+        return changed;
+    }
+}
