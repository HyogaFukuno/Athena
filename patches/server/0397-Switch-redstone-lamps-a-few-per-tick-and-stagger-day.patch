diff --git a/src/test/java/athena/server/RedstoneLampQueueTest.java b/src/test/java/athena/server/RedstoneLampQueueTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..da1ed7a9095dc1a801c8805d499b8e9bd54b21da
--- /dev/null
+++ b/src/test/java/athena/server/RedstoneLampQueueTest.java
@@ -0,0 +1,61 @@
+package athena.server;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import java.util.ArrayList;
+import java.util.List;
+
+import org.junit.Test;
+
+public class RedstoneLampQueueTest {
+
+    @Test
+    public void drainsInTheOrderQueuedUpToTheBudget() {
+        RedstoneLampQueue queue = new RedstoneLampQueue();
+        for (long p = 1; p <= 5; p++) {
+            assertTrue(queue.offer(p));
+        }
+        List<Long> seen = new ArrayList<>();
+        assertEquals(2, queue.drain(2, p -> seen.add(p)));
+        assertEquals(List.of(1L, 2L), seen);
+        assertEquals(3, queue.size());
+        assertEquals(3, queue.drain(10, p -> seen.add(p)));
+        assertEquals(List.of(1L, 2L, 3L, 4L, 5L), seen);
+        assertTrue(queue.isEmpty());
+    }
+
+    @Test
+    public void aLampQueuedTwiceWaitsOnce() {
+        RedstoneLampQueue queue = new RedstoneLampQueue();
+        assertTrue(queue.offer(7));
+        assertTrue(queue.offer(8));
+        assertFalse(queue.offer(7));
+        List<Long> seen = new ArrayList<>();
+        queue.drain(10, p -> seen.add(p));
+        assertEquals(List.of(7L, 8L), seen);
+    }
+
+    @Test
+    public void positionsWithNothingToDoDoNotUseTheBudget() {
+        RedstoneLampQueue queue = new RedstoneLampQueue();
+        for (long p = 1; p <= 10; p++) {
+            queue.offer(p);
+        }
+        List<Long> seen = new ArrayList<>();
+        // only even positions change a lamp
+        assertEquals(2, queue.drain(2, p -> { seen.add(p); return p % 2 == 0; }));
+        assertEquals(List.of(1L, 2L, 3L, 4L), seen);
+        assertEquals(6, queue.size());
+    }
+
+    @Test
+    public void aLampQueuedWhileDrainingWaitsForItsTurn() {
+        RedstoneLampQueue queue = new RedstoneLampQueue();
+        queue.offer(1);
+        List<Long> seen = new ArrayList<>();
+        queue.drain(5, p -> { seen.add(p); if (p == 1) queue.offer(2); return true; });
+        assertEquals(List.of(1L, 2L), seen);
+    }
+}
diff --git a/src/test/java/net/minecraft/server/TileEntityLightDetectorPhaseTest.java b/src/test/java/net/minecraft/server/TileEntityLightDetectorPhaseTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..38af2588afebff151edcefd9feb3cacc120e6167
--- /dev/null
+++ b/src/test/java/net/minecraft/server/TileEntityLightDetectorPhaseTest.java
@@ -0,0 +1,37 @@
+package net.minecraft.server;
+
+import static org.junit.Assert.assertTrue;
+
+import org.junit.Test;
+
+public class TileEntityLightDetectorPhaseTest {
+
+    @Test
+    public void phasesStayWithinASecond() {
+        for (int x = -40; x <= 40; x += 3) {
+            for (int z = -40; z <= 40; z += 5) {
+                for (int y = 0; y < 256; y += 37) {
+                    int phase = TileEntityLightDetector.athenaPhase(x, y, z);
+                    assertTrue(phase >= 0 && phase < 20);
+                }
+            }
+        }
+        int far = TileEntityLightDetector.athenaPhase(29_999_999, 255, -29_999_999);
+        assertTrue(far >= 0 && far < 20);
+    }
+
+    @Test
+    public void detectorsInARowSpreadOverTheSecond() {
+        // street lamps: one detector every few blocks along a road
+        boolean[] used = new boolean[20];
+        int distinct = 0;
+        for (int i = 0; i < 20; i++) {
+            int phase = TileEntityLightDetector.athenaPhase(i * 4, 70, 12);
+            if (!used[phase]) {
+                used[phase] = true;
+                distinct++;
+            }
+        }
+        assertTrue("only " + distinct + " distinct ticks", distinct >= 10);
+    }
+}
