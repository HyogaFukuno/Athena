-    public java.util.Map<EntityPlayer, Boolean> trackedPlayerMap = new it.unimi.dsi.fastutil.objects.Reference2ObjectOpenHashMap<EntityPlayer, Boolean>();
-    public Set<EntityPlayer> trackedPlayers = trackedPlayerMap.keySet();
     // PaperSpigot end
+    // Athena start - hold the viewers in a flat array instead of a hash map.
+    //
+    // This collection is walked for *every packet* an entity sends: broadcast() is how a movement,
+    // a metadata change, an equipment change or an effect reaches the players watching, so on a
+    // populated world it is one of the most frequently traversed structures in the server. It is
+    // also tiny - a viewer list is at most max-players long, and usually a handful - which is
+    // exactly the size where a hash table loses. A probe has to hash the key, index a table, and
+    // follow it to the entry; a linear scan over four references is one cache line and no
+    // indirection at all, and iterating the array in order gives the prefetcher something to work
+    // with where a bucket walk gives it nothing.
+    //
+    // viewerFresh runs parallel to viewers and carries what the map's value used to: true until
+    // that player has had its first update, which is forced to be an absolute teleport because the
+    // position it got in the spawn packet is not something we can be sure of.
+    //
+    // Removal swaps in the last element rather than compacting, so the order viewers appear in is
+    // not stable. Nothing depends on it: every use either sends the same packet to all of them or
+    // asks whether one particular player is present.
+    private EntityPlayer[] viewers = new EntityPlayer[4];
+    private boolean[] viewerFresh = new boolean[4];
+    private int viewerCount;
+    public final Set<EntityPlayer> trackedPlayers = new ViewerSet(); // the read-mostly view plugins and CraftBukkit use
+
+    private int viewerIndex(EntityPlayer entityplayer) {
+        EntityPlayer[] viewers = this.viewers;
+
+        for (int i = 0; i < this.viewerCount; ++i) {
+            if (viewers[i] == entityplayer) {
+                return i;
+            }
+        }
+
+        return -1;
+    }
+
+    private void addViewer(EntityPlayer entityplayer) {
+        if (this.viewerCount == this.viewers.length) {
+            this.viewers = java.util.Arrays.copyOf(this.viewers, this.viewerCount << 1);
+            this.viewerFresh = java.util.Arrays.copyOf(this.viewerFresh, this.viewerCount << 1);
+        }
+
+        this.viewers[this.viewerCount] = entityplayer;
+        this.viewerFresh[this.viewerCount] = true;
+        ++this.viewerCount;
+    }
+
+    private boolean removeViewer(EntityPlayer entityplayer) {
+        int i = this.viewerIndex(entityplayer);
+
+        if (i < 0) {
+            return false;
+        }
+
+        int last = --this.viewerCount;
+
+        this.viewers[i] = this.viewers[last];
+        this.viewerFresh[i] = this.viewerFresh[last];
+        this.viewers[last] = null;
+        return true;
+    }
+
+    private final class ViewerSet extends java.util.AbstractSet<EntityPlayer> {
+
+        public int size() {
+            return EntityTrackerEntry.this.viewerCount;
+        }
+
+        public boolean contains(Object object) {
+            return object instanceof EntityPlayer && EntityTrackerEntry.this.viewerIndex((EntityPlayer) object) >= 0;
+        }
+
+        public boolean remove(Object object) {
+            return object instanceof EntityPlayer && EntityTrackerEntry.this.removeViewer((EntityPlayer) object);
+        }
+
+        public Iterator<EntityPlayer> iterator() {
+            return new Iterator<EntityPlayer>() {
+                private int next;
+
+                public boolean hasNext() {
+                    return this.next < EntityTrackerEntry.this.viewerCount;
+                }
+
+                public EntityPlayer next() {
+                    if (!this.hasNext()) {
+                        throw new java.util.NoSuchElementException();
+                    }
+
+                    return EntityTrackerEntry.this.viewers[this.next++];
+                }
+
+                public void remove() {
+                    if (this.next <= 0) {
+                        throw new IllegalStateException();
+                    }
+
+                    // The swap puts an unvisited element where the removed one was, so step back
+                    // onto it rather than past it.
+                    EntityTrackerEntry.this.removeViewer(EntityTrackerEntry.this.viewers[--this.next]);
+                }
+            };
+        }
+    }
+    // Athena end
     int trackerIndex = -1; // Athena - this entry's slot in EntityTracker's array
 
