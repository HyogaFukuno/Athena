@@ -76,9 +84,36 @@ public final class AthenaTeleportQueue {
                         continue;
                     }
 
-                    Location to = batch.destination.of(index, player);
+                    final Location to = batch.destination.of(index, player);
 
-                    if (to != null && player.teleport(to, PlayerTeleportEvent.TeleportCause.PLUGIN)) {
+                    if (to == null) {
