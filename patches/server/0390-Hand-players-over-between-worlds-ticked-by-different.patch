@@ -18,7 +18,53 @@ public final class AthenaChunkPreloader {
 
     private final List<Batch> batches = new ArrayList<Batch>();
 
-    private AthenaChunkPreloader() {}
+    // Athena - one per thread that ticks worlds: INSTANCE for the server thread, one in each
+    // AthenaWorldThread for its world (see forWorld). A square is drained by its world's thread.
+    AthenaChunkPreloader() {
+        this(null);
+    }
+
+    AthenaChunkPreloader(AthenaWorldThread thread) {
+        this.thread = thread;
+    }
+
+    /** The world thread this preloader belongs to; null for the server thread's. */
+    private final AthenaWorldThread thread;
+
+    /** The preloader of the thread that ticks {@code world}. */
+    public static AthenaChunkPreloader forWorld(WorldServer world) {
+        AthenaWorldThread thread = world.athenaThread;
+        return thread != null ? thread.preloader : INSTANCE;
+    }
+
+    /** Hands a square to the preloader of its world's thread, on that thread. */
+    private static void adoptOnOwner(final Batch batch) {
+        if (batch.world.isMainThread()) {
+            forWorld(batch.world).batches.add(batch);
+        } else {
+            batch.world.athenaRunOnTickThread(() -> adoptOnOwner(batch));
+        }
+    }
+
+    /** Takes over the squares of a world thread that stopped. Server thread. */
+    void adoptAll(AthenaChunkPreloader from) {
+        this.batches.addAll(from.batches);
+        from.batches.clear();
+    }
+
+    /**
+     * The argument checks of preload, for a caller that hands the request to another thread and
+     * still wants a bad square to throw at once.
+     */
+    public static void check(int minX, int minZ, int maxX, int maxZ, int perTick) {
+        long wide = (long) maxX - minX + 1L, high = (long) maxZ - minZ + 1L;
+        if (wide <= 0 || high <= 0 || wide > MAX_CHUNKS || high > MAX_CHUNKS || wide * high > MAX_CHUNKS) {
+            throw new IllegalArgumentException("Preload must contain between 1 and " + MAX_CHUNKS + " chunks");
+        }
+        if (perTick < 1) {
+            throw new IllegalArgumentException("perTick must be at least 1");
+        }
+    }
 
     private static final class Batch {
 
@@ -97,6 +143,14 @@ public final class AthenaChunkPreloader {
         }
 
         for (Batch batch : this.batches.toArray(new Batch[0])) {
+            // Athena start - the world moved to or from its own thread: its square goes with it
+            if (batch.world.athenaThread != this.thread && !batch.world.athenaUnloaded) {
+                this.batches.remove(batch);
+                final Batch moving = batch;
+                adoptOnOwner(moving);
+                continue;
+            }
+            // Athena end
             boolean worldGone = batch.world.athenaUnloaded; // Athena - the lifecycle flag also covers late callbacks
 
             if (!worldGone) {
