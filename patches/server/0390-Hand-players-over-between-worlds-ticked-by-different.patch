+                    }
+                    // Athena start - a player whose world ticks on another thread is teleported there;
+                    // the result comes back here, and the group completes once all are back
+                    EntityPlayer handle = player instanceof org.bukkit.craftbukkit.entity.CraftPlayer ? ((org.bukkit.craftbukkit.entity.CraftPlayer) player).getHandle() : null;
+                    if (handle != null && handle.world != null && handle.world.athenaIsThreaded()) { // this queue runs on the server thread
+                        ++batch.pending;
+                        final Batch owner = batch;
+                        final Player moving = player;
+                        WorldServer.athenaRunForEntity(handle, () -> {
+                            boolean done = false;
+                            try {
+                                done = moving.isOnline() && moving.teleport(to, PlayerTeleportEvent.TeleportCause.PLUGIN);
+                            } catch (Exception exception) {
+                                LOGGER.warn("[Athena] Teleporting " + moving.getName() + " failed", exception);
+                            } finally {
+                                final boolean result = done;
+                                MinecraftServer.getServer().processQueue.add(() -> {
+                                    --owner.pending;
+                                    if (result) ++owner.teleported;
+                                });
+                            }
+                        });
+                        continue;
+                    }
+                    // Athena end
+                    if (player.teleport(to, PlayerTeleportEvent.TeleportCause.PLUGIN)) {
                         ++batch.teleported;
                     }
                 } catch (Exception exception) {
@@ -93,7 +128,7 @@ public final class AthenaTeleportQueue {
