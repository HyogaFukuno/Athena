From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: glacier <hyouga.dev@gmail.com>
Date: Thu, 12 Nov 2026 04:24:12 +0900
Subject: [PATCH] A template section read often reads a shared heap copy of its
 ids

One block read off the mapping is a call through the segment's var handle, which C1 does not
inline; collision checks and getType on template sections took some 2% of the world threads.
A section read 256 times takes the store's heap copy of its ids, made once for every world on
the template and held weakly; the copies alive at once take at most 4 MB per store.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/src/main/java/net/minecraft/server/AthenaSectionStore.java b/src/main/java/net/minecraft/server/AthenaSectionStore.java
index c804b6148c3d58b5de47cdbe7cd573f51161e90f..6444105468cbcad44fbd5cf088c6a311b5507044 100644
--- a/src/main/java/net/minecraft/server/AthenaSectionStore.java
+++ b/src/main/java/net/minecraft/server/AthenaSectionStore.java
@@ -437,9 +437,106 @@ final class AthenaSectionStore {
         }
         section.athenaStore = this; // Athena - as this store holds it, until modCount moves
         section.athenaStoreModCount = section.modCount;
+        section.athenaStoreSlot = index * 16 + sectionY;
         return true;
     }
 
+    // Athena start - heap copies of the ids of the sections read most; see ChunkSection.mappedStateIdAt.
+    //
+    // Held weakly, like the packets: a copy lives as long as a section of some world reads it, and a
+    // store kept between matches keeps none. By chunk index * 16 + section y. The copies alive at
+    // once take at most HEAP_BYTES; past that a section goes on reading the mapping.
+    static final int HEAP_AFTER = 256;
+    static final long HEAP_BYTES = 4L << 20;
+
+    /** A section's ids off the mapping: a packed section's 2048 bytes, or a raw one's 4096 chars. Never written. */
+    static final class HeapIds {
+        final byte[] packed;
+        final char[] raw;
+
+        HeapIds(byte[] packed, char[] raw) {
+            this.packed = packed;
+            this.raw = raw;
+        }
+
+        long bytes() {
+            return this.raw != null ? 8192L : 2048L;
+        }
+    }
+
+    private static final class HeapReference extends WeakReference<HeapIds> {
+        final long bytes;
+
+        HeapReference(HeapIds ids, java.lang.ref.ReferenceQueue<HeapIds> queue) {
+            super(ids, queue);
+            this.bytes = ids.bytes();
+        }
+    }
+
+    private volatile java.util.concurrent.atomic.AtomicReferenceArray<HeapReference> heapIds;
+    private final java.lang.ref.ReferenceQueue<HeapIds> heapGone = new java.lang.ref.ReferenceQueue<HeapIds>();
+    private final java.util.concurrent.atomic.AtomicLong heapBytes = new java.util.concurrent.atomic.AtomicLong();
+
+    /** The heap copy of the section in {@code slot}, made now if no world has one; null once the copies alive take HEAP_BYTES. */
+    HeapIds heapIds(int slot, MemorySegment mapping, long at, boolean raw) {
+        java.util.concurrent.atomic.AtomicReferenceArray<HeapReference> copies = this.heapIds;
+
+        if (copies == null) {
+            synchronized (this) {
+                copies = this.heapIds;
+                if (copies == null) {
+                    this.heapIds = copies = new java.util.concurrent.atomic.AtomicReferenceArray<HeapReference>(this.keys.length * 16);
+                }
+            }
+        }
+        if (slot < 0 || slot >= copies.length() || mapping != this.mapping) {
+            return null;
+        }
+        for (java.lang.ref.Reference<? extends HeapIds> gone; (gone = this.heapGone.poll()) != null; ) {
+            this.heapBytes.addAndGet(-((HeapReference) gone).bytes);
+        }
+
+        HeapIds made = null;
+        HeapReference mine = null;
+
+        for (;;) {
+            HeapReference reference = copies.get(slot);
+            HeapIds shared = reference == null ? null : reference.get();
+
+            if (shared != null) {
+                if (mine != null) {
+                    mine.clear(); // another world made it first: never enqueued, so given back here
+                    this.heapBytes.addAndGet(-mine.bytes);
+                }
+                return shared;
+            }
+            if (made == null) {
+                long bytes = raw ? 8192L : 2048L;
+
+                if (this.heapBytes.addAndGet(bytes) > HEAP_BYTES) {
+                    this.heapBytes.addAndGet(-bytes);
+                    return null;
+                }
+                made = raw
+                        ? new HeapIds(null, mapping.asSlice(at, 8192L).toArray(CHAR_LE))
+                        : new HeapIds(mapping.asSlice(at, 2048L).toArray(ValueLayout.JAVA_BYTE), null);
+                mine = new HeapReference(made, this.heapGone);
+            }
+            if (copies.compareAndSet(slot, reference, mine)) {
+                return made;
+            }
+        }
+    }
+
+    /** The bytes the heap copies alive take, as far as the store has seen them go; for tests. */
+    long heapBytes() {
+        for (java.lang.ref.Reference<? extends HeapIds> gone; (gone = this.heapGone.poll()) != null; ) {
+            this.heapBytes.addAndGet(-((HeapReference) gone).bytes);
+        }
+        return this.heapBytes.get();
+    }
+    // Athena end
+
     // Athena start - the chunk packets of this template's worlds; see AthenaChunkPacketCache.Payload.
     //
     // Held weakly: a packet lives as long as a chunk of some world uses it, so the worlds that are on
diff --git a/src/main/java/net/minecraft/server/ChunkSection.java b/src/main/java/net/minecraft/server/ChunkSection.java
