@@ -916,7 +918,28 @@ public class ChunkSection {
         return this.blockIds == null && this.packedIds == null;
     }
 
+    // Athena start - a mapped section read block by block often reads a heap copy instead.
+    //
+    // One block read off the mapping is a call through the segment's var handle, which C1 - all the
+    // small servers compile with - does not inline: some 2% of the world threads' time in a match
+    // went to collision checks and getType reading template sections that way. A section read
+    // AthenaSectionStore.HEAP_AFTER times takes the store's heap copy of its ids, made once and
+    // shared by every world on the template that has the section loaded (see
+    // AthenaSectionStore.heapIds); the store caps how many it makes. The copy is never written: the
+    // first setType copies the ids into the section's own arrays as before.
+    private AthenaSectionStore.HeapIds mappedHeap;
+    private int mappedReads;
+    int athenaStoreSlot = -1; // the section's slot in athenaStore, set as it maps the ids
+
     private char mappedStateIdAt(int index) {
+        AthenaSectionStore.HeapIds heap = this.mappedHeap;
+
+        if (heap == null && ++this.mappedReads == AthenaSectionStore.HEAP_AFTER) {
+            heap = this.mappedHeap = this.athenaHeapIds();
+        }
+        if (heap != null) {
+            return heap.raw != null ? heap.raw[index] : this.palette[heap.packed[index >> 1] >> ((index & 1) << 2) & 15];
+        }
         java.lang.foreign.MemorySegment ids = this.mappedIds;
 
         if (this.mappedRaw) {
@@ -925,7 +948,26 @@ public class ChunkSection {
         return this.palette[ids.get(java.lang.foreign.ValueLayout.JAVA_BYTE, this.mappedAt + (index >> 1)) >> ((index & 1) << 2) & 15];
     }
 
+    /** The store's heap copy of these ids, or null if the store makes no more. */
+    private AthenaSectionStore.HeapIds athenaHeapIds() {
+        AthenaSectionStore store = this.athenaStore;
+
+        return store == null || this.athenaStoreSlot < 0 ? null : store.heapIds(this.athenaStoreSlot, this.mappedIds, this.mappedAt, this.mappedRaw);
+    }
+
+    /** Whether block reads go to the store's heap copy; for tests. */
+    boolean athenaReadsHeapCopy() {
+        return this.isMapped() && this.mappedHeap != null;
+    }
+    // Athena end
+
     private char[] mappedUnpackInto(char[] ids) {
+        AthenaSectionStore.HeapIds heap = this.mappedHeap; // Athena - the same ids, already off the mapping
+
+        if (heap != null && heap.raw != null) {
+            System.arraycopy(heap.raw, 0, ids, 0, 4096);
+            return ids;
+        }
         java.lang.foreign.MemorySegment mapped = this.mappedIds;
 
         if (this.mappedRaw) {
@@ -935,9 +977,14 @@ public class ChunkSection {
 
         char[] palette = this.palette;
         // Athena - one copy off the mapping, then the heap: see recalcBlockCounts
-        byte[] packed = MAPPED_SCRATCH.get();
+        byte[] packed;
 
-        java.lang.foreign.MemorySegment.copy(mapped, java.lang.foreign.ValueLayout.JAVA_BYTE, this.mappedAt, packed, 0, 2048);
+        if (heap != null) {
+            packed = heap.packed;
+        } else {
+            packed = MAPPED_SCRATCH.get();
+            java.lang.foreign.MemorySegment.copy(mapped, java.lang.foreign.ValueLayout.JAVA_BYTE, this.mappedAt, packed, 0, 2048);
+        }
         for (int k = 0; k < 4096; k += 2) {
             int b = packed[k >> 1];
 
@@ -954,8 +1001,12 @@ public class ChunkSection {
     private void copyMappedIds() {
         java.lang.foreign.MemorySegment mapped = this.mappedIds;
 
+        AthenaSectionStore.HeapIds heap = this.mappedHeap;
+
         if (this.mappedRaw) {
             this.blockIds = this.mappedUnpackInto(new char[4096]);
+        } else if (heap != null) {
+            this.packedIds = heap.packed.clone(); // the store's copy is shared and never written
         } else {
             this.packedIds = mapped.asSlice(this.mappedAt, 2048L).toArray(java.lang.foreign.ValueLayout.JAVA_BYTE);
         }
diff --git a/src/test/java/net/minecraft/server/AthenaSectionStoreTest.java b/src/test/java/net/minecraft/server/AthenaSectionStoreTest.java
index 82765ab3ba80a240a8c240f478f819fc4b069d8a..403a9babaa04c4fb6e3263e3d4b006d6fdd1d81d 100644
--- a/src/test/java/net/minecraft/server/AthenaSectionStoreTest.java
+++ b/src/test/java/net/minecraft/server/AthenaSectionStoreTest.java
@@ -230,6 +230,72 @@ public class AthenaSectionStoreTest extends AbstractTestingBase {
         assertTrue("a mapped section was written", checked > 0);
     }
 
+    /**
+     * A mapped section read block by block HEAP_AFTER times reads the store's heap copy of its ids:
+     * the same blocks, one copy for every loaded copy of the section, and a write still changes the
+     * written section alone.
+     */
+    @Test
+    public void aSectionReadOftenReadsOneSharedHeapCopy() throws Exception {
+        File dir = template(9L);
+        AthenaSectionStore store = built(dir);
+        AthenaTemplateRegion region = AthenaTemplateRegion.open(new File(dir, "region/r.-1.0.mca"));
+        int packed = 0, raw = 0;
+
+        for (int x = 0; x < 32; x += 7) {
+            for (int z = 0; z < 32; z += 9) {
+                NBTTagList sections = region.read(x, z).getCompound("Level").getList("Sections", 10);
+
+                for (int k = 0; k < sections.size(); ++k) {
+                    NBTTagCompound nbt = sections.get(k);
+                    int y = nbt.getByte("Y");
+                    ChunkSection first = new ChunkSection(y << 4, true);
+                    ChunkSection second = new ChunkSection(y << 4, true);
+
+                    assertTrue(store.apply(-32 + x, z, y, first, true));
+                    assertTrue(store.apply(-32 + x, z, y, second, true));
+                    if (!first.isMapped()) {
+                        continue;
+                    }
+                    long before = store.heapBytes();
+
+                    for (int i = 0; i < AthenaSectionStore.HEAP_AFTER - 1; ++i) {
+                        first.getType(i & 15, i >> 8 & 15, i >> 4 & 15);
+                    }
+                    assertFalse("not yet", first.athenaReadsHeapCopy());
+                    first.getType(0, 0, 0);
+                    assertTrue("read often", first.athenaReadsHeapCopy());
+                    long made = store.heapBytes() - before;
+
+                    for (int i = 0; i < AthenaSectionStore.HEAP_AFTER; ++i) {
+                        second.getType(0, 0, 0);
+                    }
+                    assertTrue(second.athenaReadsHeapCopy());
+                    assertEquals("the second copy shares the first's", made, store.heapBytes() - before);
+                    if (made == 8192L) ++raw; else if (made == 2048L) ++packed;
+
+                    ChunkSection expected = fromNbt(nbt);
+
+                    first.recalcBlockCounts();
+                    assertSameContent("heap copy " + x + "," + y + "," + z, expected, first);
+
+                    IBlockData was = second.getType(3, 4, 5);
+
+                    first.setType(3, 4, 5, Blocks.GLASS.getBlockData());
+                    assertFalse(first.isMapped());
+                    assertSame(Blocks.GLASS.getBlockData(), first.getType(3, 4, 5));
+                    assertSame("the shared copy is untouched", was, second.getType(3, 4, 5));
+                    assertTrue(second.athenaReadsHeapCopy());
+                    second.recalcBlockCounts();
+                    assertSameContent("after the other's write " + x + "," + y + "," + z, expected, second);
+                }
+            }
+        }
+        region.close();
+        assertTrue("packed sections read from a heap copy", packed > 0);
+        assertTrue("raw sections read from a heap copy", raw > 0);
+    }
+
     @Test
     public void aChangedTemplateIsRebuilt() throws Exception {
         File dir = template(3L);
