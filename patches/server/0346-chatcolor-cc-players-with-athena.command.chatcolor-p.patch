From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: glacier <hyouga.dev@gmail.com>
Date: Wed, 28 Oct 2026 08:21:52 +0900
Subject: [PATCH] /chatcolor (/cc): players with athena.command.chatcolor pick
 the colour of their chat; Athena's messages share the [Athena] prefix


diff --git a/src/main/java/athena/server/AthenaMessages.java b/src/main/java/athena/server/AthenaMessages.java
new file mode 100644
index 0000000000000000000000000000000000000000..9ef1cc8fa08fc589369a7e1ca9b96946312c3669
--- /dev/null
+++ b/src/main/java/athena/server/AthenaMessages.java
@@ -0,0 +1,23 @@
+package athena.server;
+
+import org.bukkit.ChatColor;
+
+/**
+ * Athena - what Athena tells players in chat starts with {@code [Athena]} in light purple, so it is
+ * told apart from the plugins' messages (and from the VIP rank's dark purple).
+ */
+final class AthenaMessages {
+    private static final String PREFIX = "&8[&dAthena&8] ";
+
+    private AthenaMessages() {}
+
+    /** {@code text} with {@code &} colour codes, after the prefix. */
+    static String format(String text) {
+        return ChatColor.translateAlternateColorCodes('&', PREFIX + text);
+    }
+
+    /** {@code text} as it is (its {@code &} stays a {@code &}: what a player typed, a colour code to show), after the prefix. */
+    static String formatRaw(String text) {
+        return ChatColor.translateAlternateColorCodes('&', PREFIX) + text;
+    }
+}
