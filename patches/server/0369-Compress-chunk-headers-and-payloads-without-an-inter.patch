From: glacier <hyouga.dev@gmail.com>
Date: Fri, 30 Oct 2026 08:43:31 +0900
Subject: [PATCH] Compress chunk headers and payloads without an intermediate
 full copy


diff --git a/src/main/java/net/minecraft/server/AthenaChunkPacketCache.java b/src/main/java/net/minecraft/server/AthenaChunkPacketCache.java
index 4ee0603d710f1a3e0c6f91df0c22bebb5e6f5964..9d6248e895e4076fcc718afa7d8c4086951f1cee 100644
--- a/src/main/java/net/minecraft/server/AthenaChunkPacketCache.java
+++ b/src/main/java/net/minecraft/server/AthenaChunkPacketCache.java
@@ -173,50 +173,50 @@ final class AthenaChunkPacketCache {
             return this.frame; // frame is set before map is cleared
         }
 
-        ByteBuf raw = Unpooled.buffer(data.data.length + 32);
-
+        // Athena - serialize only the header and feed the existing immutable payload separately.
+        // NO_FLUSH keeps both inputs in one zlib stream without a full-size intermediate copy.
+        ByteBuf header = Unpooled.buffer(32);
         try {
-            PacketDataSerializer serializer = new PacketDataSerializer(raw);
-
+            PacketDataSerializer serializer = new PacketDataSerializer(header);
             serializer.writeVarIntToBuffer(packetId);
             serializer.writeInt(this.chunkX);
             serializer.writeInt(this.chunkZ);
             serializer.writeBoolean(true);
             serializer.writeShort((short) (data.dataSize & 0xFFFF));
-            serializer.writeByteArray(data.data);
-
-            int rawLength = raw.readableBytes();
-
-            if (rawLength < threshold) {
-                return null;
-            }
+            serializer.writeVarIntToBuffer(data.data.length);
+            int rawLength = header.readableBytes() + data.data.length;
+            if (rawLength < threshold) return null;
 
             Deflater deflater = DEFLATER.get();
             ByteBuf out = Unpooled.buffer(rawLength / 4 + 64);
-            PacketDataSerializer outSerializer = new PacketDataSerializer(out);
-            byte[] chunk = DEFLATE_BUFFER.get();
-
-            outSerializer.writeVarIntToBuffer(rawLength);
             try {
-                deflater.setInput(raw.array(), raw.arrayOffset() + raw.readerIndex(), rawLength);
-                deflater.finish();
-
-                while (!deflater.finished()) {
-                    int n = deflater.deflate(chunk);
-
-                    out.writeBytes(chunk, 0, n);
+                new PacketDataSerializer(out).writeVarIntToBuffer(rawLength);
+                byte[] buffer = DEFLATE_BUFFER.get();
+                try {
+                    deflater.setInput(header.array(), header.arrayOffset() + header.readerIndex(), header.readableBytes());
+                    while (!deflater.needsInput()) {
+                        int count = deflater.deflate(buffer);
+                        out.writeBytes(buffer, 0, count);
+                    }
+                    deflater.setInput(data.data);
+                    deflater.finish();
+                    while (!deflater.finished()) {
+                        int count = deflater.deflate(buffer);
+                        out.writeBytes(buffer, 0, count);
+                    }
+                } finally {
+                    deflater.reset();
                 }
+                result = new byte[out.readableBytes()];
+                out.readBytes(result);
             } finally {
-                deflater.reset();
+                out.release();
             }
-
-            result = new byte[out.readableBytes()];
-            out.readBytes(result);
             this.frame = result;
             this.map = null;
             return result;
         } finally {
-            raw.release();
+            header.release();
         }
     }
 
diff --git a/src/test/java/net/minecraft/server/AthenaChunkCompressionInputTest.java b/src/test/java/net/minecraft/server/AthenaChunkCompressionInputTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..e4d8b7cc665efa2f9b6744a8de62047936f57871
--- /dev/null
+++ b/src/test/java/net/minecraft/server/AthenaChunkCompressionInputTest.java
@@ -0,0 +1,101 @@
+package net.minecraft.server;
+
+import static org.junit.Assert.*;
+
+import io.netty.buffer.ByteBuf;
+import io.netty.buffer.Unpooled;
+import java.util.Random;
+import java.util.concurrent.*;
+import java.util.zip.Deflater;
+import org.bukkit.support.AbstractTestingBase;
+import org.junit.Test;
+
+public class AthenaChunkCompressionInputTest extends AbstractTestingBase {
+    @Test
+    public void splitInputsMatchTheOriginalStreamAtLevelsLengthsAndThresholds() throws Exception {
+        int previous = PacketCompressor.level();
+        try {
+            for (int level : new int[] {1, 6, 9}) {
+                PacketCompressor.setLevel(level);
+                ExecutorService thread = Executors.newSingleThreadExecutor();
+                try {
+                    thread.submit(() -> {
+                        for (int length : new int[] {0, 1, 127, 128, 16383, 16384, 196864}) {
+                            for (boolean noisy : new boolean[] {false, true}) {
+                                byte[] payload = new byte[length];
+                                if (noisy) new Random(length).nextBytes(payload);
+                                PacketPlayOutMapChunk.ChunkMap map = new PacketPlayOutMapChunk.ChunkMap();
+                                map.data = payload;
+                                map.dataSize = 0xA55A;
+                                byte[] raw = raw(map);
+                                byte[] expected = originalFrame(raw, level);
+                                for (int threshold : new int[] {raw.length - 1, raw.length, raw.length + 1}) {
+                                    AthenaChunkPacketCache cache = new AthenaChunkPacketCache(Integer.MIN_VALUE, Integer.MAX_VALUE, map);
+                                    byte[] actual = cache.frame(0x1234, threshold);
+                                    if (threshold > raw.length) {
+                                        assertNull(actual);
+                                        assertSame(map, cache.map());
+                                    } else {
+                                        assertArrayEquals("level=" + level + ",length=" + length + ",noisy=" + noisy, expected, actual);
+                                        assertNull(cache.map());
+                                        assertSame(actual, cache.frame(0x1234, threshold));
+                                    }
+                                }
+                            }
+                        }
+                    }).get(30, TimeUnit.SECONDS);
+                } finally { thread.shutdownNow(); }
+            }
+        } finally { PacketCompressor.setLevel(previous); }
+    }
+
+    @Test
+    public void concurrentFirstReadersShareTheSameCompleteFrame() throws Exception {
+        PacketPlayOutMapChunk.ChunkMap map = new PacketPlayOutMapChunk.ChunkMap();
+        map.data = new byte[196864];
+        new Random(11).nextBytes(map.data);
+        AthenaChunkPacketCache cache = new AthenaChunkPacketCache(Integer.MIN_VALUE, Integer.MAX_VALUE, map);
+        byte[] expected = originalFrame(raw(map), PacketCompressor.level());
+        ExecutorService threads = Executors.newFixedThreadPool(3);
+        CountDownLatch start = new CountDownLatch(1);
+        try {
+            java.util.List<Future<byte[]>> results = new java.util.ArrayList<>();
+            for (int i = 0; i < 3; ++i) results.add(threads.submit(() -> { start.await(); return cache.frame(0x1234, 0); }));
+            start.countDown();
+            byte[] first = results.get(0).get(10, TimeUnit.SECONDS);
+            assertArrayEquals(expected, first);
+            for (Future<byte[]> result : results) assertSame(first, result.get(10, TimeUnit.SECONDS));
+        } finally { threads.shutdownNow(); }
+    }
+
+    private static byte[] raw(PacketPlayOutMapChunk.ChunkMap map) {
+        ByteBuf buffer = Unpooled.buffer();
+        try {
+            PacketDataSerializer serializer = new PacketDataSerializer(buffer);
+            serializer.writeVarIntToBuffer(0x1234);
+            serializer.writeInt(Integer.MIN_VALUE);
+            serializer.writeInt(Integer.MAX_VALUE);
+            serializer.writeBoolean(true);
+            serializer.writeShort(map.dataSize);
+            serializer.writeByteArray(map.data);
+            byte[] result = new byte[buffer.readableBytes()];
+            buffer.readBytes(result);
+            return result;
+        } finally { buffer.release(); }
+    }
+
+    private static byte[] originalFrame(byte[] raw, int level) {
+        ByteBuf output = Unpooled.buffer();
+        Deflater compressor = new Deflater(level);
+        try {
+            new PacketDataSerializer(output).writeVarIntToBuffer(raw.length);
+            compressor.setInput(raw);
+            compressor.finish();
+            byte[] scratch = new byte[8192];
+            while (!compressor.finished()) output.writeBytes(scratch, 0, compressor.deflate(scratch));
+            byte[] result = new byte[output.readableBytes()];
+            output.readBytes(result);
+            return result;
+        } finally { compressor.end(); output.release(); }
+    }
+}
