+    @After
+    public void tearDown() throws Exception {
+        // put the statics the settings feed (the guard's switches, budgets, ...) back to their defaults
+        File fresh = new File(this.dir, "fresh.yml");
+        AthenaConfig.init(fresh, null);
+        for (File file : this.dir.listFiles()) {
+            file.delete();
+        }
+        this.dir.delete();
+    }
+
+    private void write(File file, String... lines) throws Exception {
+        Files.write(file.toPath(), Arrays.asList(lines), StandardCharsets.UTF_8);
+    }
+
+    private String read(File file) throws Exception {
+        return new String(Files.readAllBytes(file.toPath()), StandardCharsets.UTF_8);
+    }
+
+    private static String withoutComments(String yml) {
+        StringBuilder out = new StringBuilder();
+
+        for (String line : yml.split("\n")) {
+            if (!line.trim().startsWith("#")) {
+                out.append(line).append('\n');
+            }
+        }
+        return out.toString();
+    }
+
+    private void writeOldPandaSpigotYml() throws Exception {
+        write(this.panda,
+                "maxBookPageSize: 1234",
+                "ioUring: true",
+                "networkCompressionLevel: 3",
+                "chunkUnloadMillisPerTick: 7",
+                "bungeeGuardTokens:",
+                "  - secret-one",
+                "guard:",
+                "  enabled: true",
+                "  enforce: false",
+                "  kickViolations: 9",
+                "worlds:",
+                "  default:",
+                "    randomArrowDamage: false",
+                "    chunkUnloadMargin: 2",
+                "  lobby:",
+                "    cacheChunkPackets: false");
+    }
+
+    @Test
+    public void theFirstStartMovesTheSettingsWithTheirValues() throws Exception {
+        writeOldPandaSpigotYml();
+
+        AthenaConfig.init(this.athena, this.panda);
+
+        AthenaConfig config = AthenaConfig.get();
+        assertTrue(config.ioUring);
+        assertEquals(3, config.networkCompressionLevel);
+        assertEquals(7, config.chunkUnloadMillisPerTick);
+        assertEquals(10, config.chunkLoadFinishMillisPerTick); // not set before: the default
+        assertEquals(Arrays.asList("secret-one"), config.bungeeGuardTokens);
+        assertFalse(config.guard.enforce);
+        assertEquals(9, config.guard.kickViolations);
+        assertEquals(2, AthenaConfig.getWorldConfig("world").chunkUnloadMargin);
+        assertTrue(AthenaConfig.getWorldConfig("world").cacheChunkPackets);
+        assertFalse(AthenaConfig.getWorldConfig("lobby").cacheChunkPackets);
+
+        String athenaYml = read(this.athena);
+        assertTrue(athenaYml, athenaYml.contains("secret-one"));
+        assertTrue(athenaYml, athenaYml.contains("chunkUnloadMargin: 2"));
+
+        // pandaspigot.yml keeps PandaSpigot's own settings and loses Athena's
+        String pandaYml = read(this.panda);
+        assertTrue(pandaYml, pandaYml.contains("maxBookPageSize: 1234"));
+        assertTrue(pandaYml, pandaYml.contains("randomArrowDamage: false"));
+        for (String key : new String[] {"ioUring", "networkCompressionLevel", "chunkUnloadMillisPerTick", "bungeeGuardTokens", "secret-one", "guard", "chunkUnloadMargin", "cacheChunkPackets"}) {
+            assertFalse(key + " left in pandaspigot.yml:\n" + pandaYml, pandaYml.contains(key));
+        }
+    }
+
+    @Test
+    public void laterStartsKeepAthenaYmlAndDropWhatReappearsInPandaSpigotYml() throws Exception {
+        writeOldPandaSpigotYml();
+        AthenaConfig.init(this.athena, this.panda);
+
+        // someone copies an old pandaspigot.yml back in
+        writeOldPandaSpigotYml();
+        String before = read(this.athena);
+        AthenaConfig.init(this.athena, this.panda);
+
+        // the YAML library re-indents comments when it rewrites a file (pandaspigot.yml too): compare the settings
+        assertEquals("athena.yml is the one that counts", withoutComments(before), withoutComments(read(this.athena)));
+        assertTrue(AthenaConfig.get().ioUring);
+        assertFalse(read(this.panda).contains("ioUring"));
+    }
+
+    @Test
