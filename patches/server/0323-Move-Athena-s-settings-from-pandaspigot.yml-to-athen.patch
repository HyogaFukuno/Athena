From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: glacier <hyouga.dev@gmail.com>
Date: Mon, 19 Oct 2026 08:26:43 +0900
Subject: [PATCH] Move Athena's settings from pandaspigot.yml to athena.yml

Every setting Athena added - debugVerifyAthenaIndexes, ioUring, bungeeGuardTokens,
networkCompressionLevel, the two chunk budgets and guard, and per world cacheChunkPackets,
chunkUnloadMargin, asyncChunkShaping and asyncChunkDecoration - now lives in athena.yml
(--athena-settings), laid out like pandaspigot.yml with worlds.default and per-world sections.
pandaspigot.yml keeps only PandaSpigot's own settings.

athena.yml is read before pandaspigot.yml, on startup and on /reload. The first start with it moves
the keys a server already has in pandaspigot.yml into athena.yml with their values and removes them
there, and logs what it moved; once athena.yml exists, Athena keys found in pandaspigot.yml are
ignored, removed and logged. Checked by booting a copy of a production-style pandaspigot.yml:
guard.enforce/log false and chunkUnloadMargin 2 carried over, nothing left behind. Tests 5521/5521.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/src/main/java/athena/server/AthenaConfig.java b/src/main/java/athena/server/AthenaConfig.java
new file mode 100644
index 0000000000000000000000000000000000000000..50f5e6106431dbd2a020aeaaad713ab3330b10df
--- /dev/null
+++ b/src/main/java/athena/server/AthenaConfig.java
@@ -0,0 +1,276 @@
+package athena.server;
+
+import com.google.common.base.Throwables;
+import com.hpfxd.configurate.eoyaml.EOYamlConfigurationLoader;
+import java.io.File;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import net.minecraft.server.World;
+import org.apache.logging.log4j.LogManager;
+import org.apache.logging.log4j.Logger;
+import org.spongepowered.configurate.CommentedConfigurationNode;
+import org.spongepowered.configurate.ConfigurationNode;
+import org.spongepowered.configurate.objectmapping.ConfigSerializable;
+import org.spongepowered.configurate.objectmapping.ObjectMapper;
+import org.spongepowered.configurate.objectmapping.meta.Comment;
+import org.spongepowered.configurate.util.MapFactories;
+import org.spongepowered.configurate.util.NamingSchemes;
+
+/**
+ * Athena - athena.yml: every setting Athena added, kept apart from pandaspigot.yml so that PandaSpigot's
+ * file stays PandaSpigot's. Laid out the same way - global settings at the top, per-world ones under
+ * worlds.default and sections named after worlds - and read on startup and on /reload, before
+ * pandaspigot.yml.
+ *
+ * <p>Servers set up before athena.yml existed have these keys in pandaspigot.yml. The first start
+ * with this version moves them: their values become athena.yml's and they are taken out of
+ * pandaspigot.yml, so nothing configured is lost and nothing is set in two places. Once athena.yml
+ * exists, Athena keys found in pandaspigot.yml are ignored, logged and removed.
+ */
+@ConfigSerializable
+@SuppressWarnings({"FieldCanBeLocal", "FieldMayBeFinal"})
+public class AthenaConfig {
+
+    private static final Logger LOGGER = LogManager.getLogger("Athena");
+
+    /** The global keys athena.yml took over from pandaspigot.yml. */
+    private static final String[] MOVED_GLOBAL_KEYS = {
+        "debugVerifyAthenaIndexes", "ioUring", "bungeeGuardTokens", "networkCompressionLevel",
+        "chunkLoadFinishMillisPerTick", "chunkUnloadMillisPerTick", "guard"
+    };
+    /** And the per-world ones, under worlds.<name>. */
+    private static final String[] MOVED_WORLD_KEYS = {
+        "cacheChunkPackets", "chunkUnloadMargin", "asyncChunkShaping", "asyncChunkDecoration"
+    };
+
+    private static AthenaConfig config = new AthenaConfig();
+    private static AthenaWorldConfig defaultWorldConfig = new AthenaWorldConfig();
+    private static final Map<String, AthenaWorldConfig> worldConfigs = new HashMap<String, AthenaWorldConfig>();
+
+    private static EOYamlConfigurationLoader loader(File file, String header) {
+        return EOYamlConfigurationLoader.builder()
+                .file(file)
+                .defaultOptions(o -> o
+                        .header(header)
+                        .mapFactory(MapFactories.insertionOrdered())
+                        .serializers(build -> build.registerAnnotatedObjects(ObjectMapper.factoryBuilder()
+                                .defaultNamingScheme(NamingSchemes.CAMEL_CASE)
+                                .build())))
+                .build();
+    }
+
+    /**
+     * Loads athena.yml, moving Athena's keys out of pandaspigot.yml first, and applies the settings
+     * that live in static fields elsewhere. Called on startup and every reload, before
+     * PandaSpigotConfig.init.
+     */
+    public static void init(File file, File pandaSpigotFile) {
+        try {
+            boolean fresh = !file.exists();
+            EOYamlConfigurationLoader loader = loader(file,
+                    "This is the configuration file for Athena: the settings Athena adds to PandaSpigot.\n" +
+                    "PandaSpigot's own settings stay in pandaspigot.yml.");
+            CommentedConfigurationNode root = loader.load();
+
+            if (migrate(root, fresh, pandaSpigotFile) && fresh) {
+                // write the moved values in the file's own order, not in the order they were found,
+                // so that the next start does not rearrange the file
+                CommentedConfigurationNode ordered = loader.createNode();
+                ordered.set(root.get(AthenaConfig.class));
+                ordered.node("worlds").from(root.node("worlds"));
+                root = ordered;
+            }
+
+            config = root.get(AthenaConfig.class);
+
+            CommentedConfigurationNode worldsNode = root.node("worlds")
+                    .comment("Settings which can be configured per world. \"default\" gives the values for\n" +
+                            "every world without a section of its own; to set a world apart, add a section\n" +
+                            "with the world's name.");
+            ConfigurationNode defaultWorldNode = worldsNode.node("default");
+            defaultWorldConfig = defaultWorldNode.get(AthenaWorldConfig.class);
+            defaultWorldNode.set(defaultWorldConfig); // populate the defaults in the file
+
+            root.set(config);
+            loader.save(root);
+
+            worldConfigs.clear();
+            for (Map.Entry<Object, ? extends ConfigurationNode> entry : worldsNode.childrenMap().entrySet()) {
+                if (!"default".equals(entry.getKey())) {
+                    worldConfigs.put(entry.getKey().toString(), entry.getValue().get(AthenaWorldConfig.class));
+                }
+            }
+
+            apply(config);
+        } catch (Exception e) {
+            throw Throwables.propagate(e);
+        }
+    }
+
+    /**
+     * Moves Athena's keys out of pandaspigot.yml: into athena.yml if it is being created now, nowhere
+     * (with a warning) if it already existed. Returns whether any were found.
+     */
+    private static boolean migrate(CommentedConfigurationNode root, boolean fresh, File pandaSpigotFile) throws Exception {
+        if (pandaSpigotFile == null || !pandaSpigotFile.isFile()) {
+            return false;
+        }
+
+        EOYamlConfigurationLoader pandaLoader = loader(pandaSpigotFile,
+                "This is the configuration file for PandaSpigot.\n" +
+                "Use caution when modifying settings, as some may impact gameplay in non-obvious ways.");
+        CommentedConfigurationNode panda = pandaLoader.load();
+        List<String> found = new ArrayList<String>();
+
+        for (String key : MOVED_GLOBAL_KEYS) {
+            move(panda, root, fresh, found, key);
+        }
+        for (Map.Entry<Object, ? extends CommentedConfigurationNode> world : panda.node("worlds").childrenMap().entrySet()) {
+            for (String key : MOVED_WORLD_KEYS) {
+                move(panda, root, fresh, found, "worlds", world.getKey(), key);
+            }
+        }
+
+        if (found.isEmpty()) {
+            return false;
+        }
+        pandaLoader.save(panda);
+        if (fresh) {
+            LOGGER.info("Moved Athena's settings from {} to athena.yml: {}", pandaSpigotFile.getName(), found);
+        } else {
+            LOGGER.warn("Ignored and removed Athena settings found in {} - they are read from athena.yml: {}", pandaSpigotFile.getName(), found);
+        }
+        return true;
+    }
+
+    private static void move(CommentedConfigurationNode from, CommentedConfigurationNode to, boolean copy, List<String> found, Object... path) {
+        CommentedConfigurationNode node = from.node(path);
+
+        if (node.virtual()) {
+            return;
+        }
+        if (copy) {
+            to.node(path).from(node);
+        }
+        node.parent().removeChild(path[path.length - 1]);
+
+        StringBuilder name = new StringBuilder();
+        for (Object part : path) {
+            name.append(name.length() == 0 ? "" : ".").append(part);
+        }
+        found.add(name.toString());
+    }
+
+    /** The settings that other classes keep in static fields. */
+    private static void apply(AthenaConfig config) {
+        // publish the audit gate as a plain static; see AthenaIndexAudit.enabled()
+        net.minecraft.server.AthenaIndexAudit.setEnabled(config.debugVerifyAthenaIndexes);
+        // the network deflate level, read by each Netty thread's deflater as it is made
+        net.minecraft.server.PacketCompressor.setLevel(config.networkCompressionLevel);
+        // how long a tick may spend finishing chunk loads, and unloading (saving) chunks
+        org.bukkit.craftbukkit.chunkio.ChunkIOExecutor.setFinishBudgetMillis(config.chunkLoadFinishMillisPerTick);
+        net.minecraft.server.ChunkProviderServer.setUnloadBudgetMillis(config.chunkUnloadMillisPerTick);
+        // the guard's switches
+        GuardConfig guard = config.guard;
+        net.minecraft.server.AthenaGuard.configure(guard.enabled, guard.enforce, guard.movement, guard.timer, guard.combat, guard.maxReach, guard.log, guard.kick, guard.kickMessage, guard.kickViolations, guard.kickWindowSeconds);
+    }
+
+    public static AthenaConfig get() {
+        return config;
+    }
+
+    public static AthenaWorldConfig getWorldConfig(String worldName) {
+        AthenaWorldConfig world = worldConfigs.get(worldName);
+
+        return world != null ? world : defaultWorldConfig;
+    }
+
+    public static AthenaWorldConfig getWorldConfig(World world) {
+        return getWorldConfig(world.worldData.getName());
+    }
+
+    //------------------------------------------------------------------------
+    @Comment("DEBUG ONLY. Verifies, every tick, that the derived lookup structures Athena added\n" +
+        "still agree with the collections they mirror:\n" +
+        "  - ChunkProviderServer.creatureCensus vs a fresh sum over every loaded chunk, and the\n" +
+        "    two sites that adjust it, which is where a real divergence was found\n" +
+        "  - Chunk's X/Z bucket index vs the entity slice it is derived from, and the per-slice\n" +
+        "    IMonster and EntityHuman counts a target query skips slices on\n" +
+        "Any disagreement is logged as a warning with a stack trace. This costs real time, so\n" +
+        "leave it off outside of testing.")
+    public boolean debugVerifyAthenaIndexes = false;
+
+    @Comment("Use Linux io_uring for player connections instead of epoll: reads and writes go to the\n" +
+        "kernel in batches rather than one system call each. Needs Linux 5.9 or newer, and a\n" +
+        "container may block it (Docker's default seccomp profile does); when it is not available\n" +
+        "the server says why and uses epoll. Takes effect on restart.\n" +
+        "Default: false")
+    public boolean ioUring = false;
+
+    @Comment("Tokens a proxy must send to log players in, when bungeecord is on in spigot.yml.\n" +
+        "IP forwarding lets whoever reaches this server's port claim any player's UUID, an operator's\n" +
+        "included. With a token listed here, a login that does not carry one of them is refused, so\n" +
+        "only the proxy can log players in even if the port is reachable. Velocity sends the contents\n" +
+        "of its forwarding.secret file when player-info-forwarding-mode = \"BUNGEEGUARD\"; the\n" +
+        "BungeeGuard plugin does the same for BungeeCord. Keep this file private. Empty: no check.\n" +
+        "Write one token per line, as a block list - a one-line [\"...\"] list is read as a single\n" +
+        "token, brackets and all, and then no login gets in:\n" +
+        "  bungeeGuardTokens:\n" +
+        "    - the-contents-of-forwarding.secret\n" +
+        "Takes effect on restart.\n" +
+        "Default: []")
+    public List<String> bungeeGuardTokens = new ArrayList<String>();
+
+    @Comment("The zlib level (1-9) packets over the network compression threshold are compressed\n" +
+        "at. Chunks are compressed once and cached (see cacheChunkPackets) and always use the\n" +
+        "default level; this is everything else - entity metadata, inventories, tab list and\n" +
+        "scoreboard packets. 1 is the fastest and sends the most bytes. Takes effect on restart.\n" +
+        "Default: 6")
+    public int networkCompressionLevel = 6;
+
+    @Comment("How many milliseconds one tick may spend finishing chunks read from disk (their entities,\n" +
+        "ChunkLoadEvent, neighbours); the rest wait for the next ticks. Many players arriving in a\n" +
+        "world at once request hundreds of chunks together, and finishing them all in one tick froze\n" +
+        "the server for up to a second. 0 finishes everything in the tick it was read, as vanilla.\n" +
+        "Default: 10")
+    public int chunkLoadFinishMillisPerTick = 10;
+
+    @Comment("How many milliseconds one tick may spend unloading chunks (an ordinary world saves each\n" +
+        "one as it goes); the rest stay queued for the next ticks. Everyone leaving a world at once\n" +
+        "queued its whole view and made ~140 ms ticks. 0 keeps only vanilla's 100 chunks a tick.\n" +
+        "Default: 10")
+    public int chunkUnloadMillisPerTick = 10;
+
+    @Comment("Server-authoritative checks on what players report. The server decides where a player\n" +
+        "can be and whom they can hit: moves no unmodified client could make are set back, hits\n" +
+        "that could not land are dropped, and fall damage and critical hits follow the ground the\n" +
+        "server sees. 1.8 and 1.7.10 clients are both checked by their own physics.\n" +
+        "  enforce: false only logs what would have been blocked (to look for false positives)")
+    public GuardConfig guard = new GuardConfig();
+
+    @ConfigSerializable
+    public static class GuardConfig {
+        public boolean enabled = true;
+        public boolean enforce = true;
+        @Comment("Speed, fly, step, jump height, and the ground used for fall damage and critical hits")
+        public boolean movement = true;
+        @Comment("Movement packets sent faster than real time")
+        public boolean timer = true;
+        @Comment("Reach, hits off to the side, hits without an arm swing, more than one hit a tick")
+        public boolean combat = true;
+        @Comment("Vanilla is 3.0, measured from the eye to the nearest point of the target's box")
+        public double maxReach = 3.0D;
+        @Comment("When enforcing, also kick a player whose checks fail kickViolations times within\n" +
+            "kickWindowSeconds (each failed move is still set back, each failed hit still dropped). Two hits\n" +
+            "in one tick never count: fast clicking does that")
+        public boolean kick = true;
+        public int kickViolations = 5;
+        public int kickWindowSeconds = 30;
+        public String kickMessage = "不正な動作を検出したため切断しました";
+        @Comment("Log what is blocked (or would be, when not enforcing), at most once per check per\n" +
+            "player every two seconds")
+        public boolean log = true;
+    }
+}
