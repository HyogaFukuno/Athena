+++ b/src/main/java/athena/server/AthenaWorldConfig.java
@@ -0,0 +1,62 @@
+package athena.server;
+
+import org.spongepowered.configurate.objectmapping.ConfigSerializable;
+import org.spongepowered.configurate.objectmapping.meta.Comment;
+
+/**
+ * Athena - the per-world settings in athena.yml (worlds.default, or a section named after the world).
+ * Read once, when the world loads.
+ */
+@ConfigSerializable
+@SuppressWarnings({"FieldCanBeLocal", "FieldMayBeFinal"})
+public class AthenaWorldConfig {
+
+    @Comment("When enabled, each chunk's packet is compressed once and the compressed bytes are\n" +
+            "sent to every player that needs the chunk, until a block or light change in it\n" +
+            "makes a new one. On a small map players cross chunk borders constantly and 1.8\n" +
+            "resends a row of chunks each time: a 20-player arena compressed the same few\n" +
+            "hundred chunks 70,000 times in three minutes, and that compression was most of\n" +
+            "the CPU the server used. Chunks are then sent one per packet instead of in bulk\n" +
+            "packets; the chunk data is the same.\n" +
+            "Not used while anti-xray is on - it rewrites a chunk depending on its neighbours -\n" +
+            "or when network compression is off, where there is nothing to cache.\n" +
+            "Default: true")
+    public boolean cacheChunkPackets = true;
+
+    @Comment("How many chunks past the view distance a player keeps a chunk before it is unloaded\n" +
+            "from the client. 1.8 unloads a chunk as soon as it leaves the view square and sends it\n" +
+            "again when it comes back, so walking to and fro across a chunk border resends a whole\n" +
+            "row each time. With a margin, chunks are still sent at the view distance but only\n" +
+            "forgotten that much further out. The client draws by its own render distance; it just\n" +
+            "holds a few more chunks, which the server keeps up to date. 0 is vanilla.\n" +
+            "Default: 0")
+    public int chunkUnloadMargin = 0;
+
+    @Comment("When enabled, the first half of generating a brand new chunk - noise, biomes,\n" +
+            "surface blocks, caves and ravines - runs on a worker thread instead of the\n" +
+            "server thread. It is a pure function of the seed and the chunk coordinates, so\n" +
+            "the terrain it produces is identical either way; structures, lighting, the\n" +
+            "chunk map, events and population all still happen on the server thread in the\n" +
+            "same order as before.\n" +
+            "Only ordinary generated worlds use it. A world with a plugin chunk generator\n" +
+            "always generates on the server thread.\n" +
+            "Default: true")
+    public boolean asyncChunkShaping = true;
+
+    @Comment("When enabled, the decoration pass of populating a chunk - ores, trees, plants -\n" +
+            "runs on a worker thread instead of the server thread. It is about three quarters\n" +
+            "of what populating a chunk costs and touches no entities or tile entities, so it\n" +
+            "is the part that can be lifted out. Structures, lakes, dungeons, the animals a new\n" +
+            "chunk starts with, ice and snow, plugin block populators and ChunkPopulateEvent all\n" +
+            "still run on the server thread, in the same order as before; the blocks the\n" +
+            "decoration chose are replayed there too, so lighting and client updates are\n" +
+            "unchanged.\n" +
+            "Decoration runs on a single thread for the whole server, so its ordering is exactly\n" +
+            "as serial as it has always been.\n" +
+            "The blocks are put into the chunk sections in bulk and the chunk is relit and sent\n" +
+            "once, rather than one setTypeAndData per block: a replayed write reaches loaded\n" +
+            "neighbours that an inline one does not, and propagating skylight into them for every\n" +
+            "block was more expensive than the decoration it replaced.\n" +
+            "Default: true")
+    public boolean asyncChunkDecoration = true;
+}
