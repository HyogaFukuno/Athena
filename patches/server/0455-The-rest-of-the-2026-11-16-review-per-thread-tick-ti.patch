+    /**
+     * The 1.7 tab list knows its entries by name alone, at most 16 characters: two players whose
+     * names are the same once cut to 16 shared one entry, and when one left the other went too.
+     * The name to list {@code profile} under, unlike every other entry of the session: if taken, a
+     * colour code is added at the end (invisible), or put over the last two characters.
+     */
+    static String uniqueListName(Map<UUID, Profile> profiles, UUID uuid, Profile profile) {
+        String base = profile.listName();
+        if (!listedByOther(profiles, uuid, base)) return base;
+        String stem = base.length() <= 14 ? base : base.substring(0, 14);
+        for (int k = 0; k < 16; ++k) {
+            String name = stem + '\u00a7' + Character.forDigit(k, 16);
+            if (!listedByOther(profiles, uuid, name)) return name;
+        }
+        for (int k = 0; ; ++k) { // more than 16 of the same name: numbers
+            String digits = Integer.toString(k);
+            String name = (base.length() + digits.length() <= 16 ? base : base.substring(0, 16 - digits.length())) + digits;
+            if (!listedByOther(profiles, uuid, name)) return name;
+        }
+    }
+
+    private static boolean listedByOther(Map<UUID, Profile> profiles, UUID uuid, String name) {
+        for (Map.Entry<UUID, Profile> entry : profiles.entrySet()) {
+            if (name.equals(entry.getValue().listed) && !entry.getKey().equals(uuid)) return true;
+        }
+        return false;
+    }
