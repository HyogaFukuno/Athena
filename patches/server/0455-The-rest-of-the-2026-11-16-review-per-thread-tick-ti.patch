@@ -0,0 +1,56 @@
+package net.minecraft.server;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertSame;
+
+import com.mojang.authlib.GameProfile;
+import java.lang.reflect.Field;
+import java.util.List;
+import java.util.UUID;
+import org.junit.Test;
+
+/**
+ * Athena - a disguise has a UUID of its own, and every tab list packet a viewer is sent carries it
+ * for the disguised player (not only those that carry a name): only the player sees their own.
+ */
+public class AthenaDisguiseUuidTest {
+
+    private static EntityPlayer player(String name) throws Exception {
+        EntityPlayer player = AthenaAuditFixtures.allocate(EntityPlayer.class);
+        player.setProfile(new GameProfile(UUID.randomUUID(), name));
+        AthenaAuditFixtures.set(player, EntityPlayer.class, "playerInteractManager", AthenaAuditFixtures.allocate(PlayerInteractManager.class));
+        return player;
+    }
+
+    @SuppressWarnings("unchecked")
+    private static UUID uuid(PacketPlayOutPlayerInfo packet, int i) throws Exception {
+        Field field = PacketPlayOutPlayerInfo.class.getDeclaredField("players");
+        field.setAccessible(true);
+        return ((List<PacketPlayOutPlayerInfo.PlayerInfoData>) field.get(packet)).get(i).getProfile().getId();
+    }
+
+    @Test
+    public void everyActionCarriesTheDisguisesUuidForOthers() throws Exception {
+        EntityPlayer hidden = player("RealName");
+        EntityPlayer other = player("Other");
+        GameProfile disguise = new GameProfile(UUID.randomUUID(), "SwiftFox482");
+        hidden.athenaDisguise = disguise;
+
+        for (PacketPlayOutPlayerInfo.EnumPlayerInfoAction action : PacketPlayOutPlayerInfo.EnumPlayerInfoAction.values()) {
+            PacketPlayOutPlayerInfo packet = new PacketPlayOutPlayerInfo(action, hidden, other);
+            PacketPlayOutPlayerInfo seenByOther = packet.athenaFor(other);
+            assertEquals(action + ", seen by another", disguise.getId(), uuid(seenByOther, 0));
+            assertEquals(other.getProfile().getId(), uuid(seenByOther, 1));
+            assertSame(action + ", seen by the player: as made", packet, packet.athenaFor(hidden));
+            assertEquals(hidden.getProfile().getId(), uuid(packet.athenaFor(hidden), 0));
+        }
+
+        // no one disguised: the same packet for everyone
+        hidden.athenaDisguise = null;
+        PacketPlayOutPlayerInfo packet = new PacketPlayOutPlayerInfo(PacketPlayOutPlayerInfo.EnumPlayerInfoAction.UPDATE_LATENCY, java.util.Arrays.asList(hidden, other));
+        assertSame(packet, packet.athenaFor(other));
+
+        // the entry a disguise had is taken off as it is
+        assertEquals(disguise.getId(), uuid(PacketPlayOutPlayerInfo.athenaRemove(disguise.getId()).athenaFor(other), 0));
+    }
+}
