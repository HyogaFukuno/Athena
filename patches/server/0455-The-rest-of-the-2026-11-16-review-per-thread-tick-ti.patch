@@ -0,0 +1,51 @@
+package net.minecraft.server;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+
+import java.io.File;
+import java.io.RandomAccessFile;
+import java.nio.file.Files;
+import java.util.HashMap;
+import java.util.Map;
+import org.junit.Test;
+
+/** Athena - a frame file damaged on disk is not mapped (its chunk packets are made again instead). */
+public class AthenaFrameFileCrcTest {
+
+    @Test
+    public void aDamagedFileIsNotMapped() throws Exception {
+        File dir = Files.createTempDirectory("athena-frames").toFile();
+        try {
+            File file = AthenaFrameFile.file(dir, 0x1234L, 0x21, 6, 256);
+            Map<Integer, AthenaFrameFile.Pending> added = new HashMap<Integer, AthenaFrameFile.Pending>();
+            added.put(1, new AthenaFrameFile.Pending(3, new byte[256], new byte[] { 1, 2, 3, 4, 5 }));
+            added.put(3, new AthenaFrameFile.Pending(1, new byte[256], new byte[] { 9, 8, 7 }));
+            assertEquals(2, AthenaFrameFile.write(file, 0x1234L, 4, null, added));
+
+            AthenaFrameFile mapped = AthenaFrameFile.map(file, 0x1234L, 4);
+            assertNotNull("as written", mapped);
+            assertTrue(mapped.has(1) && mapped.has(3));
+
+            // rewritten with an old file's frames kept: still whole
+            added.clear();
+            added.put(2, new AthenaFrameFile.Pending(7, new byte[256], new byte[] { 6, 6 }));
+            assertEquals(3, AthenaFrameFile.write(file, 0x1234L, 4, mapped, added));
+            assertNotNull("rewritten", AthenaFrameFile.map(file, 0x1234L, 4));
+
+            // one byte of the last frame changed
+            try (RandomAccessFile raf = new RandomAccessFile(file, "rw")) {
+                raf.seek(raf.length() - 1);
+                int b = raf.read();
+                raf.seek(raf.length() - 1);
+                raf.write(b ^ 0x40);
+            }
+            assertNull("damaged", AthenaFrameFile.map(file, 0x1234L, 4));
+        } finally {
+            for (File f : dir.listFiles()) f.delete();
+            dir.delete();
+        }
+    }
+}
