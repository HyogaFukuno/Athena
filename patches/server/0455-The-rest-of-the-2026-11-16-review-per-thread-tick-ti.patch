@@ -0,0 +1,31 @@
+package net.minecraft.server;
+
+import static org.junit.Assert.fail;
+
+import io.netty.handler.codec.DecoderException;
+import org.junit.Test;
+
+/** Athena - one connection cannot keep the event loop inflating: a budget of bytes per connection. */
+public class AthenaInflateBudgetTest {
+
+    @Test
+    public void theBurstPassesThenFramesAreRefusedUntilItRefills() throws Exception {
+        PacketDecompressor decompressor = new PacketDecompressor(256);
+        int frame = 2 << 20; // the protocol's largest
+        long frames = PacketDecompressor.ATHENA_INFLATE_BURST / frame;
+        for (int i = 0; i < frames; ++i) {
+            decompressor.athenaCharge(frame);
+        }
+        try {
+            decompressor.athenaCharge(frame);
+            fail("over the burst");
+        } catch (DecoderException expected) {
+        }
+        // small packets still pass while the bucket refills
+        Thread.sleep(50L);
+        decompressor.athenaCharge(32 << 10);
+        // a second's refill is enough for RATE bytes
+        Thread.sleep(1100L);
+        decompressor.athenaCharge((int) Math.min(PacketDecompressor.ATHENA_INFLATE_RATE, frame));
+    }
+}
