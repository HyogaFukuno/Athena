diff --git a/src/main/java/net/minecraft/server/AthenaTickTimes.java b/src/main/java/net/minecraft/server/AthenaTickTimes.java
new file mode 100644
index 0000000000000000000000000000000000000000..97af89eafb1a43b04174552870fc853c5f7a2616
--- /dev/null
+++ b/src/main/java/net/minecraft/server/AthenaTickTimes.java
@@ -0,0 +1,90 @@
+package net.minecraft.server;
+
+import java.util.concurrent.atomic.AtomicLong;
+
+/**
+ * Athena - how long a world thread's ticks take, for /tps and the diagnostics kit: the server
+ * thread's numbers say nothing about the matches, which tick on threads of their own.
+ *
+ * <p>Only the owning thread records. Readers see the last full window of {@link #WINDOW} ticks
+ * (for /tps) and running totals (for the kit, which takes the difference between two reads).
+ */
+final class AthenaTickTimes {
+
+    static final int WINDOW = 100;
+    static final long OVER_NANOS = 50_000_000L;
+
+    /** One full window, immutable. */
+    static final class Window {
+        final int ticks;
+        final long sumNanos;
+        final long maxNanos;
+        final int over50;
+        /** System.nanoTime() when the window ended. */
+        final long endNanos;
+
+        Window(int ticks, long sumNanos, long maxNanos, int over50, long endNanos) {
+            this.ticks = ticks;
+            this.sumNanos = sumNanos;
+            this.maxNanos = maxNanos;
+            this.over50 = over50;
+            this.endNanos = endNanos;
+        }
+    }
+
+    // the window being filled: the owning thread only
+    private int ticks;
+    private long sumNanos;
+    private long maxNanos;
+    private int over50;
+
+    private volatile Window last;
+    /** Totals since the thread started; one writer, so plain increments of volatiles are safe. */
+    private volatile long totalTicks;
+    private volatile long totalNanos;
+    private volatile long totalOver50;
+    /** The longest tick since the kit last took it. */
+    private final AtomicLong maxSinceTaken = new AtomicLong();
+
+    /** On the owning thread, after each tick. */
+    void record(long nanos) {
+        ++this.ticks;
+        this.sumNanos += nanos;
+        if (nanos > this.maxNanos) this.maxNanos = nanos;
+        boolean over = nanos > OVER_NANOS;
+        if (over) ++this.over50;
+        this.totalTicks = this.totalTicks + 1;
+        this.totalNanos = this.totalNanos + nanos;
+        if (over) this.totalOver50 = this.totalOver50 + 1;
+        if (nanos > this.maxSinceTaken.get()) this.maxSinceTaken.accumulateAndGet(nanos, Math::max);
+        if (this.ticks == WINDOW) {
+            this.last = new Window(this.ticks, this.sumNanos, this.maxNanos, this.over50, System.nanoTime());
+            this.ticks = 0;
+            this.sumNanos = 0L;
+            this.maxNanos = 0L;
+            this.over50 = 0;
+        }
+    }
+
+    /** The last full window, or null before the first. */
+    Window last() {
+        return this.last;
+    }
+
+    long totalTicks() {
+        return this.totalTicks;
+    }
+
+    long totalNanos() {
+        return this.totalNanos;
+    }
+
+    long totalOver50() {
+        return this.totalOver50;
+    }
+
+    /** The longest tick since the last call, and starts over. */
+    long takeMax() {
+        return this.maxSinceTaken.getAndSet(0L);
+    }
+}
