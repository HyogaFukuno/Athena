+package net.minecraft.server;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNotEquals;
+import static org.junit.Assert.assertTrue;
+
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.Map;
+import java.util.Set;
+import java.util.UUID;
+import org.junit.Test;
+
+/** Athena - 1.7 tab entries are known by name: two names the same once cut to 16 get entries of their own. */
+public class AthenaLegacy17ListNameTest {
+
+    private static AthenaLegacy17.Profile listed(Map<UUID, AthenaLegacy17.Profile> profiles, UUID uuid, String name, String displayName) {
+        AthenaLegacy17.Profile profile = new AthenaLegacy17.Profile(name);
+        profile.displayName = displayName;
+        profiles.put(uuid, profile);
+        profile.listed = AthenaLegacy17.uniqueListName(profiles, uuid, profile);
+        return profile;
+    }
+
+    @Test
+    public void namesCutToTheSameSixteenGetEntriesOfTheirOwn() {
+        Map<UUID, AthenaLegacy17.Profile> profiles = new HashMap<UUID, AthenaLegacy17.Profile>();
+        UUID a = UUID.randomUUID();
+        UUID b = UUID.randomUUID();
+        AthenaLegacy17.Profile first = listed(profiles, a, "Steve", "§aSteve the Great One");
+        AthenaLegacy17.Profile second = listed(profiles, b, "Steve2", "§aSteve the Great Two");
+        assertEquals("Steve the Great ", first.listed);
+        assertNotEquals(first.listed, second.listed);
+        assertTrue(second.listed.length() <= 16);
+
+        // a short name: the colour code goes at the end, nothing visible changes
+        UUID c = UUID.randomUUID();
+        UUID d = UUID.randomUUID();
+        listed(profiles, c, "Alex", null);
+        AthenaLegacy17.Profile alex = listed(profiles, d, "Bob", "Alex");
+        assertEquals("Alex§0", alex.listed);
+
+        // the same uuid listed again keeps its name
+        assertEquals(first.listed, AthenaLegacy17.uniqueListName(profiles, a, first));
+
+        // many of the same name: all different, none over 16
+        Set<String> names = new HashSet<String>();
+        for (int i = 0; i < 40; ++i) {
+            AthenaLegacy17.Profile p = listed(profiles, UUID.randomUUID(), "x" + i, "SameSameSameSameSame");
+            assertTrue(p.listed.length() <= 16);
+            assertTrue(names.add(p.listed));
+        }
+    }
+}
