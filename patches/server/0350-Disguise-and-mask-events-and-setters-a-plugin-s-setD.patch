     @Override
     public void setDisplayName(final String name) {
+        // Athena start - masked or disguised: a plugin's display name is the real one, shown when both come off
+        if (this.athenaRealDisplayName != null) {
+            this.athenaRealDisplayName = name == null ? getName() : name;
+            return;
+        }
+        this.athenaSetDisplayName(name);
