@@ -28,6 +28,7 @@ import org.bukkit.event.player.PlayerTeleportEvent;
  */
 public final class AthenaServerImpl implements AthenaServer {
     /** A mask's colour: 1 to 4 colour or format codes, as a 1.8 team prefix leaves room for before a name. */
+    private static final java.util.regex.Pattern MINECRAFT_NAME = java.util.regex.Pattern.compile("[A-Za-z0-9_]{1,16}");
     private static final java.util.regex.Pattern MASK_COLOR = java.util.regex.Pattern.compile("(&[0-9a-fk-orA-FK-OR]){1,4}");
 
 
@@ -210,6 +211,65 @@ public final class AthenaServerImpl implements AthenaServer {
         craft.athenaUpdateDisplayName();
     }
 
+    @Override
+    public String setDisguise(Player player, String name, String skinValue, String skinSignature) {
+        org.spigotmc.AsyncCatcher.catchOp("Athena set a disguise"); // Athena - server thread only; see the class comment
+        org.bukkit.craftbukkit.entity.CraftPlayer craft = (org.bukkit.craftbukkit.entity.CraftPlayer) player;
+        net.minecraft.server.EntityPlayer handle = craft.getHandle();
+        boolean joined = net.minecraft.server.MinecraftServer.getServer().getPlayerList().players.contains(handle);
+        if (name == null) {
+            if (handle.athenaDisguise != null) {
+                net.minecraft.server.MinecraftServer.LOGGER.info("[Disguise] {} ({}) is no longer disguised as {} (by a plugin)", player.getName(), player.getUniqueId(), handle.athenaDisguise.getName());
+                if (joined) {
+                    craft.athenaDisguise(null);
+                } else {
+                    handle.athenaDisguise = null;
+                    craft.athenaUpdateDisplayName();
+                }
+            }
+            return null;
+        }
+        Validate.isTrue(MINECRAFT_NAME.matcher(name).matches(), "Not a Minecraft name: " + name);
+        if (DisguiseCommand.taken(name, handle)) {
+            name = DisguiseCommand.randomName(handle);
+        }
+        com.mojang.authlib.GameProfile disguise = new com.mojang.authlib.GameProfile(player.getUniqueId(), name);
+        if (skinValue != null) {
+            disguise.getProperties().put("textures", new com.mojang.authlib.properties.Property("textures", skinValue, skinSignature));
+        }
+        if (joined) {
+            craft.athenaDisguise(disguise);
+        } else {
+            // logging in: not in anyone's tab list yet, so the first entries everyone gets are the disguise's
+            handle.athenaDisguise = disguise;
+            craft.athenaUpdateDisplayName();
+        }
+        net.minecraft.server.MinecraftServer.LOGGER.info("[Disguise] {} ({}) disguised as {} (kept from before)", player.getName(), player.getUniqueId(), name);
+        return name;
+    }
+
+    @Override
+    public String getDisguiseName(Player player) {
+        com.mojang.authlib.GameProfile disguise = ((org.bukkit.craftbukkit.entity.CraftPlayer) player).getHandle().athenaDisguise;
+        return disguise == null ? null : disguise.getName();
+    }
+
+    @Override
+    public boolean setMask(Player player, String mask) {
+        org.spigotmc.AsyncCatcher.catchOp("Athena set a mask"); // Athena - server thread only; see the class comment
+        org.bukkit.craftbukkit.entity.CraftPlayer craft = (org.bukkit.craftbukkit.entity.CraftPlayer) player;
+        net.minecraft.server.EntityPlayer handle = craft.getHandle();
+        if (mask != null && !handle.athenaMasks.containsKey(mask)) {
+            return false;
+        }
+        if (mask != null && !mask.equals(handle.athenaMask)) {
+            net.minecraft.server.MinecraftServer.LOGGER.info("[Mask] {} ({}) masked as {} (kept from before)", player.getName(), player.getUniqueId(), mask);
+        }
+        handle.athenaMask = mask;
+        craft.athenaUpdateDisplayName();
+        return true;
+    }
+
     @Override
     public String getMask(Player player) {
         return ((org.bukkit.craftbukkit.entity.CraftPlayer) player).getHandle().athenaMask;
