-            boolean rescan = entitytrackerentry != null && entitytrackerentry.willRescan();
-
-            entityplayer.trackerWillRescan = rescan;
-            anyRescan |= rescan;
-        }
+        ArrayList arraylist = null; // Athena - most ticks move no player; do not allocate for them
 
-        EntityPlayer[] scratch = this.viewerScratch(players.size());
-
-        for (int i = 0; i < this.entryCount; ++i) {
+        for (int i = 0; i < this.entryCount; ++i) { // Athena - indexed walk
             EntityTrackerEntry entitytrackerentry = this.entries[i];
 
-            entitytrackerentry.track(players);
-            // track() already offered this entry to every player, so the moved ones are done.
-            if (anyRescan && !entitytrackerentry.playerEntitiesUpdated) {
-                entitytrackerentry.updateMovedViewers(scratch);
-            }
-        }
-
-        if (!anyRescan) {
-            return;
-        }
-
-        for (int i = 0; i < players.size(); ++i) {
