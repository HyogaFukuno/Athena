diff --git a/src/test/java/net/minecraft/server/AthenaConfigSafetyTest.java b/src/test/java/net/minecraft/server/AthenaConfigSafetyTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..d9cc0b147840e2064d917f5c5e5a86ba40fe1df6
--- /dev/null
+++ b/src/test/java/net/minecraft/server/AthenaConfigSafetyTest.java
@@ -0,0 +1,62 @@
+package net.minecraft.server;
+
+import static org.junit.Assert.*;
+
+import athena.server.AthenaConfig;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import org.junit.After;
+import org.junit.Test;
+
+public class AthenaConfigSafetyTest {
+    @After
+    public void restoreDefaults() throws Exception {
+        AthenaConfig.init(Files.createTempDirectory("athena-defaults").resolve("athena.yml").toFile(), null);
+    }
+
+    @Test
+    public void invalidGlobalOrWorldSettingsLeaveTheOriginalSecretsIntact() throws Exception {
+        for (String invalid : new String[] {"networkCompressionLevel: broken\n",
+                "worlds:\n  arena:\n    chunkUnloadMargin: broken\n"}) {
+            Path dir = Files.createTempDirectory("athena-config-invalid");
+            Path source = dir.resolve("pandaspigot.yml"), destination = dir.resolve("athena.yml");
+            String old = "bungeeGuardTokens:\n  - audit-dummy-secret\n" + invalid;
+            Files.writeString(source, old);
+            try { AthenaConfig.init(destination.toFile(), source.toFile()); fail("invalid setting accepted"); }
+            catch (RuntimeException expected) {}
+            assertEquals(old, Files.readString(source));
+            assertFalse(Files.exists(destination));
+        }
+    }
+
+    @Test
+    public void destinationWriteFailureLeavesTheSourceUntouched() throws Exception {
+        Path dir = Files.createTempDirectory("athena-config-io");
+        Path source = dir.resolve("pandaspigot.yml"), parentFile = dir.resolve("not-a-directory");
+        String old = "bungeeGuardTokens:\n  - audit-dummy-secret\n";
+        Files.writeString(source, old);
+        Files.writeString(parentFile, "block destination writes");
+        try { AthenaConfig.init(parentFile.resolve("athena.yml").toFile(), source.toFile()); fail("write succeeded"); }
+        catch (RuntimeException expected) {}
+        assertEquals(old, Files.readString(source));
+        assertFalse(Files.exists(dir.resolve("pandaspigot.yml.bak")));
+    }
+
+    @Test
+    public void successfulMigrationBacksUpTheExactSourceBeforeRemoval() throws Exception {
+        Path dir = Files.createTempDirectory("athena-config-backup");
+        Path source = dir.resolve("pandaspigot.yml"), destination = dir.resolve("athena.yml");
+        String old = "# keep this comment\nbungeeGuardTokens:\n  - audit-dummy-secret\n";
+        Files.writeString(source, old);
+        AthenaConfig.init(destination.toFile(), source.toFile());
+        assertEquals(old, Files.readString(dir.resolve("pandaspigot.yml.bak")));
+        assertFalse(Files.readString(source).contains("audit-dummy-secret"));
+        assertTrue(Files.readString(destination).contains("audit-dummy-secret"));
+        String reappeared = "networkCompressionLevel: 2\n";
+        Files.writeString(source, reappeared);
+        AthenaConfig.init(destination.toFile(), source.toFile());
+        assertEquals(reappeared, Files.readString(dir.resolve("pandaspigot.yml.bak")));
+        assertFalse(Files.readString(source).contains("networkCompressionLevel"));
+        assertEquals(6, AthenaConfig.get().networkCompressionLevel);
+    }
+}
