+    // Athena - temporary output stays beside its destination so rename is atomic. Failure leaves
+    // the old file in place; a filesystem without atomic rename fails safely instead of truncating it.
+    private static void saveAtomically(File file, CommentedConfigurationNode root, String header) throws IOException {
+        Path destination = file.toPath().toAbsolutePath();
+        Path temporary = Files.createTempFile(destination.getParent(), file.getName() + ".", ".tmp");
+        try {
+            loader(temporary.toFile(), header).save(root);
+            Files.move(temporary, destination, StandardCopyOption.REPLACE_EXISTING, StandardCopyOption.ATOMIC_MOVE);
+        } finally {
+            Files.deleteIfExists(temporary);
         }
+    }
 
