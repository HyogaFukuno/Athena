+package net.minecraft.server;
+
+import org.junit.After;
+import org.junit.Before;
+import org.junit.Test;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Random;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertTrue;
+import static org.junit.Assert.fail;
+
+/**
+ * AthenaGuard's movement bounds against a model of the 1.8 client: EntityLivingBase.onLivingUpdate,
+ * moveEntityWithHeading, moveFlying and jump, and Entity.moveEntity with its two-way step-up, written
+ * out from the client's code, on a small world of boxes. A client moved this way is what every
+ * honest player is, so the guard must never flag it; a client moved any faster or higher must be.
+ */
+public class AthenaGuardMovementTest {
+
+    // the world: boxes, and where the ice is
+    private final List<double[]> boxes = new ArrayList<double[]>();
+
+    private boolean savedEnforce;
+
+    @Before
+    public void world() {
+        this.savedEnforce = AthenaGuard.enforce;
+        AthenaGuard.enforce = true;
+        AthenaGuard.movement = true;
+        AthenaGuard.enabled = true;
+        this.boxes.add(new double[] { -1000, -1, -1000, 1000, 0, 1000 });          // floor
+        for (int x = 5; x < 15; ++x) {                                             // a staggered edge of slabs
+            for (int z = -20 + (x - 5); z < 20; ++z) {
+                this.boxes.add(new double[] { x, 0, z, x + 1, 0.5, z + 1 });
+            }
+        }
+        this.boxes.add(new double[] { 20, 2.0, -1000, 30, 3.0, 1000 });            // a ceiling two blocks up
+        this.boxes.add(new double[] { 40, 0, -1000, 41, 1.0, 1000 });              // a wall one block high
+        this.boxes.add(new double[] { 50, 0, -1000, 52, 1.5, 1000 });              // a fence-high ledge
+        this.boxes.add(new double[] { 60, 0, -1000, 61, 3.0, 1000 });              // a wall to jump into
+        this.boxes.add(new double[] { 70, 0, -1000, 80, 4.0, 1000 });              // a platform to fall from
+    }
+
+    @After
+    public void restore() {
+        AthenaGuard.enforce = this.savedEnforce;
+    }
+
+    private boolean ice(double x) {
+        return x >= -40 && x < -10;
+    }
+
+    private double slipperiness(double x, double minY) {
+        return ice(x) ? 0.98D : 0.6D;
+    }
+
+    // ------------------------------------------------------------------ the client
+    private final class Client {
+        double minX, minY, minZ, maxX, maxY, maxZ;
+        double motX, motY, motZ;
+        boolean onGround = true;
+        int jumpTicks;
+        float yaw;
+        double lastX, lastY, lastZ;
+        int positionTicks;
+        int speedAmp = -1;
+
+        Client(double x, double y, double z) {
+            this.set(x, y, z);
+            this.lastX = x; this.lastY = y; this.lastZ = z;
+        }
+
+        void set(double x, double y, double z) {
+            this.minX = x - 0.3; this.minY = y; this.minZ = z - 0.3;
+            this.maxX = x + 0.3; this.maxY = y + 1.8; this.maxZ = z + 0.3;
+        }
+
+        double x() { return (this.minX + this.maxX) / 2; }
+        double y() { return this.minY; }
+        double z() { return (this.minZ + this.maxZ) / 2; }
+
+        /** One client tick; returns whether a position packet goes out this tick. */
+        boolean tick(float forward, float strafe, boolean jumping, boolean sprinting, double cheatSpeed) {
+            if (this.jumpTicks > 0) --this.jumpTicks;
+            if (Math.abs(this.motX) < 0.005D) this.motX = 0;
+            if (Math.abs(this.motY) < 0.005D) this.motY = 0;
+            if (Math.abs(this.motZ) < 0.005D) this.motZ = 0;
+            if (jumping) {
+                if (this.onGround && this.jumpTicks == 0) {
+                    this.motY = 0.41999998688697815D;
+                    if (sprinting) {
+                        float f = this.yaw * 0.017453292F;
+                        this.motX -= MathHelper.sin(f) * 0.2F;
+                        this.motZ += MathHelper.cos(f) * 0.2F;
+                    }
+                    this.jumpTicks = 10;
+                }
+            } else {
+                this.jumpTicks = 0;
+            }
+            strafe *= 0.98F;
+            forward *= 0.98F;
+
+            double speed = 0.10000000149011612D * (sprinting ? 1.3D : 1.0D) * (1.0D + 0.2D * (this.speedAmp + 1));
+            float f4 = 0.91F;
+            if (this.onGround) f4 = (float) slipperiness(this.x(), this.minY) * 0.91F;
+            float f = 0.16277136F / (f4 * f4 * f4);
+            float f5 = this.onGround ? (float) speed * f : (sprinting ? 0.026F : 0.02F);
+            this.moveFlying(strafe, forward, f5);
+            f4 = 0.91F;
+            if (this.onGround) f4 = (float) slipperiness(this.x(), this.minY) * 0.91F;
+
+            this.moveEntity(this.motX * cheatSpeed, this.motY, this.motZ * cheatSpeed);
+            this.motY -= 0.08D;
+            this.motY *= 0.9800000190734863D;
+            this.motX *= f4;
+            this.motZ *= f4;
+
+            double dx = this.x() - this.lastX, dy = this.y() - this.lastY, dz = this.z() - this.lastZ;
+            ++this.positionTicks;
+            if (dx * dx + dy * dy + dz * dz > 9.0E-4D || this.positionTicks >= 20) {
+                this.lastX = this.x(); this.lastY = this.y(); this.lastZ = this.z();
+                this.positionTicks = 0;
+                return true;
+            }
+            return false;
+        }
+
+        void moveFlying(float strafe, float forward, float friction) {
+            float f = strafe * strafe + forward * forward;
+            if (f >= 1.0E-4F) {
+                f = MathHelper.sqrt(f);
+                if (f < 1.0F) f = 1.0F;
+                f = friction / f;
+                strafe *= f;
+                forward *= f;
+                float f1 = MathHelper.sin(this.yaw * 3.1415927F / 180.0F);
+                float f2 = MathHelper.cos(this.yaw * 3.1415927F / 180.0F);
+                this.motX += strafe * f2 - forward * f1;
+                this.motZ += forward * f2 + strafe * f1;
+            }
+        }
+
+        List<double[]> colliding(double minX, double minY, double minZ, double maxX, double maxY, double maxZ) {
+            List<double[]> out = new ArrayList<double[]>();
+            for (double[] b : boxes) {
+                if (b[3] > minX && b[0] < maxX && b[4] > minY && b[1] < maxY && b[5] > minZ && b[2] < maxZ) out.add(b);
+            }
+            return out;
+        }
+
+        void moveEntity(double d0, double d1, double d2) {
+            double d6 = d0, d7 = d1, d8 = d2;
+            List<double[]> list = this.colliding(this.minX + Math.min(d0, 0), this.minY + Math.min(d1, 0), this.minZ + Math.min(d2, 0),
+                    this.maxX + Math.max(d0, 0), this.maxY + Math.max(d1, 0), this.maxZ + Math.max(d2, 0));
+            double[] pre = { this.minX, this.minY, this.minZ, this.maxX, this.maxY, this.maxZ };
+            for (double[] b : list) d1 = AxisAlignedBBHelper.calcYOffset(b[0], b[1], b[2], b[3], b[4], b[5], this.minX, this.minY, this.minZ, this.maxX, this.maxY, this.maxZ, d1);
+            this.minY += d1; this.maxY += d1;
+            boolean flag1 = this.onGround || d7 != d1 && d7 < 0.0D;
+            for (double[] b : list) d0 = AxisAlignedBBHelper.calcXOffset(b[0], b[1], b[2], b[3], b[4], b[5], this.minX, this.minY, this.minZ, this.maxX, this.maxY, this.maxZ, d0);
+            this.minX += d0; this.maxX += d0;
+            for (double[] b : list) d2 = AxisAlignedBBHelper.calcZOffset(b[0], b[1], b[2], b[3], b[4], b[5], this.minX, this.minY, this.minZ, this.maxX, this.maxY, this.maxZ, d2);
+            this.minZ += d2; this.maxZ += d2;
+
+            if (flag1 && (d6 != d0 || d8 != d2)) {
+                double d10 = d0, d11 = d1, d12 = d2;
+                double[] post = { this.minX, this.minY, this.minZ, this.maxX, this.maxY, this.maxZ };
+                double step = 0.6000000238418579D;
+                List<double[]> l2 = this.colliding(pre[0] + Math.min(d6, 0), pre[1], pre[2] + Math.min(d8, 0), pre[3] + Math.max(d6, 0), pre[4] + step, pre[5] + Math.max(d8, 0));
+                double[] a = pre.clone();
+                double sMinX = a[0] + Math.min(d6, 0), sMaxX = a[3] + Math.max(d6, 0), sMinZ = a[2] + Math.min(d8, 0), sMaxZ = a[5] + Math.max(d8, 0);
+                double d13 = step;
+                for (double[] b : l2) d13 = AxisAlignedBBHelper.calcYOffset(b[0], b[1], b[2], b[3], b[4], b[5], sMinX, a[1], sMinZ, sMaxX, a[4], sMaxZ, d13);
+                a[1] += d13; a[4] += d13;
+                double d14 = d6;
+                for (double[] b : l2) d14 = AxisAlignedBBHelper.calcXOffset(b[0], b[1], b[2], b[3], b[4], b[5], a[0], a[1], a[2], a[3], a[4], a[5], d14);
+                a[0] += d14; a[3] += d14;
+                double d15 = d8;
+                for (double[] b : l2) d15 = AxisAlignedBBHelper.calcZOffset(b[0], b[1], b[2], b[3], b[4], b[5], a[0], a[1], a[2], a[3], a[4], a[5], d15);
+                a[2] += d15; a[5] += d15;
+                double[] c = pre.clone();
+                double d16 = step;
+                for (double[] b : l2) d16 = AxisAlignedBBHelper.calcYOffset(b[0], b[1], b[2], b[3], b[4], b[5], c[0], c[1], c[2], c[3], c[4], c[5], d16);
+                c[1] += d16; c[4] += d16;
+                double d17 = d6;
+                for (double[] b : l2) d17 = AxisAlignedBBHelper.calcXOffset(b[0], b[1], b[2], b[3], b[4], b[5], c[0], c[1], c[2], c[3], c[4], c[5], d17);
+                c[0] += d17; c[3] += d17;
+                double d18 = d8;
+                for (double[] b : l2) d18 = AxisAlignedBBHelper.calcZOffset(b[0], b[1], b[2], b[3], b[4], b[5], c[0], c[1], c[2], c[3], c[4], c[5], d18);
+                c[2] += d18; c[5] += d18;
+                double[] chosen;
+                if (d14 * d14 + d15 * d15 > d17 * d17 + d18 * d18) { d0 = d14; d2 = d15; d1 = -d13; chosen = a; }
+                else { d0 = d17; d2 = d18; d1 = -d16; chosen = c; }
+                for (double[] b : l2) d1 = AxisAlignedBBHelper.calcYOffset(b[0], b[1], b[2], b[3], b[4], b[5], chosen[0], chosen[1], chosen[2], chosen[3], chosen[4], chosen[5], d1);
+                chosen[1] += d1; chosen[4] += d1;
+                if (d10 * d10 + d12 * d12 >= d0 * d0 + d2 * d2) { d0 = d10; d1 = d11; d2 = d12; chosen = post; }
+                this.minX = chosen[0]; this.minY = chosen[1]; this.minZ = chosen[2]; this.maxX = chosen[3]; this.maxY = chosen[4]; this.maxZ = chosen[5];
+            }
+
+            this.onGround = d7 != d1 && d7 < 0.0D;
+            if (d6 != d0) this.motX = 0;
+            if (d8 != d2) this.motZ = 0;
+            if (d7 != d1) this.motY = 0;
+        }
+    }
+
+    // ------------------------------------------------------------------ the server's view of the same world
+    private boolean groundAt(double x, double y, double z) {
+        double half = 0.3 - 1.0E-7;
+        return !new Client(0, 0, 0).colliding(x - half, y - 0.001, z - half, x + half, y, z + half).isEmpty();
+    }
+
+    private boolean ceilingAt(double x, double y, double z) {
+        double half = 0.3 - 1.0E-7;
+        return !new Client(0, 0, 0).colliding(x - half, y + 1.8, z - half, x + half, y + 1.801, z + half).isEmpty();
+    }
+
+    private final class Server {
+        final AthenaGuard guard = new AthenaGuard(null);
+        double x, y, z;
+        int skipped;
+        int flagged;
+        String firstFlag;
+
+        Server(double x, double y, double z, int speedAmp) {
+            this.x = x; this.y = y; this.z = z;
+            this.guard.athenaTestEffects(speedAmp, -1);
+            this.receive(x, y, z); // seeds
+        }
+
+        /** A packet with a position; returns the guard's verdict. */
+        int receive(double nx, double ny, double nz) {
+            int ticks = this.skipped + 1;
+            this.skipped = 0;
+            double dx = nx - this.x, dy = ny - this.y, dz = nz - this.z;
+            boolean groundA = groundAt(this.x, ny, this.z), groundB = groundAt(nx, ny, nz);
+            boolean groundNow = groundA || groundB;
+            Client probe = new Client(0, 0, 0);
+            boolean wall = !probe.colliding(Math.min(this.x, nx) - 0.301, Math.min(this.y, ny) + 0.001, Math.min(this.z, nz) - 0.301,
+                    Math.max(this.x, nx) + 0.301, Math.max(this.y, ny) + 2.4, Math.max(this.z, nz) + 0.301).isEmpty();
+            double fall = this.guard.fallDepth(ticks);
+            double half = 0.3 - 1.0E-7;
+            boolean landing = (ticks > 1 || !this.guard.groundStart()) && !probe.colliding(this.x - half, this.y - fall, this.z - half, this.x + half, this.y, this.z + half).isEmpty();
+            boolean maybeGround = groundNow || wall && landing && dy <= 0;
+            boolean certain = groundA == groundB && !wall;
+            double slip = slipperiness(nx, ny);
+            int r;
+            if (!this.guard.athenaKnown()) {
+                this.guard.athenaSeed(Math.sqrt(dx * dx + dz * dz) / ticks, dy / ticks, groundNow, maybeGround, certain, slip);
+                r = 0;
+            } else {
+                boolean ceiling = dy > 0 && this.guard.groundStart() && (ceilingAt(this.x, ny, this.z) || ceilingAt(nx, ny, nz));
+                r = this.guard.evaluate(ticks, Math.sqrt(dx * dx + dz * dz), dy, groundNow, maybeGround, certain, ticks > 1 && landing, slip, false, false, false, ceiling, 0.0);
+            }
+            if (r == 0) {
+                this.x = nx; this.y = ny; this.z = nz;
+            }
+            return r;
+        }
+
+        void noPosition() {
+            ++this.skipped;
+        }
+    }
+
+    // ------------------------------------------------------------------ honest clients
+    @Test
+    public void honestClientsAreNeverFlagged() {
+        Random random = new Random(Long.getLong("athena.guardSeed", 20261012L));
+        int packets = 0;
+
+        for (int run = 0, runs = Integer.getInteger("athena.guardRuns", 400); run < runs; ++run) {
+            double startX = new double[] { 0, 3, 17, -20, 35, 45, 55, 65, 75 }[run % 9];
+            double startY = startX >= 70 && startX < 80 ? 4.0 : 0.0;
+            int speedAmp = run % 3 - 1; // none, Speed I, Speed II
+            Client c = new Client(startX + random.nextDouble(), startY, random.nextDouble() * 10);
+            c.speedAmp = speedAmp;
+            Server s = new Server(c.x(), c.y(), c.z(), speedAmp);
+            c.yaw = random.nextFloat() * 360;
+            boolean sprint = random.nextBoolean();
+            boolean jumpHeld = false;
+            float forward = 1, strafe = 0;
+
+            java.util.ArrayDeque<String> history = new java.util.ArrayDeque<String>();
+            for (int t = 0; t < 400; ++t) {
+                if (random.nextInt(20) == 0) sprint = !sprint;
+                if (random.nextInt(8) == 0) jumpHeld = random.nextInt(3) > 0;
+                if (random.nextInt(15) == 0) strafe = random.nextInt(3) - 1;
+                if (random.nextInt(25) == 0) forward = random.nextInt(4) == 0 ? 0 : 1;
+                if (random.nextInt(4) == 0) c.yaw += (random.nextFloat() - 0.5F) * 60;
+                boolean sprinting = sprint && forward > 0.8F;
+
+                double by = c.y(), bx = c.x(), bz = c.z(); boolean bg = c.onGround;
+                boolean sentNow = c.tick(forward, strafe, jumpHeld, sprinting, 1.0);
+                history.add(String.format(java.util.Locale.ROOT, "t=%d x=%.4f y=%.5f z=%.4f dh=%.4f dy=%.5f groundBefore=%b groundAfter=%b sent=%b jump=%b sprint=%b serverGround=%b",
+                        t, c.x(), c.y(), c.z(), Math.hypot(c.x() - bx, c.z() - bz), c.y() - by, bg, c.onGround, sentNow, jumpHeld, sprinting, s.guard.groundStart()));
+                if (history.size() > 10) history.removeFirst();
+                if (sentNow) {
+                    ++packets;
+                    int r = s.receive(c.x(), c.y(), c.z());
+                    if (r != 0) {
+                        fail(String.join("\n", history) + "\nrun " + run + " tick " + t + ": an honest move was flagged (" + r + ") at "
+                                + c.x() + "," + c.y() + "," + c.z() + " speed " + speedAmp + " sprint " + sprinting + " jump " + jumpHeld);
+                    }
+                } else {
+                    s.noPosition();
+                }
+            }
+        }
+        assertTrue(packets > 100000);
+    }
+
+    // ------------------------------------------------------------------ cheats
+    private int flagsFor(double cheatSpeed, boolean fly, double startX, int ticks) {
+        Random random = new Random(7L);
+        Client c = new Client(startX, 0, 0);
+        Server s = new Server(c.x(), c.y(), c.z(), -1);
+        int flags = 0;
+
+        for (int t = 0; t < ticks; ++t) {
+            boolean sent = c.tick(1, 0, random.nextInt(3) == 0, true, cheatSpeed);
+            if (fly && t > 5) {
+                c.motY = 0.1; // keeps climbing
+            }
+            if (sent) {
+                if (s.receive(c.x(), c.y(), c.z()) != 0) {
+                    ++flags;
+                    // set back, as the server would
+                    c.set(s.x, s.y, s.z);
+                    c.lastX = s.x; c.lastY = s.y; c.lastZ = s.z;
+                }
+            } else {
+                s.noPosition();
+            }
+        }
+        return flags;
+    }
+
+    @Test
+    public void speedIsCaught() {
+        assertTrue(this.flagsFor(1.3, false, -100, 200) > 10);
+    }
+
+    @Test
+    public void flyIsCaught() {
+        assertTrue(this.flagsFor(1.0, true, -100, 200) > 10);
+    }
+
+    @Test
+    public void stepAndMiniHopsAreCaught() {
+        Server s = new Server(0.5, 0, 0.5, -1);
+        // a 1-block step onto nothing
+        assertEquals(2, s.receive(0.6, 1.0, 0.5));
+        Server t = new Server(0.5, 0, 0.5, -1);
+        // the hop a packet criticals cheat makes: up a little from the ground, not a jump
+        assertEquals(2, t.receive(0.5, 0.11, 0.5));
+        Server u = new Server(0.5, 0, 0.5, -1);
+        // a real jump is fine
+        assertEquals(0, u.receive(0.5, 0.41999998688697815, 0.5));
+    }
