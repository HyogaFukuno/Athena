+
+    @ConfigSerializable
+    public static class GuardConfig {
+        public boolean enabled = true;
+        public boolean enforce = true;
+        @Comment("Speed, fly, step, jump height, and the ground used for fall damage and critical hits")
+        public boolean movement = true;
+        @Comment("Movement packets sent faster than real time")
+        public boolean timer = true;
+        @Comment("Reach, hits off to the side, hits without an arm swing, more than one hit a tick")
+        public boolean combat = true;
+        @Comment("Vanilla is 3.0, measured from the eye to the nearest point of the target's box")
+        public double maxReach = 3.0D;
+        @Comment("Log what is blocked (or would be, when not enforcing), at most once per check per\n" +
+            "player every two seconds")
+        public boolean log = true;
+    }
+    // Athena end
 }
diff --git a/src/main/java/net/minecraft/server/AthenaGuard.java b/src/main/java/net/minecraft/server/AthenaGuard.java
new file mode 100644
index 0000000000000000000000000000000000000000..f781ddcbddbe88d48f0328ed3a56da6045c5cacc
--- /dev/null
+++ b/src/main/java/net/minecraft/server/AthenaGuard.java
@@ -0,0 +1,581 @@
+package net.minecraft.server;
+
+import org.apache.logging.log4j.LogManager;
+import org.apache.logging.log4j.Logger;
+
+// Athena - server-authoritative movement and combat checks.
+//
+// The client reports where it is and whom it hit; the server decides whether that could have
+// happened, and where it could not, the server's answer stands: the move is set back to the last
+// position the server accepted, the hit is dropped, and fall damage and critical hits follow the
+// ground the server sees under the player rather than the flag the client sends.
+//
+// Every bound below is an upper bound on what an unmodified 1.8 (or 1.7.10) client can do, taken
+// from the client's own physics: a legitimate client always lands inside it, so a legitimate
+// player never sees any of this. What the bounds leave out on purpose - lower bounds on speed,
+// falling faster than gravity - gives a cheat nothing.
+//
+// One instance per PlayerConnection; everything runs on the server thread.
+public final class AthenaGuard {
+
+    private static final Logger LOGGER = LogManager.getLogger("Athena/Guard");
+
+    // ------------------------------------------------------------------ configuration
+    // Refreshed by PandaSpigotConfig.init, like AthenaIndexAudit's switch.
+    static volatile boolean enabled = true;
+    /** false: detect and log only, change nothing (to look for false positives first). */
+    static volatile boolean enforce = true;
+    static volatile boolean movement = true;
+    static volatile boolean timer = true;
+    static volatile boolean combat = true;
+    static volatile double maxReach = 3.0D;
+    static volatile boolean log = true;
+
+    // ------------------------------------------------------------------ constants (1.8 client physics)
+    private static final double GRAVITY = 0.08D;
+    private static final double DRAG = 0.9800000190734863D;       // 0.98F
+    private static final double JUMP = 0.41999998688697815D;      // 0.42F
+    private static final double STEP = 0.6000000238418579D;       // 0.6F; 1.7 steps 0.5, which is less
+    private static final double AIR_ACCEL = 0.026D;               // jumpMovementFactor while sprinting
+    private static final double SPRINT_JUMP = 0.2D;
+    private static final double BASE_SPEED = 0.10000000149011612D;
+    private static final double EPS_H = 0.005D;
+    private static final double EPS_V = 0.01D;
+
+    private final EntityPlayer player;
+
+    // movement state, as of the last accepted move
+    private boolean known;          // false after a teleport, a vehicle, flight: the next move only seeds the state
+    private boolean groundStart;    // on the ground at the start of the tick the next move begins with
+    private boolean groundCertain;  // and the client agrees: see moveOk
+    private boolean groundSeen;     // what is under the feet, and nothing else: fall damage and critical hits
+    private double motionFriction;  // what the last tick's motion was multiplied by: friction at its start
+    private double accelFriction;   // slipperiness x 0.91 under the feet at the start of the next tick
+    private double lastH;           // horizontal distance of the last client tick
+    private double lastDy;          // vertical distance of the last client tick
+    private int ticksSincePos;      // client ticks since the last packet with a position
+    private int freshTicks;         // ticks since the state was seeded, while still unsure of the client's onGround
+    private double grantH, grantV;  // knockback the server sent, and until when it may show up
+    private long grantUntil;
+    private int speedAmp = -1, jumpAmp = -1;
+    private long effectsGraceUntil; // keep a potion's allowance a little after it ends: the client lags
+
+    // timer
+    private long lastFlyingNanos;
+    private double balanceMillis;
+
+    // combat
+    private int swings;
+    private int lastAttackTick = Integer.MIN_VALUE;
+
+    // logging, at most one line per check per player every few seconds
+    private final long[] lastLog = new long[8];
+
+    AthenaGuard(EntityPlayer player) {
+        this.player = player;
+    }
+
+    public static void configure(boolean enabled, boolean enforce, boolean movement, boolean timer, boolean combat, double maxReach, boolean log) {
+        AthenaGuard.log = log;
+        AthenaGuard.enabled = enabled;
+        AthenaGuard.enforce = enforce;
+        AthenaGuard.movement = movement;
+        AthenaGuard.timer = timer;
+        AthenaGuard.combat = combat;
+        AthenaGuard.maxReach = maxReach;
+    }
+
+    /** Whether the server's own reading of the ground replaces the client's onGround flag. */
+    static boolean authoritative() {
+        return enabled && enforce && movement;
+    }
+
+    boolean groundStart() {
+        return this.groundStart;
+    }
+
+    /**
+     * The ground for this move, as of the last moveOk: the server's when enforcing and the player is
+     * checked, the client's flag otherwise. A client that claims ground the server does not see is
+     * how NoFall and packet criticals work; when only logging, that is reported here.
+     */
+    boolean groundFor(boolean clientGround) {
+        if (!enabled || !movement || this.exempt() || !this.known) {
+            return clientGround;
+        }
+        if (clientGround && !this.groundSeen && this.player.fallDistance > 3.0F) {
+            this.flag(6, "nofall", "claims ground %.1f blocks into a fall", this.player.fallDistance);
+        }
+        return enforce ? this.groundSeen : clientGround;
+    }
+
+    /** Positions are not the client's to decide from here on: a teleport, a respawn, a dismount. */
+    void reset() {
+        this.known = false;
+        this.ticksSincePos = 0;
+    }
+
+    private boolean exempt() {
+        return !enabled || this.player.abilities.canFly || this.player.abilities.isFlying || this.player.isSpectator()
+                || this.player.playerInteractManager.isCreative() || this.player.noclip || this.player.vehicle != null
+                || this.player.dead || this.player.isSleeping();
+    }
+
+    // ------------------------------------------------------------------ knockback the server sent
+    void onVelocitySent(double x, double y, double z) {
+        double h = Math.sqrt(x * x + z * z);
+
+        this.grantH = Math.max(this.grantH, h);
+        this.grantV = Math.max(this.grantV, y);
+        this.grantUntil = MinecraftServer.currentTick + 10 + this.player.ping / 50;
+    }
+
+    // ------------------------------------------------------------------ timer
+    /** Called on the Netty thread as a movement packet arrives; the clock is the arrival time. */
+    static void stamp(PacketPlayInFlying packet) {
+        packet.athenaReceivedNanos = System.nanoTime();
+    }
+
+    /**
+     * Each movement packet is one client tick, 50 ms. A client that sends them faster than time
+     * passes is running its clock fast. A late burst after a stall is paid for by the time the stall
+     * banked; the bank is capped, and a slow leak forgives clock drift.
+     */
+    boolean timerOk(PacketPlayInFlying packet) {
+        long now = packet.athenaReceivedNanos != 0L ? packet.athenaReceivedNanos : System.nanoTime();
+
+        if (this.lastFlyingNanos == 0L) {
+            this.lastFlyingNanos = now;
+            return true;
+        }
+
+        double elapsed = (now - this.lastFlyingNanos) / 1.0E6D;
+
+        this.lastFlyingNanos = now;
+        this.balanceMillis += elapsed - 50.0D + elapsed * 0.003D; // 0.3% drift allowance
+        if (this.balanceMillis > 1000.0D) {
+            this.balanceMillis = 1000.0D;
+        }
+
+        if (!timer || this.exempt()) {
+            this.balanceMillis = Math.max(this.balanceMillis, 0.0D);
+            return true;
+        }
+
+        if (this.balanceMillis < -250.0D) {
+            this.balanceMillis += 50.0D; // this packet is not counted
+            this.flag(0, "timer", "%.0f ms ahead of real time", -this.balanceMillis);
+            return !enforce;
+        }
+
+        return true;
+    }
+
+    // ------------------------------------------------------------------ movement
+    /**
+     * Checks one movement packet against what the client could have done since the last accepted
+     * one. (fromX, fromY, fromZ) is the last accepted position, (x, y, z) the reported one.
+     * Returns false when the move must be set back.
+     */
+    boolean moveOk(World world, boolean hasPos, double fromX, double fromY, double fromZ, double x, double y, double z) {
+        if (!hasPos) {
+            ++this.ticksSincePos;
+            return true;
+        }
+
+        int ticks = this.ticksSincePos + 1;
+        this.ticksSincePos = 0;
+
+        double dx = x - fromX;
+        double dy = y - fromY;
+        double dz = z - fromZ;
+        double h = Math.sqrt(dx * dx + dz * dz);
+        // The client's onGround is whether its vertical move collided going down. It moves vertically
+        // first, over where it started, then sideways - so it lands on (or is still standing on) what is
+        // under the start, even when the end is over air: stepping off an edge is a tick on the ground,
+        // brushing a corner while falling is a landing. A step-up decides it at the end instead.
+        boolean groundStartXZ = groundAt(world, this.player, fromX, y, fromZ);
+        boolean groundEndXZ = groundAt(world, this.player, x, y, z);
+        boolean groundNow = groundStartXZ || groundEndXZ;
+        // Against something beside or over the player the step-up can leave the client on the ground
+        // where it is not: a jump turned back into a sideways move ends in the air at ground height, and
+        // a landing turned into a step can end floating, still on the ground (and free to jump). Both
+        // need a wall, and the second a real landing under the start within the fall of these ticks.
+        boolean wall = this.nearWall(world, fromX, fromY, fromZ, x, y, z);
+        double fall = this.fallDepth(ticks);
+        boolean landing = ticks > 1 || !this.groundStart ? this.groundBelow(world, fromX, fromY, fromZ, fall) : false;
+        boolean maybeGround = groundNow || wall && landing && dy <= 0.0D; // floating ground ends a fall, never a rise
+        boolean certain = groundStartXZ == groundEndXZ && !wall;
+        double slipNow = slipperiness(world, x, y, z);
+
+        if (!movement || this.exempt() || !this.known) {
+            this.seedFresh(h / ticks, dy / ticks, groundNow, maybeGround, certain, slipNow);
+            return true;
+        }
+
+        this.refreshEffects();
+        boolean granted = MinecraftServer.currentTick <= this.grantUntil;
+        boolean inLiquid = this.player.isInWater() || this.player.isInLava() || liquidAt(world, x, y, z);
+        boolean climbing = this.player.isOnLadder();
+        // a jump cut short by a ceiling: the client moves up before it moves sideways, so the ceiling
+        // that stopped it is over where it started (or, after sideways, over where it ended)
+        boolean ceiling = dy > 0.0D && this.groundStart && (ceilingAt(world, fromX, y, fromZ) || ceilingAt(world, x, y, z));
+        double slimeUp = dy > 0.0D ? this.slimeBounce(world, fromX, fromY, fromZ) : 0.0D;
+
+        if (this.evaluate(ticks, h, dy, groundNow, maybeGround, certain, ticks > 1 && landing, slipNow, granted, inLiquid, climbing, ceiling, slimeUp) != 0 && enforce) {
+            this.known = false;
+            return false;
+        }
+        return true;
+    }
+
+    /**
+     * The bounds themselves, given what the world looks like around the move; no world access here,
+     * so the arithmetic can be tested against a model of the client. Returns 0 when the move is one a
+     * client could make, 1 for too fast, 2 for rising where it could not, and updates the state for
+     * the next move unless it fails while enforcing.
+     */
+    int evaluate(int ticks, double h, double dy, boolean groundNow, boolean maybeGround, boolean certain, boolean landed,
+                 double slipNow, boolean granted, boolean inLiquid, boolean climbing, boolean ceiling, double slimeUp) {
+        // landed: the packet covers ticks the client did not report, and it could have come down on
+        // something in them - and jumped again from it on the last
+        boolean fromGround = this.groundStart || landed;
+        double speedMul = 1.0D + 0.2D * (this.speedAmp + 1);
+        double jump = JUMP + 0.1D * (this.jumpAmp + 1);
+        int result = 0;
+
+        // horizontal, per client tick: |d(t+1)| <= |d(t)| x f(t) + a(t+1), where f(t) is the friction at
+        // the start of tick t (vanilla multiplies the motion by it after the move) and a(t+1) the
+        // acceleration at the start of the next: on the ground the sprinting walk speed scaled by
+        // 0.16277136 / f^3, in the air 0.026. The jump that starts a tick adds 0.2 more.
+        // a jump from where the client was last reported: it is the packet's last tick (a client that
+        // jumps sends a position, but the ticks before it may not have been sent)
+        // sprints - including one the step-up turned back into a sideways move, which keeps the push but
+        // not the height, against something beside or over the player (certain is false then)
+        boolean jumped = fromGround && (dy > 0.0D || !certain);
+        double v = this.lastH;
+        double maxH = 0.0D;
+        // The client's onGround is "collided while moving down this tick", not "touching the ground":
+        // with its vertical motion exactly 0 - a new entity after a respawn, a client set back - it is
+        // in the air for a tick while standing on the floor, and keeps the air's friction. In steady
+        // play gravity makes the motion -0.0784 every tick on the ground and the two agree; just after
+        // seeding, assume the air's.
+        double fMotion = this.freshTicks < 3 ? Math.max(this.motionFriction, 0.91D) : this.motionFriction;
+        boolean ground = this.groundStart;
+        double fAccel = this.accelFriction;
+
+        for (int i = 0; i < ticks; ++i) {
+            double a = ground ? Math.max(BASE_SPEED * 1.3D * speedMul * 0.16277136D / (fAccel * fAccel * fAccel), AIR_ACCEL) : AIR_ACCEL;
+
+            v = v * fMotion + a + (i == ticks - 1 && jumped ? SPRINT_JUMP : 0.0D);
+            maxH += v;
+            // the ticks the client did not report moved under 0.03 blocks each, on ground or in air:
+            // take the larger of each
+            fMotion = Math.max(ground ? fAccel : 0.91D, 0.91D);
+            ground = true;
+            fAccel = 0.546D;
+        }
+
+        if (granted) {
+            // knockback replaces the motion (an explosion adds to it); the push itself, the walk on
+            // top of it, and what was already there
+            maxH = Math.max(maxH, (this.lastH + this.grantH + BASE_SPEED * 1.3D * speedMul + SPRINT_JUMP) * ticks);
+        }
+        if (inLiquid) {
+            maxH = Math.max(maxH, 0.35D * ticks); // swimming is slower than this; the edge boost is not
+        }
+
+        if (h > maxH + EPS_H) {
+            this.flag(1, "speed", "moved %.3f, at most %.3f (ticks %d, last %.3f, friction %.3f/%.3f, ground %b)", h, maxH, ticks, this.lastH, this.motionFriction, this.accelFriction, this.groundStart);
+            result = 1;
+        }
+
+        // vertical: up from the ground is a jump, a step or a ceiling; in the air it is gravity
+        if (result == 0 && dy > 0.0D && !inLiquid && !climbing && !granted) {
+            double maxUp;
+
+            if (fromGround) {
+                // the ticks not reported before it moved under 0.03 blocks, or came down; all of the
+                // rise is the last tick's
+                if (Math.abs(dy - jump) < 1.0E-4D || dy <= jump && (ceiling || landed)) {
+                    maxUp = dy; // a jump: whole, cut short by a ceiling, or after a landing that took some back
+                } else if (dy <= STEP + 1.0E-4D && groundNow) {
+                    maxUp = dy; // stepped up onto something
+                } else {
+                    maxUp = slimeUp;
+                }
+            } else {
+                double vy = Math.abs(this.lastDy) < 0.005D ? 0.0D : this.lastDy;
+
+                maxUp = 0.0D;
+                for (int i = 0; i < ticks; ++i) {
+                    vy = (vy - GRAVITY) * DRAG;
+                    maxUp += vy;
+                }
+                if (groundNow) {
+                    maxUp = Math.max(maxUp, STEP); // stepped up while landing
+                }
+                maxUp = Math.max(maxUp, slimeUp);
+            }
+
+            if (dy > maxUp + EPS_V) {
+                this.flag(2, "fly", "rose %.3f, at most %.3f (ground %b, last %.3f, ticks %d)", dy, maxUp, this.groundStart, this.lastDy, ticks);
+                result = 2;
+            }
+        }
+
+        if (result != 0 && enforce) {
+            return result;
+        }
+
+        // the vertical speed of the last tick, for the next packet's gravity bound: exact for a one-tick
+        // packet, an upper bound otherwise
+        double lastVy;
+        if (landed && dy > 0.0D) {
+            lastVy = Math.max(dy, jump); // came down, then jumped: the jump's speed, not the net
+        } else if (ticks == 1 || fromGround && dy > 0.0D) {
+            lastVy = dy; // one tick, or a rise from the ground that is all the last tick's
+        } else if (groundNow) {
+            lastVy = 0.0D;
+        } else {
+            double vy = Math.abs(this.lastDy) < 0.005D ? 0.0D : this.lastDy;
+
+            for (int i = 0; i < ticks; ++i) {
+                vy = (vy - GRAVITY) * DRAG;
+            }
+            lastVy = Math.max(vy, dy / ticks);
+        }
+
+        if (granted) {
+            this.grantH *= 0.91D;
+            this.grantV = Math.max(this.grantV - GRAVITY, 0.0D);
+        } else {
+            this.grantH = this.grantV = 0.0D;
+        }
+
+        // several ticks: the net distance can be less than the last tick's when the direction turned, so
+        // keep the bound
+        this.seed(ticks == 1 ? h : v, lastVy, groundNow, maybeGround, certain, slipNow);
+        return result;
+    }
+
+    private void seedFresh(double h, double dy, boolean groundNow, boolean maybeGround, boolean certain, double slipNow) {
+        this.freshTicks = 0;
+        this.seed(h, dy, groundNow, maybeGround, certain, slipNow);
+    }
+
+    private void seed(double h, double dy, boolean groundNow, boolean maybeGround, boolean certain, double slipNow) {
+        if (this.known && this.freshTicks < 3) {
+            ++this.freshTicks;
+        }
+        this.known = true;
+        this.lastH = h;
+        this.lastDy = dy;
+        // the last tick's motion was multiplied by the friction at its start (the air's, the larger,
+        // when the client may have been in the air), the next tick accelerates by the ground at its own
+        // start (the ground's, the larger, when it may have been on the ground)
+        this.motionFriction = this.groundStart && this.groundCertain && this.accelFriction > 0.0D ? this.accelFriction : 0.91D;
+        this.accelFriction = maybeGround ? slipNow * 0.91D : 0.91D;
+        this.groundStart = maybeGround;
+        this.groundCertain = certain;
+        this.groundSeen = groundNow;
+    }
+
+    /** How far the client could have fallen in these ticks, from its last vertical speed. */
+    double fallDepth(int ticks) {
+        double vy = Math.abs(this.lastDy) < 0.005D ? 0.0D : this.lastDy;
+        double depth = 0.0D;
+
+        for (int i = 0; i < ticks; ++i) {
+            vy = (vy - GRAVITY) * DRAG;
+            depth -= vy;
+        }
+        return Math.max(depth, 0.0D) + 0.001D;
+    }
+
+    // for AthenaGuardMovementTest, which drives evaluate() from a model of the client
+    boolean athenaKnown() { return this.known; }
+    void athenaSeed(double h, double dy, boolean groundNow, boolean maybeGround, boolean certain, double slipNow) { this.seedFresh(h, dy, groundNow, maybeGround, certain, slipNow); }
+    void athenaTestEffects(int speedAmp, int jumpAmp) { this.speedAmp = speedAmp; this.jumpAmp = jumpAmp; }
+
+    private void refreshEffects() {
+        MobEffect speed = this.player.getEffect(MobEffectList.FASTER_MOVEMENT);
+        MobEffect jumpBoost = this.player.getEffect(MobEffectList.JUMP);
+        long tick = MinecraftServer.currentTick;
+        int s = speed != null ? speed.getAmplifier() : -1;
+        int j = jumpBoost != null ? jumpBoost.getAmplifier() : -1;
+
+        if (s >= this.speedAmp && j >= this.jumpAmp) {
+            this.speedAmp = s;
+            this.jumpAmp = j;
+            this.effectsGraceUntil = tick + 20 + this.player.ping / 50;
+        } else if (tick > this.effectsGraceUntil) {
+            this.speedAmp = s;
+            this.jumpAmp = j;
+        }
+    }
+
+    // ------------------------------------------------------------------ the world, as the server sees it
+    /** Whether something under these feet holds the player up. */
+    // The client's box is clipped exactly to the faces it touches, but rebuilt here from its centre
+    // (x +- 0.3) it can overlap a wall it only touches by a rounding error - enough to count the wall
+    // as ground under a player sliding down it. The probes are narrowed by far more than that error.
+    private static final double HALF = 0.3D - 1.0E-7D;
+
+    static boolean groundAt(World world, Entity player, double x, double y, double z) {
+        return world.hasCubes(player, x - HALF, y - 0.001D, z - HALF, x + HALF, y, z + HALF);
+    }
+
+    /** Whether something under the feet at (x, y, z) is within depth below them. */
+    private boolean groundBelow(World world, double x, double y, double z, double depth) {
+        return world.hasCubes(this.player, x - HALF, y - depth, z - HALF, x + HALF, y, z + HALF);
+    }
+
+    /**
+     * Anything the move could have run into sideways - beside the boxes it swept from start to end,
+     * above the lower feet - or over the head within a jump: what a step-up needs to start.
+     */
+    private boolean nearWall(World world, double fromX, double fromY, double fromZ, double x, double y, double z) {
+        return world.hasCubes(this.player, Math.min(fromX, x) - 0.301D, Math.min(fromY, y) + 0.001D, Math.min(fromZ, z) - 0.301D,
+                Math.max(fromX, x) + 0.301D, Math.max(fromY, y) + 2.4D, Math.max(fromZ, z) + 0.301D);
+    }
+
+    private boolean ceilingAt(World world, double x, double y, double z) {
+        return world.hasCubes(this.player, x - HALF, y + 1.8D, z - HALF, x + HALF, y + 1.801D, z + HALF);
+    }
+
+    private static boolean liquidAt(World world, double x, double y, double z) {
+        return world.containsLiquid(x - 0.3D, y - 0.4D, z - 0.3D, x + 0.3D, y + 1.8D, z + 0.3D);
+    }
+
+    private static double slipperiness(World world, double x, double y, double z) {
+        Block block = world.getType(new BlockPosition(MathHelper.floor(x), MathHelper.floor(y) - 1, MathHelper.floor(z))).getBlock();
+
+        return block.frictionFactor;
+    }
+
+    /** A slime block under the feet sends a falling player back up as fast as it came down. */
+    private double slimeBounce(World world, double x, double y, double z) {
+        Block block = world.getType(new BlockPosition(MathHelper.floor(x), MathHelper.floor(y - 0.2D), MathHelper.floor(z))).getBlock();
+
+        return block == Blocks.SLIME ? Math.max(-this.lastDy, 0.0D) + GRAVITY : 0.0D;
+    }
+
+    // ------------------------------------------------------------------ combat
+    void onSwing() {
+        if (this.swings < 8) {
+            ++this.swings;
+        }
+    }
+
+    /**
+     * Whether this attack is one the client could have made. An attack drops when it comes without
+     * the arm swing a client always sends first, when it is the second this tick (a second hit inside
+     * the target's invulnerability does nothing in vanilla anyway), when the target was out of reach
+     * wherever it stood in the time the attacker could have seen it, or when it was well off to the
+     * side of where the attacker was looking.
+     */
+    boolean attackOk(Entity target) {
+        if (!enabled || !combat || this.player.playerInteractManager.isCreative() || this.player.isSpectator()) {
+            return true;
+        }
+
+        int tick = MinecraftServer.currentTick;
+
+        if (this.swings <= 0) {
+            this.flag(3, "noswing", "attacked %s without swinging", target.getName());
+            if (enforce) {
+                return false;
+            }
+        } else {
+            --this.swings;
+        }
+
+        if (this.lastAttackTick == tick) {
+            return !enforce; // no log: harmless and common with fast clicking
+        }
+        this.lastAttackTick = tick;
+
+        double eyeX = this.player.locX;
+        double eyeY = this.player.locY + (double) this.player.getHeadHeight();
+        double eyeZ = this.player.locZ;
+        // the attack was made a tick before the move that follows it, so the eye may be off by that move
+        double slack = Math.min(this.lastH, 1.0D) + 0.03D;
+        double reach = maxReach + 0.1D + slack;
+        int lookback = Math.min(20, 4 + (this.player.ping + 49) / 50);
+        double best = Double.MAX_VALUE;
+        double bestMinX = 0, bestMinY = 0, bestMinZ = 0, bestMaxX = 0, bestMaxY = 0, bestMaxZ = 0;
+
+        for (int back = 0; back <= lookback; ++back) {
+            double[] box = target instanceof EntityPlayer ? ((EntityPlayer) target).athenaBoxAt(tick - back) : null;
+
+            if (box == null) {
+                if (back > 0) {
+                    break;
+                }
+                box = new double[] { target.boundingBoxMinX, target.boundingBoxMinY, target.boundingBoxMinZ, target.boundingBoxMaxX, target.boundingBoxMaxY, target.boundingBoxMaxZ };
+            }
+
+            double d = distanceToBox(eyeX, eyeY, eyeZ, box[0] - 0.1D, box[1] - 0.1D, box[2] - 0.1D, box[3] + 0.1D, box[4] + 0.1D, box[5] + 0.1D);
+
+            if (d < best) {
+                best = d;
+                bestMinX = box[0]; bestMinY = box[1]; bestMinZ = box[2]; bestMaxX = box[3]; bestMaxY = box[4]; bestMaxZ = box[5];
+            }
+        }
+
+        if (best > reach) {
+            this.flag(4, "reach", "hit %s at %.2f, at most %.2f (ping %d)", target.getName(), best, reach, this.player.ping);
+            if (enforce) {
+                return false;
+            }
+        }
+
+        // direction: the angle from the line of sight to the nearest target position, less the angle
+        // the box itself covers, must not be large. Generous: it only has to catch a hit on something
+        // beside or behind the attacker.
+        double cx = (bestMinX + bestMaxX) / 2.0D - eyeX;
+        double cy = (bestMinY + bestMaxY) / 2.0D - eyeY;
+        double cz = (bestMinZ + bestMaxZ) / 2.0D - eyeZ;
+        double len = Math.sqrt(cx * cx + cy * cy + cz * cz);
+
+        if (len > 0.5D) {
+            float yaw = this.player.yaw * 0.017453292F;
+            float pitch = this.player.pitch * 0.017453292F;
+            double lx = -Math.sin(yaw) * Math.cos(pitch);
+            double ly = -Math.sin(pitch);
+            double lz = Math.cos(yaw) * Math.cos(pitch);
+            double cos = (lx * cx + ly * cy + lz * cz) / len;
+            double angle = Math.toDegrees(Math.acos(Math.max(-1.0D, Math.min(1.0D, cos))));
+            double halfDiag = Math.sqrt((bestMaxX - bestMinX) * (bestMaxX - bestMinX) + (bestMaxY - bestMinY) * (bestMaxY - bestMinY) + (bestMaxZ - bestMinZ) * (bestMaxZ - bestMinZ)) / 2.0D + 0.1D;
+            double cover = Math.toDegrees(Math.atan(halfDiag / len));
+
+            if (angle - cover > 60.0D) {
+                this.flag(5, "aim", "hit %s %.0f degrees off the line of sight", target.getName(), angle - cover);
+                if (enforce) {
+                    return false;
+                }
+            }
+        }
+
+        return true;
+    }
+
+    private static double distanceToBox(double x, double y, double z, double minX, double minY, double minZ, double maxX, double maxY, double maxZ) {
+        double dx = x < minX ? minX - x : (x > maxX ? x - maxX : 0.0D);
+        double dy = y < minY ? minY - y : (y > maxY ? y - maxY : 0.0D);
+        double dz = z < minZ ? minZ - z : (z > maxZ ? z - maxZ : 0.0D);
+
+        return Math.sqrt(dx * dx + dy * dy + dz * dz);
+    }
+
+    // ------------------------------------------------------------------ reporting
+    private void flag(int check, String name, String format, Object... args) {
+        long now = System.currentTimeMillis();
+
+        if (log && now - this.lastLog[check] >= 2000L) {
+            this.lastLog[check] = now;
+            LOGGER.info("{} {} [{}]: {}", this.player != null ? this.player.getName() : "-", name, enforce ? "blocked" : "detected", String.format(java.util.Locale.ROOT, format, args));
+        }
+    }
+}
