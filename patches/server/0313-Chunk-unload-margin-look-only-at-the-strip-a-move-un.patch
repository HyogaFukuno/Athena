         if (wrong != 0) {
             report(wrong + " slots of PlayerChunkMap.instanceChunks disagree with the instance they mirror");
         }
+
+        // and the view squares the chunk unload margin relies on
+        int[] squares = map.auditViewSquares();
+
+        if (squares[0] != 0 || squares[1] != 0 || squares[2] != 0) {
+            report("player view squares: " + squares[0] + " chunks in view not watched, " + squares[1]
+                    + " watched past the margin, " + squares[2] + " instances with no player");
+        }
     }
 
