+    /**
+     * For the index audit only: the view squares as the margin invariant has them. Every chunk within
+     * a player's view distance of its managed position is watched by the player, none past view
+     * distance + chunkUnloadMargin is, and no instance is left without a player. Returns
+     * {missing, beyond, empty}.
+     */
+    int[] auditViewSquares() {
+        int missing = 0;
+        int beyond = 0;
+        int empty = 0;
+
+        for (EntityPlayer player : this.managedPlayers) {
+            int cx = (int) player.managedPosX >> 4;
+            int cz = (int) player.managedPosZ >> 4;
+            int r = player.viewDistance;
+
+            for (int x = cx - r; x <= cx + r; ++x) {
+                for (int z = cz - r; z <= cz + r; ++z) {
+                    PlayerChunkMap.PlayerChunk playerchunk = this.getPlayerInstance(x, z, false);
+
+                    if (playerchunk == null || !playerchunk.playersWatchingChunk.contains(player)) {
+                        ++missing;
+                    }
+                }
+            }
+        }
+
+        for (PlayerChunkMap.PlayerChunk playerchunk : this.playerInstanceList) {
+            if (playerchunk.removedFromInstanceList) {
+                continue;
+            }
+            if (playerchunk.playersWatchingChunk.isEmpty()) {
+                ++empty;
+            }
+            for (EntityPlayer player : playerchunk.playersWatchingChunk) {
+                int m = player.viewDistance + this.athenaUnloadMargin;
+
+                if (!this.overlaps(playerchunk.location.x, playerchunk.location.z, (int) player.managedPosX >> 4, (int) player.managedPosZ >> 4, m)) {
+                    ++beyond;
+                }
+            }
+        }
+
+        return new int[] {missing, beyond, empty};
+    }
     // Athena end
