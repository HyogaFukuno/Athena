+    // Athena start - the queued coordinate at x, z, or null. The spiral used to make a PlayerChunk at
+    // every position it passed just to read its location: harmless at the view distance, where the
+    // player watches every chunk anyway, but past it (chunkUnloadMargin) it left an empty instance
+    // in every chunk of the margin, for good. A queued chunk always has an instance.
+    private ChunkCoordIntPair athenaQueuedAt(int x, int z, java.util.Set<ChunkCoordIntPair> queued) {
+        PlayerChunkMap.PlayerChunk playerchunk = this.getPlayerInstance(x, z, false);
+
+        return playerchunk != null && queued.contains(playerchunk.location) ? playerchunk.location : null;
+    }
