From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: glacier <hyouga.dev@gmail.com>
Date: Sun, 15 Nov 2026 06:57:29 +0900
Subject: [PATCH] Query results, the batch list and the connections' copy are
 reused per thread

Pushing, a player's pick-up range and a hopper's inventory look fill a list kept per thread
(AthenaScratchLists, one per depth) instead of a new ArrayList each: 148 MB, 3.7% of what a
match allocated. The packet batch keeps its list from batch to batch, and a world thread's
connection tick copies the players into an array it keeps.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/src/main/java/net/minecraft/server/AthenaScratchLists.java b/src/main/java/net/minecraft/server/AthenaScratchLists.java
new file mode 100644
index 0000000000000000000000000000000000000000..6778c91b7fe770c8fbc60ed1ce0ee623f3fe56e4
--- /dev/null
+++ b/src/main/java/net/minecraft/server/AthenaScratchLists.java
@@ -0,0 +1,70 @@
+package net.minecraft.server;
+
+import java.util.ArrayList;
+
+/**
+ * Athena - lists an entity query fills and its caller reads, then lets go, reused per thread.
+ *
+ * The push of every living entity (EntityLiving.collideWithNearbyEntities), a player's pick-up range
+ * (EntityHuman) and a hopper's look for an inventory entity each made a new ArrayList a tick and grew
+ * it: 148 MB, 3.7% of what a match allocated (VPS-B, 8 rooms). The result never leaves the caller,
+ * so the caller takes a list here, fills it, walks it and gives it back. What the walk calls - a
+ * pick-up event, a collision - may run another query on the same thread before the list is given
+ * back: each depth has a list of its own. A list that grew past {@value #KEEP} entries is let go
+ * rather than kept at that size.
+ */
+final class AthenaScratchLists {
+
+    static final int KEEP = 256;
+
+    private static final ThreadLocal<AthenaScratchLists> LOCAL = new ThreadLocal<AthenaScratchLists>() {
+        @Override
+        protected AthenaScratchLists initialValue() {
+            return new AthenaScratchLists();
+        }
+    };
+
+    private ArrayList<Entity>[] lists = newLists(4);
+    private int depth;
+
+    @SuppressWarnings("unchecked")
+    private static ArrayList<Entity>[] newLists(int n) {
+        return (ArrayList<Entity>[]) new ArrayList[n];
+    }
+
+    /** An empty list for this thread; give it back with {@link #release} when done with it. */
+    static ArrayList<Entity> take() {
+        AthenaScratchLists local = LOCAL.get();
+        int depth = local.depth++;
+
+        if (depth == local.lists.length) {
+            local.lists = java.util.Arrays.copyOf(local.lists, depth * 2);
+        }
+        ArrayList<Entity> list = local.lists[depth];
+        if (list == null) {
+            list = local.lists[depth] = new ArrayList<Entity>();
+        }
+        return list;
+    }
+
+    /** Gives back the list {@link #take} gave last on this thread, emptied. */
+    static void release(ArrayList<Entity> list) {
+        AthenaScratchLists local = LOCAL.get();
+        int depth = --local.depth;
+
+        if (depth < 0 || local.lists[depth] != list) {
+            local.depth = Math.max(0, depth + 1);
+            throw new IllegalStateException("scratch lists given back out of order");
+        }
+        if (list.size() > KEEP) {
+            local.lists[depth] = null; // let a list that grew that far go
+        } else {
+            list.clear();
+        }
+    }
+
+    /** How many lists this thread holds out now (for the test). */
+    static int depthForTest() {
+        return LOCAL.get().depth;
+    }
+}
