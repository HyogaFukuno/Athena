diff --git a/src/test/java/net/minecraft/server/AthenaScratchListsTest.java b/src/test/java/net/minecraft/server/AthenaScratchListsTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..59d26530c33d4ae9c2451da583596bdb3ebbc4df
--- /dev/null
+++ b/src/test/java/net/minecraft/server/AthenaScratchListsTest.java
@@ -0,0 +1,71 @@
+package net.minecraft.server;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNotSame;
+import static org.junit.Assert.assertSame;
+import static org.junit.Assert.assertTrue;
+import static org.junit.Assert.fail;
+
+import java.util.ArrayList;
+import org.junit.Test;
+
+/**
+ * Athena - a query's result list is reused per thread: a query run while another's list is held
+ * (from what its walk calls) gets a list of its own, a list comes back empty, one that grew too far
+ * is let go, and lists are given back in the order they were taken.
+ */
+public class AthenaScratchListsTest {
+
+    @Test
+    public void eachDepthHasItsOwnListAndItIsReused() {
+        assertEquals(0, AthenaScratchLists.depthForTest());
+        java.util.ArrayDeque<ArrayList<Entity>> held = new java.util.ArrayDeque<ArrayList<Entity>>();
+        java.util.Set<ArrayList<Entity>> seen = java.util.Collections.newSetFromMap(new java.util.IdentityHashMap<ArrayList<Entity>, Boolean>());
+        for (int i = 0; i < 8; ++i) { // deeper than the first array of lists
+            ArrayList<Entity> list = AthenaScratchLists.take();
+            assertTrue("a list of its own at depth " + i, seen.add(list));
+            assertTrue(list.isEmpty());
+            list.add(null);
+            held.push(list);
+        }
+        assertEquals(8, AthenaScratchLists.depthForTest());
+        ArrayList<Entity> outer = held.peekLast();
+        while (!held.isEmpty()) {
+            AthenaScratchLists.release(held.pop());
+        }
+        assertEquals(0, AthenaScratchLists.depthForTest());
+
+        ArrayList<Entity> again = AthenaScratchLists.take();
+        assertSame("reused", outer, again);
+        assertTrue("emptied", again.isEmpty());
+        AthenaScratchLists.release(again);
+    }
+
+    @Test
+    public void aListThatGrewTooFarIsLetGo() {
+        ArrayList<Entity> list = AthenaScratchLists.take();
+        for (int i = 0; i <= AthenaScratchLists.KEEP; ++i) {
+            list.add(null);
+        }
+        AthenaScratchLists.release(list);
+        ArrayList<Entity> next = AthenaScratchLists.take();
+        assertNotSame(list, next);
+        assertTrue(next.isEmpty());
+        AthenaScratchLists.release(next);
+    }
+
+    @Test
+    public void listsComeBackInTheOrderTheyWereTaken() {
+        ArrayList<Entity> outer = AthenaScratchLists.take();
+        ArrayList<Entity> inner = AthenaScratchLists.take();
+        try {
+            AthenaScratchLists.release(outer);
+            fail("the outer list given back before the inner one");
+        } catch (IllegalStateException expected) {
+            // the depth is left as it was
+        }
+        AthenaScratchLists.release(inner);
+        AthenaScratchLists.release(outer);
+        assertEquals(0, AthenaScratchLists.depthForTest());
+    }
+}
