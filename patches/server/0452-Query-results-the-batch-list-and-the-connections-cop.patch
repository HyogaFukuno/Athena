@@ -470,9 +470,20 @@ public final class AthenaWorldThread extends Thread {
      * and its tick (keep-alive, chat throttle, idle kick). A closed connection is left to the server
      * thread, which takes it off its list and posts its disconnect here.
      */
+    // Athena - a copy of the world's players, kept from tick to tick (this thread's only): a packet
+    // handled here can take its player out of the list (a teleport to another world), so the walk is
+    // over a copy, and toArray made a new array for every world every tick
+    private Object[] connectionScratch = new Object[16];
+
     private void tickConnections(WorldServer world) {
-        Object[] players = world.players.toArray();
-        for (Object human : players) {
+        int count = world.players.size();
+        if (this.connectionScratch.length < count) {
+            this.connectionScratch = new Object[Math.max(count, this.connectionScratch.length * 2)];
+        }
+        Object[] players = world.players.toArray(this.connectionScratch);
+        try {
+        for (int p = 0; p < count; ++p) {
+            Object human = players[p];
             if (!(human instanceof EntityPlayer)) continue;
             PlayerConnection connection = ((EntityPlayer) human).playerConnection;
             if (connection == null) continue;
@@ -487,6 +498,9 @@ public final class AthenaWorldThread extends Thread {
                 networkmanager.disableAutoRead();
             }
         }
+        } finally {
+            java.util.Arrays.fill(players, 0, count, null); // hold no player past the walk
+        }
     }
 
     // Athena start - a hit is handled when it arrives, not at the next tick.
