From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: glacier <hyouga.dev@gmail.com>
Date: Fri, 16 Oct 2026 16:13:28 +0900
Subject: [PATCH] Keep a player's chunks a margin past the view distance
 (chunkUnloadMargin)

1.8 forgets a chunk as it leaves the view square and resends it as it comes back, so moving to and
fro across a chunk border resends a row each time. With chunkUnloadMargin (per world, default 0)
chunks are still sent at the view distance but forgotten only that many chunks further out. 20-bot
minigame bench at margin 2: chunk packets 134,000 -> 9,800, bytes sent 276 -> 47 MB, Netty CPU
-22% (3/3), container memory peak -76 MB.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/src/main/java/com/hpfxd/pandaspigot/config/PandaSpigotWorldConfig.java b/src/main/java/com/hpfxd/pandaspigot/config/PandaSpigotWorldConfig.java
index d731fdba9cf1053acfbfe49f15c3eec36a1b6e61..b381ef55fc2ab265e4ad1140a113d7f38117d830 100644
--- a/src/main/java/com/hpfxd/pandaspigot/config/PandaSpigotWorldConfig.java
+++ b/src/main/java/com/hpfxd/pandaspigot/config/PandaSpigotWorldConfig.java
@@ -85,6 +85,18 @@ public class PandaSpigotWorldConfig {
             "Default: true")
     public boolean cacheChunkPackets = true;
 
+    // Athena start
+    @Comment("How many chunks past the view distance a player keeps a chunk before it is unloaded\n" +
+            "from the client. 1.8 unloads a chunk as soon as it leaves the view square and sends it\n" +
+            "again when it comes back, so walking to and fro across a chunk border resends a whole\n" +
+            "row each time. With a margin, chunks are still sent at the view distance but only\n" +
+            "forgotten that much further out. The client draws by its own render distance; it just\n" +
+            "holds a few more chunks, which the server keeps up to date. 0 is vanilla. Read when\n" +
+            "the world loads.\n" +
+            "Default: 0")
+    public int chunkUnloadMargin = 0;
+    // Athena end
+
     @Comment("When enabled, the first half of generating a brand new chunk - noise, biomes,\n" +
             "surface blocks, caves and ravines - runs on a worker thread instead of the\n" +
             "server thread. It is a pure function of the seed and the chunk coordinates, so\n" +
diff --git a/src/main/java/net/minecraft/server/PlayerChunkMap.java b/src/main/java/net/minecraft/server/PlayerChunkMap.java
index 45a53d35fa1f4db63bc767737e129c5faff23ed1..4e63d02b5c2ad157eb9c988be5f4a57f4aba0cb9 100644
--- a/src/main/java/net/minecraft/server/PlayerChunkMap.java
+++ b/src/main/java/net/minecraft/server/PlayerChunkMap.java
@@ -137,9 +137,76 @@ public class PlayerChunkMap {
 
     public PlayerChunkMap(WorldServer worldserver, int viewDistance /* Spigot */) {
         this.world = worldserver;
+        this.athenaUnloadMargin = Math.max(0, Math.min(worldserver.pandaSpigotConfig.chunkUnloadMargin, 8)); // Athena - before any player is added
         this.setPlayerViewRadius(viewDistance); // Spigot
     }
 
+    // Athena start - chunks are sent at the view distance and forgotten only past it plus this margin.
+    //
+    // 1.8 forgets a chunk the moment it leaves the view square and sends it again the moment it
+    // comes back, so a player moving to and fro across a chunk border reloads a whole row of chunks
+    // each time: on a small arena that was most of the chunk traffic (134,000 chunk packets in three
+    // minutes for 20 players), each one written, encrypted and sent. With a margin the client keeps
+    // the chunks it has until the player is margin chunks further on, and those that come back
+    // into view need nothing. The client renders by its own render distance, so this adds no view
+    // beyond it; the server keeps sending the margin's block changes, so what the client holds stays
+    // right.
+    //
+    // Invariant, with r the player's view distance and m = r + margin: every chunk the player
+    // watches is within m of the player's managed position. movePlayer, removePlayer and the view
+    // distance changes keep it; read once here, the margin never changes under a player.
+    private final int athenaUnloadMargin;
+
+    private void athenaMovePlayerWithMargin(EntityPlayer entityplayer, int i, int j, int k, int l, int r) {
+        int m = r + this.athenaUnloadMargin;
+
+        // forgotten: watched chunks (all within m of the old position) that are past m of the new one
+        for (int x = k - m; x <= k + m; ++x) {
+            for (int z = l - m; z <= l + m; ++z) {
+                if (!this.overlaps(x, z, i, j, m)) {
+                    PlayerChunkMap.PlayerChunk playerchunk = this.getPlayerInstance(x, z, false);
+
+                    if (playerchunk != null) {
+                        playerchunk.removePlayer(entityplayer);
+                    }
+                }
+            }
+        }
+
+        this.filterChunkLoadQueue(entityplayer);
+        entityplayer.managedPosX = entityplayer.locX;
+        entityplayer.managedPosZ = entityplayer.locZ;
+
+        // sent: the new view square, less what the player still has
+        List<ChunkCoordIntPair> chunksToLoad = new ArrayList<ChunkCoordIntPair>();
+
+        for (int x = i - r; x <= i + r; ++x) {
+            for (int z = j - r; z <= j + r; ++z) {
+                if (this.overlaps(x, z, k, l, m)) {
+                    PlayerChunkMap.PlayerChunk playerchunk = this.getPlayerInstance(x, z, false);
+
+                    if (playerchunk != null && playerchunk.playersWatchingChunk.contains(entityplayer)) {
+                        continue;
+                    }
+                }
+                chunksToLoad.add(new ChunkCoordIntPair(x, z));
+            }
+        }
+
+        Collections.sort(chunksToLoad, new ChunkCoordComparator(entityplayer));
+        for (ChunkCoordIntPair pair : chunksToLoad) {
+            this.getPlayerInstance(pair.x, pair.z, true).addPlayer(entityplayer);
+        }
+
+        int dx = i - k;
+        int dz = j - l;
+
+        if (dx > 1 || dx < -1 || dz > 1 || dz < -1) {
+            Collections.sort(entityplayer.chunkCoordIntPairQueue, new ChunkCoordComparator(entityplayer));
+        }
+    }
+    // Athena end
+
     public WorldServer getWorldServer() {
         return this.world;
     }
@@ -325,7 +392,7 @@ public class PlayerChunkMap {
         java.util.Set<ChunkCoordIntPair> arraylist = new java.util.HashSet<ChunkCoordIntPair>(entityplayer.chunkCoordIntPairQueue);
         // Athena end
         int i = 0;
-        int j = entityplayer.viewDistance; // PaperSpigot - Player view distance API
+        int j = entityplayer.viewDistance + this.athenaUnloadMargin; // PaperSpigot - Player view distance API // Athena - queued chunks in the margin are still watched, so still sent
         int k = (int) entityplayer.locX >> 4;
         int l = (int) entityplayer.locZ >> 4;
         int i1 = 0;
@@ -376,8 +443,9 @@ public class PlayerChunkMap {
         int j = (int) entityplayer.managedPosZ >> 4;
 
         // PaperSpigot start - Player view distance API
-        for (int k = i - entityplayer.viewDistance; k <= i + entityplayer.viewDistance; ++k) {
-            for (int l = j - entityplayer.viewDistance; l <= j + entityplayer.viewDistance; ++l) {
+        int m = entityplayer.viewDistance + this.athenaUnloadMargin; // Athena - and the chunks kept past it
+        for (int k = i - m; k <= i + m; ++k) {
+            for (int l = j - m; l <= j + m; ++l) {
         // PaperSpigot end
                 PlayerChunkMap.PlayerChunk playerchunkmap_playerchunk = this.getPlayerInstance(k, l, false);
 
@@ -412,7 +480,9 @@ public class PlayerChunkMap {
             int k1 = j - l;
             List<ChunkCoordIntPair> chunksToLoad = new LinkedList<ChunkCoordIntPair>(); // CraftBukkit
 
-            if (j1 != 0 || k1 != 0) {
+            if ((j1 != 0 || k1 != 0) && this.athenaUnloadMargin > 0) {
+                this.athenaMovePlayerWithMargin(entityplayer, i, j, k, l, i1); // Athena
+            } else if (j1 != 0 || k1 != 0) {
                 for (int l1 = i - i1; l1 <= i + i1; ++l1) {
                     for (int i2 = j - i1; i2 <= j + i1; ++i2) {
                         if (!this.overlaps(l1, i2, k, l, i1)) {
@@ -478,10 +548,16 @@ public class PlayerChunkMap {
                         }
                     }
                 } else {
-                    for (i1 = k - this.playerViewRadius; i1 <= k + this.playerViewRadius; ++i1) {
-                        for (j1 = l - this.playerViewRadius; j1 <= l + this.playerViewRadius; ++j1) {
-                            if (!this.overlaps(i1, j1, k, l, i)) {
-                                this.getPlayerInstance(i1, j1, true).removePlayer(entityplayer);
+                    // Athena - around the managed position, with the margin: the chunks kept past the view go too
+                    int mk = (int) entityplayer.managedPosX >> 4, ml = (int) entityplayer.managedPosZ >> 4, m = this.athenaUnloadMargin;
+                    for (i1 = mk - this.playerViewRadius - m; i1 <= mk + this.playerViewRadius + m; ++i1) {
+                        for (j1 = ml - this.playerViewRadius - m; j1 <= ml + this.playerViewRadius + m; ++j1) {
+                            if (!this.overlaps(i1, j1, mk, ml, i + m)) {
+                                PlayerChunkMap.PlayerChunk playerchunk = this.getPlayerInstance(i1, j1, false);
+
+                                if (playerchunk != null) {
+                                    playerchunk.removePlayer(entityplayer);
+                                }
                             }
                         }
                     }
@@ -510,10 +586,16 @@ public class PlayerChunkMap {
                     }
                 }
             } else {
-                for (int x = cx - player.viewDistance; x <= cx + player.viewDistance; ++x) {
-                    for (int z = cz - player.viewDistance; z <= cz + player.viewDistance; ++z) {
-                        if (!this.overlaps(x, z, cx, cz, viewDistance)) {
-                            this.getPlayerInstance(x, z, true).removePlayer(player);
+                // Athena - around the managed position, with the margin: the chunks kept past the view go too
+                int mx = (int) player.managedPosX >> 4, mz = (int) player.managedPosZ >> 4, m = this.athenaUnloadMargin;
+                for (int x = mx - player.viewDistance - m; x <= mx + player.viewDistance + m; ++x) {
+                    for (int z = mz - player.viewDistance - m; z <= mz + player.viewDistance + m; ++z) {
+                        if (!this.overlaps(x, z, mx, mz, viewDistance + m)) {
+                            PlayerChunkMap.PlayerChunk playerchunk = this.getPlayerInstance(x, z, false);
+
+                            if (playerchunk != null) {
+                                playerchunk.removePlayer(player);
