From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: glacier <hyouga.dev@gmail.com>
Date: Wed, 26 Aug 2026 08:06:33 +0900
Subject: [PATCH] Carry the chunk and section across a run of replayed writes

Decoration works a feature at a time, so consecutive writes land in the same
chunk and usually the same section. Looking both up per block - a hash get and
an array index - was about a sixth of the replay loop, which the profile put at
half the cost of applying a decoration.

On 625 chunks of spawn generation, six runs each way, this takes the gain from
6.4% to 12.2% median and from 78% to 89% of pairings.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>

diff --git a/src/main/java/net/minecraft/server/ChunkDecorationBuffer.java b/src/main/java/net/minecraft/server/ChunkDecorationBuffer.java
index 55d34a93292943df5b572d5cfe6b060e49dd73a2..75fca7810e339a025e2d04fdfa19b9e54c1b69b8 100644
--- a/src/main/java/net/minecraft/server/ChunkDecorationBuffer.java
+++ b/src/main/java/net/minecraft/server/ChunkDecorationBuffer.java
@@ -249,6 +249,11 @@ public class ChunkDecorationBuffer {
         int count = this.logPositions.size();
         List<IBlockData> previous = new ArrayList<IBlockData>(count);
 
+        long lastKey = Long.MIN_VALUE;
+        Chunk lastChunk = null;
+        int lastSectionY = -1;
+        ChunkSection lastSection = null;
+
         touched.defaultReturnValue(0);
 
         // 1 - the blocks themselves, with no lighting and no notification
@@ -265,7 +270,16 @@ public class ChunkDecorationBuffer {
             int y = BlockPosition.unpackY(packed);
             int z = BlockPosition.unpackZ(packed);
             long key = ChunkCoordIntPair.chunkXZ2Int(x >> 4, z >> 4);
-            Chunk chunk = this.captured.get(key);
+
+            // Decoration works a feature at a time, so runs of writes land in the same chunk and
+            // usually the same section. Looking either up again per block was a sixth of this loop.
+            if (key != lastKey) {
+                lastKey = key;
+                lastChunk = this.captured.get(key);
+                lastSectionY = -1;
+            }
+
+            Chunk chunk = lastChunk;
 
             if (chunk == null) {
                 previous.add(null);
@@ -273,7 +287,7 @@ public class ChunkDecorationBuffer {
             }
 
             ChunkSection[] sections = chunk.getSections();
-            ChunkSection section = sections[y >> 4];
+            ChunkSection section = (y >> 4) == lastSectionY ? lastSection : sections[y >> 4];
 
             if (section == null) {
                 if (iblockdata.getBlock() == Blocks.AIR) {
@@ -285,6 +299,8 @@ public class ChunkDecorationBuffer {
                 sections[y >> 4] = section;
             }
 
+            lastSectionY = y >> 4;
+            lastSection = section;
             previous.add(section.getType(x & 15, y & 15, z & 15));
             section.setType(x & 15, y & 15, z & 15, iblockdata);
             touched.put(key, touched.get(key) | 1 << (y >> 4));
