@@ -0,0 +1,199 @@
+package net.minecraft.server;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+
+import io.netty.buffer.ByteBuf;
+import io.netty.buffer.Unpooled;
+import io.netty.channel.ChannelHandlerContext;
+import io.netty.channel.ChannelInboundHandlerAdapter;
+import io.netty.channel.embedded.EmbeddedChannel;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Random;
+import java.util.zip.Deflater;
+import org.bukkit.support.AbstractTestingBase;
+import org.junit.Test;
+
+/**
+ * Athena - PacketSplitter decodes a play connection's frames itself (athenaDecodeDirect) when the
+ * server's own decompressor and decoder follow it: the packets that come out of the decoder's place
+ * must be the ones the three stages made, whatever way the bytes arrive, compressed or not, and a
+ * pipeline with anything else in it must take the three stages.
+ */
+public class AthenaDirectDecodeTest extends AbstractTestingBase {
+
+    private static final class Capture extends ChannelInboundHandlerAdapter {
+        final List<Object> read = new ArrayList<Object>();
+
+        @Override
+        public void channelRead(ChannelHandlerContext ctx, Object msg) {
+            this.read.add(msg);
+        }
+    }
+
+    private static EmbeddedChannel channel(Capture capture, int threshold, boolean pluginBetween) {
+        EmbeddedChannel channel = new EmbeddedChannel();
+
+        channel.attr(NetworkManager.attrKeyConnectionState).set(EnumProtocol.PLAY);
+        channel.pipeline().addLast("splitter", new PacketSplitter());
+        if (pluginBetween) {
+            channel.pipeline().addLast("plugin", new ChannelInboundHandlerAdapter());
+        }
+        if (threshold >= 0) {
+            channel.pipeline().addLast("decompress", new PacketDecompressor(threshold));
+        }
+        channel.pipeline().addLast("decoder", new PacketDecoder(EnumProtocolDirection.SERVERBOUND))
+                .addLast("packet_handler", capture);
+        return channel;
+    }
+
+    private static void varInt(ByteBuf out, int value) {
+        new PacketDataSerializer(out).writeVarIntToBuffer(value);
+    }
+
+    private static byte[] body(int id, java.util.function.Consumer<PacketDataSerializer> fields) {
+        PacketDataSerializer out = new PacketDataSerializer(Unpooled.buffer());
+        out.writeVarIntToBuffer(id);
+        fields.accept(out);
+        byte[] bytes = new byte[out.readableBytes()];
+        out.readBytes(bytes);
+        return bytes;
+    }
+
+    /** The frame the client sends for {@code body}: compressed past the threshold, as the vanilla client does. */
+    private static void frame(ByteBuf out, byte[] body, int threshold) {
+        ByteBuf frame = Unpooled.buffer();
+
+        if (threshold < 0) {
+            frame.writeBytes(body);
+        } else if (body.length < threshold) {
+            varInt(frame, 0);
+            frame.writeBytes(body);
+        } else {
+            varInt(frame, body.length);
+            Deflater deflater = new Deflater();
+            deflater.setInput(body);
+            deflater.finish();
+            byte[] buffer = new byte[8192];
+            while (!deflater.finished()) {
+                frame.writeBytes(buffer, 0, deflater.deflate(buffer));
+            }
+            deflater.end();
+        }
+        varInt(out, frame.readableBytes());
+        out.writeBytes(frame);
+    }
+
+    private static List<byte[]> bodies() {
+        List<byte[]> bodies = new ArrayList<byte[]>();
+        Random random = new Random(5);
+
+        for (int i = 0; i < 40; ++i) {
+            final int n = i;
+            switch (i % 3) {
+                case 0:
+                    bodies.add(body(0x00, out -> out.writeVarIntToBuffer(n * 7919)));
+                    break;
+                case 1:
+                    bodies.add(body(0x01, out -> out.writeString("chat " + n + " 日本語")));
+                    break;
+                default:
+                    final byte[] payload = new byte[random.nextInt(2000)];
+                    random.nextBytes(payload);
+                    bodies.add(body(0x17, out -> {
+                        out.writeString("MC|Test");
+                        out.writeBytes(payload);
+                    }));
+            }
+        }
+        return bodies;
+    }
+
+    private static String describe(Object packet) {
+        if (packet instanceof PacketPlayInKeepAlive) return "keepalive " + ((PacketPlayInKeepAlive) packet).getKey();
+        if (packet instanceof PacketPlayInChat) return "chat " + ((PacketPlayInChat) packet).getMessage();
+        if (packet instanceof PacketPlayInCustomPayload) {
+            PacketDataSerializer data = ((PacketPlayInCustomPayload) packet).getBufferData();
+            return "payload " + ((PacketPlayInCustomPayload) packet).getChannelName() + " " + io.netty.buffer.ByteBufUtil.hexDump(data);
+        }
+        return String.valueOf(packet);
+    }
+
+    private static List<String> decode(int threshold, boolean pluginBetween, int pieces) {
+        Capture capture = new Capture();
+        EmbeddedChannel channel = channel(capture, threshold, pluginBetween);
+        ByteBuf all = Unpooled.buffer();
+
+        all.writeZero(3); // a run of zeros before the first frame is passed over
+        for (byte[] body : bodies()) {
+            frame(all, body, threshold);
+        }
+        // the bytes arrive in pieces of every size, frames cut anywhere
+        Random random = new Random(pieces);
+        while (all.isReadable()) {
+            int n = pieces == 1 ? all.readableBytes() : Math.min(all.readableBytes(), 1 + random.nextInt(pieces));
+            channel.writeInbound(all.readRetainedSlice(n));
+        }
+        all.release();
+        List<String> out = new ArrayList<String>();
+        for (Object packet : capture.read) {
+            out.add(describe(packet));
+        }
+        assertFalse(channel.finish());
+        return out;
+    }
+
+    @Test
+    public void theDirectDecodeReadsWhatTheThreeStagesRead() {
+        for (int threshold : new int[] { -1, 256 }) {
+            List<String> expected = decode(threshold, true, 1); // a handler in between: the three stages
+            assertEquals(40, expected.size());
+            for (int pieces : new int[] { 1, 3, 17, 300 }) {
+                long before = PacketSplitter.athenaDecoded;
+                assertEquals("threshold " + threshold + ", pieces of up to " + pieces, expected, decode(threshold, false, pieces));
+                assertEquals("decoded directly", before + 40, PacketSplitter.athenaDecoded);
+            }
+        }
+    }
+
+    @Test
+    public void anotherProtocolTakesTheThreeStages() {
+        Capture capture = new Capture();
+        EmbeddedChannel channel = channel(capture, -1, false);
+        channel.attr(NetworkManager.attrKeyConnectionState).set(EnumProtocol.HANDSHAKING);
+        ByteBuf in = Unpooled.buffer();
+        frame(in, body(0x00, out -> {
+            out.writeVarIntToBuffer(47);
+            out.writeString("localhost");
+            out.writeShort(25565);
+            out.writeVarIntToBuffer(2);
+        }), -1);
+        long before = PacketSplitter.athenaDecoded;
+        channel.writeInbound(in);
+        assertEquals(1, capture.read.size());
+        assertTrue(capture.read.get(0) instanceof PacketHandshakingInSetProtocol);
+        assertEquals(before, PacketSplitter.athenaDecoded);
+        channel.finish();
+    }
+
+    @Test
+    public void aPacketLongerThanItsFrameCloses() {
+        Capture capture = new Capture();
+        EmbeddedChannel channel = channel(capture, -1, false);
+        ByteBuf in = Unpooled.buffer();
+        frame(in, body(0x00, out -> {
+            out.writeVarIntToBuffer(1);
+            out.writeByte(9); // one byte more than a keep-alive
+        }), -1);
+        try {
+            channel.writeInbound(in);
+        } catch (Exception expected) {
+            // the decoder's exception, as from the three stages
+        }
+        assertTrue(capture.read.isEmpty());
+        assertNull(channel.readInbound());
+    }
+}
