+    // Athena start - a play connection's frames are split, inflated and decoded here, in one handler.
+    //
+    // Each frame went through three decoders: this one cut it out as a retained slice, the
+    // decompressor took that and cut it again after the data length, the packet decoder read the
+    // packet out of the second slice. Each stage is a ByteToMessageDecoder of its own - its output
+    // list, its cumulation, a fireChannelRead to the next context - and each made a slice and a
+    // PacketDataSerializer: together 5% of a match's CPU and a tenth of the event loop's (VPS-B,
+    // 8 rooms, ~110 players over the network). Here the frame is read where it lies in the
+    // cumulation, an uncompressed one with no copy and no slice, and the packet goes on from the
+    // decoder's place in the pipeline, exactly as the decoder would have passed it on.
+    //
+    // Only where it is certain to be the same thing: the play protocol, and the server's own
+    // decompressor (if compression is on) and packet decoder right after this handler, nothing between
+    // them. A plugin's decoder in there (a protocol translator), the 1.7 translator, or any other
+    // protocol takes the three stages as before. -Dathena.disableDirectDecode=true turns it off.
+    private static final boolean ATHENA_DIRECT = !Boolean.getBoolean("athena.disableDirectDecode");
+    /** Packets decoded here; for tests and measurements (a plain count several event loops may put out by a few). */
+    static long athenaDecoded;
+
+    // the event loop's, found again for every read (athenaDirect)
+    private ChannelHandlerContext athenaDecoderContext;
+    private PacketDecompressor athenaDecompressor;
+
+    private boolean athenaDirect(ChannelHandlerContext context) {
+        io.netty.channel.Channel channel = context.channel();
+
+        if (channel.attr(NetworkManager.attrKeyConnectionState).get() != EnumProtocol.PLAY) {
+            return false;
+        }
+
+        io.netty.channel.ChannelPipeline pipeline = channel.pipeline();
+
+        if (!io.netty.channel.AthenaPipelineWalk.walkable(pipeline)) {
+            return false;
+        }
+        synchronized (pipeline) { // as names() walks
+            final ChannelHandlerContext end = io.netty.channel.AthenaPipelineWalk.end(pipeline);
+            ChannelHandlerContext at = io.netty.channel.AthenaPipelineWalk.next(context);
+            PacketDecompressor decompressor = null;
+
+            if (at != end && at.handler() instanceof PacketDecompressor) {
+                if (at.handler().getClass() != PacketDecompressor.class) {
+                    return false;
+                }
+                decompressor = (PacketDecompressor) at.handler();
+                at = io.netty.channel.AthenaPipelineWalk.next(at);
+            }
+            if (at == end || at.handler() == null || at.handler().getClass() != PacketDecoder.class || ((PacketDecoder) at.handler()).athenaServerbound() == false) {
+                return false;
+            }
+            this.athenaDecoderContext = at;
+            this.athenaDecompressor = decompressor;
+        }
+        return true;
+    }
+
+    private void athenaDecodeDirect(ChannelHandlerContext context, ByteBuf bytebuf) throws Exception {
+        final ChannelHandlerContext decoder = this.athenaDecoderContext;
+        final PacketDecompressor decompressor = this.athenaDecompressor;
+        final int threshold = decompressor != null ? decompressor.athenaThreshold() : -1;
+
+        while (bytebuf.isReadable()) {
+            if (!context.channel().isActive() || context.isRemoved()) {
+                bytebuf.clear();
+                return;
+            }
+
+            // the frame length, read as VarIntByteDecoder reads it: zeros before it are skipped,
+            // three bytes at most, an empty frame is passed over
+            int at = bytebuf.readerIndex();
+            final int limit = bytebuf.writerIndex();
+
+            while (at < limit && bytebuf.getByte(at) == 0) {
+                ++at;
+            }
+            if (at == limit) {
+                bytebuf.clear(); // nothing but zeros
+                return;
+            }
+            bytebuf.readerIndex(at);
+
+            int length = 0;
+            int bytes = 0;
+            boolean done = false;
+
+            while (at + bytes < limit) {
+                byte k = bytebuf.getByte(at + bytes);
+
+                length |= (k & 0x7F) << bytes++ * 7;
+                if (bytes > 3) {
+                    bytebuf.clear();
+                    throw new CorruptedFrameException("VarInt too big");
+                }
+                if ((k & 0x80) != 128) {
+                    done = true;
+                    break;
+                }
+            }
+            if (!done) {
+                return; // the length is not all here yet
+            }
+            if (length == 0) {
+                bytebuf.readerIndex(at + bytes);
+                continue;
+            }
+            if (!bytebuf.isReadable(bytes + length)) {
+                return; // nor the frame
+            }
+
+            final int frameStart = at + bytes;
+            final int frameEnd = frameStart + length;
+            Packet packet;
+
+            bytebuf.readerIndex(frameStart);
+            if (decompressor == null) {
+                packet = this.athenaReadPacket(context, bytebuf, frameEnd);
+            } else {
+                PacketDataSerializer frame = new PacketDataSerializer(bytebuf);
+                int dataLength;
+                // the data length must be read inside the frame, as the decompressor reads it from its slice
+                int savedWriter = bytebuf.writerIndex();
+
+                bytebuf.writerIndex(frameEnd);
+                try {
+                    dataLength = frame.readVarIntFromBuffer();
+                } finally {
+                    bytebuf.writerIndex(savedWriter);
+                }
+                if (dataLength == 0) {
+                    packet = this.athenaReadPacket(context, bytebuf, frameEnd);
+                } else {
+                    ByteBuf compressed = bytebuf.slice(bytebuf.readerIndex(), frameEnd - bytebuf.readerIndex());
+                    ByteBuf inflated = PacketDecompressor.athenaInflate(context, compressed, new PacketDataSerializer(compressed), dataLength, threshold);
+
+                    try {
+                        packet = this.athenaReadPacket(context, inflated, inflated.writerIndex());
+                    } finally {
+                        inflated.release();
+                    }
+                }
+            }
+            bytebuf.readerIndex(frameEnd);
+            if (packet != null) {
+                ++athenaDecoded;
+                decoder.fireChannelRead(packet);
+            }
+        }
+    }
+
+    /** PacketDecoder.decode, for the bytes of {@code in} from its reader index up to {@code end}; null for an empty packet. */
+    private Packet athenaReadPacket(ChannelHandlerContext context, ByteBuf in, int end) throws Exception {
+        if (in.readerIndex() == end) {
+            return null; // the packet decoder passes an empty frame over
+        }
+
+        int savedWriter = in.writerIndex();
+
+        in.writerIndex(end); // the packet may read no further than its frame, as from a slice
+        try {
+            PacketDataSerializer packetdataserializer = new PacketDataSerializer(in);
+            int i = packetdataserializer.readVarIntFromBuffer();
+            Packet packet = EnumProtocol.PLAY.getPacket(EnumProtocolDirection.SERVERBOUND, i);
+
+            if (packet == null) {
+                throw new java.io.IOException("Bad packet id " + i);
+            }
+            packet.readPacketData(packetdataserializer);
+            if (packetdataserializer.readableBytes() > 0) {
+                throw new java.io.IOException("Packet " + EnumProtocol.PLAY.getId() + "/" + i + " (" + packet.getClass().getSimpleName() + ") was larger than I expected, found " + packetdataserializer.readableBytes() + " bytes extra whilst reading packet " + i);
+            }
+            return packet;
+        } finally {
+            in.writerIndex(Math.max(savedWriter, in.readerIndex()));
+        }
+    }
+    // Athena end
 }
