     }
+    // Athena end
 
     private void a(int i, int j, int k) {
         this.depthNoiseArray = this.noiseGen6.generateNoiseOctaves(this.depthNoiseArray, i, k, 5, 5, (double) this.settings.depthNoiseScaleX, (double) this.settings.depthNoiseScaleZ, (double) this.settings.depthNoiseScaleExponent);
diff --git a/src/main/java/net/minecraft/server/ChunkShape.java b/src/main/java/net/minecraft/server/ChunkShape.java
new file mode 100644
index 0000000000000000000000000000000000000000..6a177447b7367cc4076291a14a3fa0c26329d3a3
--- /dev/null
+++ b/src/main/java/net/minecraft/server/ChunkShape.java
@@ -0,0 +1,21 @@
+package net.minecraft.server;
+
+// Athena start - the result of the off-thread half of chunk generation.
+//
+// Everything in here is produced without reading or writing the World: the block states come out
+// of the noise and the biome table, and the biome ids are a copy, because the generator reuses its
+// own BiomeBase[] for the next chunk. Handing this to the server thread is what lets the rest of
+// generation - structure starts, the Chunk itself, lighting, population - stay exactly where it was.
+public class ChunkShape {
+
+    /** Block states for the chunk, in the layout ChunkSnapshot uses. */
+    public final ChunkSnapshot blocks;
+    /** The chunk's 16x16 biome ids, ready to be copied into Chunk.getBiomeIndex(). */
+    public final byte[] biomeIndex;
+
+    public ChunkShape(ChunkSnapshot chunksnapshot, byte[] abyte) {
+        this.blocks = chunksnapshot;
+        this.biomeIndex = abyte;
+    }
+}
+// Athena end
