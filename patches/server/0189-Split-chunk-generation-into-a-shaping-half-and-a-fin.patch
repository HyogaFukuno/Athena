     public void setBlocksInChunk(int i, int j, ChunkSnapshot chunksnapshot) {
-        this.biomesForGeneration = this.worldObj.getWorldChunkManager().getBiomes(this.biomesForGeneration, i * 4 - 2, j * 4 - 2, 10, 10);
+        this.biomesForGeneration = this.chunkManager().getBiomes(this.biomesForGeneration, i * 4 - 2, j * 4 - 2, 10, 10);
         this.a(i * 4, 0, j * 4);
         // Athena - the two states written below never change; the innermost loop runs 65536 times
