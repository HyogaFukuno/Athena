+    public ChunkShape shapeChunk(int i, int j) {
         this.rand.setSeed((long) i * 341873128712L + (long) j * 132897987541L);
         ChunkSnapshot chunksnapshot = new ChunkSnapshot();
 
         this.setBlocksInChunk(i, j, chunksnapshot);
-        this.biomesForGeneration = this.worldObj.getWorldChunkManager().getBiomeBlock(this.biomesForGeneration, i * 16, j * 16, 16, 16);
+        this.biomesForGeneration = this.chunkManager().getBiomeBlock(this.biomesForGeneration, i * 16, j * 16, 16, 16);
