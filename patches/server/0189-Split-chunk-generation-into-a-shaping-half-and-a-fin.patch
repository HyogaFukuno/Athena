         if (this.settings.useCaves && this.worldObj.paperSpigotConfig.generateCaves) { // PaperSpigot
             this.caveGenerator.generate(this, this.worldObj, i, j, chunksnapshot);
@@ -170,6 +227,20 @@ public class ChunkProviderGenerate implements IChunkProvider {
             this.ravineGenerator.generate(this, this.worldObj, i, j, chunksnapshot);
         }
 
+        // biomesForGeneration is scratch that the next chunk overwrites, so the ids are copied out here
+        byte[] abyte = new byte[256];
+
+        for (int k = 0; k < abyte.length; ++k) {
+            abyte[k] = (byte) this.biomesForGeneration[k].id;
+        }
+
+        return new ChunkShape(chunksnapshot, abyte);
+    }
