         if (entity instanceof EntityInsentient) {
@@ -1269,6 +1293,14 @@ public class Chunk {
             counts = itemCounts;
         } else if (IInventory.class.isAssignableFrom(oclass)) {
             counts = inventoryEntityCounts;
+        // Athena start - the two cases mobs actually spend their time on. The player count covers
+        // every EntityHuman, so asking for a subclass of it can only over-count, never skip a slice
+        // that held a match. See AthenaMonsterOnly for why the predicate marker is sound.
+        } else if (EntityHuman.class.isAssignableFrom(oclass)) {
+            counts = playerCounts;
+        } else if (predicate instanceof AthenaMonsterOnly) {
+            counts = monsterCounts;
+        // Athena end
         } else {
             counts = null;
