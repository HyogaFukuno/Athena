@@ -21,21 +21,40 @@ public class PathfinderGoalNearestAttackableTarget<T extends EntityLiving> exten
     // it was composed from rather than built once in the constructor.
     private Predicate composedSelector;
     private Predicate composedFrom;
+    // Whether this goal was built on a selector that can only accept an IMonster, which lets the
+    // query skip any chunk slice holding none. See AthenaMonsterOnly.
+    private boolean monsterOnly;
 
     private Predicate composedSelector() {
         if (this.composedFrom != this.targetEntitySelector) {
-            final Predicate inner = this.targetEntitySelector;
+            Predicate inner = this.targetEntitySelector;
             this.composedFrom = inner;
-            this.composedSelector = new Predicate() {
-                public boolean apply(Object object) {
-                    // same order and same tests Predicates.and(inner, NOT_SPECTATING) applied
-                    return inner.apply(object)
-                        && (!(object instanceof EntityHuman) || !((EntityHuman) object).isSpectator());
-                }
-            };
+            this.composedSelector = this.monsterOnly ? new MonsterOnlyComposed(inner) : new Composed(inner);
         }
         return this.composedSelector;
     }
+
+    /** inner, then NOT_SPECTATING - the order and the tests Predicates.and applied. */
+    private static class Composed implements Predicate {
+
+        final Predicate inner;
+
+        Composed(Predicate inner) {
+            this.inner = inner;
+        }
+
+        public boolean apply(Object object) {
+            return this.inner.apply(object)
+                && (!(object instanceof EntityHuman) || !((EntityHuman) object).isSpectator());
+        }
+    }
+
+    private static final class MonsterOnlyComposed extends Composed implements AthenaMonsterOnly {
+
+        MonsterOnlyComposed(Predicate inner) {
+            super(inner);
+        }
+    }
     // Athena end
 
