--- a/src/main/java/net/minecraft/server/WorldServer.java
+++ b/src/main/java/net/minecraft/server/WorldServer.java
@@ -1501,6 +1501,39 @@ public class WorldServer extends World implements IAsyncTaskHandler {
     /** Set while some thread is inside this world's tick (MinecraftServer.athenaTickWorld). */
     volatile boolean athenaInTick;
 
+    /** Athena.runOnWorldTimer tasks: touched by the tick thread only; others hand theirs over through athenaNewTimers. */
+    private final java.util.ArrayList<athena.server.AthenaWorldTimer> athenaTimers = new java.util.ArrayList<>();
+    private final java.util.concurrent.ConcurrentLinkedQueue<athena.server.AthenaWorldTimer> athenaNewTimers = new java.util.concurrent.ConcurrentLinkedQueue<>();
+
+    /** Adds a timer; any thread. It is taken on at the start of the world's next tick. */
+    public void athenaAddTimer(athena.server.AthenaWorldTimer timer) {
+        this.athenaNewTimers.add(timer);
+    }
+
+    /** At the start of each tick, on the tick thread: the timers that are due. */
+    void athenaRunTimers() {
+        athena.server.AthenaWorldTimer added;
+        while ((added = this.athenaNewTimers.poll()) != null) {
+            added.start(this.athenaCurrentTick);
+            this.athenaTimers.add(added);
+        }
+        if (this.athenaTimers.isEmpty()) return;
+        // a timer may add timers (they wait in athenaNewTimers for the next tick) or cancel any of them
+        for (int i = 0; i < this.athenaTimers.size(); i++) {
+            if (!this.athenaTimers.get(i).tick(this.athenaCurrentTick)) {
+                this.athenaTimers.remove(i--);
+            }
+        }
+    }
+
+    /** When the world is unloaded: its timers stop. */
+    public void athenaCancelTimers() {
+        for (athena.server.AthenaWorldTimer timer : this.athenaTimers) timer.cancel();
+        athena.server.AthenaWorldTimer timer;
+        while ((timer = this.athenaNewTimers.poll()) != null) timer.cancel();
+        this.athenaTimers.clear();
+    }
+
     public ListenableFuture<Object> postToMainThread(Runnable runnable) {
         AthenaWorldThread thread = this.athenaThread;
         if (thread == null) {
