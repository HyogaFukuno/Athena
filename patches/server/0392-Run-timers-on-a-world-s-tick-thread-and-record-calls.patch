index 0000000000000000000000000000000000000000..bdd96dd2b0c3e3d8fe5c1195431057be24f078f0
--- /dev/null
+++ b/src/test/java/athena/server/AthenaWorldTimerTest.java
@@ -0,0 +1,59 @@
+package athena.server;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import java.util.ArrayList;
+import java.util.List;
+
+import org.junit.Test;
+
+public class AthenaWorldTimerTest {
+
+    /** Runs the timer once per tick from {@code from} to {@code to} and returns the ticks it ran at. */
+    private static List<Long> run(AthenaWorldTimer timer, List<Long> ran, long from, long to) {
+        for (long tick = from; tick <= to; tick++) {
+            if (!timer.tick(tick)) break;
+        }
+        return ran;
+    }
+
+    @Test
+    public void runsAfterTheDelayThenEveryPeriod() {
+        final List<Long> ran = new ArrayList<>();
+        final long[] now = {0};
+        AthenaWorldTimer timer = new AthenaWorldTimer(null, () -> ran.add(now[0]), 3, 5);
+        timer.start(100);
+        for (now[0] = 100; now[0] <= 120; now[0]++) {
+            assertTrue(timer.tick(now[0]));
+        }
+        assertEquals(List.of(103L, 108L, 113L, 118L), ran);
+        assertFalse(timer.isCancelled());
+    }
+
+    @Test
+    public void aPeriodOfZeroRunsOnce() {
+        final List<Long> ran = new ArrayList<>();
+        AthenaWorldTimer timer = new AthenaWorldTimer(null, () -> ran.add(1L), 0, 0);
+        timer.start(7);
+        run(timer, ran, 7, 20);
+        assertEquals(List.of(1L), ran);
+        assertTrue(timer.isCancelled());
+        assertFalse(timer.tick(21));
+    }
+
+    @Test
+    public void cancelStopsIt() {
+        final List<Long> ran = new ArrayList<>();
+        final AthenaWorldTimer[] self = new AthenaWorldTimer[1];
+        self[0] = new AthenaWorldTimer(null, () -> {
+            ran.add(1L);
+            if (ran.size() == 2) self[0].cancel();
+        }, 1, 1);
+        self[0].start(0);
+        run(self[0], ran, 0, 50);
+        assertEquals(2, ran.size());
+        assertTrue(self[0].isCancelled());
+    }
