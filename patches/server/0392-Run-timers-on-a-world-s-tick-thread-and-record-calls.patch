     }
+
+    @Override
+    public athena.api.WorldTask runOnWorldTimer(World world, Runnable task, long delay, long period) {
+        Validate.notNull(world, "World may not be null");
+        Validate.notNull(task, "Task may not be null");
+        net.minecraft.server.WorldServer handle = ((CraftWorld) world).getHandle();
+        athena.server.AthenaWorldTimer timer = new athena.server.AthenaWorldTimer(handle, task, delay, period);
+        handle.athenaAddTimer(timer);
+        return timer;
+    }
 }
diff --git a/src/main/java/athena/server/AthenaThreadCheck.java b/src/main/java/athena/server/AthenaThreadCheck.java
new file mode 100644
index 0000000000000000000000000000000000000000..b394bf57d1dd2ca8ee0f1e3e485e3d36661df8b3
--- /dev/null
+++ b/src/main/java/athena/server/AthenaThreadCheck.java
@@ -0,0 +1,110 @@
+package athena.server;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.atomic.LongAdder;
+
+import net.minecraft.server.World;
+import net.minecraft.server.WorldServer;
+import org.apache.logging.log4j.LogManager;
+import org.apache.logging.log4j.Logger;
+
+/**
+ * A test aid for worlds on their own threads: with {@code -Dathena.threadCheck=true}, the places that
+ * change a world (blocks, entities, chunk lookups, the entity tracker, the player chunk map, entity
+ * moves) record every call from a thread other than the one that ticks that world, instead of
+ * letting it race. Each place is logged once with its stack, and counted; {@link #report} lists them,
+ * and the server logs the list when it stops. Off, the checks compile away ({@link #ENABLED} is a
+ * constant).
+ *
+ * <p>The JVM's ThreadSanitizer does not run Minecraft, so this is how the long tests find calls that
+ * slipped past the routing to a world's thread.
+ */
+public final class AthenaThreadCheck {
+    public static final boolean ENABLED = Boolean.getBoolean("athena.threadCheck");
+
+    private static final Logger LOGGER = LogManager.getLogger();
+    /** Stacks of this many frames tell one place from another. */
+    private static final int KEY_FRAMES = 8;
+    /** Places logged with their whole stack; later ones are only counted. */
+    private static final int LOGGED_PLACES = 50;
+
+    private static final Map<String, LongAdder> PLACES = new ConcurrentHashMap<>();
+    private static final LongAdder TOTAL = new LongAdder();
+
+    private AthenaThreadCheck() {}
+
+    /** Records the call if this thread is not the one that ticks {@code world}. */
+    public static void check(World world, String what) {
+        if (world instanceof WorldServer && !((WorldServer) world).isMainThread()) {
+            record((WorldServer) world, what);
+        }
+    }
+
+    /** Records a call that AsyncCatcher is about to refuse. */
+    public static void refused(World world, String what) {
+        record(world instanceof WorldServer ? (WorldServer) world : null, "refused " + what);
+    }
+
+    private static void record(WorldServer world, String what) {
+        TOTAL.increment();
+        StackTraceElement[] stack = new Throwable().getStackTrace();
+        StringBuilder key = new StringBuilder(what).append(" on ").append(threadKind(Thread.currentThread().getName()));
+        int frames = 0;
+        for (int i = 2; i < stack.length && frames < KEY_FRAMES; i++, frames++) {
+            key.append(" < ").append(stack[i].getClassName()).append('.').append(stack[i].getMethodName()).append(':').append(stack[i].getLineNumber());
+        }
+        String place = key.toString();
+        LongAdder count = PLACES.get(place);
+        if (count == null) {
+            LongAdder created = new LongAdder();
+            count = PLACES.putIfAbsent(place, created);
+            if (count == null) {
+                count = created;
+                if (PLACES.size() <= LOGGED_PLACES) {
+                    StringBuilder trace = new StringBuilder();
+                    for (int i = 2; i < stack.length; i++) {
+                        trace.append("\n\tat ").append(stack[i]);
+                    }
+                    String owner = world == null ? "?" : (world.athenaThread != null ? world.athenaThread.getName() : "the server thread");
+                    LOGGER.warn("Thread check: " + what + " in " + (world == null ? "?" : world.getWorldData().getName())
+                            + " from " + Thread.currentThread().getName() + ", which does not tick it (" + owner + " does):" + trace);
+                }
+            }
+        }
+        count.increment();
+    }
+
+    /** "Athena world wt-0" and "Netty Epoll Server IO #3" count as one thread kind each. */
+    private static String threadKind(String name) {
+        return name.replaceAll("[ #-]*\\d+$", "");
+    }
+
+    /** Calls from the wrong thread recorded so far. */
+    public static long total() {
+        return TOTAL.sum();
+    }
+
+    /** One line per place, most calls first. */
+    public static List<String> report() {
+        List<Map.Entry<String, LongAdder>> entries = new ArrayList<>(PLACES.entrySet());
+        entries.sort((a, b) -> Long.compare(b.getValue().sum(), a.getValue().sum()));
+        List<String> lines = new ArrayList<>();
+        for (Map.Entry<String, LongAdder> entry : entries) {
+            lines.add(entry.getValue().sum() + "x " + entry.getKey());
+        }
+        return lines;
+    }
+
+    /** For the server's stop: the summary, if the check is on. */
+    public static void logReport() {
+        if (!ENABLED) return;
+        List<String> lines = report();
+        LOGGER.info("Thread check: " + total() + " calls from a thread that does not tick the world, at " + lines.size() + " places");
+        for (String line : lines) {
+            LOGGER.info("Thread check: " + line);
+        }
+    }
+}
diff --git a/src/main/java/athena/server/AthenaWorldTimer.java b/src/main/java/athena/server/AthenaWorldTimer.java
new file mode 100644
index 0000000000000000000000000000000000000000..db0fbc4579830136cc41a508e6e5582864d23e5b
--- /dev/null
+++ b/src/main/java/athena/server/AthenaWorldTimer.java
@@ -0,0 +1,68 @@
+package athena.server;
+
+import athena.api.WorldTask;
+import net.minecraft.server.WorldServer;
+import org.bukkit.World;
+
+/**
+ * One Athena.runOnWorldTimer task. Its world's tick thread runs it at the start of the world's tick
+ * (WorldServer.athenaRunTimers), counting the world's own ticks, so it keeps time with the world
+ * and not with the server thread.
+ */
+public final class AthenaWorldTimer implements WorldTask {
+    private final WorldServer world;
+    private final Runnable task;
+    private final long delay;
+    private final long period;
+    /** The world tick it runs next at; set when the tick thread takes it on. */
+    private long next;
+    private volatile boolean cancelled;
+
+    public AthenaWorldTimer(WorldServer world, Runnable task, long delay, long period) {
+        this.world = world;
+        this.task = task;
+        this.delay = Math.max(0L, delay);
+        this.period = period;
+    }
+
+    /** On the tick thread, when it takes the timer on. */
+    public void start(long currentTick) {
+        this.next = currentTick + this.delay;
+    }
+
+    /**
+     * On the tick thread, once a tick: runs the task if it is due.
+     *
+     * @return false once the timer is done and can be dropped
+     */
+    public boolean tick(long currentTick) {
+        if (this.cancelled) return false;
+        if (currentTick < this.next) return true;
+        try {
+            this.task.run();
+        } catch (Throwable throwable) {
+            org.apache.logging.log4j.LogManager.getLogger().error("A timer task for world " + this.world.getWorldData().getName() + " threw", throwable);
+        }
+        if (this.period <= 0L) {
+            this.cancelled = true;
+            return false;
+        }
+        this.next = currentTick + this.period;
+        return !this.cancelled;
+    }
+
+    @Override
+    public World getWorld() {
+        return this.world.getWorld();
+    }
+
+    @Override
+    public void cancel() {
+        this.cancelled = true;
+    }
+
+    @Override
+    public boolean isCancelled() {
+        return this.cancelled;
+    }
+}
