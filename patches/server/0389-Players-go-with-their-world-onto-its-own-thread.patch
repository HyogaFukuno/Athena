@@ -113,6 +123,30 @@ public final class AthenaWorldThread extends Thread {
         }
     }
 
+    /**
+     * ServerConnection.networkTick for the players in this world: each connection's queued packets
+     * and its tick (keep-alive, chat throttle, idle kick). A closed connection is left to the server
+     * thread, which takes it off its list and posts its disconnect here.
+     */
+    private void tickConnections() {
+        Object[] players = this.world.players.toArray();
+        for (Object human : players) {
+            if (!(human instanceof EntityPlayer)) continue;
+            PlayerConnection connection = ((EntityPlayer) human).playerConnection;
+            if (connection == null) continue;
+            final NetworkManager networkmanager = connection.networkManager;
+            if (networkmanager.hasNoChannel() || !networkmanager.isChannelOpen()) continue;
+            try {
+                networkmanager.processReceivedPackets();
+            } catch (Exception exception) {
+                LOGGER.warn("Failed to handle packet for " + ((EntityPlayer) human).getName(), exception);
+                final ChatComponentText message = new ChatComponentText("Internal server error");
+                networkmanager.sendPacket(new PacketPlayOutKickDisconnect(message), future -> networkmanager.close(message));
+                networkmanager.disableAutoRead();
+            }
+        }
+    }
+
     private void runTasks() {
         Runnable task;
         while ((task = this.tasks.poll()) != null) {
