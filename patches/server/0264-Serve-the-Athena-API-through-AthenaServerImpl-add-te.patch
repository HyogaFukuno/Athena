diff --git a/src/main/java/athena/server/AthenaServerImpl.java b/src/main/java/athena/server/AthenaServerImpl.java
new file mode 100644
index 0000000000000000000000000000000000000000..7615de68fcf4d1a5f6d36e0eb4e973e39676a39c
--- /dev/null
+++ b/src/main/java/athena/server/AthenaServerImpl.java
@@ -0,0 +1,102 @@
+package athena.server;
+
+import athena.api.AthenaServer;
+import java.io.File;
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.List;
+import java.util.concurrent.CompletableFuture;
+import java.util.function.Function;
+import net.minecraft.server.AthenaTeleportQueue;
+import net.minecraft.server.AthenaTemplateDataManager;
+import org.apache.commons.lang.Validate;
+import org.bukkit.Location;
+import org.bukkit.World;
+import org.bukkit.WorldCreator;
+import org.bukkit.craftbukkit.CraftServer;
+import org.bukkit.craftbukkit.CraftWorld;
+import org.bukkit.entity.Entity;
+import org.bukkit.entity.Player;
+import org.bukkit.event.player.PlayerTeleportEvent;
+
+/**
+ * Athena - the server's side of athena.api.Athena. Template worlds are CraftServer's (they share
+ * createWorld's second half); gradual teleports are AthenaTeleportQueue's, drained in the tick loop.
+ */
+public final class AthenaServerImpl implements AthenaServer {
+
+    private final CraftServer server;
+
+    public AthenaServerImpl(CraftServer server) {
+        this.server = server;
+    }
+
+    @Override
+    public World loadTemplateWorld(String name, File templateFolder) {
+        return this.server.loadTemplateWorld(new WorldCreator(name), templateFolder);
+    }
+
+    @Override
+    public World loadTemplateWorld(WorldCreator creator, File templateFolder) {
+        return this.server.loadTemplateWorld(creator, templateFolder);
+    }
+
+    @Override
+    public boolean isTemplateWorld(World world) {
+        return world instanceof CraftWorld && ((CraftWorld) world).getHandle().getDataManager() instanceof AthenaTemplateDataManager;
+    }
+
+    @Override
+    public CompletableFuture<Boolean> teleportAsync(final Entity entity, Location location) {
+        Validate.notNull(entity, "Entity may not be null");
+        Validate.notNull(location, "Location may not be null");
+        Validate.notNull(location.getWorld(), "Location has no world");
+
+        final Location to = location.clone();
+        final CompletableFuture<Boolean> future = new CompletableFuture<Boolean>();
+
+        // the callback runs on the server thread, straight away if the chunk is loaded already
+        to.getWorld().getChunkAtAsync(to.getBlockX() >> 4, to.getBlockZ() >> 4, chunk -> {
+            try {
+                boolean present = entity instanceof Player ? ((Player) entity).isOnline() : entity.isValid();
+
+                future.complete(present && entity.teleport(to, PlayerTeleportEvent.TeleportCause.PLUGIN));
+            } catch (Throwable throwable) {
+                future.completeExceptionally(throwable);
+            }
+        });
+        return future;
+    }
+
+    @Override
+    public CompletableFuture<Integer> teleportGradually(Collection<? extends Player> players, final Function<? super Player, ? extends Location> destination, int perTick) {
+        Validate.notNull(players, "Players may not be null");
+        Validate.notNull(destination, "Destination may not be null");
+        checkPerTick(perTick);
+        return AthenaTeleportQueue.INSTANCE.teleportGradually(players, (index, player) -> destination.apply(player), perTick);
+    }
+
+    @Override
+    public CompletableFuture<Integer> teleportGradually(List<? extends Player> players, List<? extends Location> destinations, int perTick) {
+        Validate.notNull(players, "Players may not be null");
+        Validate.notNull(destinations, "Destinations may not be null");
+        checkPerTick(perTick);
+        if (players.size() != destinations.size()) {
+            throw new IllegalArgumentException("There are " + players.size() + " players but " + destinations.size() + " destinations");
+        }
+
+        // copied now: player i goes to destination i as the lists are at this call
+        final List<Location> to = new ArrayList<Location>(destinations.size());
+
+        for (Location location : destinations) {
+            to.add(location == null ? null : location.clone());
+        }
+        return AthenaTeleportQueue.INSTANCE.teleportGradually(players, (index, player) -> to.get(index), perTick);
+    }
+
+    private static void checkPerTick(int perTick) {
+        if (perTick < 1) {
+            throw new IllegalArgumentException("perTick must be at least 1, was " + perTick);
+        }
+    }
+}
