diff --git a/src/main/java/net/minecraft/server/PlayerConnectionUtils.java b/src/main/java/net/minecraft/server/PlayerConnectionUtils.java
index cb7b1aa82cc263089a6386b45fb115dd8433cf47..1396eb98a1aaad85bdadcc57ccb141e49400a9ce 100644
--- a/src/main/java/net/minecraft/server/PlayerConnectionUtils.java
+++ b/src/main/java/net/minecraft/server/PlayerConnectionUtils.java
@@ -13,4 +13,25 @@ public class PlayerConnectionUtils {
             throw CancelledPacketHandleException.INSTANCE;
         }
     }
+
+    // Athena start - the same hand-off, answered with a return value instead of an exception.
+    //
+    // Every play packet but chat arrives on a Netty thread and comes through here to be run again on
+    // the server thread; ensureMainThread then throws a shared exception that NetworkManager catches.
+    // A throw is an unwind through the compiled frames between here and the catch, looked up by the
+    // runtime frame by frame - with twenty players, some 400 of them a second, about 1% of the
+    // process's CPU. The handlers call this and return when it answers true. ensureMainThread stays
+    // for anything outside the server that calls it.
+    public static <T extends PacketListener> boolean postToMainThread(final Packet<T> packet, final T t0, IAsyncTaskHandler iasynctaskhandler) {
+        if (!iasynctaskhandler.isMainThread()) {
+            iasynctaskhandler.postToMainThread(new Runnable() {
+                public void run() {
+                    packet.processPacket(t0);
+                }
+            });
+            return true;
+        }
+        return false;
+    }
+    // Athena end
 }
