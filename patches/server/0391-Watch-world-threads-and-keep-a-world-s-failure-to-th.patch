     private final CraftScoreboard mainScoreboard;
     private final MinecraftServer server;
     private final Collection<CraftScoreboard> scoreboards = new WeakCollection<CraftScoreboard>();
+    /**
+     * Athena - held for the list of scoreboards and for the scores vanilla keeps by criteria (deaths,
+     * kills, health), which a world on its own thread updates for its players while others do for
+     * theirs. A plugin that changes one scoreboard from several threads must guard it itself.
