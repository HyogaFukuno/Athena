diff --git a/src/main/java/net/minecraft/server/WorldServer.java b/src/main/java/net/minecraft/server/WorldServer.java
index 0ccc618dcc7213ce877504825d18fd57229d2194..c8ef543c0b2a4ec6a79786a3b7a8a9622648e6c7 100644
--- a/src/main/java/net/minecraft/server/WorldServer.java
+++ b/src/main/java/net/minecraft/server/WorldServer.java
@@ -1496,6 +1496,8 @@ public class WorldServer extends World implements IAsyncTaskHandler {
     // Athena start - "the main thread" of a world is the thread that ticks it: its AthenaWorldThread
     // if it has one, else the server thread. Packets of players in the world, and tasks for it, run there.
     public volatile AthenaWorldThread athenaThread;
+    /** Set when this world's thread threw: the server thread owns the world but no longer ticks it. */
+    public volatile boolean athenaHalted;
     /** Set while some thread is inside this world's tick (MinecraftServer.athenaTickWorld). */
     volatile boolean athenaInTick;
 
@@ -1566,6 +1568,9 @@ public class WorldServer extends World implements IAsyncTaskHandler {
     public void athenaStartThread() {
         org.spigotmc.AsyncCatcher.catchOp("start a world thread");
         if (this.athenaThread != null) return;
+        if (this.athenaHalted) {
+            throw new IllegalStateException("World " + this.worldData.getName() + " stopped ticking after its thread threw; it cannot be given a thread again");
+        }
         if (this.athenaInTick) {
             // the server thread would go on ticking the rest of this tick while the new thread starts its own
             throw new IllegalStateException("Cannot start world " + this.worldData.getName() + "'s thread from inside its own tick; start it from a scheduler task or a command");
@@ -1582,6 +1587,40 @@ public class WorldServer extends World implements IAsyncTaskHandler {
         thread.start();
     }
 
+    /**
+     * After this world's thread threw (AthenaWorldThread.run): the server thread takes the world back,
+     * halted - it owns it but no longer ticks it - calls WorldThreadFailureEvent, and sends the players
+     * still in it afterwards to the main world's spawn. Server thread.
+     */
+    void athenaRecoverFailedThread(AthenaWorldThread thread) {
+        if (this.athenaThread != thread) return;
+        try {
+            thread.join(10000L); // it has left its loop; let it finish dying
+        } catch (InterruptedException e) {
+            Thread.currentThread().interrupt();
+        }
+        this.athenaHalted = true;
+        this.athenaThread = null;
+        thread.handBack();
+        AthenaChunkPreloader.INSTANCE.adoptAll(thread.preloader);
+        org.bukkit.craftbukkit.chunkio.ChunkIOExecutor.handBack(this);
+        org.bukkit.craftbukkit.chunkgen.ChunkGenExecutor.handBack(this);
+        try {
+            this.getServer().getPluginManager().callEvent(new athena.api.event.WorldThreadFailureEvent(this.getWorld(), thread.failure));
+        } catch (Throwable throwable) {
+            MinecraftServer.LOGGER.warn("A WorldThreadFailureEvent listener threw", throwable);
+        }
+        WorldServer main = this.server.worlds.get(0);
+        BlockPosition spawn = main.getSpawn();
+        for (Object human : this.players.toArray()) {
+            if (human instanceof EntityPlayer && ((EntityPlayer) human).playerConnection != null) {
+                ((EntityPlayer) human).getBukkitEntity().teleport(new org.bukkit.Location(main.getWorld(), spawn.getX() + 0.5D, spawn.getY(), spawn.getZ() + 0.5D),
+                        org.bukkit.event.player.PlayerTeleportEvent.TeleportCause.PLUGIN);
+            }
+        }
+        MinecraftServer.LOGGER.warn("World " + this.worldData.getName() + " is halted: it no longer ticks; its players were sent to " + main.getWorldData().getName());
+    }
+
     /**
      * Hands this world's ticking back to the server thread: waits for its thread to finish the
      * current tick. Call on the server thread.
