diff --git a/src/main/java/net/minecraft/server/AthenaWorldThread.java b/src/main/java/net/minecraft/server/AthenaWorldThread.java
index 07bc81a496afd7b74f26ecda309e99759641471b..c6d2fce018c5264ddfcbec5781d1e7a1cc488e09 100644
--- a/src/main/java/net/minecraft/server/AthenaWorldThread.java
+++ b/src/main/java/net/minecraft/server/AthenaWorldThread.java
@@ -14,12 +14,9 @@ import org.apache.logging.log4j.Logger;
  * (WorldServer.postToMainThread, Athena.runOnWorld). While it runs, only this thread may touch
  * the world: AsyncCatcher.catchOp(reason, world) and WorldServer.isMainThread answer for it. A
  * stall here (a slow plugin, a long chunk load) holds up this world alone; the server thread and
- * the other worlds keep their 20 ticks a second. A throwable out of the tick stops this world's
- * thread (the world then stops ticking) instead of the server.
- *
- * Players may not be in such a world yet: their packets and connection ticks still run on the
- * server thread. Athena.setWorldThreaded refuses a world with players, and teleports into it are
- * refused.
+ * the other worlds keep their 20 ticks a second, and the watchdog below reports the stall. A
+ * throwable out of the tick stops this world's thread instead of the server: the server thread takes
+ * the world back, halted (WorldServer.athenaRecoverFailedThread).
  */
 public final class AthenaWorldThread extends Thread {
 
@@ -39,6 +36,12 @@ public final class AthenaWorldThread extends Thread {
     volatile long ticks;
     /** Set when a tick threw: the thread stopped and the world no longer ticks. */
     volatile Throwable failure;
+    /** Set by the watchdog while it has reported this thread stalled. */
+    volatile boolean stallReported;
+    private volatile long lastStallMillis;
+
+    /** For tests only (set by reflection): the name of a world whose next tick throws. */
+    static volatile String crashForTest;
 
     AthenaWorldThread(WorldServer world) {
         super("World thread - " + world.getWorldData().getName());
@@ -55,6 +58,9 @@ public final class AthenaWorldThread extends Thread {
     static void beforeFirstStart() {
         if (started) return;
         started = true;
+        Thread watchdog = new Thread(AthenaWorldThread::watch, "Athena world watchdog");
+        watchdog.setDaemon(true);
+        watchdog.start();
         if (co.aikar.timings.Timings.isTimingsEnabled()) {
             // what the server does when it stops: Timings.setTimingsEnabled only resets the data on the
             // next tick, while this turns every timer off at once
@@ -66,6 +72,61 @@ public final class AthenaWorldThread extends Thread {
     /** Set once the thread has stopped and its leftover tasks went to the server thread. */
     private volatile boolean handedBack;
 
+    // ---- the watchdog ----
+
+    /** How long a world thread may go without finishing a tick before it is reported; athena.yml. */
+    private static volatile long stallMillis = 10_000L;
+
+    public static void setStallMillis(long millis) {
+        stallMillis = Math.max(1000L, millis);
+    }
+
+    /**
+     * Once a second: a world thread that has not finished a tick for stallMillis is reported once,
+     * with its stack, and WorldThreadStallEvent is called; once it ticks again that is reported too.
+     * Spigot's watchdog, which stops the server, watches the server thread only.
+     */
+    private static void watch() {
+        while (true) {
+            try {
+                Thread.sleep(1000L);
+                MinecraftServer server = MinecraftServer.getServer();
+                if (server == null) continue;
+                for (WorldServer world : server.worlds) {
+                    AthenaWorldThread thread = world.athenaThread;
+                    if (thread == null || !thread.isAlive() || thread.failed()) continue;
+                    long since = thread.millisSinceTick();
+                    if (!thread.stallReported && since >= stallMillis) {
+                        thread.stallReported = true;
+                        StringBuilder stack = new StringBuilder();
+                        for (StackTraceElement element : thread.getStackTrace()) {
+                            stack.append("\n\tat ").append(element);
+                        }
+                        LOGGER.error("World " + world.getWorldData().getName() + " has not finished a tick for " + since + " ms; the server and the other worlds go on. Its thread is at:" + stack);
+                        thread.callStall(since, false);
+                    } else if (thread.stallReported && since < 1000L) {
+                        thread.stallReported = false;
+                        LOGGER.warn("World " + world.getWorldData().getName() + " is ticking again after " + thread.lastStallMillis + " ms");
+                        thread.callStall(thread.lastStallMillis, true);
+                    }
+                    thread.lastStallMillis = thread.stallReported ? Math.max(thread.lastStallMillis, since) : 0L;
+                }
+            } catch (InterruptedException interrupted) {
+                return;
+            } catch (Throwable throwable) {
+                LOGGER.warn("The world watchdog failed a round", throwable);
+            }
+        }
+    }
+
+    private void callStall(long millis, boolean recovered) {
+        try {
+            org.bukkit.Bukkit.getPluginManager().callEvent(new athena.api.event.WorldThreadStallEvent(this.world.getWorld(), millis, recovered));
+        } catch (Throwable throwable) {
+            LOGGER.warn("A WorldThreadStallEvent listener threw", throwable);
+        }
+    }
+
     /** Queues {@code task} to run on this thread before its next tick. */
     void post(Runnable task) {
         this.tasks.add(task);
@@ -101,6 +162,11 @@ public final class AthenaWorldThread extends Thread {
                 next += TICK_NANOS;
 
                 this.runTasks();
+                String crash = crashForTest;
+                if (crash != null && crash.equals(this.world.getWorldData().getName())) {
+                    crashForTest = null;
+                    throw new IllegalStateException("A tick of " + crash + " that a test made fail");
+                }
                 ++this.world.athenaCurrentTick;
                 // the server thread's tick, for one world: chunk loads that finished, time updates, the
                 // world, then the connections of the players in it; their packets are batched the same way
@@ -123,6 +189,9 @@ public final class AthenaWorldThread extends Thread {
             this.failure = throwable;
             this.running = false;
             LOGGER.error("World " + this.world.getWorldData().getName() + " stopped ticking: its thread threw", throwable);
+            // the server thread takes the world back; until then nothing ticks it
+            final AthenaWorldThread self = this;
+            MinecraftServer.getServer().processQueue.add(() -> self.world.athenaRecoverFailedThread(self));
         }
     }
 
