diff --git a/src/main/java/net/minecraft/server/CollisionBoxSink.java b/src/main/java/net/minecraft/server/CollisionBoxSink.java
new file mode 100644
index 0000000000000000000000000000000000000000..27c4a6b1c30518083e0f00609b83f04ac56fc27b
--- /dev/null
+++ b/src/main/java/net/minecraft/server/CollisionBoxSink.java
@@ -0,0 +1,79 @@
+package net.minecraft.server;
+
+// Athena - collects collision boxes as six raw doubles each, so gathering them allocates nothing.
+//
+// The old path returned a List<AxisAlignedBB>, which meant one 64-byte box object per scanned solid
+// block plus the list itself, every time an entity moved. Boxes were produced inside
+// Block.getCollisionBoundingBox - a megamorphic call - so neither C2 nor Graal could scalar-replace
+// them; measurements showed the cost scaling linearly with the number of blocks scanned.
+//
+// Instances are meant to be reused. Callers take a mark(), fill the sink, read the boxes back, and
+// reset(mark) when done, which makes nested use (Entity.move's step-up trial runs while the main
+// pass's boxes are still live) safe without allocating a second buffer.
+public final class CollisionBoxSink {
+
+    private static final int STRIDE = 6;
+
+    private double[] data = new double[STRIDE * 16];
+    private int size;
+
+    /** Scratch space for a single box, reused so per-block queries need no array of their own. */
+    private final double[] scratch = new double[STRIDE];
+
+    public double[] scratch() {
+        return this.scratch;
+    }
+
+    /** Index to reset() back to once the boxes added after it are no longer needed. */
+    public int mark() {
+        return this.size;
+    }
+
+    public void reset(int mark) {
+        this.size = mark;
+    }
+
+    public void clear() {
+        this.size = 0;
+    }
+
+    /** Exclusive end index, in doubles. Iterate a region as `for (int i = mark; i < end; i += 6)`. */
+    public int end() {
+        return this.size;
+    }
+
+    public boolean isEmpty(int mark) {
+        return this.size == mark;
+    }
+
+    public void add(double minX, double minY, double minZ, double maxX, double maxY, double maxZ) {
+        if (this.size + STRIDE > this.data.length) {
+            double[] bigger = new double[this.data.length << 1];
+            System.arraycopy(this.data, 0, bigger, 0, this.size);
+            this.data = bigger;
+        }
+
+        double[] d = this.data;
+        int i = this.size;
+
+        d[i] = minX;
+        d[i + 1] = minY;
+        d[i + 2] = minZ;
+        d[i + 3] = maxX;
+        d[i + 4] = maxY;
+        d[i + 5] = maxZ;
+        this.size = i + STRIDE;
+    }
+
+    /** Adds the box only if it overlaps the query box, mirroring the old intersectsWith filter. */
+    public void addIfIntersects(double minX, double minY, double minZ, double maxX, double maxY, double maxZ,
+                                double qMinX, double qMinY, double qMinZ, double qMaxX, double qMaxY, double qMaxZ) {
+        if (maxX > qMinX && minX < qMaxX && maxY > qMinY && minY < qMaxY && maxZ > qMinZ && minZ < qMaxZ) {
+            this.add(minX, minY, minZ, maxX, maxY, maxZ);
+        }
+    }
+
+    public double get(int index) {
+        return this.data[index];
+    }
+}
