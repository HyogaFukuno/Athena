From: glacier <hyouga.dev@gmail.com>
Date: Thu, 27 Aug 2026 10:28:04 +0900
Subject: [PATCH] Answer the per-chunk tracker update from the chunk's entity
 slices


diff --git a/src/main/java/net/minecraft/server/EntityTracker.java b/src/main/java/net/minecraft/server/EntityTracker.java
index 5668ab81e5b42cac6d7b46e2b08250ed84f19b46..fda10a5336ca8fbf71191db83aca68110788508b 100644
--- a/src/main/java/net/minecraft/server/EntityTracker.java
+++ b/src/main/java/net/minecraft/server/EntityTracker.java
@@ -4,6 +4,7 @@ import com.google.common.collect.Lists;
 import com.google.common.collect.Sets;
 import java.util.ArrayList;
 import java.util.Iterator;
+import java.util.List;
 import java.util.Set;
 import java.util.concurrent.Callable;
 import org.apache.logging.log4j.LogManager;
@@ -240,16 +241,44 @@ public class EntityTracker {
 
     }
 
+    // Athena start - answer this from the chunk's own entity slices.
+    //
+    // This runs once per chunk handed to a player - up to spigotConfig.maxBulkChunk per player per
+    // tick for as long as anyone is walking - and it used to walk every EntityTrackerEntry in the
+    // world to find the handful whose tracker sits in that chunk. On a populated world that is
+    // (entities in the world) x (chunks sent) x (players moving) comparisons per tick for a result
+    // that only ever names entities of one chunk.
+    //
+    // The chunk already indexes its entities by section, and trackedEntities maps an entity id to
+    // its entry, so the scan is now bounded by the entities actually in the chunk. Chunk.addEntity
+    // is what sets chunkCoordX/Z, so being in a slice and matching those fields are the same thing.
+    //
+    // The one case the old loop reached that this does not is an entity that has left the chunk
+    // while its chunkCoordX/Z still point here - Chunk.removeEntityAtIndex leaves those fields
+    // alone, so an entity that moved into an unloaded chunk keeps stale ones. It is in no loaded
+    // chunk at that moment, and updatePlayers() re-evaluates it for this player as soon as either
+    // of them moves four blocks, so no client can tell that this path skipped it.
     public void a(EntityPlayer entityplayer, Chunk chunk) {
-        Iterator iterator = this.c.iterator();
+        List<Entity>[] slices = chunk.entitySlices;
 
-        while (iterator.hasNext()) {
-            EntityTrackerEntry entitytrackerentry = (EntityTrackerEntry) iterator.next();
+        for (int i = 0; i < slices.length; ++i) {
+            List<Entity> slice = slices[i];
 
-            if (entitytrackerentry.tracker != entityplayer && entitytrackerentry.tracker.chunkCoordX == chunk.locX && entitytrackerentry.tracker.chunkCoordZ == chunk.locZ) {
-                entitytrackerentry.updatePlayer(entityplayer);
+            for (int j = 0; j < slice.size(); ++j) {
+                Entity entity = slice.get(j);
+
+                if (entity == entityplayer) {
+                    continue;
+                }
+
+                EntityTrackerEntry entitytrackerentry = (EntityTrackerEntry) this.trackedEntities.get(entity.getId());
+
+                if (entitytrackerentry != null) {
+                    entitytrackerentry.updatePlayer(entityplayer);
+                }
             }
         }
 
     }
+    // Athena end
 }
