+            List list = world.getEntitiesInAABBexcluding((Entity) null, d0 - 0.5D, d1 - 0.5D, d2 - 0.5D, d0 + 0.5D, d1 + 0.5D, d2 + 0.5D, IEntitySelector.selectInventories); // Athena - scalar overload
 
             if (list.size() > 0) {
