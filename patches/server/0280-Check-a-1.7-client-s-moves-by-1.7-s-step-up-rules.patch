+++ b/src/main/java/net/minecraft/server/PlayerConnection.java
@@ -99,12 +99,15 @@ public class PlayerConnection implements PacketListenerPlayIn, IUpdatePlayerList
     private boolean checkMovement = true;
     private boolean processedDisconnect; // CraftBukkit - added
 
+    private final boolean legacy17; // Athena - a 1.7.10 client, translated by AthenaLegacy17
+
     public PlayerConnection(MinecraftServer minecraftserver, NetworkManager networkmanager, EntityPlayer entityplayer) {
         this.minecraftServer = minecraftserver;
         this.networkManager = networkmanager;
         networkmanager.setNetHandler((PacketListener) this);
         this.player = entityplayer;
         entityplayer.playerConnection = this;
+        this.legacy17 = AthenaLegacy17.isLegacy(networkmanager); // Athena
 
         // CraftBukkit start - add fields and methods
         this.server = minecraftserver.server;
@@ -291,9 +294,11 @@ public class PlayerConnection implements PacketListenerPlayIn, IUpdatePlayerList
                         if (event.isCancelled()) {
                             // PandaSpigot start - Smooth teleportation
                             if (this.player.world.pandaSpigotConfig.smoothTeleportation) {
+                                this.player.athenaLegacy17YSize = 0.0F; // Athena - a 1.7 client zeroes ySize on a position
                                 this.player.playerConnection.sendPacket(new PacketPlayOutPosition(from.getX(), from.getY(), from.getZ(), 0, 0, TELEPORT_NO_ROT));
                             } else {
                             // PandaSpigot end
+                            this.player.athenaLegacy17YSize = 0.0F; // Athena - a 1.7 client zeroes ySize on a position
                             this.player.playerConnection.sendPacket(new PacketPlayOutPosition(from.getX(), from.getY(), from.getZ(), from.getYaw(), from.getPitch(), Collections.<PacketPlayOutPosition.EnumPlayerTeleportFlags>emptySet()));
                             } // PandaSpigot - closing bracket
                             return;
@@ -429,6 +434,17 @@ public class PlayerConnection implements PacketListenerPlayIn, IUpdatePlayerList
                         this.player.jump();
                     }
 
+                    // Athena start - a 1.7 client's move is checked by 1.7's step-up rules; see Entity.athenaLegacy17Move
+                    if (this.legacy17) {
+                        this.player.athenaLegacy17YSize *= 0.4F; // what each 1.7 move starts with
+                        this.player.athenaLegacy17Move = true;
+                        try {
+                            this.player.move(d11, d12, d13);
+                        } finally {
+                            this.player.athenaLegacy17Move = false;
+                        }
+                    } else
+                    // Athena end
                     this.player.move(d11, d12, d13);
                     this.player.onGround = packetplayinflying.isOnGround();
                     double d16 = d12;
@@ -601,6 +617,7 @@ public class PlayerConnection implements PacketListenerPlayIn, IUpdatePlayerList
         // CraftBukkit end
 
         this.player.setLocation(this.o, this.p, this.q, f2, f3);
+        this.player.athenaLegacy17YSize = 0.0F; // Athena - a 1.7 client zeroes ySize on a position
         this.player.playerConnection.sendPacket(new PacketPlayOutPosition(d0, d1, d2, f, f1, set));
     }
 
