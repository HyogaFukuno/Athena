From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: glacier <hyouga.dev@gmail.com>
Date: Thu, 24 Sep 2026 00:27:49 +0900
Subject: [PATCH] Stop tracing a line of sight nobody reads for every attack

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/src/main/java/net/minecraft/server/PlayerConnection.java b/src/main/java/net/minecraft/server/PlayerConnection.java
index 71c5a49e233ed7af2b7cb1042e35dd55666d8b6c..38061dfd3ad5e85542f629544d2778616f169934 100644
--- a/src/main/java/net/minecraft/server/PlayerConnection.java
+++ b/src/main/java/net/minecraft/server/PlayerConnection.java
@@ -1374,12 +1374,17 @@ public class PlayerConnection implements PacketListenerPlayIn, IUpdatePlayerList
 
         this.player.resetIdleTimer();
         if (entity != null) {
-            boolean flag = this.player.hasLineOfSight(entity);
+            // Athena start - no line of sight check.
+            //
+            // This traced a ray from the attacker's eyes to the target's for every use-entity
+            // packet, only to shrink the reach to 3 blocks when the ray was blocked - and
+            // PandaSpigot's fix for GH-244 (hit registration) switched that use off with
+            // "if (false && !flag)". The ray was still traced and its answer thrown away: up to 200
+            // block steps and a chunk lookup each, once per swing per player. rayTrace has no side
+            // effect anyone can see, so dropping the call changes nothing but the cost. The reach
+            // is the 6 blocks the fix settled on.
             double d0 = 36.0D;
-
-            if (false && !flag) { // PandaSpigot - Fix GH-244: Hit Registration Bug
-                d0 = 9.0D;
-            }
+            // Athena end
 
             if (this.player.getDistanceSqToEntity(entity) < d0) {
                 ItemStack itemInHand = this.player.inventory.getItemInHand(); // CraftBukkit
