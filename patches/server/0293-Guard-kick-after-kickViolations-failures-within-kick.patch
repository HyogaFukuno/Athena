From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: glacier <hyouga.dev@gmail.com>
Date: Wed, 14 Oct 2026 00:06:44 +0900
Subject: [PATCH] Guard: kick after kickViolations failures within
 kickWindowSeconds

Every check that fails still sets the move back or drops the hit; the kick
now waits until a player has failed kickViolations (default 5) checks within
kickWindowSeconds (default 30). A cheat fails over and over and is gone in
seconds; an honest player who meets a rare false positive is set back once
and plays on. A check that fails on every packet - a timer running ahead, a
client fighting a setback - counts at most once a second. The log line says
how many of the allowed failures have been used.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/src/main/java/com/hpfxd/pandaspigot/config/PandaSpigotConfig.java b/src/main/java/com/hpfxd/pandaspigot/config/PandaSpigotConfig.java
index fdb2a7d2691004e97e0d252a126cbff01e321b22..c9d78e8a433c081c54f1b51d4450bfccbfaebbdf 100644
--- a/src/main/java/com/hpfxd/pandaspigot/config/PandaSpigotConfig.java
+++ b/src/main/java/com/hpfxd/pandaspigot/config/PandaSpigotConfig.java
@@ -67,7 +67,7 @@ public class PandaSpigotConfig {
             // Athena - publish the audit gate as a plain static; see AthenaIndexAudit.enabled()
             net.minecraft.server.AthenaIndexAudit.setEnabled(config.debugVerifyAthenaIndexes);
             // Athena - and the guard's switches
-            net.minecraft.server.AthenaGuard.configure(config.guard.enabled, config.guard.enforce, config.guard.movement, config.guard.timer, config.guard.combat, config.guard.maxReach, config.guard.log, config.guard.kick, config.guard.kickMessage);
+            net.minecraft.server.AthenaGuard.configure(config.guard.enabled, config.guard.enforce, config.guard.movement, config.guard.timer, config.guard.combat, config.guard.maxReach, config.guard.log, config.guard.kick, config.guard.kickMessage, config.guard.kickViolations, config.guard.kickWindowSeconds);
             
             // call after save
             initWorlds(worldsNode);
@@ -169,9 +169,12 @@ public class PandaSpigotConfig {
         public boolean combat = true;
         @Comment("Vanilla is 3.0, measured from the eye to the nearest point of the target's box")
         public double maxReach = 3.0D;
-        @Comment("When enforcing, also kick the player the first time a check fails (the move is still set\n" +
-            "back and the hit still dropped). Two hits in one tick never kick: fast clicking does that")
+        @Comment("When enforcing, also kick a player whose checks fail kickViolations times within\n" +
+            "kickWindowSeconds (each failed move is still set back, each failed hit still dropped). Two hits\n" +
+            "in one tick never count: fast clicking does that")
         public boolean kick = true;
+        public int kickViolations = 5;
+        public int kickWindowSeconds = 30;
         public String kickMessage = "不正な動作を検出したため切断しました";
         @Comment("Log what is blocked (or would be, when not enforcing), at most once per check per\n" +
             "player every two seconds")
diff --git a/src/main/java/net/minecraft/server/AthenaGuard.java b/src/main/java/net/minecraft/server/AthenaGuard.java
index ff4fc068a13ea7718cba63867bd8df1e9b8f98eb..a487c6faaec83f8b08302b3790f22eb59ee2f7da 100644
--- a/src/main/java/net/minecraft/server/AthenaGuard.java
+++ b/src/main/java/net/minecraft/server/AthenaGuard.java
@@ -32,6 +32,8 @@ public final class AthenaGuard {
     static volatile boolean log = true;
     static volatile boolean kick = true;
     static volatile String kickMessage = "不正な動作を検出したため切断しました";
+    static volatile int kickViolations = 5;
+    static volatile int kickWindowTicks = 600;
 
     // ------------------------------------------------------------------ constants (1.8 client physics)
     private static final double GRAVITY = 0.08D;
@@ -97,6 +99,11 @@ public final class AthenaGuard {
 
     // a check failed while enforcing with kick on: PlayerConnection disconnects once the packet is dropped
     private boolean kickPending;
+    private final int[] violationTicks = new int[64]; // when the last checks failed, newest at violationHead - 1
+    private int violationHead;
+    // one failure in an episode is one violation: a check that fails on every packet (a timer running
+    // ahead, a setback the client keeps fighting) counts at most once a second
+    private final int[] lastCounted = new int[8];
 
     // logging, at most one line per check per player every few seconds
     private final long[] lastLog = new long[8];
@@ -110,9 +117,11 @@ public final class AthenaGuard {
         this.legacy17 = legacy17;
     }
 
-    public static void configure(boolean enabled, boolean enforce, boolean movement, boolean timer, boolean combat, double maxReach, boolean log, boolean kick, String kickMessage) {
+    public static void configure(boolean enabled, boolean enforce, boolean movement, boolean timer, boolean combat, double maxReach, boolean log, boolean kick, String kickMessage, int kickViolations, int kickWindowSeconds) {
         AthenaGuard.kick = kick;
         AthenaGuard.kickMessage = kickMessage;
+        AthenaGuard.kickViolations = Math.max(1, Math.min(kickViolations, 64));
+        AthenaGuard.kickWindowTicks = Math.max(1, kickWindowSeconds) * 20;
         AthenaGuard.log = log;
         AthenaGuard.enabled = enabled;
         AthenaGuard.enforce = enforce;
@@ -854,7 +863,26 @@ public final class AthenaGuard {
 
     private void flag(int check, String name, String format, Object... args) {
         long now = System.currentTimeMillis();
-        boolean kicking = enforce && kick && !this.kickPending;
+        int recent = 0;
+
+        int tick = MinecraftServer.currentTick;
+
+        if (enforce && kick && !this.kickPending && (this.lastCounted[check] == 0 || tick - this.lastCounted[check] >= 20)) {
+            // the failure kickViolations - 1 back must be inside the window: then this one makes kickViolations
+            this.lastCounted[check] = tick;
+            this.violationTicks[this.violationHead] = tick;
+            this.violationHead = (this.violationHead + 1) % this.violationTicks.length;
+        }
+        if (enforce && kick && !this.kickPending) {
+            for (int i = 1; i <= kickViolations; ++i) {
+                int t = this.violationTicks[(this.violationHead - i + this.violationTicks.length) % this.violationTicks.length];
+                if (t == 0 && i > 1 || tick - t >= kickWindowTicks) {
+                    break;
+                }
+                recent = i;
+            }
+        }
+        boolean kicking = recent >= kickViolations;
 
         if (kicking) {
             this.kickPending = true;
@@ -862,7 +890,8 @@ public final class AthenaGuard {
         if (log && (kicking || now - this.lastLog[check] >= 2000L)) {
             this.lastLog[check] = now;
             String detail = String.format(java.util.Locale.ROOT, format, args) + (check == 1 || check == 2 ? this.context() : "");
-            LOGGER.info("{} {} [{}]: {}", this.player != null ? this.player.getName() : "-", name, kicking ? "kicked" : enforce ? "blocked" : "detected", detail);
+            String verdict = kicking ? "kicked" : enforce ? (kick ? "blocked " + recent + "/" + kickViolations : "blocked") : "detected";
+            LOGGER.info("{} {} [{}]: {}", this.player != null ? this.player.getName() : "-", name, verdict, detail);
         }
     }
 }
