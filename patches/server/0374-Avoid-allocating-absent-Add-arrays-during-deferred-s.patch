From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: glacier <hyouga.dev@gmail.com>
Date: Fri, 30 Oct 2026 13:21:00 +0900
Subject: [PATCH] Avoid allocating absent Add arrays during deferred section
 packing


diff --git a/src/main/java/net/minecraft/server/AthenaDeferredSectionData.java b/src/main/java/net/minecraft/server/AthenaDeferredSectionData.java
index 049266f73e1fb211a1eb2045871975c706a64c37..9561c52e992dc15c28d92c262420db509b43b062 100644
--- a/src/main/java/net/minecraft/server/AthenaDeferredSectionData.java
+++ b/src/main/java/net/minecraft/server/AthenaDeferredSectionData.java
@@ -80,7 +80,8 @@ final class AthenaDeferredSectionData {
         NibbleArray add = ChunkRegionLoader.packSectionIds(this.ids, blocks, data);
 
         this.data = data.getData();
-        this.add = add == null ? new byte[this.data.length] : add.getData();
+        // Athena - absent high ID bits have no Add tag, so no zero-filled backing array is needed.
+        this.add = add == null ? null : add.getData();
         this.ids = null; // Athena - the packed arrays now own all data needed by these tags
         this.blocks = blocks; // published last: it is what pack() tests to decide it has run
     }
diff --git a/src/test/java/net/minecraft/server/AthenaDeferredAddTagTest.java b/src/test/java/net/minecraft/server/AthenaDeferredAddTagTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..7c813e807edc354572eecd6317a90ed62de837a0
--- /dev/null
+++ b/src/test/java/net/minecraft/server/AthenaDeferredAddTagTest.java
@@ -0,0 +1,123 @@
+package net.minecraft.server;
+
+import static org.junit.Assert.assertArrayEquals;
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertNull;
+
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.DataInputStream;
+import java.io.DataOutputStream;
+import java.lang.foreign.MemorySegment;
+import java.lang.reflect.Field;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.List;
+import org.bukkit.support.AbstractTestingBase;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.junit.runners.Parameterized;
+
+/**
+ * Athena - deferred saves omit unused Add storage while preserving extended block IDs and NBT bytes.
+ */
+@RunWith(Parameterized.class)
+public class AthenaDeferredAddTagTest extends AbstractTestingBase {
+
+    @Parameterized.Parameters(name = "storage={0},extendedIds={1}")
+    public static Collection<Object[]> cases() {
+        List<Object[]> cases = new ArrayList<>();
+
+        for (String storage : new String[] {"plain", "uniform", "packed", "mapped"}) {
+            for (boolean extended : new boolean[] {false, true}) {
+                cases.add(new Object[] {storage, extended});
+            }
+        }
+        return cases;
+    }
+
+    private final String storage;
+    private final boolean extended;
+
+    public AthenaDeferredAddTagTest(String storage, boolean extended) {
+        this.storage = storage;
+        this.extended = extended;
+    }
+
+    @Test
+    public void onlyRequiredAddStorageIsAllocatedAndSerialized() throws Exception {
+        char[] ids = new char[4096];
+
+        for (int i = 0; i < ids.length; ++i) {
+            ids[i] = (char) (storage.equals("uniform") || i % 2 == 0 ? (extended ? 0x1234 : 0x0FFF) : 16);
+        }
+
+        ChunkSection section = new ChunkSection(0, true);
+
+        if (storage.equals("mapped")) {
+            byte[] mapped = new byte[8192];
+
+            ByteBuffer.wrap(mapped).order(ByteOrder.LITTLE_ENDIAN).asCharBuffer().put(ids);
+            section.athenaMapRawIds(MemorySegment.ofArray(mapped), 0);
+        } else if (storage.equals("plain")) {
+            section.setData(ids.clone());
+        } else {
+            section.setDataSharingUniform(ids.clone());
+        }
+
+        NBTTagCompound actual = new NBTTagCompound();
+
+        AthenaDeferredSectionData.attach(actual, section);
+
+        byte[] blocks = new byte[4096];
+        NibbleArray data = new NibbleArray();
+        NibbleArray add = ChunkRegionLoader.packSectionIds(ids, blocks, data);
+        NBTTagCompound expected = new NBTTagCompound();
+
+        expected.setByteArray("Blocks", blocks);
+        expected.setByteArray("Data", data.getData());
+        if (add != null) {
+            expected.setByteArray("Add", add.getData());
+        }
+
+        byte[] serialized = serialize(actual);
+
+        assertArrayEquals(serialize(expected), serialized);
+
+        NBTTagCompound restored = NBTCompressedStreamTools.read(new DataInputStream(new ByteArrayInputStream(serialized)));
+
+        assertEquals(expected, restored);
+        assertEquals(extended, actual.hasKey("Add"));
+        assertArrayEquals(blocks, actual.getByteArray("Blocks"));
+        assertArrayEquals(data.getData(), actual.getByteArray("Data"));
+
+        Field ownerField = actual.get("Blocks").getClass().getDeclaredField("owner");
+
+        ownerField.setAccessible(true);
+
+        Field addField = AthenaDeferredSectionData.class.getDeclaredField("add");
+
+        addField.setAccessible(true);
+
+        Object allocated = addField.get(ownerField.get(actual.get("Blocks")));
+
+        if (extended) {
+            assertNotNull(allocated);
+            assertArrayEquals(add.getData(), (byte[]) allocated);
+        } else {
+            assertNull("no Add tag must mean no retained Add array", allocated);
+        }
+    }
+
+    private static byte[] serialize(NBTTagCompound compound) throws Exception {
+        ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+
+        try (DataOutputStream stream = new DataOutputStream(bytes)) {
+            NBTCompressedStreamTools.write(compound, (java.io.DataOutput) stream);
+        }
+        return bytes.toByteArray();
+    }
+}
