+    /** A request to take one world off this thread; see leave. */
+    private static final class Leave {
+        final WorldServer world;
+        final java.util.concurrent.CountDownLatch done = new java.util.concurrent.CountDownLatch(1);
+        /** leave gave up waiting; guarded by this. */
+        boolean abandoned;
+
+        Leave(WorldServer world) {
+            this.world = world;
+        }
+    }
+
+    /**
+     * Takes {@code world} off this thread, which goes on ticking its other worlds: at the end of the
+     * tick in progress, this thread sets the world's athenaThread to null, and from then on the server
+     * thread owns it and tasks still queued here for it are passed on there. Waits for that. Server
+     * thread.
+     *
+     * @return whether it happened within {@code timeoutMillis}; if not, the request stands and this
+     *         thread hands the world over once its tick ends (WorldServer.athenaAfterLeave)
+     */
+    boolean leave(WorldServer world, long timeoutMillis) {
+        Leave leave = new Leave(world);
+        this.leaving.add(leave);
+        java.util.concurrent.locks.LockSupport.unpark(this);
+        boolean done = false;
+        try {
+            done = leave.done.await(timeoutMillis, TimeUnit.MILLISECONDS);
+        } catch (InterruptedException e) {
+            Thread.currentThread().interrupt();
+        }
+        if (done) return true;
+        synchronized (leave) {
+            if (leave.done.getCount() == 0L) return true;
+            leave.abandoned = true;
+            return false;
+        }
+    }
+
+    /** At the top of the loop: lets go of the worlds the server thread asked for. */
+    private void runLeaves() {
+        Leave leave;
+        while ((leave = this.leaving.poll()) != null) {
+            final WorldServer world = leave.world;
+            this.worlds.remove(world);
+            if (world.athenaThread == this) world.athenaThread = null; // the server thread's from here
+            boolean abandoned;
+            synchronized (leave) {
+                leave.done.countDown();
+                abandoned = leave.abandoned;
+            }
+            if (abandoned) {
+                LOGGER.warn("World " + world.getWorldData().getName() + " left its thread late; the server thread ticks it again");
+                MinecraftServer.getServer().processQueue.add(world::athenaAfterLeave);
+            }
+        }
+        if (this.worlds.isEmpty()) {
+            this.running = false; // nothing left to tick
         }
     }
 
