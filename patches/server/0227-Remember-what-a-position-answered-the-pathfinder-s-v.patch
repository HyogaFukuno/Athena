@@ -348,6 +350,20 @@ public final class AthenaIndexAudit {
         }
     }
 
+    /**
+     * Checks a hit in PathfinderNormal's vertical offset memo against a fresh scan of the same
+     * position. Unlike the structures above this one is not rebuilt from anything - it caches a
+     * pure function, and what can go wrong is the invalidation: a stale entry surviving into a
+     * search with a different mob, a different block access, or different flags.
+     */
+    public static void auditVerticalOffset(int x, int y, int z, int cached, int fresh) {
+        ++offsetChecks;
+        if (cached != fresh) {
+            report("vertical offset memo says " + cached + " for " + x + "," + y + "," + z
+                    + " but a fresh scan says " + fresh);
+        }
+    }
+
     // ------------------------------------------------------------------
 
     private static void report(String message) {
@@ -372,10 +388,11 @@ public final class AthenaIndexAudit {
         }
 
         lastSummaryTick = currentTick;
-        LOGGER.info("checks: census={} ({} non-empty), entityBuckets={} ({} indexed, {} entities), sectionLiquids={} ({} non-empty) | mismatches={}",
+        LOGGER.info("checks: census={} ({} non-empty), entityBuckets={} ({} indexed, {} entities), sectionLiquids={} ({} non-empty), verticalOffset={} | mismatches={}",
