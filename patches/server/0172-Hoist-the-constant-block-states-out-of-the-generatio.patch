+        // per column, so 65536 times per chunk.
+        IBlockData bedrock = Blocks.BEDROCK.getBlockData();
+        IBlockData stone = Blocks.STONE.getBlockData();
+        boolean flatBedrock = world.paperSpigotConfig.generateFlatBedrock; // PaperSpigot
 
         for (int l1 = 255; l1 >= 0; --l1) {
-            if (l1 <= (world.paperSpigotConfig.generateFlatBedrock ? 0 : random.nextInt(5))) { // PaperSpigot - Configurable flat bedrock
-                chunksnapshot.setBlockState(k1, l1, j1, Blocks.BEDROCK.getBlockData());
+            if (l1 <= (flatBedrock ? 0 : random.nextInt(5))) { // PaperSpigot - Configurable flat bedrock // Athena - hoisted
+                chunksnapshot.setBlockState(k1, l1, j1, bedrock); // Athena - hoisted
             } else {
                 IBlockData iblockdata2 = chunksnapshot.getBlockState(k1, l1, j1);
 
@@ -290,7 +295,7 @@ public abstract class BiomeBase {
                     if (l == -1) {
                         if (i1 <= 0) {
                             iblockdata = null;
-                            iblockdata1 = Blocks.STONE.getBlockData();
+                            iblockdata1 = stone; // Athena - hoisted
                         } else if (l1 >= k - 4 && l1 <= k + 1) {
                             iblockdata = this.topBlock;
                             iblockdata1 = this.fillerBlock;
@@ -309,7 +314,7 @@ public abstract class BiomeBase {
                             chunksnapshot.setBlockState(k1, l1, j1, iblockdata);
                         } else if (l1 < k - 7 - i1) {
                             iblockdata = null;
-                            iblockdata1 = Blocks.STONE.getBlockData();
+                            iblockdata1 = stone; // Athena - hoisted
                             chunksnapshot.setBlockState(k1, l1, j1, Blocks.GRAVEL.getBlockData());
                         } else {
                             chunksnapshot.setBlockState(k1, l1, j1, iblockdata1);
