From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: glacier <hyouga.dev@gmail.com>
Date: Thu, 15 Oct 2026 23:23:46 +0900
Subject: [PATCH] Write Adventure text into packets as JSON, once per broadcast

Chat, title and tab list packets turned each Adventure Component into JSON, parsed it back into
a 1.8 component and wrote it out as JSON again, once per receiver. The serializer's JSON goes out
as it is now, and the last component serialized is remembered by identity, so a broadcast builds
its JSON once. The client reads the same component (AthenaAdventureJsonTest).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/src/main/java/com/hpfxd/pandaspigot/adventure/PandaAdventure.java b/src/main/java/com/hpfxd/pandaspigot/adventure/PandaAdventure.java
index e29cb67c2dd3f0bf803bfd89951f06c10b0816f6..31d4d32cb883d14bd378587ab8f17ddf6c89d442 100644
--- a/src/main/java/com/hpfxd/pandaspigot/adventure/PandaAdventure.java
+++ b/src/main/java/com/hpfxd/pandaspigot/adventure/PandaAdventure.java
@@ -49,6 +49,42 @@ public final class PandaAdventure {
         return array;
     }
 
+    // Athena start - write Adventure text straight into packets as JSON
+    // The chat, title and tab list packets turned each Component into JSON, parsed that JSON back
+    // into a 1.8 component, and turned it into JSON again to write it - once per receiver. The
+    // client only ever sees the JSON, and SERIALIZER already writes the oldest format with 1.8
+    // hover events, so its output goes out as it is.
+    //
+    // A broadcast hands every receiver the same Component instance, so the last one serialized is
+    // remembered and the receivers after the first reuse its JSON. Components are immutable, and
+    // identity is the check: equals walks the whole tree, which is what this is avoiding. The pair
+    // is one immutable object swapped through a volatile, since packets are written on several
+    // Netty threads at once; two threads may both serialize the same component, to the same JSON.
+    private static final String EMPTY_JSON = "{\"text\":\"\"}";
+
+    private record LastJson(Component component, String json) {}
+
+    private static volatile LastJson lastJson;
+
+    /** The JSON a packet carries for this component: what {@link #asVanilla} would have been written as. */
+    public static String asJson(Component component) {
+        if (component == null) {
+            return EMPTY_JSON;
+        }
+
+        LastJson last = lastJson;
+
+        if (last != null && last.component() == component) {
+            return last.json();
+        }
+
+        String json = SERIALIZER.serialize(component);
+
+        lastJson = new LastJson(component, json);
+        return json;
+    }
+    // Athena end
+
     public static IChatBaseComponent asVanilla(Component component) {
         return component == null ? new ChatComponentText("") : IChatBaseComponent.ChatSerializer.jsonToComponent(SERIALIZER.serialize(component));
     }
diff --git a/src/main/java/net/minecraft/server/PacketPlayOutChat.java b/src/main/java/net/minecraft/server/PacketPlayOutChat.java
index 5983f90b964ceea87ab102f4532f697a17b813e4..d05c039ff07188d11aa328cc81a64dacd1aa9d59 100644
--- a/src/main/java/net/minecraft/server/PacketPlayOutChat.java
+++ b/src/main/java/net/minecraft/server/PacketPlayOutChat.java
@@ -30,7 +30,7 @@ public class PacketPlayOutChat implements Packet<PacketListenerPlayOut> {
         // Spigot start
         // PandaSpigot start - Adventure
         if (adventure$message != null) {
-            packetdataserializer.writeChatComponent(com.hpfxd.pandaspigot.adventure.PandaAdventure.asVanilla(adventure$message));
+            packetdataserializer.writeString(com.hpfxd.pandaspigot.adventure.PandaAdventure.asJson(adventure$message)); // Athena - the JSON as it is, not parsed and rewritten
         } else if (components != null) {
         // PandaSpigot end
             packetdataserializer.writeString(net.md_5.bungee.chat.ComponentSerializer.toString(components));
