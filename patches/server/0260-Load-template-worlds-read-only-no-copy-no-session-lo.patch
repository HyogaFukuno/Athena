diff --git a/src/main/java/net/minecraft/server/AthenaTemplateChunkLoader.java b/src/main/java/net/minecraft/server/AthenaTemplateChunkLoader.java
new file mode 100644
index 0000000000000000000000000000000000000000..e4e3b524b553e2c33e2a90c777951f555ebf46e3
--- /dev/null
+++ b/src/main/java/net/minecraft/server/AthenaTemplateChunkLoader.java
@@ -0,0 +1,87 @@
+package net.minecraft.server;
+
+import java.io.File;
+import java.io.IOException;
+import java.util.HashMap;
+import java.util.Map;
+
+// Athena - the chunk loader of a template world (see athena.api.AthenaWorlds): chunks come from
+// the template's region files, read only, and are never saved.
+//
+// It is a ChunkRegionLoader so that every path that loads a chunk - the async chunk IO threads, the
+// synchronous fallback, chunkExists deciding between loading and generating - goes through it
+// unchanged; only where the NBT comes from and whether anything is written differ. The NBT to
+// Chunk conversion is the inherited one, so a template chunk loads exactly like a saved chunk.
+final class AthenaTemplateChunkLoader extends ChunkRegionLoader {
+
+    private static final AthenaTemplateRegion MISSING = null;
+
+    private final File directory;
+    // region coordinates -> the open region, or a stored null for a region file that is not there
+    private final Map<Long, AthenaTemplateRegion> regions = new HashMap<Long, AthenaTemplateRegion>();
+    private boolean closed;
+
+    AthenaTemplateChunkLoader(File directory) {
+        super(directory);
+        this.directory = directory;
+    }
+
+    private synchronized AthenaTemplateRegion region(int chunkX, int chunkZ) throws IOException {
+        if (this.closed) {
+            return MISSING;
+        }
+
+        int regionX = chunkX >> 5;
+        int regionZ = chunkZ >> 5;
+        Long key = Long.valueOf((long) regionX << 32 | regionZ & 0xFFFFFFFFL);
+
+        if (this.regions.containsKey(key)) {
+            return this.regions.get(key);
+        }
+
+        AthenaTemplateRegion region = AthenaTemplateRegion.open(new File(new File(this.directory, "region"), "r." + regionX + "." + regionZ + ".mca"));
+
+        this.regions.put(key, region);
+        return region;
+    }
+
+    @Override
+    public boolean chunkExists(World world, int i, int j) {
+        try {
+            AthenaTemplateRegion region = this.region(i, j);
+
+            return region != null && region.has(i & 31, j & 31);
+        } catch (IOException e) {
+            return false;
+        }
+    }
+
+    @Override
+    public Object[] loadChunk(World world, int i, int j) throws IOException {
+        AthenaTemplateRegion region = this.region(i, j);
+        NBTTagCompound nbttagcompound = region == null ? null : region.read(i & 31, j & 31);
+
+        return nbttagcompound == null ? null : this.a(world, i, j, nbttagcompound);
+    }
+
+    /** Nothing is saved: a template world's changes live in memory only. */
+    @Override
+    public void saveChunk(World world, Chunk chunk) {}
+
+    @Override
+    public void saveExtraData() {}
+
+    /** Closes the template's region files. Called when the world unloads. */
+    synchronized void close() {
+        this.closed = true;
+        for (AthenaTemplateRegion region : this.regions.values()) {
+            if (region != null) {
+                try {
+                    region.close();
+                } catch (IOException ignored) {
+                }
+            }
+        }
+        this.regions.clear();
+    }
+}
diff --git a/src/main/java/net/minecraft/server/AthenaTemplateDataManager.java b/src/main/java/net/minecraft/server/AthenaTemplateDataManager.java
new file mode 100644
index 0000000000000000000000000000000000000000..ae88924e6af24a6c43a9cd6b73e854c5ac08f00f
--- /dev/null
+++ b/src/main/java/net/minecraft/server/AthenaTemplateDataManager.java
@@ -0,0 +1,114 @@
+package net.minecraft.server;
+
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.InputStream;
+import java.util.UUID;
+
+// Athena - the save handler of a template world (see athena.api.AthenaWorlds).
+//
+// WorldNBTStorage, the normal one, writes into the world folder from its constructor on: it
+// creates data/ and playerdata/, writes session.lock, and writes uid.dat the first time the world's
+// UUID is asked for. This one reads level.dat from the template and writes nothing at all: no
+// session lock (several worlds may share the template), a UUID made up per load, no player data
+// (players are saved by the main world's handler in any case), no villages, maps or structure
+// data (getDataFile answers null, which PersistentCollection treats as "nothing stored").
+public final class AthenaTemplateDataManager implements IDataManager, IPlayerFileData {
+
+    private final File template;
+    private final String name;
+    private final UUID uuid = UUID.randomUUID();
+    private AthenaTemplateChunkLoader chunkLoader;
+
+    public AthenaTemplateDataManager(File template, String name) {
+        this.template = template;
+        this.name = name;
+    }
+
+    @Override
+    public WorldData getWorldData() {
+        for (String fileName : new String[] {"level.dat", "level.dat_old"}) {
+            File file = new File(this.template, fileName);
+
+            if (file.isFile()) {
+                try (InputStream in = new FileInputStream(file)) {
+                    return new WorldData(NBTCompressedStreamTools.readCompressed(in).getCompound("Data"));
+                } catch (Exception exception) {
+                    exception.printStackTrace();
+                }
+            }
+        }
+        return null;
+    }
+
+    @Override
+    public void checkSession() {}
+
+    @Override
+    public IChunkLoader createChunkLoader(WorldProvider worldprovider) {
+        File directory = this.template;
+
+        if (worldprovider instanceof WorldProviderHell) {
+            directory = new File(this.template, "DIM-1");
+        } else if (worldprovider instanceof WorldProviderTheEnd) {
+            directory = new File(this.template, "DIM1");
+        }
+        this.chunkLoader = new AthenaTemplateChunkLoader(directory);
+        return this.chunkLoader;
+    }
+
+    @Override
+    public void saveWorldData(WorldData worlddata, NBTTagCompound nbttagcompound) {}
+
+    @Override
+    public void saveWorldData(WorldData worlddata) {}
+
+    @Override
+    public IPlayerFileData getPlayerFileData() {
+        return this;
+    }
+
+    @Override
+    public void flush() {}
+
+    @Override
+    public File getDirectory() {
+        return this.template;
+    }
+
+    @Override
+    public File getDataFile(String s) {
+        return null;
+    }
+
+    @Override
+    public String getWorldDirectoryName() {
+        return this.name;
+    }
+
+    @Override
+    public UUID getUUID() {
+        return this.uuid;
+    }
+
+    // IPlayerFileData - never used for players (the main world's handler is), and never writes
+    @Override
+    public void save(EntityHuman entityhuman) {}
+
+    @Override
+    public NBTTagCompound load(EntityHuman entityhuman) {
+        return null;
+    }
+
+    @Override
+    public String[] getSeenPlayers() {
+        return new String[0];
+    }
+
+    /** Closes the template's files; the world is being unloaded. */
+    public void close() {
+        if (this.chunkLoader != null) {
+            this.chunkLoader.close();
+        }
+    }
+}
diff --git a/src/main/java/net/minecraft/server/AthenaTemplateRegion.java b/src/main/java/net/minecraft/server/AthenaTemplateRegion.java
new file mode 100644
index 0000000000000000000000000000000000000000..798501fcf4c8a12df6063597de07b8562130b67f
--- /dev/null
+++ b/src/main/java/net/minecraft/server/AthenaTemplateRegion.java
@@ -0,0 +1,147 @@
+package net.minecraft.server;
+
+import java.io.BufferedInputStream;
+import java.io.ByteArrayInputStream;
+import java.io.Closeable;
+import java.io.DataInputStream;
+import java.io.EOFException;
+import java.io.File;
+import java.io.IOException;
+import java.io.InputStream;
+import java.nio.ByteBuffer;
+import java.nio.channels.FileChannel;
+import java.nio.file.StandardOpenOption;
+import java.util.zip.GZIPInputStream;
+import java.util.zip.InflaterInputStream;
+
+// Athena - one region file of a template world, opened read only.
+//
+// RegionFile opens its file for writing and pads a short one with zeros, and RegionFileCache
+// creates a region file that is missing; either would write into a template several servers
+// share. This reads the same format - an 8 KB header of sector offsets, then per chunk a length,
+// a compression type and the compressed NBT - and never writes. Reads are positional, so the
+// chunk IO threads and the server thread can read one file at once without a lock.
+final class AthenaTemplateRegion implements Closeable {
+
+    private static final int SECTOR = 4096;
+
+    private final FileChannel channel;
+    private final int[] offsets = new int[1024];
+    private final long size;
+
+    private AthenaTemplateRegion(FileChannel channel) throws IOException {
+        this.channel = channel;
+        this.size = channel.size(); // a template does not change under us
+
+        ByteBuffer header = ByteBuffer.allocate(SECTOR);
+
+        readFully(header, 0L);
+        header.flip();
+        for (int i = 0; i < 1024 && header.remaining() >= 4; ++i) {
+            this.offsets[i] = header.getInt();
+        }
+    }
+
+    /** The region file at {@code file}, or null if there is none. */
+    static AthenaTemplateRegion open(File file) throws IOException {
+        if (!file.isFile()) {
+            return null;
+        }
+        return new AthenaTemplateRegion(FileChannel.open(file.toPath(), StandardOpenOption.READ));
+    }
+
+    /**
+     * Whether the chunk at these region-local coordinates is stored, from the offset table alone.
+     *
+     * The server asks this on its own thread for every chunk it is about to load, to choose between
+     * loading and generating; RegionFile answers it by reading the chunk's first bytes. Here it
+     * costs no IO at all. A stored chunk whose data then turns out unreadable reads as null, and
+     * the server generates the chunk instead, as it does for one that is not there.
+     */
+    boolean has(int x, int z) {
+        if ((x | z) < 0 || x >= 32 || z >= 32) {
+            return false;
+        }
+
+        int offset = this.offsets[x + z * 32];
+
+        return offset != 0 && (long) ((offset >>> 8) + (offset & 255)) * SECTOR <= this.size;
+    }
+
+    /** The chunk's NBT, or null if it is not stored. */
+    NBTTagCompound read(int x, int z) throws IOException {
+        int[] header = this.header(x, z);
+
+        if (header == null) {
+            return null;
+        }
+
+        int sector = header[0];
+        int length = header[1];
+        int type = header[2];
+        ByteBuffer data = ByteBuffer.allocate(length - 1);
+
+        readFully(data, (long) sector * SECTOR + 5L);
+
+        InputStream raw = new ByteArrayInputStream(data.array());
+        InputStream in = type == 1 ? new GZIPInputStream(raw) : new InflaterInputStream(raw);
+
+        try (DataInputStream stream = new DataInputStream(new BufferedInputStream(in))) {
+            return NBTCompressedStreamTools.read(stream);
+        }
+    }
+
+    /** {sector, length, compression type} for a stored chunk, null for one that is not. */
+    private int[] header(int x, int z) throws IOException {
+        if ((x | z) < 0 || x >= 32 || z >= 32) {
+            return null;
+        }
+
+        int offset = this.offsets[x + z * 32];
+
+        if (offset == 0) {
+            return null;
+        }
+
+        int sector = offset >>> 8;
+        int sectors = offset & 255;
+
+        if ((long) (sector + sectors) * SECTOR > this.size) {
+            return null;
+        }
+
+        ByteBuffer head = ByteBuffer.allocate(5);
+
+        readFully(head, (long) sector * SECTOR);
+        head.flip();
+
+        int length = head.getInt();
+        int type = head.get();
+
+        if (length <= 1 || length > SECTOR * sectors || (type != 1 && type != 2)) {
+            return null;
+        }
+        return new int[] {sector, length, type};
+    }
+
+    private void readFully(ByteBuffer buffer, long position) throws IOException {
+        long at = position;
+
+        while (buffer.hasRemaining()) {
+            int n = this.channel.read(buffer, at);
+
+            if (n < 0) {
+                if (position == 0L) {
+                    return; // a header shorter than a sector: the rest reads as empty
+                }
+                throw new EOFException();
+            }
+            at += n;
+        }
+    }
+
+    @Override
+    public void close() throws IOException {
+        this.channel.close();
+    }
+}
