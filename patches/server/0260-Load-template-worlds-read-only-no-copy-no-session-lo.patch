diff --git a/src/test/java/net/minecraft/server/AthenaTemplateRegionTest.java b/src/test/java/net/minecraft/server/AthenaTemplateRegionTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..ef1131da154d2b61aa58c787cc3ec03407858cf4
--- /dev/null
+++ b/src/test/java/net/minecraft/server/AthenaTemplateRegionTest.java
@@ -0,0 +1,123 @@
+package net.minecraft.server;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+
+import java.io.DataOutputStream;
+import java.io.File;
+import java.nio.file.Files;
+import java.util.Random;
+import org.junit.Test;
+
+/**
+ * Athena - a template world reads region files written by the normal save path, reads them back
+ * exactly, and never changes or creates a file in the template.
+ */
+public class AthenaTemplateRegionTest {
+
+    private static NBTTagCompound chunkNbt(int x, int z, long seed) {
+        Random random = new Random(seed);
+        NBTTagCompound level = new NBTTagCompound();
+        byte[] blocks = new byte[4096];
+
+        random.nextBytes(blocks);
+        level.setInt("xPos", x);
+        level.setInt("zPos", z);
+        level.setByteArray("Blocks", blocks);
+        level.setLong("seed", seed);
+
+        NBTTagCompound root = new NBTTagCompound();
+
+        root.set("Level", level);
+        return root;
+    }
+
+    private static File template() throws Exception {
+        File dir = Files.createTempDirectory("athena-template").toFile();
+        File regionDir = new File(dir, "region");
+
+        regionDir.mkdirs();
+
+        // written the way the server saves chunks: RegionFile, deflate stream per chunk
+        RegionFile region = new RegionFile(new File(regionDir, "r.0.0.mca"));
+
+        for (int x = 0; x < 32; x += 3) {
+            for (int z = 0; z < 32; z += 5) {
+                try (DataOutputStream out = region.getChunkDataOutputStream(x, z)) {
+                    NBTCompressedStreamTools.write(chunkNbt(x, z, x * 131L + z), (java.io.DataOutput) out);
+                }
+            }
+        }
+        region.close();
+        return dir;
+    }
+
+    @Test
+    public void readsBackWhatTheServerWrote() throws Exception {
+        File dir = template();
+        File file = new File(dir, "region/r.0.0.mca");
+        long size = file.length();
+        long modified = file.lastModified();
+        AthenaTemplateRegion region = AthenaTemplateRegion.open(file);
+
+        assertNotNull(region);
+        for (int x = 0; x < 32; ++x) {
+            for (int z = 0; z < 32; ++z) {
+                boolean stored = x % 3 == 0 && z % 5 == 0;
+
+                assertEquals("has " + x + "," + z, stored, region.has(x, z));
+
+                NBTTagCompound nbt = region.read(x, z);
+
+                if (stored) {
+                    assertEquals(chunkNbt(x, z, x * 131L + z), nbt);
+                } else {
+                    assertNull(nbt);
+                }
+            }
+        }
+        assertFalse(region.has(-1, 0));
+        assertFalse(region.has(32, 0));
+        region.close();
+
+        assertEquals("the template file is untouched", size, file.length());
+        assertEquals("the template file is untouched", modified, file.lastModified());
+    }
+
+    @Test
+    public void aMissingRegionIsNotCreated() throws Exception {
+        File dir = template();
+        AthenaTemplateChunkLoader loader = new AthenaTemplateChunkLoader(dir);
+
+        assertTrue(loader.chunkExists(null, 0, 0));
+        assertFalse(loader.chunkExists(null, 1, 0));
+        assertFalse("region 5,5 has no file", loader.chunkExists(null, 5 * 32, 5 * 32));
+        assertNull(loader.loadChunk(null, 5 * 32 + 1, 5 * 32 + 1));
+        assertFalse("nothing was created in the template", new File(dir, "region/r.5.5.mca").exists());
+        assertEquals("only the one region file", 1, new File(dir, "region").list().length);
+
+        loader.close();
+        assertFalse("a closed loader answers nothing", loader.chunkExists(null, 0, 0));
+    }
+
+    @Test
+    public void theDataManagerWritesNothing() throws Exception {
+        File dir = template();
+        AthenaTemplateDataManager manager = new AthenaTemplateDataManager(dir, "match1");
+
+        manager.checkSession();
+        manager.saveWorldData(null);
+        manager.saveWorldData(null, null);
+        assertNull(manager.getDataFile("villages"));
+        assertNotNull(manager.getUUID());
+        assertTrue("a fresh UUID per load", !manager.getUUID().equals(new AthenaTemplateDataManager(dir, "match2").getUUID()));
+
+        String[] entries = dir.list();
+
+        java.util.Arrays.sort(entries);
+        assertEquals("[region]", java.util.Arrays.toString(entries));
+    }
+}
