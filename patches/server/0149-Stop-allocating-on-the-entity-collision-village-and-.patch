+package net.minecraft.server;
+
+import static org.junit.Assert.assertArrayEquals;
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertSame;
+
+import java.util.Iterator;
+import org.junit.Test;
+
+/**
+ * Athena - facings() now hands out shared arrays built in a holder class.
+ *
+ * <p>The holder exists because EnumDirection.&lt;clinit&gt; reaches EnumDirectionLimit.&lt;clinit&gt;
+ * through EnumAxis's constants while NORTH..DOWN are still null. If the arrays were ever moved back
+ * into static fields of the enum they would silently fill with nulls, and every direction-driven
+ * block update would break in a way that no compiler check catches. These tests pin that down.
+ */
+public class EnumDirectionFacingsTest {
+
+    @Test
+    public void horizontalFacingsAreFullyInitialized() {
+        EnumDirection[] facings = EnumDirection.EnumDirectionLimit.HORIZONTAL.facings();
+
+        for (EnumDirection facing : facings) {
+            assertNotNull("class initialization order left a null in HORIZONTAL", facing);
+        }
+
+        assertArrayEquals(new EnumDirection[]{
+            EnumDirection.NORTH, EnumDirection.EAST, EnumDirection.SOUTH, EnumDirection.WEST
+        }, facings);
+    }
+
+    @Test
+    public void verticalFacingsAreFullyInitialized() {
+        EnumDirection[] facings = EnumDirection.EnumDirectionLimit.VERTICAL.facings();
+
+        for (EnumDirection facing : facings) {
+            assertNotNull("class initialization order left a null in VERTICAL", facing);
+        }
+
+        assertArrayEquals(new EnumDirection[]{EnumDirection.UP, EnumDirection.DOWN}, facings);
+    }
+
+    @Test
+    public void facingsIsSharedRatherThanRebuilt() {
+        assertSame(EnumDirection.EnumDirectionLimit.HORIZONTAL.facings(),
+                   EnumDirection.EnumDirectionLimit.HORIZONTAL.facings());
+        assertSame(EnumDirection.EnumDirectionLimit.VERTICAL.facings(),
+                   EnumDirection.EnumDirectionLimit.VERTICAL.facings());
+    }
+
+    @Test
+    public void iterationStillYieldsTheSameOrder() {
+        // the remaining iterator() callers must be unaffected by the array now being shared
+        for (EnumDirection.EnumDirectionLimit limit : EnumDirection.EnumDirectionLimit.values()) {
+            Iterator<EnumDirection> iterator = limit.iterator();
+
+            for (EnumDirection expected : limit.facings()) {
+                assertSame(expected, iterator.next());
+            }
+        }
+    }
+
+    @Test
+    public void everyDirectionBelongsToItsAxisPlane() {
+        // the plane wiring is what forces the holder; verify it still resolves both ways
+        for (EnumDirection direction : EnumDirection.VALUES) {
+            EnumDirection.EnumDirectionLimit plane = direction.getAxis().getPlane();
+            boolean found = false;
+
+            for (EnumDirection facing : plane.facings()) {
+                found |= facing == direction;
+            }
+
+            if (!found) {
+                throw new AssertionError(direction + " is missing from its own plane " + plane);
+            }
+        }
+    }
+}
