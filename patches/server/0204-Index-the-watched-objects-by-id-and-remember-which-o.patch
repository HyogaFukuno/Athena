+    // Athena start - the pre-index path, kept for the case the mask cannot represent
+    private List<DataWatcher.WatchableObject> getChangedSlow() {
+        ArrayList arraylist = null;
+        Iterator iterator = this.dataValues.valueCollection().iterator();
 
-            // this.f.readLock().unlock(); // PandaSpigot
+        while (iterator.hasNext()) {
