+    // Athena start - keep the id index and the dirty mask in step with dataValues. A freshly built
+    // WatchableObject is born watched, so registering one marks its bit.
+    private void mirror(int i, DataWatcher.WatchableObject datawatcher_watchableobject) {
+        if ((i & ~31) == 0) {
+            this.byId[i] = datawatcher_watchableobject;
+            this.dirtyMask |= 1 << i;
+        } else {
+            this.hasUnmirroredId = true;
+        }
+    }
+    // Athena end
+
     public byte getByte(int i) {
