     // Spigot End
+    // Athena start - index the watched objects by id, and remember which ones are dirty.
+    //
+    // Data value ids are 0-31 by protocol - addObject rejects anything larger, and the wire format
+    // packs the id into five bits - so every registered object fits a 32-slot array and every dirty
+    // set fits an int. dataValues stays the authoritative map (it is what the watchedObjects
+    // decorator plugins reflect on is built from) and holds the same WatchableObject instances, so
+    // the two can never disagree about an object's contents; only membership has to be mirrored,
+    // which happens in addObject and add.
+    //
+    // What this buys: getWatchedObject was a trove hash probe on every read, and getChanged walked
+    // the whole map asking each entry whether it had changed. getChanged runs once per tracked
+    // entity per tracker update, so that scan was (entities) x (registered ids) per tick to find
+    // the handful that actually moved. The mask visits exactly the dirty ones.
+    private final DataWatcher.WatchableObject[] byId = new DataWatcher.WatchableObject[32];
+    private int dirtyMask;
+    // An id outside 0-31 cannot be mirrored, and cannot be written to the wire either. Nothing in
+    // the server registers one, but add() never rejected it, so keep the old full scan available
+    // rather than silently dropping such an entry from getChanged.
+    private boolean hasUnmirroredId;
+    // Athena end
     private boolean objectChanged;
     // private ReadWriteLock f = new ReentrantReadWriteLock(); // PandaSpigot - Remove DataWatcher Locking
 
