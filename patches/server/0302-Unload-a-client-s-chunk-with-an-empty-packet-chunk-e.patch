diff --git a/src/test/java/net/minecraft/server/AthenaLegacy17Test.java b/src/test/java/net/minecraft/server/AthenaLegacy17Test.java
index f292805778077741e5f0e41778a2db2ced223222..af30a7b4fb88abbf3b30aaf0b16edcc4db837a9e 100644
--- a/src/test/java/net/minecraft/server/AthenaLegacy17Test.java
+++ b/src/test/java/net/minecraft/server/AthenaLegacy17Test.java
@@ -128,6 +128,35 @@ public class AthenaLegacy17Test extends AbstractTestingBase {
         assertEquals(7, data17[data17.length - 1]);
     }
 
+    @Test
+    public void aChunkUnloadIsAnEmptyFullChunkUnderTheCompressionThreshold() throws Exception {
+        PacketDataSerializer p = packet(0x21);
+
+        PacketPlayOutMapChunk.unload(3, -4).writePacketData(p);
+        assertTrue("goes out uncompressed", p.readableBytes() < 256);
+
+        PacketDataSerializer copy = new PacketDataSerializer(p.copy());
+        copy.readVarIntFromBuffer();
+        PacketPlayOutMapChunk read = new PacketPlayOutMapChunk();
+        read.readPacketData(copy);
+        assertFalse(copy.isReadable());
+
+        // a 1.7 client inflates 256 biome bytes before it sees the empty mask and unloads
+        PacketDataSerializer sent = sent(this.out(), p).get(0);
+
+        assertEquals(0x21, sent.readVarIntFromBuffer());
+        assertEquals(3, sent.readInt());
+        assertEquals(-4, sent.readInt());
+        assertTrue(sent.readBoolean());
+        assertEquals(0, sent.readUnsignedShort());
+        assertEquals(0, sent.readUnsignedShort());
+        byte[] compressed = new byte[sent.readInt()];
+
+        sent.readBytes(compressed);
+        assertFalse(sent.isReadable());
+        assertEquals(256, inflate(compressed, 256).length);
+    }
+
     @Test
     public void theCachedChunkIsTheSameAsATranslatedOne() {
         byte[] data = new byte[8192 + 4096 + 256];
