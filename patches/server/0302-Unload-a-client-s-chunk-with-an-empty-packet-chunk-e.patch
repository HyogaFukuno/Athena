From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: glacier <hyouga.dev@gmail.com>
Date: Fri, 16 Oct 2026 03:19:38 +0900
Subject: [PATCH] Unload a client's chunk with an empty packet; chunk events
 only when heard

The unload packet carried the chunk's 256 biome bytes, which a client never reads once it sees
the empty mask: 270 bytes, so every unload was extracted on the server thread and deflated on a
Netty thread. It has no data now - 13 bytes, uncompressed. A 1.7 client inflates before it looks
at the mask, so it gets 256 zero bytes deflated once. The chunk send loop looks a chunk up once,
the player chunk load and unload events are built only when something listens, and the 1.7
encoder keeps its deflate buffer per thread.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/src/main/java/net/minecraft/server/AthenaLegacy17Encoder.java b/src/main/java/net/minecraft/server/AthenaLegacy17Encoder.java
index 6919b4d04532d3296e7d5ae17297741f478fda09..249d16dd335c27522de9547b0e90868a52265856 100644
--- a/src/main/java/net/minecraft/server/AthenaLegacy17Encoder.java
+++ b/src/main/java/net/minecraft/server/AthenaLegacy17Encoder.java
@@ -1117,6 +1117,21 @@ final class AthenaLegacy17Encoder extends ChannelOutboundHandlerAdapter {
         int chunkZ = in.readInt();
         boolean groundUp = in.readBoolean();
         int mask = in.readUnsignedShort();
+
+        if (groundUp && mask == 0) {
+            // an unload: 1.7 inflates the data before it looks at the mask, so it needs a stream that
+            // inflates to the 256 biome bytes it expects, and then never reads them
+            PacketDataSerializer p = packet(ctx, id, out);
+
+            p.writeInt(chunkX);
+            p.writeInt(chunkZ);
+            p.writeBoolean(true);
+            p.writeShort(0);
+            p.writeShort(0);
+            p.writeInt(UNLOAD_BIOMES.length);
+            p.writeBytes(UNLOAD_BIOMES);
+            return;
+        }
         int size = in.readVarIntFromBuffer();
         int sections = Integer.bitCount(mask);
         boolean sky = size == sections * (8192 + 2048 + 2048) + (groundUp ? 256 : 0);
@@ -1225,9 +1240,32 @@ final class AthenaLegacy17Encoder extends ChannelOutboundHandlerAdapter {
         p.setInt(lengthAt, p.writerIndex() - start);
     }
 
+    /** 256 zero biome bytes, deflated once: the body of every 1.7 chunk unload. */
+    private static final byte[] UNLOAD_BIOMES;
+
+    static {
+        Deflater deflater = new Deflater(4);
+        byte[] out = new byte[512];
+
+        deflater.setInput(new byte[256]);
+        deflater.finish();
+        int n = deflater.deflate(out);
+
+        deflater.end();
+        UNLOAD_BIOMES = java.util.Arrays.copyOf(out, n);
+    }
+
+    // Athena - the deflate output buffer, one per event loop like the deflater, not 8 KB per packet
+    private static final FastThreadLocal<byte[]> DEFLATE_BUFFER = new FastThreadLocal<byte[]>() {
+        @Override
+        protected byte[] initialValue() {
+            return new byte[8192];
+        }
+    };
+
     private static void deflate(PacketDataSerializer p, byte[] data, int length) {
         Deflater deflater = DEFLATER.get();
-        byte[] chunk = new byte[8192];
+        byte[] chunk = DEFLATE_BUFFER.get();
 
         deflater.reset();
         deflater.setInput(data, 0, length);
