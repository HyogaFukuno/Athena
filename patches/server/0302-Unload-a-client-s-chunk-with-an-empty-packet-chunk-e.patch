diff --git a/src/main/java/net/minecraft/server/PacketPlayOutMapChunk.java b/src/main/java/net/minecraft/server/PacketPlayOutMapChunk.java
index 5cb2618437d129ab3e7a91b899a9b22bf3eb4649..b070923f34c12ad21703736b8cdaf2717a97fb67 100644
--- a/src/main/java/net/minecraft/server/PacketPlayOutMapChunk.java
+++ b/src/main/java/net/minecraft/server/PacketPlayOutMapChunk.java
@@ -34,6 +34,30 @@ public class PacketPlayOutMapChunk implements Packet<PacketListenerPlayOut> {
     }
     // Athena end
 
+    // Athena start - the packet that tells a client to forget a chunk.
+    //
+    // A full chunk with no sections is how 1.8 unloads one, and the client stops reading the moment
+    // it sees the empty mask: the 256 biome bytes the packet carried were never looked at. They made
+    // it 270 bytes, over the 256-byte compression threshold, so every unload - one per chunk per
+    // border a player crosses, as many as the chunk sends - was extracted on the server thread and
+    // deflated on a Netty thread. With no data it is 13 bytes and goes out uncompressed.
+    private static final PacketPlayOutMapChunk.ChunkMap UNLOAD_DATA = new PacketPlayOutMapChunk.ChunkMap();
+
+    static {
+        UNLOAD_DATA.data = new byte[0];
+    }
+
+    static PacketPlayOutMapChunk unload(int chunkX, int chunkZ) {
+        PacketPlayOutMapChunk packet = new PacketPlayOutMapChunk();
+
+        packet.chunkX = chunkX;
+        packet.chunkZ = chunkZ;
+        packet.d = true;
+        packet.extractedData = UNLOAD_DATA;
+        return packet;
+    }
+    // Athena end
+
     public PacketPlayOutMapChunk(Chunk chunk, boolean flag, int i) {
         this.chunkX = chunk.locX;
         this.chunkZ = chunk.locZ;
