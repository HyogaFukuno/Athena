@@ -328,7 +328,13 @@ public class AthenaGuardMovementTest {
                 // only where the player fits: a box rebuilt from its centre can sit 1e-14 inside a wall it touched
                 if (teleports && been.size() >= 8 && random.nextInt(30) == 0
