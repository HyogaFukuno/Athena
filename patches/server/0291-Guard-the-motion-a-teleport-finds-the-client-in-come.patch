From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: glacier <hyouga.dev@gmail.com>
Date: Tue, 13 Oct 2026 20:26:11 +0900
Subject: [PATCH] Guard: the motion a teleport finds the client in comes from
 moves the server threw away

From enforcing on sg2: a player walking off its pre-game pedestal and jumping
was kicked for rising 0.333 where 0.127 was allowed, the second tick of a
jump. The jump's first tick was in flight when the plugin sent the player
back; vanilla's checkMovement throws such moves away, so the guard never saw
the jump, and the client carried its speed to the pedestal.

Every position packet is now observed before anything filters it; while the
client has not yet arrived where it was sent, the motion between those
packets is carried into the seed - and a rise at all counts as a jump, since
ticks the client did not report can sit between them. For the first three
moves after a teleport, the depth the client could have come down by assumes
it started at rest, not the vertical speed the guard guessed.

AthenaGuardMovementTest's teleport run now sometimes lets one more client
tick go out before the teleport arrives; 24 seeds x 3000 runs are clean.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/src/main/java/net/minecraft/server/AthenaGuard.java b/src/main/java/net/minecraft/server/AthenaGuard.java
index 1246b85b6fa5899ddf628b5f474adf713f87e7bc..015e1899ddaf5fdf31fbda98c2b429b91dbc4581 100644
--- a/src/main/java/net/minecraft/server/AthenaGuard.java
+++ b/src/main/java/net/minecraft/server/AthenaGuard.java
@@ -68,6 +68,7 @@ public final class AthenaGuard {
     private int ticksSincePos;      // client ticks since the last packet with a position
     private int freshTicks;         // ticks since the state was seeded, while still unsure of the client's onGround
     private double landRise;        // for this move: how far over the start the client could have landed
+    private double repX, repY, repZ = Double.NaN; // the last position the client reported, checked or not
     private double carriedH, carriedVy, carriedDown; // motion as of a teleport: the client keeps it, the position it moved by is lost
     private double grantH, grantV;  // knockback the server sent, and until when it may show up
     private long grantUntil;
@@ -182,6 +183,33 @@ public final class AthenaGuard {
         this.grantSentTick = MinecraftServer.currentTick;
     }
 
+    /**
+     * Every movement packet with a position, before anything filters it. While the client has not yet
+     * arrived where the server sent it, its moves are thrown away (vanilla's checkMovement) - but they
+     * are what its motion is when the teleport reaches it, and it keeps that motion: a jump just
+     * before the teleport goes on rising from the new position.
+     */
+    void observe(PacketPlayInFlying packet) {
+        if (!packet.isMoving() || packet.getPositionY() == -999.0D) {
+            return;
+        }
+        this.observe(packet.getPositionX(), packet.getPositionY(), packet.getPositionZ());
+    }
+
+    void observe(double x, double y, double z) {
+        if (this.awaiting && !Double.isNaN(this.repZ)
+                && !(Math.abs(x - this.awaitX) < 0.01D && Math.abs(y - this.awaitY) < 0.01D && Math.abs(z - this.awaitZ) < 0.01D)) {
+            double dx = x - this.repX, dy = y - this.repY, dz = z - this.repZ;
+
+            this.carriedH = Math.min(Math.max(this.carriedH, Math.sqrt(dx * dx + dz * dz)), 1.0D);
+            // ticks it did not report can sit between two in-flight positions: rising at all, it may
+            // have just jumped
+            this.carriedVy = Math.max(this.carriedVy, dy > 0.0D ? JUMP + 0.1D * (this.jumpAmp + 1) : dy);
+            this.carriedDown = Math.min(Math.max(this.carriedDown, -dy), 4.0D);
+        }
+        this.repX = x; this.repY = y; this.repZ = z;
+    }
+
     // ------------------------------------------------------------------ timer
     /**
      * The client answers every position the server sends with a movement packet of its own, on top
@@ -295,9 +323,11 @@ public final class AthenaGuard {
         // Right after a teleport the client's onGround is the one it had before, so it may step up from
         // the air: against a wall it meets on the way down this tick, and end floating where it began.
         boolean fresh = this.fresh();
-        double fall = this.fallDepth(ticks);
+        // after a teleport the vertical speed is not known: it may have come straight down
+        // (for the first few moves: the vertical speed the guard tracks starts from a guess)
+        double fall = this.freshTicks < 3 ? this.freshFall(ticks) : this.fallDepth(ticks);
         // the vertical move comes first, so what the sideways one runs into can be as low as it fell
-        boolean wall = this.nearWall(world, fromX, fromY - (fresh ? this.freshFall(ticks) : fall), fromZ, x, y, z);
+        boolean wall = this.nearWall(world, fromX, fromY - fall, fromZ, x, y, z);
         // something to come down on under the start, or an edge the box touches that it can step onto
         boolean landing = ticks > 1 || !this.groundStart || !this.groundCertain || fresh ? this.groundBelow(world, fromX, fromY, fromZ, fall) || this.edgeNear(world, fromX, fromY, fromZ, fall) : false;
         // landing on an edge can step the client up first: a jump after it rises from that height
@@ -549,7 +579,10 @@ public final class AthenaGuard {
     // for AthenaGuardMovementTest, which drives evaluate() from a model of the client
     boolean athenaKnown() { return this.known; }
     boolean fresh() { return this.freshTicks == 0; }
+    boolean athenaRecent() { return this.freshTicks < 3; }
     void athenaLandRise(double rise) { this.landRise = rise; }
+    void athenaAwait(double x, double y, double z) { this.carry(); this.known = false; this.awaiting = true; this.awaitX = x; this.awaitY = y; this.awaitZ = z; }
+    void athenaArrived() { this.awaiting = false; }
     boolean athenaGroundCertain() { return this.groundCertain; }
     void athenaSeed(double h, double dy, boolean groundNow, boolean maybeGround, boolean certain, double slipNow) { this.seedFresh(h, dy, groundNow, maybeGround, certain, slipNow); }
     void athenaTestEffects(int speedAmp, int jumpAmp) { this.speedAmp = speedAmp; this.jumpAmp = jumpAmp; }
