                     s.x = to[0]; s.y = ty; s.z = to[2]; s.skipped = 0;
                     c.set(to[0], ty, to[2]);
                     c.lastX = to[0]; c.lastY = ty; c.lastZ = to[2];
@@ -352,6 +358,7 @@ public class AthenaGuardMovementTest {
                 if (history.size() > 10) history.removeFirst();
                 if (sentNow) {
                     ++packets;
+                    s.guard.observe(c.x(), c.y(), c.z());
                     int r = s.receive(c.x(), c.y(), c.z());
                     if (r != 0) {
