diff --git a/src/main/java/org/bukkit/craftbukkit/util/AsynchronousExecutor.java b/src/main/java/org/bukkit/craftbukkit/util/AsynchronousExecutor.java
index d4861d5580f9466dddcdc89d020e4ed141c93501..67a3e6d370e49a2c5e2ac5fe96143d4171ea7026 100644
--- a/src/main/java/org/bukkit/craftbukkit/util/AsynchronousExecutor.java
+++ b/src/main/java/org/bukkit/craftbukkit/util/AsynchronousExecutor.java
@@ -349,6 +349,34 @@ public final class AsynchronousExecutor<P, T, C, E extends Throwable> {
         }
     }
 
+    // Athena start - finish what the worker threads completed, but stop once budgetNanos have gone.
+    //
+    // Everything a tick's worth of reads completed used to be finished in that tick. When many
+    // requests go out together - players arriving in a newly loaded world ask for their whole view at
+    // once - the reads come back within a fraction of a second and their main-thread halves (entities,
+    // ChunkLoadEvent, neighbours) landed in one tick: ~660 chunks, 0.55 s, at an SG match start. What
+    // is left over is finished on the next ticks, oldest first. At least one task is finished per call,
+    // so the queue always moves. A task that a synchronous get() finishes in the meantime is FINISHED,
+    // and finish() does nothing for it when its turn comes.
+    public void finishActive(long budgetNanos) throws E {
+        if (budgetNanos <= 0L) {
+            finishActive();
+            return;
+        }
+
+        final Queue<Task> finished = this.finished;
+        final long start = System.nanoTime();
+        Task task;
+
+        while ((task = finished.poll()) != null) {
+            task.finish();
+            if (System.nanoTime() - start >= budgetNanos) {
+                break;
+            }
+        }
+    }
+    // Athena end
+
     public void setActiveThreads(final int coreSize) {
         pool.setCorePoolSize(coreSize);
     }
diff --git a/src/test/java/org/bukkit/craftbukkit/util/AthenaFinishBudgetTest.java b/src/test/java/org/bukkit/craftbukkit/util/AthenaFinishBudgetTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..2ae19d928930cb4ad24b21fd2a2a9f15302c08d6
--- /dev/null
+++ b/src/test/java/org/bukkit/craftbukkit/util/AthenaFinishBudgetTest.java
@@ -0,0 +1,114 @@
+package org.bukkit.craftbukkit.util;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertTrue;
+
+import java.util.ArrayList;
+import java.util.List;
+import org.junit.Test;
+
+/**
+ * Athena - AsynchronousExecutor.finishActive(budget): finished loads wait for later ticks once a tick's
+ * budget is spent, are finished in the order they completed, and a load a synchronous get() finished
+ * in the meantime is not finished twice.
+ */
+public class AthenaFinishBudgetTest {
+
+    private static final class Provider implements AsynchronousExecutor.CallBackProvider<Integer, Integer, Runnable, RuntimeException> {
+        final List<Integer> stage2 = new ArrayList<Integer>();
+        final long stage2Nanos;
+
+        Provider(long stage2Nanos) {
+            this.stage2Nanos = stage2Nanos;
+        }
+
+        public Integer callStage1(Integer parameter) {
+            return parameter;
+        }
+
+        public void callStage2(Integer parameter, Integer object) {
+            long until = System.nanoTime() + this.stage2Nanos;
+            while (System.nanoTime() < until) {
+                // a chunk's main-thread half takes time
+            }
+            this.stage2.add(parameter);
+        }
+
+        public void callStage3(Integer parameter, Integer object, Runnable callback) {
+            callback.run();
+        }
+
+        public Thread newThread(Runnable runnable) {
+            Thread thread = new Thread(runnable, "test loader");
+            thread.setDaemon(true);
+            return thread;
+        }
+    }
+
+    private static void awaitReads(AsynchronousExecutor<?, ?, ?, ?> executor, int count) throws InterruptedException {
+        for (int i = 0; i < 500 && executor.finished.size() < count; ++i) {
+            Thread.sleep(2);
+        }
+        assertEquals("reads completed", count, executor.finished.size());
+    }
+
+    @Test
+    public void aBudgetSpreadsTheFinishingOverTicks() throws InterruptedException {
+        Provider provider = new Provider(2_000_000L); // 2 ms each
+        AsynchronousExecutor<Integer, Integer, Runnable, RuntimeException> executor = new AsynchronousExecutor<Integer, Integer, Runnable, RuntimeException>(provider, 1);
+        final int[] callbacks = new int[1];
+
+        for (int i = 0; i < 20; ++i) {
+            executor.add(i, () -> ++callbacks[0]);
+        }
+        awaitReads(executor, 20);
+
+        executor.finishActive(5_000_000L); // 5 ms: three or so
+        int first = provider.stage2.size();
+        assertTrue("some finished: " + first, first >= 1);
+        assertTrue("not all in one tick: " + first, first < 20);
+
+        int ticks = 1;
+        while (provider.stage2.size() < 20 && ticks < 100) {
+            executor.finishActive(5_000_000L);
+            ++ticks;
+        }
+        assertEquals(20, provider.stage2.size());
+        assertEquals("every callback ran once", 20, callbacks[0]);
+        // one worker thread completes them in order, and they are finished in that order
+        for (int i = 0; i < 20; ++i) {
+            assertEquals(Integer.valueOf(i), provider.stage2.get(i));
+        }
+    }
+
+    @Test
+    public void aLoadFinishedSynchronouslyWhileWaitingIsNotFinishedAgain() throws InterruptedException {
+        Provider provider = new Provider(0L);
+        AsynchronousExecutor<Integer, Integer, Runnable, RuntimeException> executor = new AsynchronousExecutor<Integer, Integer, Runnable, RuntimeException>(provider, 1);
+        final int[] callbacks = new int[1];
+
+        executor.add(7, () -> ++callbacks[0]);
+        awaitReads(executor, 1);
+
+        // the chunk is needed now (a teleport): it is finished before its turn in the queue
+        assertEquals(Integer.valueOf(7), executor.getSkipQueue(7));
+        assertEquals(1, provider.stage2.size());
+
+        executor.finishActive(1L); // its turn: nothing more happens
+        assertEquals(1, provider.stage2.size());
+        assertEquals(0, executor.finished.size());
+    }
