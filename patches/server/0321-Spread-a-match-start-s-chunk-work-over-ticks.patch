+    @Test
+    public void noBudgetFinishesEverything() throws InterruptedException {
+        Provider provider = new Provider(1_000_000L);
+        AsynchronousExecutor<Integer, Integer, Runnable, RuntimeException> executor = new AsynchronousExecutor<Integer, Integer, Runnable, RuntimeException>(provider, 1);
+
+        for (int i = 0; i < 10; ++i) {
+            executor.add(i, () -> {});
+        }
+        awaitReads(executor, 10);
+        executor.finishActive(0L);
+        assertEquals(10, provider.stage2.size());
+    }
