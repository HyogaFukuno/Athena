@@ -162,6 +162,34 @@ public class Chunk {
 
         return new PacketPlayOutMapChunk(cache);
     }
+
+    /**
+     * Builds the packet cache ahead of the first player to need it, and has it compressed off the
+     * server thread. For chunks preloaded before players arrive (AthenaChunkPreloader): otherwise the
+     * first send of every chunk of a newly loaded match map builds its cache on the server thread, and
+     * players arriving together made that ~0.2 s of one tick. The extraction stays here - it reads the
+     * chunk - and is spread over the preload's ticks; the deflate, ~1 ms a chunk, is not the server
+     * thread's, and once it is done the cache keeps only the compressed frame.
+     */
+    void athenaWarmPacketCache() {
+        MinecraftServer server = MinecraftServer.getServer();
+        int threshold = server == null ? -1 : server.aK();
+
+        if (threshold < 0) {
+            return; // no compression: packets are never served from the cache
+        }
+        AthenaChunkPacketCache cache = this.athenaPacketCache;
+
+        if (cache != null && cache.matches(this)) {
+            return;
+        }
+        PacketPlayOutMapChunk packet = this.athenaFullChunkPacket();
+        Integer id = EnumProtocol.PLAY.getPacketId(EnumProtocolDirection.CLIENTBOUND, packet);
+
+        if (id != null) {
+            AthenaChunkPacketCache.compressAhead(packet.athenaCache, id, threshold);
+        }
+    }
     // Athena end
 
     // PaperSpigot start - ChunkMap caching
