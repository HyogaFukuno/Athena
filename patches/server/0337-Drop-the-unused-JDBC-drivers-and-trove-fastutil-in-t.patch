     // may come from another thread, and the queue must be seen whole once the field is seen.
     private volatile ConcurrentLinkedQueue<BlockPosition> tileEntityPosQueue;
-    protected gnu.trove.map.hash.TObjectIntHashMap<Class> entityCount = new gnu.trove.map.hash.TObjectIntHashMap<Class>(); // Spigot
+    protected it.unimi.dsi.fastutil.objects.Object2IntOpenHashMap<Class> entityCount = new it.unimi.dsi.fastutil.objects.Object2IntOpenHashMap<Class>(); // Spigot // Athena - fastutil in place of trove
     // Athena - true while this chunk's tally is folded into the world's creature census. Set only
     // by ChunkCreatureCensus, at the points where the chunk enters or leaves the provider's map.
     boolean inCreatureCensus;
@@ -1107,7 +1107,7 @@ public class Chunk {
         // chunk: a chicken jockey loses its rider, a wolf or ocelot is tamed, a mob picks up loot.
         // Asking it a second time in removeEntityAtIndex can therefore answer differently from the
         // way it answers here, and the pair stops being symmetric - a decrement runs for an entity
-        // that was never incremented, or an increment is never taken back out. Trove's adjustValue
+        // that was never incremented, or an increment is never taken back out. The decrement below
         // silently does nothing when the key is absent, so entityCount hides half of that, but the
         // census applies its adjustment unconditionally and drifts away from the sum it mirrors.
         // Record the decision once, here, and let removal follow it instead of re-deciding.
@@ -1126,7 +1126,7 @@ public class Chunk {
             if ( creatureType.getCreatureClass().isAssignableFrom( entity.getClass() ) )
             {
                 if ( AthenaIndexAudit.enabled() ) AthenaIndexAudit.auditCensusSite( this, "Chunk.addEntity", creatureType.getCreatureClass(), false ); // Athena - audit hook
-                this.entityCount.adjustOrPutValue( creatureType.getCreatureClass(), 1, 1 );
+                this.entityCount.addTo( creatureType.getCreatureClass(), 1 ); // Athena - fastutil: absent counts from 0
                 if ( this.inCreatureCensus ) this.world.getCreatureCensus().adjust( creatureType.getCreatureClass(), 1 ); // Athena - keep the world total in step
             }
         }
@@ -1201,7 +1201,7 @@ public class Chunk {
             if ( creatureType.getCreatureClass().isAssignableFrom( entity.getClass() ) )
             {
                 if ( AthenaIndexAudit.enabled() ) AthenaIndexAudit.auditCensusSite( this, "Chunk.removeEntityAtIndex", creatureType.getCreatureClass(), true ); // Athena - audit hook
-                this.entityCount.adjustValue( creatureType.getCreatureClass(), -1 );
+                if ( this.entityCount.containsKey( creatureType.getCreatureClass() ) ) this.entityCount.addTo( creatureType.getCreatureClass(), -1 ); // Athena - fastutil: as trove's adjustValue, nothing when absent
                 if ( this.inCreatureCensus ) this.world.getCreatureCensus().adjust( creatureType.getCreatureClass(), -1 ); // Athena - keep the world total in step
             }
         }
