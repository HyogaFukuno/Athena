@@ -1,7 +1,8 @@
 package net.minecraft.server;
 
-import gnu.trove.iterator.TObjectIntIterator;
-import gnu.trove.map.hash.TObjectIntHashMap;
+import it.unimi.dsi.fastutil.objects.Object2IntMap;
+import it.unimi.dsi.fastutil.objects.Object2IntOpenHashMap;
+import it.unimi.dsi.fastutil.objects.ObjectIterator;
 import java.util.Collection;
 
 /**
@@ -30,11 +31,11 @@ import java.util.Collection;
  */
 public final class ChunkCreatureCensus {
 
-    private final TObjectIntHashMap<Class> counts = new TObjectIntHashMap<Class>();
+    private final Object2IntOpenHashMap<Class> counts = new Object2IntOpenHashMap<Class>();
 
     /** The sum for one creature class. Zero when nothing of that class is loaded. */
     public int count(Class creatureClass) {
-        return this.counts.get(creatureClass);
+        return this.counts.getInt(creatureClass);
     }
 
     /** Applies one chunk-level change. Called only while the chunk is in the provider's map. */
@@ -43,7 +44,7 @@ public final class ChunkCreatureCensus {
             return;
         }
 
-        int now = this.counts.adjustOrPutValue(creatureClass, delta, delta);
+        int now = this.counts.addTo(creatureClass, delta) + delta; // addTo answers the value before
 
         if (now == 0) {
             this.counts.remove(creatureClass);
@@ -71,13 +72,13 @@ public final class ChunkCreatureCensus {
     }
 
     private void fold(Chunk chunk, int sign) {
-        // Iterate rather than calling keys(), which builds an Object[] per call. This runs on every
+        // A fast iterator hands back one reused entry rather than one per mapping. This runs on every
         // chunk load and unload, and the audit runs it over every loaded chunk once a tick.
-        TObjectIntIterator<Class> iterator = chunk.entityCount.iterator();
+        ObjectIterator<Object2IntMap.Entry<Class>> iterator = chunk.entityCount.object2IntEntrySet().fastIterator();
 
         while (iterator.hasNext()) {
-            iterator.advance();
-            this.adjust(iterator.key(), sign * iterator.value());
+            Object2IntMap.Entry<Class> entry = iterator.next();
+            this.adjust(entry.getKey(), sign * entry.getIntValue());
         }
     }
 
@@ -99,23 +100,17 @@ public final class ChunkCreatureCensus {
     public String describeDifference(ChunkCreatureCensus expected) {
         StringBuilder builder = new StringBuilder();
 
-        TObjectIntIterator<Class> wanted = expected.counts.iterator();
+        for (Object2IntMap.Entry<Class> wanted : expected.counts.object2IntEntrySet()) {
+            int have = this.counts.getInt(wanted.getKey());
 
-        while (wanted.hasNext()) {
-            wanted.advance();
-            int have = this.counts.get(wanted.key());
-
-            if (wanted.value() != have) {
-                builder.append("\n  ").append(wanted.key().getName()).append(": tracked ").append(have).append(", actual ").append(wanted.value());
+            if (wanted.getIntValue() != have) {
+                builder.append("\n  ").append(wanted.getKey().getName()).append(": tracked ").append(have).append(", actual ").append(wanted.getIntValue());
             }
         }
 
-        TObjectIntIterator<Class> tracked = this.counts.iterator();
-
-        while (tracked.hasNext()) {
-            tracked.advance();
-            if (!expected.counts.containsKey(tracked.key())) {
-                builder.append("\n  ").append(tracked.key().getName()).append(": tracked ").append(tracked.value()).append(", actual 0");
+        for (Object2IntMap.Entry<Class> tracked : this.counts.object2IntEntrySet()) {
+            if (!expected.counts.containsKey(tracked.getKey())) {
+                builder.append("\n  ").append(tracked.getKey().getName()).append(": tracked ").append(tracked.getIntValue()).append(", actual 0");
             }
         }
 
