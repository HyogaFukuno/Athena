+
+    /**
+     * The display name (chat, plugins' messages) for the mask and disguise: the name everyone sees
+     * (the disguise's or the real one) in the mask's colour, or in the Regular rank's green when
+     * disguised without a mask. With neither, the real display name comes back. The real one is kept
+     * from when the first of them went on, so changing the mask or picking a new disguise keeps it.
+     */
+    public void athenaUpdateDisplayName() {
+        EntityPlayer self = getHandle();
+        String color = self.athenaMask != null ? self.athenaMasks.get(self.athenaMask)
+                : self.athenaDisguise != null ? org.bukkit.ChatColor.DARK_GREEN.toString() : null;
+        if (color == null) {
+            if (this.athenaRealDisplayName != null) {
+                setDisplayName(this.athenaRealDisplayName);
+                this.athenaRealDisplayName = null;
+            }
+            return;
+        }
+        if (this.athenaRealDisplayName == null) {
+            this.athenaRealDisplayName = getDisplayName();
+        }
+        setDisplayName(color + (self.athenaDisguise != null ? self.athenaDisguise.getName() : getName()) + org.bukkit.ChatColor.RESET);
+    }
