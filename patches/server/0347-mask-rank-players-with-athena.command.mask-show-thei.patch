@@ -27,6 +27,9 @@ import org.bukkit.event.player.PlayerTeleportEvent;
  * createWorld's second half); gradual teleports are AthenaTeleportQueue's, drained in the tick loop.
  */
 public final class AthenaServerImpl implements AthenaServer {
+    /** A mask's colour: 1 to 4 colour or format codes, as a 1.8 team prefix leaves room for before a name. */
+    private static final java.util.regex.Pattern MASK_COLOR = java.util.regex.Pattern.compile("(&[0-9a-fk-orA-FK-OR]){1,4}");
+
 
     // Athena - every method here works on the chunk map, the preload and teleport queues or a
     // player, none of which is safe off the server thread: each checks the thread the way Bukkit's
@@ -188,6 +191,30 @@ public final class AthenaServerImpl implements AthenaServer {
         ((org.bukkit.craftbukkit.entity.CraftPlayer) player).getHandle().athenaChatColor = color;
     }
 
+    @Override
+    public void setMasks(Player player, java.util.Map<String, String> masks) {
+        org.spigotmc.AsyncCatcher.catchOp("Athena set masks"); // Athena - server thread only; see the class comment
+        Validate.notNull(masks, "Masks may not be null");
+        java.util.Map<String, String> colors = new java.util.LinkedHashMap<String, String>();
+        for (java.util.Map.Entry<String, String> mask : masks.entrySet()) {
+            Validate.notNull(mask.getKey(), "A mask's name may not be null");
+            Validate.isTrue(mask.getValue() != null && MASK_COLOR.matcher(mask.getValue()).matches(), "Not 1 to 4 & colour codes: " + mask.getValue());
+            colors.put(mask.getKey(), org.bukkit.ChatColor.translateAlternateColorCodes('&', mask.getValue()));
+        }
+        org.bukkit.craftbukkit.entity.CraftPlayer craft = (org.bukkit.craftbukkit.entity.CraftPlayer) player;
+        net.minecraft.server.EntityPlayer handle = craft.getHandle();
+        handle.athenaMasks = java.util.Collections.unmodifiableMap(colors);
+        if (handle.athenaMask != null && !colors.containsKey(handle.athenaMask)) {
+            handle.athenaMask = null;
+        }
+        craft.athenaUpdateDisplayName();
+    }
+
+    @Override
+    public String getMask(Player player) {
+        return ((org.bukkit.craftbukkit.entity.CraftPlayer) player).getHandle().athenaMask;
+    }
+
     private static void checkPerTick(int perTick) {
         if (perTick < 1) {
             throw new IllegalArgumentException("perTick must be at least 1, was " + perTick);
diff --git a/src/main/java/athena/server/MaskCommand.java b/src/main/java/athena/server/MaskCommand.java
new file mode 100644
index 0000000000000000000000000000000000000000..e0cf9929c76cbb58d0d236bc136fa317d7fe864e
--- /dev/null
+++ b/src/main/java/athena/server/MaskCommand.java
@@ -0,0 +1,113 @@
+package athena.server;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import net.minecraft.server.EntityPlayer;
+import net.minecraft.server.MinecraftServer;
+import org.bukkit.ChatColor;
+import org.bukkit.command.Command;
+import org.bukkit.command.CommandSender;
+import org.bukkit.craftbukkit.entity.CraftPlayer;
+import org.bukkit.entity.Player;
+
+/**
+ * Athena - {@code /mask <rank>}: the player's name shows in a lower rank's colour (the display name:
+ * chat and the plugins' messages), and so does their disguise's, so that together with
+ * {@code /disguise} they pass for another player of that rank. Athena knows no ranks: the ranks a
+ * player may mask as, and their colours, come from the rank plugin (athena.api.Athena.setMasks).
+ * {@code reset} takes the mask off; it also comes off when the player leaves the server. Every mask
+ * goes to the server log with the player's real name, as disguises do.
+ */
+public final class MaskCommand extends Command {
+    private static final String RESET = "reset";
+
+    public MaskCommand(String name) {
+        super(name);
+        this.description = "Shows your name in a lower rank's colour";
+        this.usageMessage = "/mask <rank|reset>";
+        this.setPermission("athena.command.mask");
+    }
+
+    @Override
+    public boolean execute(CommandSender sender, String currentAlias, String[] args) {
+        if (!this.testPermission(sender)) {
+            return true;
+        }
+        if (!(sender instanceof Player)) {
+            sender.sendMessage(AthenaMessages.format("&cOnly a player can mask."));
+            return true;
+        }
+        CraftPlayer player = (CraftPlayer) sender;
+        EntityPlayer handle = player.getHandle();
+        Map<String, String> masks = handle.athenaMasks;
+        if (args.length != 1) {
+            if (handle.athenaMask != null) {
+                sender.sendMessage(AthenaMessages.formatRaw(ChatColor.WHITE + "You are masked as " + describe(handle, handle.athenaMask) + ChatColor.WHITE + "."));
+            }
+            sender.sendMessage(masks.isEmpty() ? AthenaMessages.format("&cThere are no ranks you can mask as.")
+                    : AthenaMessages.formatRaw(ChatColor.WHITE + "Ranks you can mask as: " + choices(handle)));
+            return true;
+        }
+
+        if (args[0].equalsIgnoreCase(RESET)) {
+            if (handle.athenaMask == null) {
+                sender.sendMessage(AthenaMessages.format("&cYou are not masked."));
+                return true;
+            }
+            handle.athenaMask = null;
+            player.athenaUpdateDisplayName();
+            MinecraftServer.LOGGER.info("[Mask] {} ({}) is no longer masked", player.getName(), player.getUniqueId());
+            sender.sendMessage(AthenaMessages.format("&fYour name is in your own rank's colour again."));
+            return true;
+        }
+        String mask = find(masks, args[0]);
+        if (mask == null) {
+            sender.sendMessage(masks.isEmpty() ? AthenaMessages.format("&cThere are no ranks you can mask as.")
+                    : AthenaMessages.formatRaw(ChatColor.RED + "You cannot mask as " + args[0] + ". Ranks you can mask as: " + choices(handle)));
+            return true;
+        }
+        handle.athenaMask = mask;
+        player.athenaUpdateDisplayName();
+        MinecraftServer.LOGGER.info("[Mask] {} ({}) masked as {}", player.getName(), player.getUniqueId(), mask);
+        sender.sendMessage(AthenaMessages.formatRaw(ChatColor.WHITE + "You are now masked as " + describe(handle, mask) + ChatColor.WHITE + "."));
+        return true;
+    }
+
+    @Override
+    public List<String> tabComplete(CommandSender sender, String alias, String[] args) {
+        List<String> names = new ArrayList<>();
+        if (args.length == 1 && sender instanceof CraftPlayer) {
+            for (String mask : ((CraftPlayer) sender).getHandle().athenaMasks.keySet()) {
+                names.add(mask.toLowerCase(Locale.ROOT));
+            }
+            names.add(RESET);
+            names.removeIf(name -> !name.startsWith(args[0].toLowerCase(Locale.ROOT)));
+        }
+        return names;
+    }
+
+    /** The mask named {@code name}, ignoring case, or null. */
+    private static String find(Map<String, String> masks, String name) {
+        for (String mask : masks.keySet()) {
+            if (mask.equalsIgnoreCase(name)) {
+                return mask;
+            }
+        }
+        return null;
+    }
+
+    private static String describe(EntityPlayer handle, String mask) {
+        return handle.athenaMasks.get(mask) + mask + ChatColor.RESET;
+    }
+
+    /** {@code Regular, Gold.}, each in its colour: already coloured, for {@link AthenaMessages#formatRaw}. */
+    private static String choices(EntityPlayer handle) {
+        StringBuilder text = new StringBuilder();
+        for (String mask : handle.athenaMasks.keySet()) {
+            text.append(text.length() == 0 ? "" : ", ").append(describe(handle, mask));
+        }
+        return text + ".";
+    }
+}
