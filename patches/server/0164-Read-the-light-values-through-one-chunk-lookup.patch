diff --git a/src/main/java/net/minecraft/server/AthenaIndexAudit.java b/src/main/java/net/minecraft/server/AthenaIndexAudit.java
index 33d03961f136a6cff3e033d9b1767ebc4da10fa3..eca7a7c159098495faa7d2185b145b9351ebfe8a 100644
--- a/src/main/java/net/minecraft/server/AthenaIndexAudit.java
+++ b/src/main/java/net/minecraft/server/AthenaIndexAudit.java
@@ -41,6 +41,8 @@ public final class AthenaIndexAudit {
     private static long powerChecks;
     private static long powerChecksSkippedBlocks;
 
+    private static long lightChunkChecks;
+
     private static long mismatches;
     private static int reports;
     private static int lastSummaryTick;
@@ -132,6 +134,28 @@ public final class AthenaIndexAudit {
         }
     }
 
+    // ------------------------------------------------------------------ light
+
+    /**
+     * Verifies the assumption getLightFor and setLightFor now make: that once getChunkIfLoaded has
+     * found a chunk, getOrCreateChunk under the same coordinates hands back the very same object.
+     * That is what lets the light path drop its second lookup, and it is a claim about
+     * ChunkProviderServer's map rather than about anything in this class - so it is checked here
+     * instead of in a unit test, on the same live-server run that exercises the flood fill.
+     */
+    public static void auditLightChunk(World world, int x, int z, Chunk found) {
+        ++lightChunkChecks;
+
+        Chunk viaProvider = world.getChunkAtWorldCoords(x, z);
+
+        if (viaProvider != found) {
+            report("getChunkIfLoaded and getOrCreateChunk disagree at chunk " + (x >> 4) + ", " + (z >> 4)
+                    + " in " + world.getWorld().getName() + " (light path got "
+                    + System.identityHashCode(found) + ", provider got " + System.identityHashCode(viaProvider)
+                    + "); the light queries would be reading the wrong chunk");
+        }
+    }
+
     // ------------------------------------------------------------------
 
     private static void report(String message) {
@@ -156,13 +180,14 @@ public final class AthenaIndexAudit {
         }
 
         lastSummaryTick = currentTick;
-        LOGGER.info("checks: chunkQueue={} ({} non-empty, max {} entries), pendingTicks={} ({} non-empty, max {} entries), skippedPower={} | mismatches={}",
+        LOGGER.info("checks: chunkQueue={} ({} non-empty, max {} entries), pendingTicks={} ({} non-empty, max {} entries), skippedPower={}, lightChunk={} | mismatches={}",
                 queueChecks, queueChecksNonEmpty, queueMaxSize,
                 pendingChecks, pendingChecksNonEmpty, pendingMaxSize,
                 powerChecksSkippedBlocks,
+                lightChunkChecks,
                 mismatches);
 
-        if (queueChecksNonEmpty == 0 && pendingChecksNonEmpty == 0 && powerChecksSkippedBlocks == 0) {
+        if (queueChecksNonEmpty == 0 && pendingChecksNonEmpty == 0 && powerChecksSkippedBlocks == 0 && lightChunkChecks == 0) {
             LOGGER.warn("No audited structure has been non-empty yet - the test is not exercising "
                     + "the changed paths. Move across chunk borders, run a redstone circuit, and let mobs spawn.");
         }
