         }
     }
 
-    public int getBrightness(EnumSkyBlock enumskyblock, BlockPosition blockposition) {
-        int i = blockposition.getX() & 15;
-        int j = blockposition.getY();
-        int k = blockposition.getZ() & 15;
-        ChunkSection chunksection = this.sections[j >> 4];
+    // Athena start - scalar brightness lookup.
+    //
+    // The light flood fill reads this for every cell it visits and for all six neighbours of every
+    // cell, and each read had to build a BlockPosition just to have three ints taken back out of
+    // it again. The bodies below are the BlockPosition versions with the accessors substituted.
+    public int getBrightness(EnumSkyBlock enumskyblock, int x, int y, int z) {
+        int i = x & 15;
+        int k = z & 15;
+        ChunkSection chunksection = this.sections[y >> 4];
+
+        return chunksection == null ? (this.canSeeSky(x, y, z) ? enumskyblock.defaultLightValue : 0) : (enumskyblock == EnumSkyBlock.SKY ? (this.world.worldProvider.getHasNoSky() ? 0 : chunksection.getExtSkylightValue(i, y & 15, k)) : (enumskyblock == EnumSkyBlock.BLOCK ? chunksection.getExtBlocklightValue(i, y & 15, k) : enumskyblock.defaultLightValue));
+    }
 
-        return chunksection == null ? (this.canSeeSky(blockposition) ? enumskyblock.defaultLightValue : 0) : (enumskyblock == EnumSkyBlock.SKY ? (this.world.worldProvider.getHasNoSky() ? 0 : chunksection.getExtSkylightValue(i, j & 15, k)) : (enumskyblock == EnumSkyBlock.BLOCK ? chunksection.getExtBlocklightValue(i, j & 15, k) : enumskyblock.defaultLightValue));
+    public boolean canSeeSky(int x, int y, int z) {
+        return y >= this.heightMap[(z & 15) << 4 | (x & 15)];
+    }
+    // Athena end
+
+    public int getBrightness(EnumSkyBlock enumskyblock, BlockPosition blockposition) {
+        return this.getBrightness(enumskyblock, blockposition.getX(), blockposition.getY(), blockposition.getZ()); // Athena - scalar
     }
 
     public void setLightFor(EnumSkyBlock enumskyblock, BlockPosition blockposition, int i) {
@@ -827,11 +840,7 @@ public class Chunk {
     }
 
     public boolean canSeeSky(BlockPosition blockposition) {
-        int i = blockposition.getX() & 15;
-        int j = blockposition.getY();
-        int k = blockposition.getZ() & 15;
-
-        return j >= this.heightMap[k << 4 | i];
+        return this.canSeeSky(blockposition.getX(), blockposition.getY(), blockposition.getZ()); // Athena - scalar
     }
 
     private TileEntity createNewTileEntity(BlockPosition blockposition) {
