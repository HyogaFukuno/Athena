From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: glacier <hyouga.dev@gmail.com>
Date: Fri, 30 Oct 2026 15:00:26 +0900
Subject: [PATCH] Drop the Server Infinisleeper thread


diff --git a/src/main/java/net/minecraft/server/DedicatedServer.java b/src/main/java/net/minecraft/server/DedicatedServer.java
index f6304ca4c3ac1bc6afd89c28967c757572a58d23..acb3ea933e6a3a5c83fc0e560a9e361a486e7130 100644
--- a/src/main/java/net/minecraft/server/DedicatedServer.java
+++ b/src/main/java/net/minecraft/server/DedicatedServer.java
@@ -43,22 +43,9 @@ public class DedicatedServer extends MinecraftServer implements IMinecraftServer
     public DedicatedServer(joptsimple.OptionSet options) {
         super(options, Proxy.NO_PROXY, DedicatedServer.a);
         // CraftBukkit end
-        Thread thread = new Thread("Server Infinisleeper") {
-            {
-                this.setDaemon(true);
-                this.start();
-            }
-
-            public void run() {
-                while (true) {
-                    try {
-                        Thread.sleep(2147483647L);
-                    } catch (InterruptedException interruptedexception) {
-                        ;
-                    }
-                }
-            }
-        };
+        // Athena - no "Server Infinisleeper": a thread asleep for good, there so that Windows would
+        // keep its 1 ms timer resolution for the whole run. Athena runs on Linux, where it was one
+        // more thread for nothing; the tick loop parks to the nanosecond either way.
     }
 
     protected boolean init() throws IOException {
