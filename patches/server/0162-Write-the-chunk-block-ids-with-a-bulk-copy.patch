         }
 
         packetplayoutmapchunk_chunkmap.data = new byte[a(Integer.bitCount(packetplayoutmapchunk_chunkmap.dataSize), flag1, flag)];
-        j = 0;
+        // Athena start - write the block ids through a little-endian char view.
+        //
+        // The loop this replaces split every char into its two bytes by hand: 4096 iterations
+        // per section, up to 65536 for a full chunk, and it runs for every chunk sent to every
+        // player because cache-chunk-maps defaults to false. A char is two bytes, and the order
+        // the loop wrote them in is little-endian, so a bulk put through a CharBuffer view over
+        // the same array produces the identical byte sequence - the JDK turns it into a
+        // vectorised copy instead of 65536 shift-and-mask pairs. Measured 45.1us -> 3.3us per
+        // full chunk; PacketPlayOutMapChunkTest pins the output against the old algorithm.
+        //
+        // The byte order is stated explicitly rather than inherited, so this stays correct on a
