diff --git a/src/test/java/net/minecraft/server/PacketPlayOutMapChunkTest.java b/src/test/java/net/minecraft/server/PacketPlayOutMapChunkTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..ab2580498eb0b8f496d9efe552ffc8deacc348bb
--- /dev/null
+++ b/src/test/java/net/minecraft/server/PacketPlayOutMapChunkTest.java
@@ -0,0 +1,129 @@
+package net.minecraft.server;
+
+import static org.junit.Assert.assertArrayEquals;
+import static org.junit.Assert.assertEquals;
+
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.nio.CharBuffer;
+import java.util.Random;
+import org.junit.Test;
+
+/**
+ * Athena - getExtractedData writes the block ids with a bulk CharBuffer put instead of splitting
+ * every char into two bytes by hand.
+ *
+ * <p>getExtractedData needs a live Chunk, so these tests pin the transform itself: the bulk put and
+ * the loop it replaced are run over the same buffer and must produce the same bytes and the same
+ * end offset. The loop below is the vanilla code verbatim - if the production copy is ever changed
+ * to a different byte order or a different element width, this stops agreeing with it.
+ */
+public class PacketPlayOutMapChunkTest {
+
+    /** The vanilla loop, kept exactly as it was written. */
+    private static int writeByHand(char[][] sections, byte[] data) {
+        int j = 0;
+
+        for (char[] achar : sections) {
+            char[] achar1 = achar;
+            int k = achar.length;
+
+            for (int l = 0; l < k; ++l) {
+                char c0 = achar1[l];
+
+                data[j++] = (byte) (c0 & 255);
+                data[j++] = (byte) (c0 >> 8 & 255);
+            }
+        }
+
+        return j;
+    }
+
+    /** What getExtractedData now does. */
+    private static int writeInBulk(char[][] sections, byte[] data) {
+        CharBuffer charbuffer = ByteBuffer.wrap(data).order(ByteOrder.LITTLE_ENDIAN).asCharBuffer();
+
+        for (char[] achar : sections) {
+            charbuffer.put(achar);
+        }
+
+        return charbuffer.position() * 2;
+    }
+
+    private static char[][] sections(int count, Random random) {
+        char[][] sections = new char[count][4096];
+
+        for (char[] section : sections) {
+            for (int i = 0; i < section.length; ++i) {
+                // Ids are packed as extension << 12 | id << 4 | data, so exercise the full width
+                // of the char rather than only the low byte.
+                section[i] = (char) random.nextInt(1 << 16);
+            }
+        }
+
+        return sections;
+    }
+
+    private void assertAgrees(int sectionCount, boolean skyLight, boolean biomes) {
+        Random random = new Random(sectionCount * 31L + (skyLight ? 2 : 0) + (biomes ? 1 : 0));
+        char[][] sections = sections(sectionCount, random);
+        int size = PacketPlayOutMapChunk.a(sectionCount, skyLight, biomes);
+
+        // Fill both buffers with a marker first, so a short write shows up as a difference in the
+        // light and biome region rather than as two matching runs of zeroes.
+        byte[] expected = new byte[size];
+        byte[] actual = new byte[size];
+        java.util.Arrays.fill(expected, (byte) 0xA5);
+        java.util.Arrays.fill(actual, (byte) 0xA5);
+
+        int expectedEnd = writeByHand(sections, expected);
+        int actualEnd = writeInBulk(sections, actual);
+
+        String what = sectionCount + " sections, skyLight=" + skyLight + ", biomes=" + biomes;
+
+        assertEquals("block id region ends at a different offset for " + what, expectedEnd, actualEnd);
+        assertEquals("block id region is not two bytes per block for " + what, sectionCount * 4096 * 2, actualEnd);
+        assertArrayEquals("bytes differ for " + what, expected, actual);
+    }
+
+    @Test
+    public void agreesForAFullChunk() {
+        assertAgrees(16, true, true);
+    }
+
+    @Test
+    public void agreesForASingleSection() {
+        assertAgrees(1, true, true);
+    }
+
+    @Test
+    public void agreesWithNoSections() {
+        assertAgrees(0, true, true);
+    }
+
+    @Test
+    public void agreesWithoutSkyLight() {
+        // The nether path: no sky light array follows the block ids.
+        assertAgrees(16, false, true);
+    }
+
+    @Test
+    public void agreesWithoutBiomes() {
+        // A partial chunk update: no biome array is appended.
+        assertAgrees(8, true, false);
+    }
+
+    @Test
+    public void writesTheLowByteFirst() {
+        // The wire format is little-endian; a big-endian view would pass every test above only if
+        // it were applied to both sides, so state the expected layout directly once.
+        char[][] sections = {new char[4096]};
+        sections[0][0] = (char) 0xBEEF;
+
+        byte[] data = new byte[PacketPlayOutMapChunk.a(1, true, true)];
+        writeInBulk(sections, data);
+
+        assertEquals((byte) 0xEF, data[0]);
+        assertEquals((byte) 0xBE, data[1]);
+    }
+}
