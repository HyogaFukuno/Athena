 //                                        per-slice IMonster and EntityHuman counts
 //   ChunkSection block counts           water, lava, fire, and blocks that react to an entity
 //                                        standing in them - all mirror the blocks the section holds
+//   ChunkSection.tickingBits            mirrors which positions hold a randomly ticking block, and
+//   Chunk.tickingSectionMask            promises, where a bit is clear, that the section is idle
 //
 // The census audit earns its keep: the site check in auditCensusSite found a real divergence in
 // live play, where a decrement was applied to a class entityCount had no entry for.
@@ -38,6 +40,7 @@ public final class AthenaIndexAudit {
     private static long censusChecksNonEmpty;
 
     private static int liquidCursor;
+    private static long tickingBitChecks; // Athena
     private static long liquidChecks;
     private static long liquidChecksNonEmpty;
 
@@ -313,6 +316,12 @@ public final class AthenaIndexAudit {
         for (int i = 0; i < sections.length; ++i) {
             ChunkSection section = sections[i];
 
+            // Athena - a clear bit in the chunk's section mask promises the random tick has nothing here
+            if ((chunk.tickingSectionMask & 1 << i) == 0 && section != null && section.shouldTick()) {
+                report("section " + i + " of chunk " + chunk.locX + "," + chunk.locZ
+                        + " holds ticking blocks but the chunk's tickingSectionMask has it cleared");
+            }
+
             if (section == null) {
                 continue;
             }
@@ -341,6 +350,14 @@ public final class AthenaIndexAudit {
                         if (block != Blocks.AIR && block.hasEntityCollisionHandler()) {
                             ++handlers;
                         }
+
+                        // Athena - the random tick's bitmap, position by position
