diff --git a/src/main/java/net/minecraft/server/Chunk.java b/src/main/java/net/minecraft/server/Chunk.java
index 029979452082e6a64a378af660b8a35cf3f10e67..04e487c08b2698f5171148b3f2880a43a5d4a17f 100644
--- a/src/main/java/net/minecraft/server/Chunk.java
+++ b/src/main/java/net/minecraft/server/Chunk.java
@@ -29,6 +29,29 @@ public class Chunk {
 
     private static final Logger logger = LogManager.getLogger();
     private final ChunkSection[] sections;
+    // Athena start - which sections the random tick has to look at, one bit per section.
+    //
+    // A set bit means "may tick"; a clear bit is a promise that the section is null or holds no
+    // ticking block, so WorldServer.tickBlocks can skip it without loading the section at all. The
+    // bits are cleared lazily - the tick clears one when it finds the section idle - and set again
+    // eagerly, from the only two ways a section can start ticking: a new section placed into the
+    // array (every such site calls setTickingSection), or a ticking block arriving in a section
+    // whose bit was cleared (the section remembers this chunk as its tickingMaskOwner). The
+    // production profile had the section walk alone at 5% of the server thread, most sections
+    // being solid stone or empty.
+    int tickingSectionMask = 0xFFFF;
+
+    void setTickingSection(int index) {
+        this.tickingSectionMask |= 1 << index;
+    }
+
+    void clearTickingSection(int index, ChunkSection section) {
+        this.tickingSectionMask &= ~(1 << index);
+        if (section != null) {
+            section.tickingMaskOwner = this;
+        }
+    }
+    // Athena end
     private final byte[] blockBiomeArray;
     private final int[] precipitationHeightMap;
     private final boolean[] updateSkylightColumns;
@@ -657,6 +680,7 @@ public class Chunk {
                 }
 
                 chunksection = this.sections[j >> 4] = new ChunkSection(j >> 4 << 4, !this.world.worldProvider.getHasNoSky());
+                this.setTickingSection(j >> 4); // Athena
                 flag = j >= i1;
             }
 
@@ -753,6 +777,7 @@ public class Chunk {
 
         if (chunksection == null) {
             chunksection = this.sections[k >> 4] = new ChunkSection(k >> 4 << 4, !this.world.worldProvider.getHasNoSky());
+            this.setTickingSection(k >> 4); // Athena
             this.initLighting();
         }
 
@@ -1661,6 +1686,8 @@ public class Chunk {
                 this.sections[i] = achunksection[i];
             }
 
+            this.tickingSectionMask = 0xFFFF; // Athena - every section is new
+
         }
     }
 
