+                        if (section.isTickingAt(y << 8 | z << 4 | x) != block.isTicking()) {
+                            report("ticking bit at " + x + "," + y + "," + z + " of section " + i + " of chunk "
+                                    + chunk.locX + "," + chunk.locZ + " says " + !block.isTicking()
+                                    + " but the block there is " + block);
+                        }
                     }
                 }
             }
@@ -401,10 +418,11 @@ public final class AthenaIndexAudit {
         }
 
         lastSummaryTick = currentTick;
-        LOGGER.info("checks: census={} ({} non-empty), entityBuckets={} ({} indexed, {} entities), sectionLiquids={} ({} non-empty), verticalOffset={} | mismatches={}",
+        LOGGER.info("checks: census={} ({} non-empty), entityBuckets={} ({} indexed, {} entities), sectionLiquids={} ({} non-empty), tickingBits={}, verticalOffset={} | mismatches={}",
                 censusChecks, censusChecksNonEmpty,
                 bucketChecks, bucketChecksIndexed, bucketEntities,
                 liquidChecks, liquidChecksNonEmpty,
+                tickingBitChecks,
