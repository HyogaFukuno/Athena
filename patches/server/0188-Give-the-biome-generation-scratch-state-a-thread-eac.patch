From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: glacier <hyouga.dev@gmail.com>
Date: Tue, 25 Aug 2026 13:05:31 +0900
Subject: [PATCH] Give the biome generation scratch state a thread each

IntCache handed the same int[] to two threads: resetIntCache() moves every
in-use array onto the free lists, so one thread's working array becomes the
next caller's. Each thread gets its own cache now, which cannot change what
GenLayer produces because it treats the arrays as scratch it always fully
overwrites.

BiomeBigHills, BiomeSavanna and BiomeTaiga chose their surface blocks by
writing topBlock/fillerBlock on the shared biome singleton and reading them
back. That choice is per-thread now. It has to keep working the same way and
not simply become a local, because WorldGenCaves and WorldGenCanyon read the
current value when they floor a carved opening - the last column shaped in a
chunk decides the cave floor, and every column of a chunk plus its carving run
on one thread in the original order.

BiomeMesa built its noise tables lazily into fields of the shared singleton
with no lock, which would let one thread read half-published arrays.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>

diff --git a/src/main/java/net/minecraft/server/BiomeBase.java b/src/main/java/net/minecraft/server/BiomeBase.java
index e7e48fda03f758d528893f1eebeff103eb1ae904..edfef87cd9e0629899bfd8e7592600a20455a2c9 100644
--- a/src/main/java/net/minecraft/server/BiomeBase.java
+++ b/src/main/java/net/minecraft/server/BiomeBase.java
@@ -264,14 +264,67 @@ public abstract class BiomeBase {
         return this.enableSnow;
     }
 
+    // Athena start - per-thread terrain-shaping block choice.
+    //
+    // BiomeBigHills, BiomeSavanna and BiomeTaiga pick their surface and filler blocks from the
+    // stone noise of the column being shaped, and used to do it by writing topBlock/fillerBlock on
+    // the biome singleton and reading them back a few lines later. Those singletons are shared by
+    // every world and every thread, so with shaping running on a worker two chunks in the same
+    // biome would interleave a write and a read and lay down the wrong surface.
+    //
+    // The choice is now per-thread. That is not just thread safety, it is what keeps the terrain
+    // identical: WorldGenCaves and WorldGenCanyon read the *current* value when they floor a
+    // carved opening, so the quirk that the last column shaped in a chunk decides the cave floor
+    // has to survive. All 256 columns of a chunk and the carving that follows them run on one
+    // thread in the original order, so each thread sees exactly the sequence the server thread
+    // used to see on its own.
+    //
+    // topBlock/fillerBlock themselves are now written only by constructors, and stay the fallback
+    // for any thread that has not shaped a column of this biome.
+    private static final class ShapingBlocks {
+
+        IBlockData top;
+        IBlockData filler;
+    }
+
+    private final ThreadLocal<BiomeBase.ShapingBlocks> shapingBlocks = new ThreadLocal<BiomeBase.ShapingBlocks>();
+
+    protected final void setShapingBlocks(IBlockData iblockdata, IBlockData iblockdata1) {
+        BiomeBase.ShapingBlocks shapingblocks = this.shapingBlocks.get();
+
+        if (shapingblocks == null) {
+            shapingblocks = new BiomeBase.ShapingBlocks();
+            this.shapingBlocks.set(shapingblocks);
+        }
+
+        shapingblocks.top = iblockdata;
+        shapingblocks.filler = iblockdata1;
+    }
+
+    public final IBlockData getShapingTopBlock() {
+        BiomeBase.ShapingBlocks shapingblocks = this.shapingBlocks.get();
+
+        return shapingblocks == null ? this.topBlock : shapingblocks.top;
+    }
+
+    public final IBlockData getShapingFillerBlock() {
+        BiomeBase.ShapingBlocks shapingblocks = this.shapingBlocks.get();
+
+        return shapingblocks == null ? this.fillerBlock : shapingblocks.filler;
+    }
+    // Athena end
+
     public void genTerrainBlocks(World world, Random random, ChunkSnapshot chunksnapshot, int i, int j, double d0) {
         this.generateBiomeTerrain(world, random, chunksnapshot, i, j, d0);
     }
 
     public final void generateBiomeTerrain(World world, Random random, ChunkSnapshot chunksnapshot, int i, int j, double d0) {
         int k = world.getSeaLevel();
-        IBlockData iblockdata = this.topBlock;
-        IBlockData iblockdata1 = this.fillerBlock;
+        // Athena - resolve the per-thread shaping choice once; it is read again inside the column scan
+        IBlockData shapingTop = this.getShapingTopBlock();
+        IBlockData shapingFiller = this.getShapingFillerBlock();
+        IBlockData iblockdata = shapingTop;
+        IBlockData iblockdata1 = shapingFiller;
         int l = -1;
         int i1 = (int) (d0 / 3.0D + 3.0D + random.nextDouble() * 0.25D);
         int j1 = i & 15;
@@ -297,8 +350,8 @@ public abstract class BiomeBase {
                             iblockdata = null;
                             iblockdata1 = stone; // Athena - hoisted
                         } else if (l1 >= k - 4 && l1 <= k + 1) {
-                            iblockdata = this.topBlock;
-                            iblockdata1 = this.fillerBlock;
+                            iblockdata = shapingTop; // Athena - per-thread shaping choice
+                            iblockdata1 = shapingFiller; // Athena - per-thread shaping choice
                         }
 
                         if (l1 < k && (iblockdata == null || iblockdata.getBlock().getMaterial() == Material.AIR)) {
