-    private static List<int[]> freeLargeArrays = Lists.newArrayList();
-    private static List<int[]> inUseLargeArrays = Lists.newArrayList();
+    // Athena start - give every thread its own scratch arrays.
+    //
+    // The lists below used to be static and shared. The `synchronized` kept them from being
+    // structurally corrupted, but it never made the *arrays* safe: resetIntCache() moves every
+    // in-use array back onto the free lists, so one thread calling it hands another thread's
+    // working array straight to the next caller. The biome data being generated in that array is
+    // then silently overwritten mid-flight.
+    //
+    // That is harmless while only the server thread runs GenLayer, and fatal the moment chunk
+    // shaping runs on a worker. A cache per thread removes the sharing entirely, and it cannot
+    // change what any generator produces: GenLayer treats these arrays as pure scratch and always
+    // writes every element it later reads, so the recycled contents were never observable.
+    //
+    // The methods stay static so that no call site has to change.
+    private static final class Cache {
 
-    public static synchronized int[] getIntCache(int i) {
+        private int intCacheSize = 256;
+        private final List<int[]> freeSmallArrays = Lists.newArrayList();
+        private final List<int[]> inUseSmallArrays = Lists.newArrayList();
+        private final List<int[]> freeLargeArrays = Lists.newArrayList();
+        private final List<int[]> inUseLargeArrays = Lists.newArrayList();
+    }
+
+    private static final ThreadLocal<Cache> caches = new ThreadLocal<Cache>() {
+        @Override
+        protected Cache initialValue() {
+            return new Cache();
+        }
+    };
+
+    public static int[] getIntCache(int i) {
+        Cache cache = IntCache.caches.get();
         int[] aint;
 
         if (i <= 256) {
-            if (IntCache.freeSmallArrays.isEmpty()) {
