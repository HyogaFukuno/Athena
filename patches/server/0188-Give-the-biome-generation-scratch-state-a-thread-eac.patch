                 aint = new int[256];
-                if (inUseSmallArrays.size() < org.spigotmc.SpigotConfig.intCacheLimit) IntCache.inUseSmallArrays.add(aint);
+                if (cache.inUseSmallArrays.size() < org.spigotmc.SpigotConfig.intCacheLimit) cache.inUseSmallArrays.add(aint);
                 return aint;
             } else {
-                aint = (int[]) IntCache.freeSmallArrays.remove(IntCache.freeSmallArrays.size() - 1);
-                if (inUseSmallArrays.size() < org.spigotmc.SpigotConfig.intCacheLimit) IntCache.inUseSmallArrays.add(aint);
+                aint = (int[]) cache.freeSmallArrays.remove(cache.freeSmallArrays.size() - 1);
+                if (cache.inUseSmallArrays.size() < org.spigotmc.SpigotConfig.intCacheLimit) cache.inUseSmallArrays.add(aint);
                 return aint;
             }
-        } else if (i > IntCache.intCacheSize) {
