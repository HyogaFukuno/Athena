From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: glacier <hyouga.dev@gmail.com>
Date: Mon, 9 Nov 2026 23:43:41 +0900
Subject: [PATCH] A template section's block counts are counted once per store

Every load of a mapped template section recounted its 4096 blocks through MemorySegment: 16% of all CPU on 8 rooms of bots, on the chunk IO threads, for counts that cannot change. The store now keeps each packed or raw section's counts after the first load, and the loader skips recalcBlockCounts when the store set them. The ticking bitmap is copied per section.

diff --git a/src/main/java/net/minecraft/server/AthenaSectionStore.java b/src/main/java/net/minecraft/server/AthenaSectionStore.java
index 5b75345d4b5e86b032f0e50e3172c0c75dedf821..290250db0c58167f7c79af6f99d2e039fb001ae3 100644
--- a/src/main/java/net/minecraft/server/AthenaSectionStore.java
+++ b/src/main/java/net/minecraft/server/AthenaSectionStore.java
@@ -107,6 +107,9 @@ final class AthenaSectionStore {
     // Athena - payload validation is lazy and shared by every world using this immutable mapping.
     // One bit per section avoids scanning its packed bytes again on the next chunk load.
     private volatile java.util.concurrent.atomic.AtomicIntegerArray validatedPackedSections;
+    // Athena - each packed or raw section's counts once some load has counted them (ChunkSection.AthenaCounts),
+    // by chunk index * 16 + section y. Shared, like the mapping, by every world on this template.
+    private volatile java.util.concurrent.atomic.AtomicReferenceArray<ChunkSection.AthenaCounts> counts;
 
     private AthenaSectionStore(MemorySegment mapping, long[] keys, long entries) {
         this.mapping = mapping;
@@ -391,9 +394,34 @@ final class AthenaSectionStore {
         if (sky) {
             section.setSkylightArray(this.light(skyLight));
         }
+        if (kind(ids) != KIND_UNIFORM) { // a uniform section counts itself without a block read
+            this.applyCounts(index * 16 + sectionY, section);
+        }
         return true;
     }
 
+    private void applyCounts(int slot, ChunkSection section) {
+        java.util.concurrent.atomic.AtomicReferenceArray<ChunkSection.AthenaCounts> counts = this.counts;
+
+        if (counts == null) {
+            synchronized (this) {
+                counts = this.counts;
+                if (counts == null) {
+                    this.counts = counts = new java.util.concurrent.atomic.AtomicReferenceArray<ChunkSection.AthenaCounts>(this.keys.length * 16);
+                }
+            }
+        }
+        ChunkSection.AthenaCounts known = counts.get(slot);
+
+        if (known == null) {
+            section.recalcBlockCounts(); // from the mapped ids just set
+            counts.set(slot, section.athenaCounts()); // two loaders racing count the same blocks
+            section.athenaMarkCountsKnown();
+            return;
+        }
+        section.athenaSetCounts(known);
+    }
+
     // one per thread that reads chunks: the chunk IO threads and the server thread
     private static final ThreadLocal<java.util.zip.Inflater> INFLATER = ThreadLocal.withInitial(java.util.zip.Inflater::new);
 
