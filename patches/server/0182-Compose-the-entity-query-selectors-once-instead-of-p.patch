+        // Athena start - compose the three selectors once instead of per shouldExecute() call.
+        // Predicates.and stores its arguments in a list and walks that list for every candidate
+        // the entity query returns; none of the three components is ever reassigned.
+        final Predicate<Entity> canBeSeen = this.canBeSeenSelector;
+        final Predicate avoidTarget = predicate;
+        this.composedSelector = new Predicate<Entity>() {
+            public boolean apply(Entity entity) {
+                // same order and same tests as Predicates.and(NOT_SPECTATING, canBeSeen, avoidTarget)
+                return (!(entity instanceof EntityHuman) || !((EntityHuman) entity).isSpectator())
+                    && canBeSeen.apply(entity) && avoidTarget.apply(entity);
+            }
+        };
+        // Athena end
     }
 
     @Override
     public boolean shouldExecute() {
-        List list = this.theEntity.world.getEntitiesWithinAABB(this.classToAvoid, Math.min(this.theEntity.boundingBoxMinX - (double) this.avoidDistance, this.theEntity.boundingBoxMaxX + (double) this.avoidDistance), Math.min(this.theEntity.boundingBoxMinY - 3.0D, this.theEntity.boundingBoxMaxY + 3.0D), Math.min(this.theEntity.boundingBoxMinZ - (double) this.avoidDistance, this.theEntity.boundingBoxMaxZ + (double) this.avoidDistance), Math.max(this.theEntity.boundingBoxMinX - (double) this.avoidDistance, this.theEntity.boundingBoxMaxX + (double) this.avoidDistance), Math.max(this.theEntity.boundingBoxMinY - 3.0D, this.theEntity.boundingBoxMaxY + 3.0D), Math.max(this.theEntity.boundingBoxMinZ - (double) this.avoidDistance, this.theEntity.boundingBoxMaxZ + (double) this.avoidDistance), Predicates.and(new Predicate[]{IEntitySelector.NOT_SPECTATING, this.canBeSeenSelector, this.avoidTargetSelector}));
+        List list = this.theEntity.world.getEntitiesWithinAABB(this.classToAvoid, Math.min(this.theEntity.boundingBoxMinX - (double) this.avoidDistance, this.theEntity.boundingBoxMaxX + (double) this.avoidDistance), Math.min(this.theEntity.boundingBoxMinY - 3.0D, this.theEntity.boundingBoxMaxY + 3.0D), Math.min(this.theEntity.boundingBoxMinZ - (double) this.avoidDistance, this.theEntity.boundingBoxMaxZ + (double) this.avoidDistance), Math.max(this.theEntity.boundingBoxMinX - (double) this.avoidDistance, this.theEntity.boundingBoxMaxX + (double) this.avoidDistance), Math.max(this.theEntity.boundingBoxMinY - 3.0D, this.theEntity.boundingBoxMaxY + 3.0D), Math.max(this.theEntity.boundingBoxMinZ - (double) this.avoidDistance, this.theEntity.boundingBoxMaxZ + (double) this.avoidDistance), this.composedSelector); // Athena - see the constructor
 
