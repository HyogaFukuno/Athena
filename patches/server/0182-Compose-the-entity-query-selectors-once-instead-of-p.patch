@@ -14,6 +14,29 @@ public class PathfinderGoalNearestAttackableTarget<T extends EntityLiving> exten
     protected final PathfinderGoalNearestAttackableTarget.DistanceComparator theNearestAttackableTargetSorter;
     protected Predicate targetEntitySelector;
     protected EntityLiving targetEntity;
+    // Athena start - keep the composed selector instead of building a Guava AndPredicate per call.
+    // shouldExecute built Predicates.and(targetEntitySelector, NOT_SPECTATING) on every run, and
+    // the composite walks its argument list once per candidate the query returns. Subclasses
+    // reassign targetEntitySelector (EntityIronGolem does), so the cache is keyed on the instance
+    // it was composed from rather than built once in the constructor.
+    private Predicate composedSelector;
+    private Predicate composedFrom;
+
+    private Predicate composedSelector() {
+        if (this.composedFrom != this.targetEntitySelector) {
+            final Predicate inner = this.targetEntitySelector;
+            this.composedFrom = inner;
+            this.composedSelector = new Predicate() {
+                public boolean apply(Object object) {
+                    // same order and same tests Predicates.and(inner, NOT_SPECTATING) applied
+                    return inner.apply(object)
+                        && (!(object instanceof EntityHuman) || !((EntityHuman) object).isSpectator());
+                }
+            };
+        }
+        return this.composedSelector;
+    }
+    // Athena end
 
     public PathfinderGoalNearestAttackableTarget(EntityCreature entitycreature, Class<T> oclass, boolean flag) {
         this(entitycreature, oclass, flag, false);
