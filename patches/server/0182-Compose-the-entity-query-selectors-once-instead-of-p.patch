From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: glacier <hyouga.dev@gmail.com>
Date: Fri, 28 Aug 2026 13:07:21 +0900
Subject: [PATCH] Compose the entity-query selectors once instead of per call

collideWithNearbyEntities runs for every living entity on every tick and built
an anonymous Predicate and a Guava AndPredicate on each call; AndPredicate walks
its argument list once per candidate the query returns, and its apply was 11.9%
of the server thread under an entity-heavy load - second only to the entity query
itself. The two pathfinder target goals composed their selectors the same way,
once per shouldExecute.

Each composite is replaced by a single predicate that runs the same tests in the
same order. The nearest-attackable-target goal caches its composite against the
selector instance it was built from, because subclasses reassign that field.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>

diff --git a/src/main/java/net/minecraft/server/EntityLiving.java b/src/main/java/net/minecraft/server/EntityLiving.java
index fa24815b4a651836648e965a6d26dc979f1b20c6..614500318be0192100ca411e4185925a219223f1 100644
--- a/src/main/java/net/minecraft/server/EntityLiving.java
+++ b/src/main/java/net/minecraft/server/EntityLiving.java
@@ -1697,16 +1697,23 @@ public abstract class EntityLiving extends Entity {
 
     protected void doTick() {}
 
-    protected void collideWithNearbyEntities() {
-        List list = this.world.getEntitiesInAABBexcluding((Entity) this, Math.min(this.boundingBoxMinX - 0.20000000298023224D, this.boundingBoxMaxX + 0.20000000298023224D), Math.min(this.boundingBoxMinY - 0.0D, this.boundingBoxMaxY + 0.0D), Math.min(this.boundingBoxMinZ - 0.20000000298023224D, this.boundingBoxMaxZ + 0.20000000298023224D), Math.max(this.boundingBoxMinX - 0.20000000298023224D, this.boundingBoxMaxX + 0.20000000298023224D), Math.max(this.boundingBoxMinY - 0.0D, this.boundingBoxMaxY + 0.0D), Math.max(this.boundingBoxMinZ - 0.20000000298023224D, this.boundingBoxMaxZ + 0.20000000298023224D), Predicates.and(IEntitySelector.NOT_SPECTATING, new Predicate() {
-            public boolean a(Entity entity) {
-                return entity.canBePushed();
-            }
+    // Athena start - one shared predicate instead of a fresh Guava AndPredicate every tick.
+    // collideWithNearbyEntities runs for every living entity on every tick, and each call built
+    // an anonymous Predicate and wrapped it with IEntitySelector.NOT_SPECTATING in a
+    // Predicates.and - which stores its arguments in a list and walks that list for every
+    // candidate the query returns. Predicates$AndPredicate.apply was 11.9% of the server thread
+    // under an entity-heavy load, more than any frame except the entity query itself.
+    // The two tests are in the order Predicates.and evaluated them, and both are pure, so the
+    // answer for any entity is the same one the composite gave.
+    private static final Predicate<Entity> NOT_SPECTATING_AND_PUSHABLE = new Predicate<Entity>() {
+        public boolean apply(Entity entity) {
+            return (!(entity instanceof EntityHuman) || !((EntityHuman) entity).isSpectator()) && entity.canBePushed();
+        }
+    };
+    // Athena end
 
-            public boolean apply(Object object) {
-                return this.a((Entity) object);
-            }
-        }));
+    protected void collideWithNearbyEntities() {
+        List list = this.world.getEntitiesInAABBexcluding((Entity) this, Math.min(this.boundingBoxMinX - 0.20000000298023224D, this.boundingBoxMaxX + 0.20000000298023224D), Math.min(this.boundingBoxMinY - 0.0D, this.boundingBoxMaxY + 0.0D), Math.min(this.boundingBoxMinZ - 0.20000000298023224D, this.boundingBoxMaxZ + 0.20000000298023224D), Math.max(this.boundingBoxMinX - 0.20000000298023224D, this.boundingBoxMaxX + 0.20000000298023224D), Math.max(this.boundingBoxMinY - 0.0D, this.boundingBoxMaxY + 0.0D), Math.max(this.boundingBoxMinZ - 0.20000000298023224D, this.boundingBoxMaxZ + 0.20000000298023224D), NOT_SPECTATING_AND_PUSHABLE); // Athena - see above
 
         if (this.canBeCollidedWith() && !list.isEmpty()) { // Spigot: Add this.ad() condition
             numCollisions -= world.spigotConfig.maxCollisionsPerEntity; // Spigot
