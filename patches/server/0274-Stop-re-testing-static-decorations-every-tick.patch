     private static void activateChunkEntities(Chunk chunk)
     {
+        // Athena start - a chunk with no monster or animal has only misc entities to activate.
+        //
+        // Every chunk within 32 blocks of every player comes through here each tick, and a map's
+        // decorations sit in a handful of them: Lobby_Games keeps 394 of its 461 item frames in the
+        // four chunks around its spawn. Every player near the centre re-tested every one of them
+        // every tick, nearly all outside the 16-block misc range and so failing. An always-active
+        // entity (a player, a projectile) needs nothing from here - its activatedTick is never read -
+        // so in such a chunk only misc entities inside the misc box matter, and the slice's bucket
+        // index finds exactly those candidates without visiting the rest.
+        if ( chunk.activationMobCount == 0 )
+        {
+            activateChunkMisc( chunk );
+            return;
+        }
+        // Athena end
         // Athena start - only the slices that hold something, walked by index.
         //
         // Every chunk within range of every player comes through here each tick, and each of its
@@ -224,6 +239,57 @@ public class ActivationRange
         }
     }
 
+    // Athena start - see activateChunkEntities
+    private static void activateChunkMisc(Chunk chunk)
+    {
+        int mask = chunk.nonEmptySliceMask;
+
+        while ( mask != 0 )
+        {
+            int k = Integer.numberOfTrailingZeros( mask );
+            mask &= mask - 1;
+            List<Entity>[] buckets = chunk.activationBuckets( k );
+
+            if ( buckets == null )
+            {
+                activateMisc( chunk.entitySlices[ k ] );
+                continue;
+            }
+
+            int hiX = chunk.activationBucketHiX( miscBBMaxX );
+            int loZ = chunk.activationBucketLoZ( k, miscBBMinZ );
+            int hiZ = chunk.activationBucketHiZ( miscBBMaxZ );
+
+            for ( int bx = chunk.activationBucketLoX( k, miscBBMinX ); bx <= hiX; ++bx )
+            {
+                for ( int bz = loZ; bz <= hiZ; ++bz )
+                {
+                    List<Entity> bucket = buckets[ bx << 2 | bz ];
+
+                    if ( bucket != null )
+                    {
+                        activateMisc( bucket );
+                    }
+                }
+            }
+        }
+    }
+
+    private static void activateMisc(List<Entity> entities)
+    {
+        for ( int index = 0, size = entities.size(); index < size; ++index )
+        {
+            Entity entity = entities.get( index );
+
+            if ( MinecraftServer.currentTick > entity.activatedTick && !entity.defaultActivationState
+                    && AxisAlignedBBHelper.intersects( miscBBMinX, miscBBMinY, miscBBMinZ, miscBBMaxX, miscBBMaxY, miscBBMaxZ, entity.boundingBoxMinX, entity.boundingBoxMinY, entity.boundingBoxMinZ, entity.boundingBoxMaxX, entity.boundingBoxMaxY, entity.boundingBoxMaxZ ) )
+            {
+                entity.activatedTick = MinecraftServer.currentTick;
+            }
+        }
+    }
+    // Athena end
+
