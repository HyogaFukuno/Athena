--- a/src/main/java/net/minecraft/server/AthenaIndexAudit.java
+++ b/src/main/java/net/minecraft/server/AthenaIndexAudit.java
@@ -319,6 +319,19 @@ public final class AthenaIndexAudit {
         Chunk chunk = (Chunk) chunks[Math.floorMod(liquidCursor++, chunks.length)];
         ChunkSection[] sections = chunk.getSections();
 
+        // Athena - the activation range skips a chunk outside the misc range whose count is zero
+        int mobs = 0;
+        for (int i = 0; i < chunk.entitySlices.length; ++i) {
+            for (Entity entity : chunk.entitySlices[i]) {
+                if (entity.activationType != 3) ++mobs;
+            }
+        }
+        ++sliceMaskChecks;
+        if (mobs != chunk.activationMobCount) {
+            report("chunk " + chunk.locX + "," + chunk.locZ + " holds " + mobs
+                    + " monsters and animals but activationMobCount says " + chunk.activationMobCount);
+        }
+
         for (int i = 0; i < sections.length; ++i) {
             ChunkSection section = sections[i];
 
