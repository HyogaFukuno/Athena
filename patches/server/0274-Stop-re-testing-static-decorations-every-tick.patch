     public void track(List<EntityHuman> list) {
+        // Athena start - a hanging entity nobody watches, that has not moved or changed, is a counter.
+        //
+        // Maps are dressed with hundreds of item frames and paintings, and each came through the whole
+        // of this method every tick: the item frame block below reads the frame's item through its
+        // data watcher, and everything after it asks the same questions again. With no viewer every
+        // broadcast here is a no-op, and when the entity is where it was last scanned, rides nothing,
+        // has no new metadata, velocity or airborne flag, and its update interval (never, for a
+        // hanging entity) has not come round, the only thing the method changes is updateCounter.
+        // Viewers are added by EntityTracker's walk over moving players, not here, so nothing is
+        // lost; the first entity to break one of these conditions takes the full path as before.
+        if (this.hanging && this.viewerCount == 0 && this.isMoving && this.w == null) {
+            Entity entity = this.tracker;
+
+            if (entity.vehicle == null && !entity.velocityChanged && !entity.isAirBorne
+                    && this.updateCounter % this.updateFrequency != 0
+                    && !entity.getDataWatcher().hasObjectChanged()
+                    && entity.getDistanceSq(this.lastTrackedEntityPosX, this.lastTrackedEntityPosY, this.lastTrackedEntityPosZ) <= 16.0D) {
+                this.playerEntitiesUpdated = false;
+                ++this.updateCounter;
+                return;
+            }
+        }
+        // Athena end
         this.playerEntitiesUpdated = false;
         if (!this.isMoving || this.tracker.getDistanceSq(this.lastTrackedEntityPosX, this.lastTrackedEntityPosY, this.lastTrackedEntityPosZ) > 16.0D) {
             this.lastTrackedEntityPosX = this.tracker.locX;
@@ -190,9 +215,9 @@ public class EntityTrackerEntry {
 
         if (this.tracker instanceof EntityItemFrame /*&& this.m % 10 == 0*/) { // CraftBukkit - Moved below, should always enter this block
             EntityItemFrame entityitemframe = (EntityItemFrame) this.tracker;
-            ItemStack itemstack = entityitemframe.getItem();
