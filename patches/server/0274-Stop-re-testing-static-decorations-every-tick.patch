@@ -982,6 +986,16 @@ public class Chunk {
 
     // Athena - accessors for AthenaIndexAudit only
     List<Entity>[] auditBuckets(int slice) { return this.entityBuckets[slice]; }
+
+    // Athena start - the bucket range of a slice that holds every entity whose box can reach x in
+    // [minX, maxX] and z in [minZ, maxZ], for the activation range; the same arithmetic as the
+    // positional query in getEntities. activationBuckets is null for a slice with no index.
+    public List<Entity>[] activationBuckets(int slice) { return this.entityBuckets[slice]; }
+    public int activationBucketLoX(int slice, double minX) { return this.bucketOf(minX - this.bucketPadX[slice]); }
+    public int activationBucketHiX(double maxX) { return this.bucketOf(maxX); }
+    public int activationBucketLoZ(int slice, double minZ) { return this.bucketOfZ(minZ - this.bucketPadZ[slice]); }
+    public int activationBucketHiZ(double maxZ) { return this.bucketOfZ(maxZ); }
+    // Athena end
     int auditBucketIndexOf(double x, double z) { return this.bucketIndexOf(x, z); }
     int auditBucketPadX(int slice) { return this.bucketPadX[slice]; }
     int auditBucketPadZ(int slice) { return this.bucketPadZ[slice]; }
@@ -1020,6 +1034,7 @@ public class Chunk {
         entity.chunkCoordZ = this.locZ;
         this.entitySlices[k].add(entity);
         this.nonEmptySliceMask |= 1 << k; // Athena
+        if (entity.activationType != 3) ++this.activationMobCount; // Athena
         // Athena start - register with the bucket index, building it if the slice has grown enough
         entity.athenaChunk = this;
         entity.athenaBucket = -1;
@@ -1100,6 +1115,7 @@ public class Chunk {
         }
 
         if (!this.entitySlices[i].remove(entity)) return; // PandaSpigot
+        if (entity.activationType != 3) --this.activationMobCount; // Athena
