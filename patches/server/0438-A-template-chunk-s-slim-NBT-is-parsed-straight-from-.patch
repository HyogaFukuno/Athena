         }
diff --git a/src/main/java/net/minecraft/server/NBTTagIntArray.java b/src/main/java/net/minecraft/server/NBTTagIntArray.java
index c9ba23cd30332f12168f443369952578519d2eb7..9ada95cb10303abbed84313f1623654e885c3573 100644
--- a/src/main/java/net/minecraft/server/NBTTagIntArray.java
+++ b/src/main/java/net/minecraft/server/NBTTagIntArray.java
@@ -33,6 +33,10 @@ public class NBTTagIntArray extends NBTBase {
         nbtreadlimiter.read((long) (32 * j));
         this.data = new int[j];
 
+        if (datainput instanceof AthenaBytesInput) {
+            ((AthenaBytesInput) datainput).readInts(this.data); // Athena - in one pass
+            return;
+        }
         for (int k = 0; k < j; ++k) {
             this.data[k] = datainput.readInt();
         }
diff --git a/src/test/java/net/minecraft/server/AthenaBytesInputTest.java b/src/test/java/net/minecraft/server/AthenaBytesInputTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..639e7c928243e698a381be988f9caffcd2417c49
--- /dev/null
+++ b/src/test/java/net/minecraft/server/AthenaBytesInputTest.java
@@ -0,0 +1,160 @@
+package net.minecraft.server;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertTrue;
+import static org.junit.Assert.fail;
+
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.DataInput;
+import java.io.DataInputStream;
+import java.io.DataOutputStream;
+import java.io.EOFException;
+import java.util.Random;
+import org.bukkit.support.AbstractTestingBase;
+import org.junit.Test;
+
+/** Athena - AthenaBytesInput reads what a DataInputStream over the same bytes reads, NBT included. */
+public class AthenaBytesInputTest extends AbstractTestingBase {
+
+    @Test
+    public void everyReadMatchesADataInputStream() throws Exception {
+        Random random = new Random(7L);
+
+        for (int round = 0; round < 2000; ++round) {
+            byte[] bytes = new byte[random.nextInt(64)];
+
+            random.nextBytes(bytes);
+            int[] ops = new int[20];
+
+            for (int i = 0; i < ops.length; ++i) {
+                ops[i] = random.nextInt(11);
+            }
+            assertEquals("round " + round, run(new DataInputStream(new ByteArrayInputStream(bytes)), ops), run(new AthenaBytesInput(bytes, 0, bytes.length), ops));
+        }
+    }
+
+    /** What the reads give, up to the first one that runs out, as text. */
+    private static String run(DataInput in, int[] ops) {
+        StringBuilder out = new StringBuilder();
+
+        try {
+            for (int op : ops) {
+                switch (op) {
+                    case 0: out.append(in.readByte()); break;
+                    case 1: out.append(in.readUnsignedByte()); break;
+                    case 2: out.append(in.readShort()); break;
+                    case 3: out.append(in.readUnsignedShort()); break;
+                    case 4: out.append((int) in.readChar()); break;
+                    case 5: out.append(in.readInt()); break;
+                    case 6: out.append(in.readLong()); break;
+                    case 7: out.append(Float.floatToRawIntBits(in.readFloat())); break;
+                    case 8: out.append(Double.doubleToRawLongBits(in.readDouble())); break;
+                    case 9: out.append(in.readBoolean()); break;
+                    default: {
+                        byte[] b = new byte[3];
+
+                        in.readFully(b);
+                        out.append(java.util.Arrays.toString(b));
+                    }
+                }
+                out.append(',');
+            }
+        } catch (EOFException e) {
+            out.append("EOF");
+        } catch (Exception e) {
+            out.append(e.getClass().getSimpleName());
+        }
+        return out.toString();
+    }
+
+    @Test
+    public void stringsDecodeAsDataInputStreamDecodesThem() throws Exception {
+        String[] strings = {"", "chest", "Ä ö ü ß", "日本語の看板", "\u0000nul", "😀 surrogates", "§aColour"};
+        ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+        DataOutputStream out = new DataOutputStream(bytes);
+
+        for (String s : strings) {
+            out.writeUTF(s);
+        }
+        byte[] b = bytes.toByteArray();
+        AthenaBytesInput in = new AthenaBytesInput(b, 0, b.length);
+
+        for (String s : strings) {
+            assertEquals(s, in.readUTF());
+        }
+        try {
+            in.readUTF();
+            fail("past the end");
+        } catch (EOFException expected) {
+        }
+    }
+
+    @Test
+    public void nbtReadsAsBefore() throws Exception {
+        Random random = new Random(11L);
+
+        for (int round = 0; round < 200; ++round) {
+            NBTTagCompound root = new NBTTagCompound();
+            NBTTagCompound level = new NBTTagCompound();
+            int[] heights = new int[256];
+
+            for (int i = 0; i < heights.length; ++i) {
+                heights[i] = random.nextInt();
+            }
+            level.setIntArray("HeightMap", heights);
+            level.setIntArray("Empty", new int[0]);
+            byte[] biomes = new byte[256];
+
+            random.nextBytes(biomes);
+            level.setByteArray("Biomes", biomes);
+            level.setLong("InhabitedTime", random.nextLong());
+            level.setDouble("d", random.nextDouble());
+            level.setFloat("f", random.nextFloat());
+            level.setShort("s", (short) random.nextInt());
+            level.setString("name", "sign line " + random.nextInt() + " 日本");
+            NBTTagList list = new NBTTagList();
+
+            for (int i = 0; i < random.nextInt(5); ++i) {
+                NBTTagCompound tile = new NBTTagCompound();
+
+                tile.setString("id", "Chest");
+                tile.setInt("x", random.nextInt());
+                tile.setIntArray("ints", new int[] {random.nextInt(), random.nextInt()});
+                list.add(tile);
+            }
+            level.set("TileEntities", list);
+            root.set("Level", level);
+
+            ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+
+            NBTCompressedStreamTools.write(root, (java.io.DataOutput) new DataOutputStream(bytes));
+            byte[] b = bytes.toByteArray();
+            NBTTagCompound before = NBTCompressedStreamTools.read((DataInput) new DataInputStream(new ByteArrayInputStream(b)), new NBTReadLimiter(1L << 23));
+            NBTTagCompound now = NBTCompressedStreamTools.read((DataInput) new AthenaBytesInput(b, 0, b.length), new NBTReadLimiter(1L << 23));
+
+            assertEquals(before, now);
+            assertEquals(root, now);
+        }
+    }
+
+    @Test
+    public void aCutShortIntArrayRunsOut() throws Exception {
+        NBTTagCompound root = new NBTTagCompound();
+
+        root.setIntArray("a", new int[] {1, 2, 3, 4});
+        ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+
+        NBTCompressedStreamTools.write(root, (java.io.DataOutput) new DataOutputStream(bytes));
+        byte[] b = bytes.toByteArray();
+
+        try {
+            NBTCompressedStreamTools.read((DataInput) new AthenaBytesInput(b, 0, b.length - 6), new NBTReadLimiter(1L << 23));
+            fail("cut short");
+        } catch (EOFException expected) {
+            assertTrue(true);
+        } catch (RuntimeException wrapped) {
+            assertTrue(String.valueOf(wrapped), wrapped.getCause() instanceof EOFException);
+        }
+    }
+}
diff --git a/src/test/java/net/minecraft/server/AthenaHeapIdsTiming.java b/src/test/java/net/minecraft/server/AthenaHeapIdsTiming.java
new file mode 100644
index 0000000000000000000000000000000000000000..3265fc948e2a923d14e422c5858895e2fdf61345
--- /dev/null
+++ b/src/test/java/net/minecraft/server/AthenaHeapIdsTiming.java
@@ -0,0 +1,85 @@
+package net.minecraft.server;
+
+import java.io.File;
+import org.bukkit.support.AbstractTestingBase;
+import org.junit.Assume;
+import org.junit.Test;
+
+/**
+ * Athena - not a test: times getType on a real template's mapped sections, read off the mapping
+ * and from the store's heap copy (ChunkSection.mappedStateIdAt). Runs only with
+ * ATHENA_TIMING_TEMPLATE set to a template folder that has a built store; run it with C1 alone
+ * (JAVA_TOOL_OPTIONS=-XX:TieredStopAtLevel=1) as the small servers run.
+ */
+public class AthenaHeapIdsTiming extends AbstractTestingBase {
+
+    @Test
+    public void time() throws Exception {
+        String path = System.getenv("ATHENA_TIMING_TEMPLATE");
+
+        Assume.assumeTrue(path != null);
+        AthenaSectionStore store = AthenaSectionStore.open(new File(path));
+
+        if (store == null) {
+            AthenaSectionStore.awaitBuilds();
+            store = AthenaSectionStore.open(new File(path));
+        }
+        java.lang.reflect.Field reads = ChunkSection.class.getDeclaredField("mappedReads");
+
+        reads.setAccessible(true);
+        java.util.List<ChunkSection> mapped = new java.util.ArrayList<ChunkSection>();
+        java.util.List<ChunkSection> heap = new java.util.ArrayList<ChunkSection>();
+
+        for (int x = -40; x <= 40 && mapped.size() < 1500; ++x) {
+            for (int z = -40; z <= 40 && mapped.size() < 1500; ++z) {
+                for (int y = 0; y < 16; ++y) {
+                    ChunkSection a = new ChunkSection(y << 4, true);
+                    ChunkSection b = new ChunkSection(y << 4, true);
+
+                    if (store.apply(x, z, y, a, true) && a.isMapped() && store.apply(x, z, y, b, true)) {
+                        reads.setInt(a, Integer.MIN_VALUE); // never takes the heap copy
+                        for (int i = 0; i < AthenaSectionStore.HEAP_AFTER; ++i) {
+                            b.getType(0, 0, 0);
+                        }
+                        if (b.athenaReadsHeapCopy()) {
+                            mapped.add(a);
+                            heap.add(b);
+                        }
+                    }
+                }
+            }
+        }
+        System.out.println("sections: " + mapped.size());
+        java.util.Random random = new java.util.Random(1L);
+        int[] at = new int[1 << 16];
+
+        for (int i = 0; i < at.length; ++i) {
+            at[i] = random.nextInt(4096);
+        }
+        long sink = 0;
+
+        for (int round = 0; round < 8; ++round) {
+            long a = System.nanoTime();
+
+            for (ChunkSection section : mapped) {
+                for (int i = 0; i < 400; ++i) {
+                    int k = at[(int) (i * 31 + sink) & (at.length - 1)];
+                    sink += section.getType(k & 15, k >> 8, k >> 4 & 15).hashCode() & 1;
+                }
+            }
+            long b = System.nanoTime();
+
+            for (ChunkSection section : heap) {
+                for (int i = 0; i < 400; ++i) {
+                    int k = at[(int) (i * 31 + sink) & (at.length - 1)];
+                    sink += section.getType(k & 15, k >> 8, k >> 4 & 15).hashCode() & 1;
+                }
+            }
+            long c = System.nanoTime();
+            long n = 400L * mapped.size();
+
+            System.out.printf("round %d: off the mapping %.1f ns, heap copy %.1f ns a getType%n", round, (b - a) / (double) n, (c - b) / (double) n);
+        }
+        System.out.println(sink == 42 ? "" : "done");
+    }
+}
