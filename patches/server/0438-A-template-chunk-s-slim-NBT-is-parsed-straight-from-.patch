@@ -0,0 +1,101 @@
+package net.minecraft.server;
+
+import java.io.File;
+import org.bukkit.support.AbstractTestingBase;
+import org.junit.Assume;
+import org.junit.Test;
+
+/**
+ * Athena - not a test: times a template chunk load from its section store, part by part: the slim
+ * NBT (inflating and parsing it), the chunk built from it, and the copies of its tile entities'
+ * NBT. Runs only with ATHENA_TIMING_TEMPLATE set to a template folder that has a built store:
+ * ATHENA_TIMING_TEMPLATE=/path/to/map_fallen_haven ./gradlew :PandaSpigot-Server:test --tests '*AthenaTemplateLoadTiming'
+ */
+public class AthenaTemplateLoadTiming extends AbstractTestingBase {
+
+    @Test
+    public void time() throws Exception {
+        String path = System.getenv("ATHENA_TIMING_TEMPLATE");
+
+        Assume.assumeTrue(path != null);
+        File dir = new File(path);
+        AthenaSectionStore store = AthenaSectionStore.open(dir);
+
+        if (store == null) {
+            AthenaSectionStore.awaitBuilds();
+            store = AthenaSectionStore.open(dir);
+        }
+        java.util.List<long[]> chunks = new java.util.ArrayList<long[]>();
+
+        for (int x = -200; x <= 200; ++x) {
+            for (int z = -200; z <= 200; ++z) {
+                if (store.hasSlim(x, z)) {
+                    chunks.add(new long[] {x, z});
+                }
+            }
+        }
+        WorldServer world = AthenaAuditFixtures.world();
+
+        world.worldProvider = new WorldProviderNormal();
+        AthenaTemplateChunkLoader loader = new AthenaTemplateChunkLoader(dir);
+        long tileEntities = 0, entities = 0, slimBytes = 0;
+
+        for (int round = 0; round < 8; ++round) {
+            long read = 0, build = 0, copy = 0;
+
+            for (long[] c : chunks) {
+                int x = (int) c[0], z = (int) c[1];
+                long a = System.nanoTime();
+                NBTTagCompound slim = store.chunk(x, z);
+                long b = System.nanoTime();
+                Object[] data = loader.loadChunk(world, x, z);
+                long d = System.nanoTime();
+                NBTTagCompound level = ((NBTTagCompound) data[1]).getCompound("Level");
+                NBTTagCompound copied = (NBTTagCompound) level.clone();
+                long e = System.nanoTime();
+
+                read += b - a;
+                build += (d - b) - (b - a); // loadChunk reads the slim NBT again
+                copy += e - d;
+                if (round == 0) {
+                    tileEntities += level.getList("TileEntities", 10).size();
+                    entities += level.getList("Entities", 10).size();
+                    java.io.ByteArrayOutputStream out = new java.io.ByteArrayOutputStream();
+                    NBTCompressedStreamTools.write(slim, (java.io.DataOutput) new java.io.DataOutputStream(out));
+                    slimBytes += out.size();
+                }
+                if (copied == null) throw new AssertionError();
+            }
+            System.out.printf("round %d: %d chunks, read slim %.1f ms (%.1f us), build %.1f ms (%.1f us), NBT copy %.1f ms (%.1f us)%n",
+                    round, chunks.size(), read / 1e6, read / 1e3 / chunks.size(), build / 1e6, build / 1e3 / chunks.size(),
+                    copy / 1e6, copy / 1e3 / chunks.size());
+        }
+        System.out.printf("tile entities %d, entities %d, slim NBT %.1f KB a chunk%n", tileEntities, entities, slimBytes / 1024.0 / chunks.size());
+
+        // the parse alone, from the inflated bytes: through a DataInputStream as before, and through AthenaBytesInput
+        java.util.List<byte[]> inflated = new java.util.ArrayList<byte[]>();
+
+        for (long[] c : chunks) {
+            java.io.ByteArrayOutputStream out = new java.io.ByteArrayOutputStream();
+
+            NBTCompressedStreamTools.write(store.chunk((int) c[0], (int) c[1]), (java.io.DataOutput) new java.io.DataOutputStream(out));
+            inflated.add(out.toByteArray());
+        }
+        for (int round = 0; round < 8; ++round) {
+            long a = System.nanoTime();
+
+            for (byte[] bytes : inflated) {
+                NBTCompressedStreamTools.read((java.io.DataInput) new java.io.DataInputStream(new java.io.ByteArrayInputStream(bytes)), new NBTReadLimiter(1L << 23));
+            }
+            long b = System.nanoTime();
+
+            for (byte[] bytes : inflated) {
+                NBTCompressedStreamTools.read((java.io.DataInput) new AthenaBytesInput(bytes, 0, bytes.length), new NBTReadLimiter(1L << 23));
+            }
+            long c = System.nanoTime();
+
+            System.out.printf("parse round %d: DataInputStream %.1f us, AthenaBytesInput %.1f us a chunk%n", round,
+                    (b - a) / 1e3 / inflated.size(), (c - b) / 1e3 / inflated.size());
+        }
+    }
+}
