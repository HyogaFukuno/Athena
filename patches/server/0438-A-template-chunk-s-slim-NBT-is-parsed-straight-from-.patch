From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: glacier <hyouga.dev@gmail.com>
Date: Thu, 12 Nov 2026 04:32:05 +0900
Subject: [PATCH] A template chunk's slim NBT is parsed straight from its
 inflated bytes

A DataInputStream over a ByteArrayInputStream read every int through a synchronized read of the
stream, 256 of them for the height map alone. AthenaBytesInput reads the same values from the
array, NBTTagIntArray takes an int array in one pass, and strings still decode through
DataInputStream.readUTF. With C1, on map_fallen_haven's 4,305 chunks: 7.6 -> 3.5 us a chunk.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/src/main/java/net/minecraft/server/AthenaBytesInput.java b/src/main/java/net/minecraft/server/AthenaBytesInput.java
new file mode 100644
index 0000000000000000000000000000000000000000..88a7a1dd5deae2ba80f00167cd62c6a810a3cc6b
--- /dev/null
+++ b/src/main/java/net/minecraft/server/AthenaBytesInput.java
@@ -0,0 +1,133 @@
+package net.minecraft.server;
+
+import java.io.DataInput;
+import java.io.DataInputStream;
+import java.io.EOFException;
+import java.io.IOException;
+
+/**
+ * Athena - a DataInput over a byte array, for NBT already inflated into one (a template chunk's slim
+ * NBT, AthenaSectionStore.chunk). A DataInputStream over a ByteArrayInputStream reads every int
+ * through a synchronized read of the stream: a chunk's height map alone is 256 of them, and the
+ * slim NBT took some 12 us a chunk to read, as long as everything else in its load together. This
+ * reads the same values in the same order, and NBTTagIntArray takes an int array in one pass. The
+ * strings are read by DataInputStream.readUTF itself, so they decode exactly as before.
+ */
+final class AthenaBytesInput implements DataInput {
+
+    private final byte[] bytes;
+    private int at;
+    private final int end;
+
+    AthenaBytesInput(byte[] bytes, int from, int length) {
+        this.bytes = bytes;
+        this.at = from;
+        this.end = from + length;
+    }
+
+    private int take(int n) throws EOFException {
+        int from = this.at;
+
+        if (n < 0 || n > this.end - from) {
+            throw new EOFException();
+        }
+        this.at = from + n;
+        return from;
+    }
+
+    @Override
+    public void readFully(byte[] into) throws IOException {
+        this.readFully(into, 0, into.length);
+    }
+
+    @Override
+    public void readFully(byte[] into, int off, int len) throws IOException {
+        if (off < 0 || len < 0 || len > into.length - off) {
+            throw new IndexOutOfBoundsException();
+        }
+        System.arraycopy(this.bytes, this.take(len), into, off, len);
+    }
+
+    /** {@code into.length} ints, as that many readInt calls read them. */
+    void readInts(int[] into) throws IOException {
+        byte[] b = this.bytes;
+        int p = this.take(into.length * 4);
+
+        for (int i = 0; i < into.length; ++i, p += 4) {
+            into[i] = b[p] << 24 | (b[p + 1] & 255) << 16 | (b[p + 2] & 255) << 8 | b[p + 3] & 255;
+        }
+    }
+
+    @Override
+    public int skipBytes(int n) {
+        int skipped = Math.max(0, Math.min(n, this.end - this.at));
+
+        this.at += skipped;
+        return skipped;
+    }
+
+    @Override
+    public boolean readBoolean() throws IOException {
+        return this.readByte() != 0;
+    }
+
+    @Override
+    public byte readByte() throws IOException {
+        return this.bytes[this.take(1)];
+    }
+
+    @Override
+    public int readUnsignedByte() throws IOException {
+        return this.readByte() & 255;
+    }
+
+    @Override
+    public short readShort() throws IOException {
+        int p = this.take(2);
+
+        return (short) (this.bytes[p] << 8 | this.bytes[p + 1] & 255);
+    }
+
+    @Override
+    public int readUnsignedShort() throws IOException {
+        return this.readShort() & 0xFFFF;
+    }
+
+    @Override
+    public char readChar() throws IOException {
+        return (char) this.readShort();
+    }
+
+    @Override
+    public int readInt() throws IOException {
+        byte[] b = this.bytes;
+        int p = this.take(4);
+
+        return b[p] << 24 | (b[p + 1] & 255) << 16 | (b[p + 2] & 255) << 8 | b[p + 3] & 255;
+    }
+
+    @Override
+    public long readLong() throws IOException {
+        return (long) this.readInt() << 32 | this.readInt() & 0xFFFFFFFFL;
+    }
+
+    @Override
+    public float readFloat() throws IOException {
+        return Float.intBitsToFloat(this.readInt());
+    }
+
+    @Override
+    public double readDouble() throws IOException {
+        return Double.longBitsToDouble(this.readLong());
+    }
+
+    @Override
+    public String readLine() {
+        throw new UnsupportedOperationException(); // NBT has no lines
+    }
+
+    @Override
+    public String readUTF() throws IOException {
+        return DataInputStream.readUTF(this);
+    }
+}
