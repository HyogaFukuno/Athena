From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: WilyWork <hezodions@gmail.com>
Date: Wed, 1 Jul 2026 20:16:55 -0300
Subject: [PATCH] Add growable plant Block API

Introduce PandaGrowablePlant for age-based NMS plants and expose the data through the public Block API implementation.

This keeps the API-facing CraftBlock bridge and the underlying server abstraction in a single patch.

diff --git a/src/main/java/net/minecraft/server/BlockCactus.java b/src/main/java/net/minecraft/server/BlockCactus.java
index 85d89f2a279e3d0eb0f4da14240d5ebd3236ff5b..3f38733d1bb0dedfaf2d4ab0988ce70c6a9dc5a3 100644
--- a/src/main/java/net/minecraft/server/BlockCactus.java
+++ b/src/main/java/net/minecraft/server/BlockCactus.java
@@ -6,7 +6,7 @@ import org.bukkit.craftbukkit.event.CraftEventFactory; // CraftBukkit
 
 
 
-public class BlockCactus extends Block {
+public class BlockCactus extends Block implements PandaGrowablePlant { // PandaSpigot
 
     public static final BlockStateInteger AGE = BlockStateInteger.of("age", 0, 15);
 
@@ -117,6 +117,12 @@ public class BlockCactus extends Block {
         return ((Integer) iblockdata.get(BlockCactus.AGE)).intValue();
     }
 
+    // PandaSpigot start - expose shared plant growth state
+    public BlockStateInteger getGrowthState() {
+        return BlockCactus.AGE;
+    }
+    // PandaSpigot end
+
     protected BlockStateList getStateList() {
         return new BlockStateList(this, new IBlockState[] { BlockCactus.AGE});
     }
