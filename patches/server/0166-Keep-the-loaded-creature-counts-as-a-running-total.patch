diff --git a/src/main/java/net/minecraft/server/ChunkCreatureCensus.java b/src/main/java/net/minecraft/server/ChunkCreatureCensus.java
new file mode 100644
index 0000000000000000000000000000000000000000..32e8915d9bd0d9462859e2d97c888b44f088a0cd
--- /dev/null
+++ b/src/main/java/net/minecraft/server/ChunkCreatureCensus.java
@@ -0,0 +1,115 @@
+package net.minecraft.server;
+
+import gnu.trove.map.hash.TObjectIntHashMap;
+import java.util.Collection;
+
+/**
+ * Athena - running total of the per-chunk creature counts across a world's loaded chunks.
+ *
+ * <p>SpawnerCreature needs, once per creature type and once per tick, the sum of
+ * {@code chunk.entityCount.get(creatureClass)} over every chunk in ChunkProviderServer's map.
+ * PandaSpigot computed that by walking the whole map, so a world holding a few thousand chunks
+ * paid a few thousand hash lookups four times a tick. A live capture put it at 5.2% of the main
+ * thread during chunk generation.
+ *
+ * <p>This mirrors the same sum incrementally. It deliberately keys on the creature Class rather
+ * than on EnumCreatureType, so that it tracks whatever Chunk.entityCount tracks: if two creature
+ * types ever shared a class, Chunk would count an entity twice under that key and so would this.
+ *
+ * <p>The mirror is maintained at exactly two kinds of place:
+ * <ul>
+ *   <li>a chunk entering or leaving ChunkProviderServer.chunks, which adds or subtracts that
+ *       chunk's whole tally - see {@link #chunkAdded} and {@link #chunkRemoved};</li>
+ *   <li>Chunk.addEntity and Chunk.removeEntityAtIndex adjusting a count while the chunk is in the
+ *       map - see {@link #adjust}.</li>
+ * </ul>
+ *
+ * <p>A missed call site would leave the total drifting away from the truth, which is why
+ * debugVerifyAthenaIndexes recomputes the sum every tick and compares. See AthenaIndexAudit.
+ */
+public final class ChunkCreatureCensus {
+
+    private final TObjectIntHashMap<Class> counts = new TObjectIntHashMap<Class>();
+
+    /** The sum for one creature class. Zero when nothing of that class is loaded. */
+    public int count(Class creatureClass) {
+        return this.counts.get(creatureClass);
+    }
+
+    /** Applies one chunk-level change. Called only while the chunk is in the provider's map. */
+    public void adjust(Class creatureClass, int delta) {
+        if (delta == 0) {
+            return;
+        }
+
+        int now = this.counts.adjustOrPutValue(creatureClass, delta, delta);
+
+        if (now == 0) {
+            this.counts.remove(creatureClass);
+        }
+    }
+
+    /** Folds a chunk's whole tally in as it enters the map. */
+    public void chunkAdded(Chunk chunk) {
+        if (chunk.inCreatureCensus) {
+            return;
+        }
+
+        chunk.inCreatureCensus = true;
+        this.fold(chunk, 1);
+    }
+
+    /** Takes a chunk's whole tally back out as it leaves the map. */
+    public void chunkRemoved(Chunk chunk) {
+        if (!chunk.inCreatureCensus) {
+            return;
+        }
+
+        chunk.inCreatureCensus = false;
+        this.fold(chunk, -1);
+    }
+
+    private void fold(Chunk chunk, int sign) {
+        for (Object key : chunk.entityCount.keys()) {
+            this.adjust((Class) key, sign * chunk.entityCount.get(key));
+        }
+    }
+
+    /** Rebuilds the sum from scratch. For the audit, and for tests. */
+    public static ChunkCreatureCensus derivedFrom(Collection<Chunk> chunks) {
+        ChunkCreatureCensus census = new ChunkCreatureCensus();
+
+        for (Chunk chunk : chunks) {
+            for (Object key : chunk.entityCount.keys()) {
+                census.adjust((Class) key, chunk.entityCount.get(key));
+            }
+        }
+
+        return census;
+    }
+
+    public boolean matches(ChunkCreatureCensus other) {
+        return this.counts.equals(other.counts);
+    }
+
+    public String describeDifference(ChunkCreatureCensus expected) {
+        StringBuilder builder = new StringBuilder();
+
+        for (Object key : expected.counts.keys()) {
+            int want = expected.counts.get(key);
+            int have = this.counts.get(key);
+
+            if (want != have) {
+                builder.append("\n  ").append(((Class) key).getName()).append(": tracked ").append(have).append(", actual ").append(want);
+            }
+        }
+
+        for (Object key : this.counts.keys()) {
+            if (!expected.counts.containsKey(key)) {
+                builder.append("\n  ").append(((Class) key).getName()).append(": tracked ").append(this.counts.get(key)).append(", actual 0");
+            }
+        }
+
+        return builder.toString();
+    }
+}
