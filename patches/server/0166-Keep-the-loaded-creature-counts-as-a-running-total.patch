diff --git a/src/test/java/net/minecraft/server/ChunkCreatureCensusTest.java b/src/test/java/net/minecraft/server/ChunkCreatureCensusTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..377d2113d92ae3764a1ee3547845caac8d49cd62
--- /dev/null
+++ b/src/test/java/net/minecraft/server/ChunkCreatureCensusTest.java
@@ -0,0 +1,109 @@
+package net.minecraft.server;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import java.util.HashMap;
+import java.util.Map;
+import java.util.Random;
+import org.junit.Test;
+
+/**
+ * Athena - the creature census keeps a running total of what SpawnerCreature used to sum by walking
+ * every loaded chunk.
+ *
+ * <p>These tests cover the container: that a stream of adjustments lands on the same numbers a
+ * fresh sum would, that a count returning to zero is forgotten rather than left as a zero entry,
+ * and that matches() actually compares contents. Whether every call site that changes
+ * Chunk.entityCount also calls adjust() is not something a unit test can see - that is what the
+ * debugVerifyAthenaIndexes audit checks on a live server, by rebuilding the sum every tick.
+ */
+public class ChunkCreatureCensusTest {
+
+    // Stand-ins for the creature classes. The census only ever uses them as identities.
+    private static final Class<?>[] CLASSES = {String.class, Integer.class, Long.class, Double.class};
+
+    @Test
+    public void countsStartAtZero() {
+        ChunkCreatureCensus census = new ChunkCreatureCensus();
+
+        for (Class<?> c : CLASSES) {
+            assertEquals(0, census.count(c));
+        }
+    }
+
+    @Test
+    public void aCountBackAtZeroIsForgotten() {
+        // Left as an explicit zero entry, the map would never compare equal to a freshly derived
+        // one, and every audit tick would report a mismatch that is not really there.
+        ChunkCreatureCensus census = new ChunkCreatureCensus();
+
+        census.adjust(String.class, 3);
+        census.adjust(String.class, -3);
+
+        assertEquals(0, census.count(String.class));
+        assertTrue("a census back at zero should equal an empty one", census.matches(new ChunkCreatureCensus()));
+    }
+
+    @Test
+    public void matchesComparesContentsNotIdentity() {
+        ChunkCreatureCensus a = new ChunkCreatureCensus();
+        ChunkCreatureCensus b = new ChunkCreatureCensus();
+
+        a.adjust(String.class, 5);
+        assertFalse(a.matches(b));
+
+        b.adjust(String.class, 5);
+        assertTrue(a.matches(b));
+
+        b.adjust(Integer.class, 1);
+        assertFalse(a.matches(b));
+    }
+
+    @Test
+    public void describeDifferenceNamesBothDirections() {
+        ChunkCreatureCensus tracked = new ChunkCreatureCensus();
+        ChunkCreatureCensus actual = new ChunkCreatureCensus();
+
+        tracked.adjust(String.class, 2);   // tracked too low
+        actual.adjust(String.class, 7);
+        tracked.adjust(Integer.class, 4);  // tracked something that is not there
+
+        String message = tracked.describeDifference(actual);
+
+        assertTrue(message, message.contains("java.lang.String: tracked 2, actual 7"));
+        assertTrue(message, message.contains("java.lang.Integer: tracked 4, actual 0"));
+    }
+
+    @Test
+    public void staysInStepWithAFullRecount() {
+        // Drive a long random sequence of adjustments through the census while keeping the same
+        // numbers by hand, and compare after every step.
+        ChunkCreatureCensus census = new ChunkCreatureCensus();
+        Map<Class<?>, Integer> reference = new HashMap<Class<?>, Integer>();
+        Random random = new Random(20260824L);
+
+        for (int step = 0; step < 20000; ++step) {
+            Class<?> c = CLASSES[random.nextInt(CLASSES.length)];
+            int have = reference.containsKey(c) ? reference.get(c) : 0;
+            // Counts are sums of per-chunk tallies, so they never go negative in practice; keep the
+            // generated deltas inside that range.
+            int delta = random.nextInt(7) - 3;
+
+            if (have + delta < 0) {
+                delta = -have;
+            }
+
+            census.adjust(c, delta);
+            reference.put(c, have + delta);
+
+            for (Class<?> each : CLASSES) {
+                int want = reference.containsKey(each) ? reference.get(each) : 0;
+
+                assertEquals("diverged at step " + step + " for " + each.getSimpleName(),
+                        want, census.count(each));
+            }
+        }
+    }
+}
