     // Athena end
 
+    // Athena start - the heights and biomes of this template's chunks; see Chunk.athenaShareTemplateArrays.
+    //
+    // Held weakly, like the packets: an array lives as long as a chunk of some world has it, and a
+    // store kept between matches keeps none. By chunk index * 2, + 1 for the biomes.
+    private volatile java.util.concurrent.atomic.AtomicReferenceArray<WeakReference<Object>> templateArrays;
+
+    /** Gives {@code chunk}, just read from this store, the heights and biomes the other worlds on it use. */
+    void shareTemplateArrays(int chunkX, int chunkZ, Chunk chunk) {
+        int index = Arrays.binarySearch(this.keys, key(chunkX, chunkZ));
+
+        if (index < 0) {
+            return;
+        }
+        java.util.concurrent.atomic.AtomicReferenceArray<WeakReference<Object>> arrays = this.templateArrays;
+
+        if (arrays == null) {
+            synchronized (this) {
+                arrays = this.templateArrays;
+                if (arrays == null) {
+                    this.templateArrays = arrays = new java.util.concurrent.atomic.AtomicReferenceArray<WeakReference<Object>>(this.keys.length * 2);
+                }
+            }
+        }
+        int[] heights = (int[]) shareArray(arrays, index * 2, chunk.athenaHeights());
+        byte[] biomes = (byte[]) shareArray(arrays, index * 2 + 1, chunk.athenaBiomes());
+
+        chunk.athenaShareTemplateArrays(heights, biomes);
+    }
+
+    /** The array the other worlds use for this slot when it holds the same values as {@code mine}; else {@code mine}, offered to them. */
+    private static Object shareArray(java.util.concurrent.atomic.AtomicReferenceArray<WeakReference<Object>> arrays, int slot, Object mine) {
+        WeakReference<Object> offered = null;
+
+        for (;;) {
+            WeakReference<Object> reference = arrays.get(slot);
+            Object shared = reference == null ? null : reference.get();
+
+            if (shared != null) {
+                // the same store gives the same values; compared all the same, so nothing but an equal array is ever taken
+                boolean same = mine instanceof int[] ? Arrays.equals((int[]) shared, (int[]) mine) : Arrays.equals((byte[]) shared, (byte[]) mine);
+
+                return same ? shared : mine;
+            }
+            if (offered == null) {
+                offered = new WeakReference<Object>(mine);
+            }
+            if (arrays.compareAndSet(slot, reference, offered)) {
+                return mine;
+            }
+        }
+    }
+    // Athena end
+
     private void applyCounts(int slot, ChunkSection section) {
         java.util.concurrent.atomic.AtomicReferenceArray<ChunkSection.AthenaCounts> counts = this.counts;
 
