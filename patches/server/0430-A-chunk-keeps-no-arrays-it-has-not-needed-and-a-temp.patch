+
+    @Test
+    public void chunksLoadedFromTheStoreShareHeightsAndBiomesUntilWritten() throws Exception {
+        File dir = fullTemplate(12L);
+
+        built(dir);
+
+        AthenaTemplateChunkLoader one = new AthenaTemplateChunkLoader(dir);
+        AthenaTemplateChunkLoader two = new AthenaTemplateChunkLoader(dir);
+        Chunk a = (Chunk) one.loadChunk(skyWorld(), -32, 0)[0];
+        Chunk b = (Chunk) two.loadChunk(skyWorld(), -32, 0)[0];
+
+        assertTrue(a.athenaSharesTemplateArrays());
+        assertSame("one copy of the heights for both worlds", a.athenaHeights(), b.athenaHeights());
+        assertSame("and of the biomes", a.athenaBiomes(), b.athenaBiomes());
+
+        int[] heightsBefore = b.athenaHeights().clone();
+        byte[] biomesBefore = b.athenaBiomes().clone();
+
+        a.getHeightMap()[3] = heightsBefore[3] + 1; // a caller that may write takes the chunk's own
+        a.getBiomeIndex()[4] = (byte) (biomesBefore[4] + 1);
+
+        assertFalse(a.athenaSharesTemplateArrays());
+        assertArrayEquals("the other world's chunk is as it was", heightsBefore, b.athenaHeights());
+        assertArrayEquals(biomesBefore, b.athenaBiomes());
+        assertEquals(heightsBefore[3] + 1, a.athenaHeights()[3]);
+
+        // the next world on the template still takes the untouched arrays
+        AthenaTemplateChunkLoader three = new AthenaTemplateChunkLoader(dir);
+        Chunk c = (Chunk) three.loadChunk(skyWorld(), -32, 0)[0];
+
+        assertSame(b.athenaHeights(), c.athenaHeights());
+        assertSame(b.athenaBiomes(), c.athenaBiomes());
+        one.close();
+        two.close();
+        three.close();
+    }
