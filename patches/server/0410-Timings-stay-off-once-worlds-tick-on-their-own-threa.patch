+    private static final sun.misc.Unsafe UNSAFE;
+    static {
+        try {
+            Field f = sun.misc.Unsafe.class.getDeclaredField("theUnsafe");
+            f.setAccessible(true);
+            UNSAFE = (sun.misc.Unsafe) f.get(null);
+        } catch (Exception e) { throw new AssertionError(e); }
+    }
+    private static <T> T allocate(Class<T> type) throws Exception { return type.cast(UNSAFE.allocateInstance(type)); }
+    private static void set(Object obj, Class<?> type, String name, Object value) throws Exception {
+        Field f = type.getDeclaredField(name); f.setAccessible(true); f.set(obj, value);
+    }
+    private static Object get(Object obj, Class<?> type, String name) throws Exception {
+        Field f = type.getDeclaredField(name); f.setAccessible(true); return f.get(obj);
+    }
+    private static void check(boolean condition, String message) { if (!condition) throw new AssertionError(message); }
+    private static void await(CountDownLatch latch) {
+        try { check(latch.await(5, TimeUnit.SECONDS), "latch timeout"); }
+        catch (InterruptedException e) { Thread.currentThread().interrupt(); throw new AssertionError(e); }
+    }
+    public static final class Server extends DedicatedServer {
+        PlayerList list;
+        private Server() { super(null); }
+        @Override public void athenaTickWorld(WorldServer world) { }
+        @Override public PlayerList getPlayerList() { return list; }
+    }
+    private static Server server() throws Exception {
+        Server s = allocate(Server.class);
+        set(s, MinecraftServer.class, "primaryThread", Thread.currentThread());
+        set(s, MinecraftServer.class, "serverThread", Thread.currentThread());
+        set(s, MinecraftServer.class, "j", new ConcurrentLinkedQueue<FutureTask<?>>());
+        set(null, MinecraftServer.class, "l", s);
+        s.worlds = new CopyOnWriteArrayList<>();
+        s.processQueue = new ConcurrentLinkedQueue<>();
+        return s;
+    }
+    private static WorldServer world(Server s) throws Exception {
+        WorldServer w = allocate(WorldServer.class);
+        set(w, WorldServer.class, "server", s);
+        set(w, World.class, "players", new ArrayList<>());
+        w.worldData = new WorldData(); w.worldData.setWorldName("recheck");
+        s.worlds.add(w);
+        return w;
+    }
