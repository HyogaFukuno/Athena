+    /** Stop at entry to PlayerList.disconnect, before inventory, events and disk IO. */
+    public static final class DisconnectList extends DedicatedPlayerList {
+        CountDownLatch called;
+        AtomicReference<Boolean> owned;
+        private DisconnectList() { super(null); }
+        @Override public net.kyori.adventure.text.Component disconnect(EntityPlayer player) {
+            owned.set(player.getServerForPlayer().isMainThread());
+            called.countDown();
+            return null;
+        }
+    }
+    @org.junit.Test public void movedDisconnect() throws Exception {
+        Server s = server(); WorldServer a = world(s), b = world(s);
+        DisconnectList list = allocate(DisconnectList.class);
+        list.called = new CountDownLatch(1); list.owned = new AtomicReference<>(); s.list = list;
+        EntityPlayer player = allocate(EntityPlayer.class);
+        player.setProfile(new com.mojang.authlib.GameProfile(new java.util.UUID(0, 1), "review-moved"));
+        player.world = a;
+        PlayerConnection connection = allocate(PlayerConnection.class);
+        connection.player = player; player.playerConnection = connection;
+        set(connection, PlayerConnection.class, "minecraftServer", s);
+        NetworkManager network = allocate(NetworkManager.class);
+        set(network, NetworkManager.class, "outboundPacketsQueue", new ConcurrentLinkedQueue<>());
+        network.channel = new io.netty.channel.embedded.EmbeddedChannel();
+        network.setNetHandler(connection);
+        CountDownLatch entered = new CountDownLatch(1), release = new CountDownLatch(1);
+        AthenaWorldThread first = new AthenaWorldThread(a), second = new AthenaWorldThread(b);
+        a.athenaThread = first; b.athenaThread = second;
+        first.post(a, () -> { entered.countDown(); await(release); });
+        first.start(); second.start();
+        try {
+            await(entered);
+            network.channel.close();
+            // Exactly ServerConnection.networkTick's scheduling expression for a closed channel.
+            WorldServer owner = ServerConnection.athenaThreadedWorldOf(network);
+            check(owner == a, "wrong original owner");
+            WorldServer.athenaRunForEntity(network.getPlayer(), network::checkDisconnected);
+            player.world = b; // the ownership change in moveToWorld, before the queued quit runs
+            release.countDown(); await(list.called);
+            check(Boolean.TRUE.equals(list.owned.get()), "the quit ran on a thread that does not own the player");
+            check(connection.athenaQuitDone(), "real onDisconnect did not mark quit");
+        } finally {
+            release.countDown(); check(first.stopAndJoin(2000), "first thread stuck");
+            check(second.stopAndJoin(2000), "second thread stuck");
+            a.athenaThread = null; b.athenaThread = null;
+            first.handBack(); second.handBack(); network.channel.close();
+        }
+    }
+    @org.junit.Test public void timingsRestart() throws Exception {
+        Server s = server(); WorldServer w = world(s);
+        set(null, AthenaWorldThread.class, "started", false);
+        AthenaWorldThread.beforeFirstStart();
+        AthenaWorldThread thread = new AthenaWorldThread(w);
+        CountDownLatch entered = new CountDownLatch(1), release = new CountDownLatch(1);
+        thread.post(w, () -> { entered.countDown(); await(release); });
+        w.athenaThread = thread; thread.start();
+        try {
+            await(entered);
+            co.aikar.timings.Timings.setTimingsEnabled(true); // exactly /timings on
+            java.lang.reflect.Method factory = co.aikar.timings.Timings.class.getDeclaredMethod("ofSafe", String.class);
+            factory.setAccessible(true);
+            Object timing = factory.invoke(null, "review after world start");
+            boolean enabled = (Boolean) get(timing, Class.forName("co.aikar.timings.TimingHandler"), "enabled");
+            check(AthenaWorldThread.anyRunning() && !co.aikar.timings.Timings.isTimingsEnabled() && !enabled, "timings came back on beside a world thread");
+        } finally {
+            co.aikar.timings.Timings.setTimingsEnabled(false);
+            co.aikar.timings.SpigotTimings.stopServer();
+            release.countDown(); check(thread.stopAndJoin(2000), "timings thread stuck");
+            w.athenaThread = null; thread.handBack();
+        }
+    }
+    @org.junit.Test public void unboundedFinishNoBudget() throws Exception { unboundedFinish(0); }
+    @org.junit.Test public void unboundedFinishZeroBudget() throws Exception { unboundedFinish(1); }
+    @org.junit.Test public void budgetedFinish() throws Exception { unboundedFinish(2); }
+}
