+    private static void unboundedFinish(int mode) throws Exception {
+        AtomicReference<Object> owner = new AtomicReference<>();
+        AtomicInteger calls = new AtomicInteger();
+        Object target = new Object();
+        AsynchronousExecutor<Integer, Integer, Runnable, RuntimeException> executor = new AsynchronousExecutor<>(
+                new AsynchronousExecutor.CallBackProvider<Integer, Integer, Runnable, RuntimeException>() {
+                    public Integer callStage1(Integer p) { return p; }
+                    public void callStage2(Integer p, Integer result) { calls.incrementAndGet(); }
+                    public void callStage3(Integer p, Integer result, Runnable r) { r.run(); }
+                    public Object athenaOwner(Integer p) { return owner.get(); }
+                    public Thread newThread(Runnable r) { Thread t = new Thread(r); t.setDaemon(true); return t; }
+                }, 1);
+        try {
+            executor.add(1, () -> {});
+            Queue<?> queue = (Queue<?>) get(executor, AsynchronousExecutor.class, "finished");
+            long deadline = System.nanoTime() + TimeUnit.SECONDS.toNanos(5);
+            while (queue.isEmpty() && System.nanoTime() < deadline) Thread.onSpinWait();
+            check(!queue.isEmpty(), "worker did not queue completion");
+            owner.set(target); // real transition: completed on main before startWorldThread
+            if (mode == 0) executor.finishActive();
+            else if (mode == 1) executor.finishActive(0L);
+            else executor.finishActive(TimeUnit.SECONDS.toNanos(1));
+            check(calls.get() == 0, "a completion ran on the server thread after its world moved, mode " + mode);
+            executor.finishActive(target, 0L);
+            check(calls.get() == 1, "routed completion lost");
+        } finally { ((ThreadPoolExecutor) get(executor, AsynchronousExecutor.class, "pool")).shutdownNow(); }
+    }
+
+    private static final class PausedIds extends HashMap<String, Short> {
+        @Override public Short get(Object key) {
+            Short value = super.get(key);
+            try { Thread.sleep(100); } // long enough for the other thread to read the same count, if it may
+            catch (InterruptedException e) { throw new AssertionError(e); }
+            return value;
+        }
+    }
+    @org.junit.Test public void mapIds() throws Exception {
+        PersistentCollection control = new PersistentCollection(null);
+        check(control.getUniqueDataId("map") == 0 && control.getUniqueDataId("map") == 1, "serial IDs");
+        PersistentCollection storage = new PersistentCollection(null);
+        PausedIds ids = new PausedIds(); ids.put("map", (short) 0);
+        set(storage, PersistentCollection.class, "idCounts", ids);
+        AtomicInteger a = new AtomicInteger(-1), b = new AtomicInteger(-2);
+        AtomicReference<Throwable> failure = new AtomicReference<>();
+        Thread first = new Thread(() -> { try { a.set(storage.getUniqueDataId("map")); } catch (Throwable t) { failure.set(t); } });
+        Thread second = new Thread(() -> { try { b.set(storage.getUniqueDataId("map")); } catch (Throwable t) { failure.set(t); } });
+        first.start(); second.start(); first.join(); second.join();
+        check(failure.get() == null, "map fixture failed: " + failure.get());
+        check(a.get() != b.get(), "two threads got the same map ID");
+    }
+
+    @org.junit.Test public void forwardedFuture() throws Exception {
+        Server s = server(); WorldServer w = world(s);
+        AtomicReference<ListenableFuture<Object>> future = new AtomicReference<>();
+        CountDownLatch taskRan = new CountDownLatch(1), entered = new CountDownLatch(1), release = new CountDownLatch(1), afterFailure = new CountDownLatch(1);
+        Thread submit = new Thread(() -> future.set(w.postToMainThread(() -> {
+            taskRan.countDown(); throw new IllegalArgumentException("review task failure");
+        })));
+        submit.start(); submit.join();
+        AthenaWorldThread thread = new AthenaWorldThread(w);
+        thread.post(w, () -> { entered.countDown(); await(release); });
+        w.athenaThread = thread; thread.start();
+        try {
+            await(entered);
+            ((Queue<FutureTask<?>>) get(s, MinecraftServer.class, "j")).remove().run();
+            check(!future.get().isDone(), "the future completed before its task ran");
+            thread.post(w, afterFailure::countDown); // after runTasks caught the preceding task's exception
+            release.countDown(); await(taskRan); await(afterFailure);
+            try {
+                future.get().get(1, TimeUnit.SECONDS);
+                throw new AssertionError("the future does not carry the task's failure");
+            } catch (java.util.concurrent.ExecutionException expected) {
+                check(expected.getCause() instanceof IllegalArgumentException, "wrong failure: " + expected.getCause());
+            }
+        } finally {
+            release.countDown(); check(thread.stopAndJoin(2000), "thread did not stop");
+            w.athenaThread = null; thread.handBack();
+        }
+    }
+
+    /** Stop exactly at the first write / decay event, leaving decision logic unchanged. */
+    private static final class Decision extends RuntimeException {
+        final String result;
+        Decision(String result) { super(result, null, false, false); this.result = result; }
+    }
+    public static final class FlowWorld extends WorldServer {
+        boolean sources;
+        CountDownLatch scanned, otherDone;
+        private FlowWorld() { super(null, null, null, 0, null, null, null); }
+        @Override public CraftWorld getWorld() { return null; }
+        @Override public CraftServer getServer() { return null; }
+        @Override public IBlockData getType(BlockPosition p) { return getType(p.getX(), p.getY(), p.getZ()); }
+        @Override public IBlockData getType(int x, int y, int z) {
+            if (y == 1 && scanned != null) { scanned.countDown(); await(otherDone); }
+            if (y < 0) return Blocks.STONE.getBlockData();
+            if (sources && y == 0 && z == 0 && Math.abs(x) == 1) return Blocks.WATER.getBlockData();
+            return Blocks.AIR.getBlockData();
+        }
+        @Override public boolean setTypeAndData(BlockPosition p, IBlockData data, int flags) {
+            throw new Decision(data.getBlock().getMaterial() == Material.WATER ? "water:" + data.get(BlockFluids.LEVEL) : "other");
+        }
+        @Override public boolean setAir(BlockPosition p) { throw new Decision("air"); }
+    }
+    private static FlowWorld flowWorld(boolean sources) throws Exception {
+        FlowWorld w = allocate(FlowWorld.class); w.sources = sources;
+        set(w, World.class, "paperSpigotConfig", allocate(org.github.paperspigot.PaperSpigotWorldConfig.class));
+        return w;
+    }
+    private static String flow(FlowWorld w) {
+        try { Blocks.FLOWING_WATER.updateTick(w, BlockPosition.ZERO, Blocks.FLOWING_WATER.getBlockData().set(BlockFluids.LEVEL, 1), new Random(1)); }
+        catch (Decision d) { return d.result; }
+        throw new AssertionError("no water decision");
+    }
+    @org.junit.Test public void water() throws Exception {
+        String serial = flow(flowWorld(true));
+        FlowWorld a = flowWorld(true), b = flowWorld(false);
+        a.scanned = new CountDownLatch(1); a.otherDone = new CountDownLatch(1);
+        AtomicReference<String> parallel = new AtomicReference<>();
+        AtomicReference<Throwable> failure = new AtomicReference<>();
+        Thread first = new Thread(() -> { try { parallel.set(flow(a)); } catch (Throwable t) { failure.set(t); } });
+        first.start(); await(a.scanned);
+        try { flow(b); } finally { a.otherDone.countDown(); }
+        first.join(); check(failure.get() == null, "water fixture failed: " + failure.get());
+        check("water:0".equals(serial) && serial.equals(parallel.get()), "another world's water changed the count: " + parallel.get());
+    }
+
+    public static final class LeafWorld extends WorldServer {
+        boolean log;
+        CountDownLatch scanned, otherDone;
+        private LeafWorld() { super(null, null, null, 0, null, null, null); }
+        @Override public boolean isAreaLoaded(int a, int b, int c, int d, int e, int f, boolean flag) { return true; }
+        @Override public Chunk getChunkIfLoaded(int x, int z) { return null; }
+        @Override public IBlockData getTypeIfLoaded(int x, int y, int z, Chunk chunk) {
+            if (x == 4 && y == 4 && z == 4 && scanned != null) { scanned.countDown(); await(otherDone); }
+            if (x == 0 && y == 0 && z == 0) return Blocks.LEAVES.getBlockData();
+            if (log && x == 1 && y == 0 && z == 0) return Blocks.LOG.getBlockData();
+            return Blocks.AIR.getBlockData();
+        }
+        @Override public CraftWorld getWorld() { throw new Decision("decay"); }
+        @Override public boolean setTypeAndData(BlockPosition p, IBlockData data, int flags) { throw new Decision("keep"); }
+    }
+    private static LeafWorld leafWorld(boolean log) throws Exception { LeafWorld w = allocate(LeafWorld.class); w.log = log; return w; }
+    private static String leaf(LeafWorld w) {
+        try { Blocks.LEAVES.updateTick(w, BlockPosition.ZERO, Blocks.LEAVES.getBlockData().set(BlockLeaves.CHECK_DECAY, true).set(BlockLeaves.DECAYABLE, true), new Random(1)); }
+        catch (Decision d) { return d.result; }
+        throw new AssertionError("no leaf decision");
+    }
+    @org.junit.Test public void leaves() throws Exception {
+        String serial = leaf(leafWorld(false));
+        LeafWorld a = leafWorld(false), b = leafWorld(true);
+        a.scanned = new CountDownLatch(1); a.otherDone = new CountDownLatch(1);
+        AtomicReference<String> parallel = new AtomicReference<>();
+        AtomicReference<Throwable> failure = new AtomicReference<>();
+        Thread first = new Thread(() -> { try { parallel.set(leaf(a)); } catch (Throwable t) { failure.set(t); } });
+        first.start(); await(a.scanned);
+        try { check("keep".equals(leaf(b)), "control leaf near log"); } finally { a.otherDone.countDown(); }
+        first.join(); check(failure.get() == null, "leaf fixture failed: " + failure.get());
+        check("decay".equals(serial) && serial.equals(parallel.get()), "another world's log kept the leaf: " + parallel.get());
+    }
+
+    public static final class MesaWorld extends WorldServer {
+        long seed;
+        CountDownLatch ready, otherDone;
+        private MesaWorld() { super(null, null, null, 0, null, null, null); }
+        @Override public long getSeed() { return seed; }
+        @Override public int getSeaLevel() {
+            if (ready != null) { ready.countDown(); await(otherDone); }
+            return 63;
+        }
+    }
+    private static MesaWorld mesaWorld(long seed) throws Exception {
+        MesaWorld w = allocate(MesaWorld.class); w.seed = seed;
+        set(w, World.class, "paperSpigotConfig", allocate(org.github.paperspigot.PaperSpigotWorldConfig.class));
+        return w;
+    }
+    private static ChunkSnapshot mesa(MesaWorld w) {
+        ChunkSnapshot chunk = new ChunkSnapshot();
+        for (int y = 0; y <= 110; ++y) chunk.setBlockState(0, y, 0, Blocks.STONE.getBlockData());
+        BiomeBase.MESA.genTerrainBlocks(w, new Random(123), chunk, 0, 0, 2.0D);
+        return chunk;
+    }
+    @org.junit.Test public void mesaNoise() throws Exception {
+        ChunkSnapshot serial = mesa(mesaWorld(1));
+        MesaWorld a = mesaWorld(1), b = mesaWorld(2);
+        a.ready = new CountDownLatch(1); a.otherDone = new CountDownLatch(1);
+        AtomicReference<ChunkSnapshot> parallel = new AtomicReference<>();
+        AtomicReference<Throwable> failure = new AtomicReference<>();
+        Thread first = new Thread(() -> { try { parallel.set(mesa(a)); } catch (Throwable t) { failure.set(t); } });
+        first.start(); await(a.ready);
+        try { mesa(b); } finally { a.otherDone.countDown(); }
+        first.join(); check(failure.get() == null, "mesa fixture failed: " + failure.get());
+        int differences = 0;
+        for (int y = 0; y < 256; ++y) if (serial.getBlockState(0, y, 0) != parallel.get().getBlockState(0, y, 0)) ++differences;
+        check(differences == 0, "another seed changed the column by " + differences + " blocks");
+    }
