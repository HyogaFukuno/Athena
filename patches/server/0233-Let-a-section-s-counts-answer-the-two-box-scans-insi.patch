diff --git a/src/test/java/net/minecraft/server/ChunkSectionBlockCountTest.java b/src/test/java/net/minecraft/server/ChunkSectionBlockCountTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..173b5e26a809f5af51ca50904cdffa2e42e547c5
--- /dev/null
+++ b/src/test/java/net/minecraft/server/ChunkSectionBlockCountTest.java
@@ -0,0 +1,185 @@
+package net.minecraft.server;
+
+import static org.junit.Assert.assertEquals;
+
+import java.util.Random;
+import org.bukkit.support.AbstractTestingBase;
+import org.junit.Test;
+
+/**
+ * Athena - ChunkSection counts the water, lava and fire blocks it holds, and the blocks that react
+ * to an entity standing in them. World turns a zero into "this box holds none of those", which lets
+ * the material box scans, isFlammableWithin and checkBlockCollisions return without reading a
+ * block.
+ *
+ * <p>That makes the counters load-bearing in one direction: a count that drifts <em>below</em> the
+ * truth silently stops an entity from noticing it is standing in water, or in fire, or on a
+ * pressure plate. The counters are maintained from {@link ChunkSection#setType} alone, which every
+ * write path funnels through, so this walks a section through a long random sequence of writes -
+ * one kind over another, over air, and air over each - and compares against a full recount after
+ * every one.
+ *
+ * <p>The live audit in AthenaIndexAudit covers the bulk load path across thousands of chunks; what
+ * it cannot do is land on the chunk a mutation just happened in, which is exactly what this does.
+ */
+public class ChunkSectionBlockCountTest extends AbstractTestingBase {
+
+    private static final IBlockData[] PALETTE = new IBlockData[] {
+        Blocks.AIR.getBlockData(),
+        Blocks.STONE.getBlockData(),
+        Blocks.WATER.getBlockData(),
+        Blocks.FLOWING_WATER.getBlockData(),
+        Blocks.LAVA.getBlockData(),
+        Blocks.FLOWING_LAVA.getBlockData(),
+        Blocks.FIRE.getBlockData(),
+        // blocks that react to an entity standing in them
+        Blocks.WEB.getBlockData(),
+        Blocks.CACTUS.getBlockData(),
+        Blocks.SOUL_SAND.getBlockData(),
+        Blocks.STONE_PRESSURE_PLATE.getBlockData(),
+    };
+
+    private static int recountMaterial(ChunkSection section, Material material) {
+        int found = 0;
+
+        for (int x = 0; x < 16; ++x) {
+            for (int y = 0; y < 16; ++y) {
+                for (int z = 0; z < 16; ++z) {
+                    if (section.getBlockByExtId(x, y, z).getMaterial() == material) {
+                        ++found;
+                    }
+                }
+            }
+        }
+
+        return found;
+    }
+
+    private static int recountHandlers(ChunkSection section) {
+        int found = 0;
+
+        for (int x = 0; x < 16; ++x) {
+            for (int y = 0; y < 16; ++y) {
+                for (int z = 0; z < 16; ++z) {
+                    Block block = section.getBlockByExtId(x, y, z);
+
+                    if (block != Blocks.AIR && block.hasEntityCollisionHandler()) {
+                        ++found;
+                    }
+                }
+            }
+        }
+
+        return found;
+    }
+
+    private static void assertAgrees(ChunkSection section, String what) {
+        int water = recountMaterial(section, Material.WATER);
+        int lava = recountMaterial(section, Material.LAVA);
+        int fire = recountMaterial(section, Material.FIRE);
+        int handlers = recountHandlers(section);
+
+        assertEquals(what + ": water count", water, section.auditCount(ChunkSection.HAS_WATER));
+        assertEquals(what + ": lava count", lava, section.auditCount(ChunkSection.HAS_LAVA));
+        assertEquals(what + ": fire count", fire, section.auditCount(ChunkSection.HAS_FIRE));
+        assertEquals(what + ": handler count", handlers, section.auditCount(ChunkSection.HAS_COLLISION_HANDLER));
+
+        assertEquals(what + ": hasWater", water > 0, section.hasWater());
+        assertEquals(what + ": hasLava", lava > 0, section.hasLava());
+        assertEquals(what + ": holdsAny(FIRE)", fire > 0, section.holdsAny(ChunkSection.HAS_FIRE));
+        assertEquals(what + ": holdsAny(HANDLER)", handlers > 0, section.holdsAny(ChunkSection.HAS_COLLISION_HANDLER));
+
+        // the mask is an "any of", which is what the callers rely on
+        assertEquals(what + ": holdsAny(FIRE|LAVA)", fire > 0 || lava > 0,
+                section.holdsAny(ChunkSection.HAS_FIRE | ChunkSection.HAS_LAVA));
+    }
+
+    @Test
+    public void countsSurviveEveryWriteTransition() {
+        ChunkSection section = new ChunkSection(0, true);
+        Random random = new Random(20260901L);
+
+        assertAgrees(section, "empty section");
+
+        for (int write = 0; write < 20000; ++write) {
+            int x = random.nextInt(16);
+            int y = random.nextInt(16);
+            int z = random.nextInt(16);
+
+            section.setType(x, y, z, PALETTE[random.nextInt(PALETTE.length)]);
+
+            // Recounting 4096 blocks after every write would be 82 million reads, so check every
+            // write for the first thousand - which is where the transitions are densest, the
+            // section still being mostly air - and then periodically.
+            if (write < 1000 || write % 97 == 0) {
+                assertAgrees(section, "after write " + write);
+            }
+        }
+
+        assertAgrees(section, "after the last write");
+    }
+
+    @Test
+    public void recalcAgreesWithTheRunningCount() {
+        ChunkSection section = new ChunkSection(0, true);
+        Random random = new Random(4242L);
+
+        for (int write = 0; write < 4000; ++write) {
+            section.setType(random.nextInt(16), random.nextInt(16), random.nextInt(16),
+                    PALETTE[random.nextInt(PALETTE.length)]);
+        }
+
+        int water = section.auditCount(ChunkSection.HAS_WATER);
+        int lava = section.auditCount(ChunkSection.HAS_LAVA);
+        int fire = section.auditCount(ChunkSection.HAS_FIRE);
+        int handlers = section.auditCount(ChunkSection.HAS_COLLISION_HANDLER);
+
+        section.recalcBlockCounts();
+
+        assertEquals("recalc disagrees about water", water, section.auditCount(ChunkSection.HAS_WATER));
+        assertEquals("recalc disagrees about lava", lava, section.auditCount(ChunkSection.HAS_LAVA));
+        assertEquals("recalc disagrees about fire", fire, section.auditCount(ChunkSection.HAS_FIRE));
+        assertEquals("recalc disagrees about handlers", handlers, section.auditCount(ChunkSection.HAS_COLLISION_HANDLER));
+        assertAgrees(section, "after recalc");
+    }
+
+    @Test
+    public void theBulkLoadConstructorCounts() {
+        ChunkSection built = new ChunkSection(0, true);
+        Random random = new Random(77L);
+
+        for (int write = 0; write < 4000; ++write) {
+            built.setType(random.nextInt(16), random.nextInt(16), random.nextInt(16),
+                    PALETTE[random.nextInt(PALETTE.length)]);
+        }
+
+        // what ChunkRegionLoader and CustomChunkGenerator do: hand over a raw id array
+        ChunkSection loaded = new ChunkSection(0, true, built.getIdArray().clone());
+
+        assertEquals("water", built.auditCount(ChunkSection.HAS_WATER), loaded.auditCount(ChunkSection.HAS_WATER));
+        assertEquals("lava", built.auditCount(ChunkSection.HAS_LAVA), loaded.auditCount(ChunkSection.HAS_LAVA));
+        assertEquals("fire", built.auditCount(ChunkSection.HAS_FIRE), loaded.auditCount(ChunkSection.HAS_FIRE));
+        assertEquals("handlers", built.auditCount(ChunkSection.HAS_COLLISION_HANDLER), loaded.auditCount(ChunkSection.HAS_COLLISION_HANDLER));
+        assertAgrees(loaded, "bulk loaded section");
+    }
+
+    /**
+     * The palette must actually exercise what the test claims to cover, or a counter that is never
+     * incremented passes every assertion above.
+     */
+    @Test
+    public void thePaletteCoversEveryCountedKind() {
+        ChunkSection section = new ChunkSection(0, true);
+        int slot = 0;
+
+        for (IBlockData state : PALETTE) {
+            section.setType(slot & 15, slot >> 8 & 15, slot >> 4 & 15, state);
+            ++slot;
+        }
+
+        for (int kind : new int[] {ChunkSection.HAS_WATER, ChunkSection.HAS_LAVA,
+                ChunkSection.HAS_FIRE, ChunkSection.HAS_COLLISION_HANDLER}) {
+            org.junit.Assert.assertTrue("palette never produces kind " + kind, section.auditCount(kind) > 0);
+        }
+    }
+}
