                 worldserver.explosionDensityCache.clear(); // PaperSpigot - Optimize explosions
             // } // CraftBukkit
 
             // this.i[i][this.ticks % 100] = System.nanoTime() - j; // CraftBukkit
         }
 
+        // Athena - index consistency audit summary
+        if (AthenaIndexAudit.enabled()) {
+            AthenaIndexAudit.tickSummary(this.ticks);
+        }
+
         this.methodProfiler.endStartSection("connection");
         SpigotTimings.connectionTimer.startTiming(); // Spigot
         this.aq().networkTick();
diff --git a/src/main/java/net/minecraft/server/World.java b/src/main/java/net/minecraft/server/World.java
