@@ -105,7 +105,10 @@ public final class AthenaBossBar {
      * blocks, back to the furthest point in a chunk that is loaded and within the player's view (so
      * the client has it), and no nearer than {@value #MIN_DISTANCE}.
      */
-    private double[] target() {
+    // Athena - into these rather than a new double[3] every tick for every player with a bar
+    private double atX, atY, atZ;
+
+    private void target() {
         Vec3D look = this.player.getLookVec();
         double eyes = this.player.locY + this.player.getHeadHeight();
         int view = Math.max(2, Math.min(this.player.viewDistance, this.player.athenaClientViewDistance)) - 1;
@@ -122,9 +125,8 @@ public final class AthenaBossBar {
             }
         }
         double y = eyes + look.yCoord * distance;
-        return new double[] {
-                this.player.locX + look.xCoord * distance,
-                Math.max(1.0D, Math.min(254.0D, y)),
-                this.player.locZ + look.zCoord * distance };
+        this.atX = this.player.locX + look.xCoord * distance;
+        this.atY = Math.max(1.0D, Math.min(254.0D, y));
+        this.atZ = this.player.locZ + look.zCoord * distance;
     }
 }
