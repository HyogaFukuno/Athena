         isTickingEffects = false;
-        for (Object e : effectsToProcess) {
-            if (e instanceof MobEffect) {
-                addEffect((MobEffect) e);
+        // Athena - by index and emptied after: CraftBukkit never cleared the list, so an effect added
+        // or removed from inside the walk (a listener of the event a poison or regeneration tick
+        // calls) was added or removed again every tick after, for as long as the entity lived - a
+        // removal queued once took that effect off for good, however often it was given again
+        for (int e = 0; e < effectsToProcess.size(); ++e) {
+            Object queued = effectsToProcess.get(e);
+            if (queued instanceof MobEffect) {
+                addEffect((MobEffect) queued);
             } else {
-                removeEffect((Integer) e);
+                removeEffect((Integer) queued);
             }
         }
+        effectsToProcess.clear();
+        } // Athena
         // CraftBukkit end
 
         if (this.updateEffects) {
