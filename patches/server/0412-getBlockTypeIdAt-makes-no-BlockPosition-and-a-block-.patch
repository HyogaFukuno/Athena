From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: glacier <hyouga.dev@gmail.com>
Date: Fri, 6 Nov 2026 16:51:26 +0900
Subject: [PATCH] getBlockTypeIdAt makes no BlockPosition, and a block keeps
 its id

A bot's path search calls it millions of times: 67% of what the server allocated and 37% of its CPU on 8 rooms of bots.

diff --git a/src/main/java/net/minecraft/server/Block.java b/src/main/java/net/minecraft/server/Block.java
index 6d675194cf999f507dcb5d6a5c86719f274c05ab..3c52e70348cbd3c579985c6c7d9e7330f3781994 100644
--- a/src/main/java/net/minecraft/server/Block.java
+++ b/src/main/java/net/minecraft/server/Block.java
@@ -135,8 +135,17 @@ public class Block {
     private IBlockData blockData;
     private String name;
 
+    private int athenaId = -1; // Athena - blocks are registered once; see getId
+
     public static int getId(Block block) {
-        return Block.REGISTRY.getIDForObject(block);
+        // Athena - the registry is a hash lookup, and this is asked for every block read by id
+        if (block == null) return Block.REGISTRY.getIDForObject(block);
+        int id = block.athenaId;
+        if (id < 0) {
+            id = Block.REGISTRY.getIDForObject(block);
+            block.athenaId = id;
+        }
+        return id;
     }
 
     public static int getCombinedId(IBlockData iblockdata) {
diff --git a/src/main/java/org/bukkit/craftbukkit/CraftWorld.java b/src/main/java/org/bukkit/craftbukkit/CraftWorld.java
index c65c9b4c0fdf300b69f82271aebcf3fab1647519..312b61f63cb4bdfb3da8050d818073a66e921a1c 100644
--- a/src/main/java/org/bukkit/craftbukkit/CraftWorld.java
+++ b/src/main/java/org/bukkit/craftbukkit/CraftWorld.java
@@ -93,7 +93,7 @@ public class CraftWorld implements World {
     }
 
     public int getBlockTypeIdAt(int x, int y, int z) {
-        return CraftMagicNumbers.getId(world.getType(new BlockPosition(x, y, z)).getBlock());
+        return CraftMagicNumbers.getId(world.getType(x, y, z).getBlock()); // Athena - no BlockPosition: a bot's path search asks this millions of times
     }
 
     public int getHighestBlockYAt(int x, int z) {
