diff --git a/src/test/java/net/minecraft/server/AthenaAuditRegressionTest.java b/src/test/java/net/minecraft/server/AthenaAuditRegressionTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..739f64729d8223b93470d5a28c5f451dca7629f7
--- /dev/null
+++ b/src/test/java/net/minecraft/server/AthenaAuditRegressionTest.java
@@ -0,0 +1,111 @@
+package net.minecraft.server;
+
+import static org.junit.Assert.*;
+
+import com.hpfxd.pandaspigot.config.PacketLimiterConfig;
+import com.mojang.authlib.GameProfile;
+import java.net.InetAddress;
+import java.util.HashMap;
+import java.util.Map;
+import org.bukkit.support.AbstractTestingBase;
+import org.junit.Test;
+import org.spongepowered.configurate.CommentedConfigurationNode;
+
+public class AthenaAuditRegressionTest extends AbstractTestingBase {
+    @Test
+    public void anUnregisteredOrDisplacedEntityIsNotAddedToItsChunk() {
+        EntityItem entity = new EntityItem(null);
+        entity.addedToChunk = false;
+        assertFalse(entity.isAddedToChunk());
+        entity.addedToChunk = true;
+        assertTrue(entity.isAddedToChunk());
+        entity.locX = 16;
+        assertFalse(entity.isAddedToChunk());
+        entity.locX = 0;
+        entity.locY = 16;
+        assertFalse(entity.isAddedToChunk());
+        entity.locY = 0;
+        entity.locZ = 16;
+        assertFalse(entity.isAddedToChunk());
+    }
+
+    @Test
+    public void throttleCleanupKeepsRecentAndBoundaryEntries() throws Exception {
+        InetAddress expired = InetAddress.getByName("192.0.2.1");
+        InetAddress recent = InetAddress.getByName("192.0.2.2");
+        InetAddress boundary = InetAddress.getByName("192.0.2.3");
+        Map<InetAddress, Long> entries = new HashMap<>();
+        long now = 1_800_000_000_000L;
+        entries.put(expired, now - 1001);
+        entries.put(recent, now - 1);
+        entries.put(boundary, now - 1000);
+        HandshakeListener.expireThrottleEntries(entries, now, 1000);
+        assertFalse(entries.containsKey(expired));
+        assertTrue(entries.containsKey(recent));
+        assertTrue(entries.containsKey(boundary));
+    }
+
+    @Test
+    public void packetLimitsSurviveSerializationIntoANewNode() throws Exception {
+        PacketLimiterConfig original = new PacketLimiterConfig("kick", null, Map.of(PacketPlayInChat.class,
+                new PacketLimiterConfig.PacketLimit(2, 10, PacketLimiterConfig.PacketLimit.ViolateAction.DROP)));
+        PacketLimiterConfig.Serializer serializer = new PacketLimiterConfig.Serializer();
+        CommentedConfigurationNode node = CommentedConfigurationNode.root();
+        serializer.serialize(PacketLimiterConfig.class, original, node);
+        PacketLimiterConfig copy = serializer.deserialize(PacketLimiterConfig.class, node);
+        assertEquals(1, copy.getPacketSpecificLimits().size());
+        PacketLimiterConfig.PacketLimit limit = copy.getPacketSpecificLimits().get(PacketPlayInChat.class);
+        assertEquals(2, limit.packetLimitInterval, 0);
+        assertEquals(10, limit.maxPacketRate, 0);
+        assertEquals(PacketLimiterConfig.PacketLimit.ViolateAction.DROP, limit.violateAction);
+    }
+
+    @Test
+    public void deferredNbtHasSymmetricEqualityAndHashing() {
+        NBTTagCompound compound = new NBTTagCompound();
+        AthenaDeferredSectionData.attach(compound, new char[4096]);
+        NBTBase deferred = compound.get("Blocks");
+        NBTBase copy = deferred.clone();
+        assertEquals(deferred, copy);
+        assertEquals(copy, deferred);
+        assertEquals(copy.hashCode(), deferred.hashCode());
+        assertEquals(compound, compound.clone());
+        assertEquals(compound.clone(), compound);
+    }
+
+    @Test
+    public void cachePolicyRejectsDisabledAntiXrayAndUncompressedWorlds() throws Exception {
+        WorldServer world = AthenaAuditFixtures.world();
+        athena.server.AthenaWorldConfig config = new athena.server.AthenaWorldConfig();
+        org.spigotmc.SpigotWorldConfig spigot = AthenaAuditFixtures.allocate(org.spigotmc.SpigotWorldConfig.class);
+        AthenaAuditFixtures.set(world, World.class, "athenaConfig", config);
+        AthenaAuditFixtures.set(world, World.class, "spigotConfig", spigot);
+        assertTrue(world.athenaUsesChunkPacketCache(256));
+        config.cacheChunkPackets = false;
+        assertFalse(world.athenaUsesChunkPacketCache(256));
+        config.cacheChunkPackets = true;
+        spigot.antiXray = true;
+        assertFalse(world.athenaUsesChunkPacketCache(256));
+        spigot.antiXray = false;
+        assertFalse(world.athenaUsesChunkPacketCache(-1));
+    }
+
+    private static final class OfflineServer extends DedicatedServer {
+        private OfflineServer() { super((joptsimple.OptionSet) null); }
+        @Override public boolean getOnlineMode() { return false; }
+    }
+
+    @Test
+    public void offlineLoginLeavesHelloBeforeSchedulingAuthentication() throws Exception {
+        DedicatedServer server = AthenaAuditFixtures.allocate(OfflineServer.class);
+        RuntimeException reachedAuthentication = new RuntimeException("stop before starting background services");
+        LoginListener listener = new LoginListener(server, null) {
+            @Override public void initUUID() { throw reachedAuthentication; }
+        };
+        PacketLoginInStart start = new PacketLoginInStart(new GameProfile(null, "audit"));
+        try { listener.processLoginStart(start); fail("test must stop before enqueue"); }
+        catch (RuntimeException ex) { assertSame(reachedAuthentication, ex); }
+        try { listener.processLoginStart(start); fail("second LoginStart was accepted"); }
+        catch (IllegalStateException expected) { assertTrue(expected.getMessage().contains("Unexpected hello")); }
+    }
+}
