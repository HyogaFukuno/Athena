@@ -22,6 +22,16 @@ public class HandshakeListener implements PacketHandshakingInListener {
         this.networkManager = networkmanager;
     }
 
+    // Athena - fix upstream's timestamp-versus-duration comparison; keep recent attempts.
+    static void expireThrottleEntries(java.util.Map<InetAddress, Long> entries, long now, long throttle) {
+        java.util.Iterator<java.util.Map.Entry<InetAddress, Long>> iterator = entries.entrySet().iterator();
+        while (iterator.hasNext()) {
+            if (now - iterator.next().getValue() > throttle) {
+                iterator.remove();
+            }
+        }
+    }
