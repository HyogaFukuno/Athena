     public void processHandshake(PacketHandshakingInSetProtocol packethandshakinginsetprotocol) {
         switch (HandshakeListener.SyntheticClass_1.a[packethandshakinginsetprotocol.getRequestedState().ordinal()]) {
         case 1:
@@ -49,14 +59,7 @@ public class HandshakeListener implements PacketHandshakingInListener {
                     if (throttleCounter > 200) {
                         throttleCounter = 0;
 
