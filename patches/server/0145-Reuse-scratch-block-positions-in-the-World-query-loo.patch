+    // Athena start - reusable scratch block positions.
+    //
+    // These query loops each allocated a MutableBlockPosition per call. Profiling a live server
+    // showed that costing ~14 MB/min, because the collision and material queries run several times
+    // per entity per tick. Each call site owns a fixed slot, so a nested query can never scribble
+    // over the position another one is still iterating with.
+    private static final int SCRATCH_POS_SLOTS = 10;
+    private static final ThreadLocal<BlockPosition.MutableBlockPosition[]> SCRATCH_POSITIONS = new ThreadLocal<BlockPosition.MutableBlockPosition[]>() {
+        protected BlockPosition.MutableBlockPosition[] initialValue() {
+            BlockPosition.MutableBlockPosition[] slots = new BlockPosition.MutableBlockPosition[SCRATCH_POS_SLOTS];
+
+            for (int i = 0; i < slots.length; ++i) {
+                slots[i] = new BlockPosition.MutableBlockPosition();
+            }
+
+            return slots;
+        }
+    };
+
+    /** The calling thread's scratch position for the given call site. Always set() it before use. */
+    private static BlockPosition.MutableBlockPosition scratchPos(int slot) {
+        return SCRATCH_POSITIONS.get()[slot];
+    }
+    // Athena end
