From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: glacier <hyouga.dev@gmail.com>
Date: Wed, 11 Nov 2026 19:44:54 +0900
Subject: [PATCH] An item with no tag is written without Spigot's meta round
 trip

Spigot's filter copied every item it wrote and took it through an ItemMeta and
back, slots, equipment and dropped items alike. An item with no tag, or an
empty one, comes back with no tag, so it is now written that way at once.
Items with a tag still go through the filter. The test compares the bytes with
the round trip for every item.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/src/main/java/net/minecraft/server/PacketDataSerializer.java b/src/main/java/net/minecraft/server/PacketDataSerializer.java
index 9c2bc9374d16de8408c5640b26bddb67e33a1231..7d50e9695725bd65238c99f98053d7f51ac57a7f 100644
--- a/src/main/java/net/minecraft/server/PacketDataSerializer.java
+++ b/src/main/java/net/minecraft/server/PacketDataSerializer.java
@@ -168,6 +168,15 @@ public class PacketDataSerializer extends ByteBuf {
             NBTTagCompound nbttagcompound = null;
 
             if (itemstack.getItem().usesDurability() || itemstack.getItem().getShareTag()) {
+                // Athena start - an item with no tag, or an empty one, has no meta: the round trip below
+                // makes an empty ItemMeta and setItemMeta takes it off, so what is written is no tag.
+                // Without the copy and the meta, as every slot, equipment and dropped item is written.
+                NBTTagCompound tag = itemstack.getTag();
+                if (tag == null || tag.isEmpty()) {
+                    this.writeNBTTagCompoundToBuffer(null);
+                    return;
+                }
+                // Athena end
                 // Spigot start - filter
                 itemstack = itemstack.cloneItemStack();
                 CraftItemStack.setItemMeta(itemstack, CraftItemStack.getItemMeta(itemstack));
diff --git a/src/test/java/net/minecraft/server/AthenaItemWriteTest.java b/src/test/java/net/minecraft/server/AthenaItemWriteTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..775f4de8a13f7bde5a035e122a4bef4fa2498e74
--- /dev/null
+++ b/src/test/java/net/minecraft/server/AthenaItemWriteTest.java
@@ -0,0 +1,82 @@
+package net.minecraft.server;
+
+import static org.junit.Assert.assertArrayEquals;
+import static org.junit.Assert.assertTrue;
+
+import io.netty.buffer.Unpooled;
+import org.bukkit.craftbukkit.inventory.CraftItemStack;
+import org.bukkit.support.AbstractTestingBase;
+import org.junit.Test;
+
+/**
+ * PacketDataSerializer.writeItemStackToBuffer writes an item with no tag, or an empty one, without
+ * Spigot's copy and meta round trip. That must write the bytes the round trip wrote, for every item.
+ */
+public class AthenaItemWriteTest extends AbstractTestingBase {
+
+    /** What writeItemStackToBuffer wrote before: the copy and the meta round trip for every item that shares its tag. */
+    private static byte[] before(ItemStack itemstack) {
+        PacketDataSerializer out = new PacketDataSerializer(Unpooled.buffer());
+
+        out.writeShort(Item.getId(itemstack.getItem()));
+        out.writeByte(itemstack.count);
+        out.writeShort(itemstack.getData());
+        NBTTagCompound nbttagcompound = null;
+        if (itemstack.getItem().usesDurability() || itemstack.getItem().getShareTag()) {
+            itemstack = itemstack.cloneItemStack();
+            CraftItemStack.setItemMeta(itemstack, CraftItemStack.getItemMeta(itemstack));
+            nbttagcompound = itemstack.getTag();
+        }
+        out.writeNBTTagCompoundToBuffer(nbttagcompound);
+        return bytes(out);
+    }
+
+    private static byte[] now(ItemStack itemstack) {
+        PacketDataSerializer out = new PacketDataSerializer(Unpooled.buffer());
+
+        out.writeItemStackToBuffer(itemstack);
+        return bytes(out);
+    }
+
+    private static byte[] bytes(PacketDataSerializer out) {
+        byte[] bytes = new byte[out.readableBytes()];
+        out.readBytes(bytes);
+        return bytes;
+    }
+
+    @Test
+    public void anItemWithoutATagIsWrittenAsTheRoundTripWroteIt() {
+        int items = 0;
+
+        for (Object object : Item.REGISTRY) {
+            Item item = (Item) object;
+
+            for (int data : new int[] { 0, 1, 3, 15, 50, 100, 1561 }) {
+                ItemStack plain = new ItemStack(item, 7, data);
+                assertArrayEquals(Item.REGISTRY.getNameForObject(item) + ":" + data + " without a tag", before(plain), now(plain));
+
+                ItemStack empty = new ItemStack(item, 7, data);
+                empty.setTag(new NBTTagCompound());
+                assertArrayEquals(Item.REGISTRY.getNameForObject(item) + ":" + data + " with an empty tag", before(empty), now(empty));
+            }
+            ++items;
+        }
+        assertTrue("items looked at: " + items, items > 300);
+    }
+
+    @Test
+    public void anItemWithATagStillGoesThroughTheFilter() {
+        ItemStack sword = new ItemStack(Items.DIAMOND_SWORD);
+        sword.addEnchantment(Enchantment.DAMAGE_ALL, 2);
+        sword.setStackDisplayName("Named");
+        assertArrayEquals(before(sword), now(sword));
+
+        ItemStack book = new ItemStack(Items.WRITTEN_BOOK);
+        NBTTagCompound tag = new NBTTagCompound();
+        tag.setString("title", "t");
+        tag.setString("author", "a");
+        tag.set("unknown", new NBTTagString("dropped by the filter"));
+        book.setTag(tag);
+        assertArrayEquals(before(book), now(book));
+    }
+}
