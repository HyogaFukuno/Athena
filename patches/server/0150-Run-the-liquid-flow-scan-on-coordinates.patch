+++ b/src/test/java/net/minecraft/server/NeighbourOffsetTest.java
@@ -0,0 +1,82 @@
+package net.minecraft.server;
+
+import static org.junit.Assert.assertEquals;
+
+import java.util.Random;
+import org.junit.Test;
+
+/**
+ * Athena - the scalarized hot paths replace BlockPosition.shift()/down()/west()/... with inline
+ * coordinate arithmetic.
+ *
+ * <p>That arithmetic is the one mechanical risk in the rewrite: a swapped sign or axis would compile
+ * cleanly and then make water flow the wrong way, or make a block update notify the wrong neighbour.
+ * These tests hold the offsets to what the position methods actually do.
+ */
+public class NeighbourOffsetTest {
+
+    @Test
+    public void shiftMatchesAdjacentOffsets() {
+        Random r = new Random(20260824L);
+
+        for (int i = 0; i < 100000; i++) {
+            int x = r.nextInt(2000000) - 1000000;
+            int y = r.nextInt(256);
+            int z = r.nextInt(2000000) - 1000000;
+            BlockPosition pos = new BlockPosition(x, y, z);
+
+            for (EnumDirection direction : EnumDirection.VALUES) {
+                BlockPosition shifted = pos.shift(direction);
+
+                assertEquals("x", x + direction.getAdjacentX(), shifted.getX());
+                assertEquals("y", y + direction.getAdjacentY(), shifted.getY());
+                assertEquals("z", z + direction.getAdjacentZ(), shifted.getZ());
+            }
+        }
+    }
+
+    @Test
+    public void namedNeighboursMatchTheOffsetsInlinedAtCallSites() {
+        Random r = new Random(99L);
+
+        for (int i = 0; i < 100000; i++) {
+            int x = r.nextInt(2000000) - 1000000;
+            int y = r.nextInt(256);
+            int z = r.nextInt(2000000) - 1000000;
+            BlockPosition pos = new BlockPosition(x, y, z);
+
+            assertSamePosition(x, y + 1, z, pos.up());
+            assertSamePosition(x, y - 1, z, pos.down());
+            assertSamePosition(x - 1, y, z, pos.west());
+            assertSamePosition(x + 1, y, z, pos.east());
+            assertSamePosition(x, y, z - 1, pos.north());
+            assertSamePosition(x, y, z + 1, pos.south());
+        }
+    }
+
+    @Test
+    public void horizontalFacingsNeverChangeTheHeight() {
+        // BlockFlowing's scan adds getAdjacentY() rather than assuming zero; make sure both agree
+        for (EnumDirection direction : EnumDirection.EnumDirectionLimit.HORIZONTAL.facings()) {
+            assertEquals(direction + " must be horizontal", 0, direction.getAdjacentY());
+        }
+    }
+
+    @Test
+    public void oppositeIsTheNegatedOffset() {
+        // the flow scan recurses with enumdirection.opposite() to avoid walking back on itself
+        for (EnumDirection direction : EnumDirection.VALUES) {
+            EnumDirection opposite = direction.opposite();
+
+            assertEquals(-direction.getAdjacentX(), opposite.getAdjacentX());
+            assertEquals(-direction.getAdjacentY(), opposite.getAdjacentY());
+            assertEquals(-direction.getAdjacentZ(), opposite.getAdjacentZ());
+        }
+    }
+
+    private static void assertSamePosition(int x, int y, int z, BlockPosition actual) {
+        assertEquals("x", x, actual.getX());
+        assertEquals("y", y, actual.getY());
+        assertEquals("z", z, actual.getZ());
+    }
+}
