From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: glacier <hyouga.dev@gmail.com>
Date: Mon, 24 Aug 2026 08:55:04 +0900
Subject: [PATCH] Index the player chunk queue instead of scanning it

chunkCoordIntPairQueue is probed with contains() on two hot paths:
PlayerChunkMap.isPlayerWatchingChunk, reached once per tracked entity per player from
EntityTrackerEntry, and PlayerChunk.sendToAllPlayersWatchingChunk, reached once per block
change per watcher. As a LinkedList each probe was a pointer-chasing scan; a live server
was measured holding 431 entries in the queue while a player moved.

ChunkCoordQueueIndex mirrors the queue as a multiset keyed by packed chunk coordinate, so
a probe becomes one hash lookup answering exactly what List.contains answered. It is a
multiset because List.contains stays true until the last copy of a coordinate leaves;
nothing is expected to enqueue a coordinate twice, but assuming so would turn a stale
duplicate into a silently wrong answer instead of a harmless one.

Every mutation site is listed in EntityPlayer. Collections.sort on the queue only permutes
it and so leaves the index alone.

diff --git a/src/main/java/net/minecraft/server/ChunkCoordQueueIndex.java b/src/main/java/net/minecraft/server/ChunkCoordQueueIndex.java
new file mode 100644
index 0000000000000000000000000000000000000000..7c4f115d5e2363839316a24172759310852b0b56
--- /dev/null
+++ b/src/main/java/net/minecraft/server/ChunkCoordQueueIndex.java
@@ -0,0 +1,99 @@
+package net.minecraft.server;
+
+import it.unimi.dsi.fastutil.longs.Long2IntMap;
+import it.unimi.dsi.fastutil.longs.Long2IntOpenHashMap;
+import java.util.Collection;
+
+// Athena - membership index for EntityPlayer.chunkCoordIntPairQueue.
+//
+// The queue is probed with contains() on two hot paths: PlayerChunkMap.isPlayerWatchingChunk,
+// reached once per tracked entity per player from EntityTrackerEntry, and
+// PlayerChunk.sendToAllPlayersWatchingChunk, reached once per block change per watcher. As a
+// LinkedList each probe was a pointer-chasing scan over up to (2 * viewDistance + 1)^2 entries.
+//
+// This holds the queue's contents as a multiset keyed by packed chunk coordinate, so a probe is a
+// single hash lookup that answers exactly what List.contains answered. It is a multiset rather than
+// a set because List.contains stays true until the *last* copy of a coordinate leaves the queue;
+// nothing is expected to enqueue a coordinate twice, but assuming so would turn a stale duplicate
+// into a silently wrong answer instead of a harmless one.
+//
+// This class only tracks; keeping it in step with the queue is the caller's job, and every
+// mutation site is listed in EntityPlayer. AthenaIndexAudit re-derives the whole thing from the
+// queue each tick when debugVerifyAthenaIndexes is on, which is what catches a missed call site.
+public final class ChunkCoordQueueIndex {
+
+    private final Long2IntOpenHashMap counts = new Long2IntOpenHashMap();
+
+    public static long key(ChunkCoordIntPair pair) {
+        return ChunkCoordIntPair.chunkXZ2Int(pair.x, pair.z);
+    }
+
+    public void add(ChunkCoordIntPair pair) {
+        if (pair != null) {
+            this.counts.addTo(key(pair), 1);
+        }
+    }
+
+    public void remove(ChunkCoordIntPair pair) {
+        if (pair != null) {
+            long k = key(pair);
+            int count = this.counts.remove(k); // absent -> 0, nothing to put back
+
+            if (count > 1) {
+                this.counts.put(k, count - 1);
+            }
+        }
+    }
+
+    public void clear() {
+        this.counts.clear();
+    }
+
+    public boolean contains(ChunkCoordIntPair pair) {
+        return this.counts.containsKey(key(pair));
+    }
+
+    /** Distinct chunk coordinates currently indexed. */
+    public int size() {
+        return this.counts.size();
+    }
+
+    /** Rebuilds the index that the given queue implies, for the audit to compare against. */
+    public static ChunkCoordQueueIndex derivedFrom(Collection<ChunkCoordIntPair> queue) {
+        ChunkCoordQueueIndex index = new ChunkCoordQueueIndex();
+
+        for (ChunkCoordIntPair pair : queue) {
+            index.add(pair); // null entries are skipped by add
+        }
+
+        return index;
+    }
+
+    public boolean matches(ChunkCoordQueueIndex other) {
+        return this.counts.equals(other.counts);
+    }
+
+    /** Human-readable account of how this index differs from the given one, for audit reports. */
+    public String describeDifference(ChunkCoordQueueIndex expected) {
+        StringBuilder sb = new StringBuilder();
+        int shown = 0;
+
+        for (Long2IntMap.Entry entry : expected.counts.long2IntEntrySet()) {
+            int have = this.counts.get(entry.getLongKey());
+
+            if (have != entry.getIntValue() && shown++ < 8) {
+                sb.append("\n    chunk ").append((int) entry.getLongKey()).append(',').append((int) (entry.getLongKey() >> 32))
+                        .append(": queue implies ").append(entry.getIntValue()).append(", index holds ").append(have);
+            }
+        }
+
+        for (Long2IntMap.Entry entry : this.counts.long2IntEntrySet()) {
+            if (!expected.counts.containsKey(entry.getLongKey()) && shown++ < 8) {
+                sb.append("\n    chunk ").append((int) entry.getLongKey()).append(',').append((int) (entry.getLongKey() >> 32))
+                        .append(": stale index entry (count ").append(entry.getIntValue()).append(')');
+            }
+        }
+
+        return sb.toString();
+    }
+}
