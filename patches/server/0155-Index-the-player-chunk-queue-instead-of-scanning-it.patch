diff --git a/src/test/java/net/minecraft/server/ChunkCoordQueueIndexTest.java b/src/test/java/net/minecraft/server/ChunkCoordQueueIndexTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..a4693bcc6a0fe8f11b597297daf8181af1da6ce9
--- /dev/null
+++ b/src/test/java/net/minecraft/server/ChunkCoordQueueIndexTest.java
@@ -0,0 +1,169 @@
+package net.minecraft.server;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import java.util.LinkedList;
+import java.util.List;
+import java.util.Random;
+import org.junit.Test;
+
+// Athena - the index must answer exactly what List.contains answered on chunkCoordIntPairQueue.
+public class ChunkCoordQueueIndexTest {
+
+    private static ChunkCoordIntPair pair(int x, int z) {
+        return new ChunkCoordIntPair(x, z);
+    }
+
+    @Test
+    public void emptyIndexContainsNothing() {
+        ChunkCoordQueueIndex index = new ChunkCoordQueueIndex();
+
+        assertFalse(index.contains(pair(0, 0)));
+        assertEquals(0, index.size());
+    }
+
+    @Test
+    public void addThenRemoveClears() {
+        ChunkCoordQueueIndex index = new ChunkCoordQueueIndex();
+
+        index.add(pair(3, -7));
+        assertTrue(index.contains(pair(3, -7)));
+        index.remove(pair(3, -7));
+        assertFalse(index.contains(pair(3, -7)));
+        assertEquals(0, index.size());
+    }
+
+    @Test
+    public void removingAnAbsentCoordinateIsHarmless() {
+        ChunkCoordQueueIndex index = new ChunkCoordQueueIndex();
+
+        index.remove(pair(1, 1));
+        index.add(pair(1, 1));
+        index.remove(pair(1, 1));
+        index.remove(pair(1, 1));
+        assertFalse(index.contains(pair(1, 1)));
+        assertEquals(0, index.size());
+    }
+
+    @Test
+    public void duplicatesNeedAsManyRemovals() {
+        // List.contains stays true until the last copy leaves the queue, so the index has to too.
+        ChunkCoordQueueIndex index = new ChunkCoordQueueIndex();
+
+        index.add(pair(5, 5));
+        index.add(pair(5, 5));
+        index.remove(pair(5, 5));
+        assertTrue("one copy still queued", index.contains(pair(5, 5)));
+        index.remove(pair(5, 5));
+        assertFalse(index.contains(pair(5, 5)));
+    }
+
+    @Test
+    public void nullEntriesAreIgnored() {
+        // The chunk send loop tolerates nulls in the queue and drops them without touching us.
+        ChunkCoordQueueIndex index = new ChunkCoordQueueIndex();
+
+        index.add(null);
+        index.remove(null);
+        assertEquals(0, index.size());
+    }
+
+    @Test
+    public void negativeAndExtremeCoordinatesDoNotCollide() {
+        ChunkCoordQueueIndex index = new ChunkCoordQueueIndex();
+        int[] values = { 0, 1, -1, 255, -255, Integer.MAX_VALUE, Integer.MIN_VALUE, 1 << 16, -(1 << 16) };
+
+        for (int x : values) {
+            for (int z : values) {
+                index.add(pair(x, z));
+            }
+        }
+
+        assertEquals(values.length * values.length, index.size());
+
+        for (int x : values) {
+            for (int z : values) {
+                assertTrue(x + "," + z, index.contains(pair(x, z)));
+            }
+        }
+    }
+
+    @Test
+    public void agreesWithListContainsOverRandomOperations() {
+        // The property that actually matters: for every coordinate, index.contains must equal
+        // queue.contains after any sequence of the mutations PlayerChunkMap performs.
+        Random random = new Random(20260824L);
+        List<ChunkCoordIntPair> queue = new LinkedList<ChunkCoordIntPair>();
+        ChunkCoordQueueIndex index = new ChunkCoordQueueIndex();
+
+        for (int step = 0; step < 20000; ++step) {
+            int x = random.nextInt(12) - 6;
+            int z = random.nextInt(12) - 6;
+            ChunkCoordIntPair p = pair(x, z);
+
+            switch (random.nextInt(10)) {
+                case 0:
+                case 1:
+                case 2:
+                case 3:
+                case 4: // enqueue, as PlayerChunk.addPlayer and filterChunkLoadQueue do
+                    queue.add(p);
+                    index.add(p);
+                    break;
+                case 5:
+                case 6:
+                case 7: // dequeue one copy, as PlayerChunk.removePlayer and the send loop do
+                    if (queue.remove(p)) {
+                        index.remove(p);
+                    } else {
+                        index.remove(p); // remove() is called unconditionally in removePlayer too
+                    }
+                    break;
+                case 8: // reorder, as movePlayer's Collections.sort does - index must not change
+                    java.util.Collections.shuffle(queue, random);
+                    break;
+                default: // wipe, as filterChunkLoadQueue does
+                    queue.clear();
+                    index.clear();
+                    break;
+            }
+
+            if (step % 97 == 0) {
+                for (int qx = -6; qx < 6; ++qx) {
+                    for (int qz = -6; qz < 6; ++qz) {
+                        ChunkCoordIntPair probe = pair(qx, qz);
+
+                        assertEquals("step " + step + " at " + qx + "," + qz,
+                                queue.contains(probe), index.contains(probe));
+                    }
+                }
+                assertTrue("derived index must match at step " + step,
+                        index.matches(ChunkCoordQueueIndex.derivedFrom(queue)));
+            }
+        }
+    }
+
+    @Test
+    public void derivedFromDetectsDivergence() {
+        // The audit relies on this: a missed add or remove has to show up as a mismatch.
+        List<ChunkCoordIntPair> queue = new LinkedList<ChunkCoordIntPair>();
+        ChunkCoordQueueIndex index = new ChunkCoordQueueIndex();
+
+        queue.add(pair(2, 2));
+        index.add(pair(2, 2));
+        assertTrue(index.matches(ChunkCoordQueueIndex.derivedFrom(queue)));
+
+        queue.add(pair(9, 9)); // enqueued without telling the index
+        assertFalse(index.matches(ChunkCoordQueueIndex.derivedFrom(queue)));
+        assertTrue(index.describeDifference(ChunkCoordQueueIndex.derivedFrom(queue)).contains("9,9"));
+
+        index.add(pair(9, 9));
+        assertTrue(index.matches(ChunkCoordQueueIndex.derivedFrom(queue)));
+
+        queue.remove(pair(2, 2)); // dequeued without telling the index
+        assertFalse(index.matches(ChunkCoordQueueIndex.derivedFrom(queue)));
+        assertTrue(index.describeDifference(ChunkCoordQueueIndex.derivedFrom(queue)).contains("stale"));
+    }
+}
