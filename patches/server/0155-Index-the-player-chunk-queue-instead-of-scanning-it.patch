+    }
+
+    public void queuedChunkClear() {
+        this.queuedChunks.clear();
+    }
+
+    public boolean hasQueuedChunk(ChunkCoordIntPair pair) {
+        return this.queuedChunks.contains(pair);
+    }
+
+    // Athena end
     public final java.util.Deque<Integer> removeQueue = new java.util.ArrayDeque<>(); // PandaSpigot
     private final ServerStatisticManager statsFile;
     private float combinedHealth = Float.MIN_VALUE;
@@ -259,11 +285,12 @@ public class EntityPlayer extends EntityHuman implements ICrafting {
                             arraylist.add(chunk);
