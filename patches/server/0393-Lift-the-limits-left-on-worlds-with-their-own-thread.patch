             WorldServer worldserver = ((CraftWorld) getBukkitEntity().getLocation().getWorld()).getHandle();
             WorldServer worldserver1 = ((CraftWorld) exit.getWorld()).getHandle();
-            // Athena start - moving between worlds touches both: only between worlds the same thread ticks
+            // Athena start - moving between worlds ticked by different threads: in two steps, as a player
             if (worldserver != worldserver1 && !worldserver.athenaSameTickThread(worldserver1)) {
