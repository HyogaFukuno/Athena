                 return;
             }
             // Athena end
@@ -2270,6 +2271,65 @@ public abstract class Entity implements ICommandListener {
         }
     }
 
+    // Athena start
+    /**
+     * teleportTo between worlds ticked by different threads. On this thread (the old world's) the
+     * entity is written out and removed; on the new world's thread a new one is made from that, put at
+     * {@code exit} (through the travel agent for a portal) and added, and the Bukkit entity is handed
+     * over to it, as teleportTo does. Riders and leashes do not come along. If the new world is gone by
+     * then, the entity is gone too.
+     */
+    private void athenaTeleportAcross(final WorldServer to, Location exit, final boolean portal) {
+        final String type = EntityTypes.getEntityString(this);
+        if (type == null) return;   // players have their own way (PlayerList.moveToWorld); others without a type cannot be rebuilt
+        final NBTTagCompound data = new NBTTagCompound();
+        this.writeToNBT(data);
+        final int cooldown = this.portalCooldown;
+        final BlockPosition portalPos = this.lastPortalPos;
+        final Vec3D portalVec = this.lastPortalVec;
+        final EnumDirection direction = this.teleportDirection;
+        final org.bukkit.craftbukkit.entity.CraftEntity bukkit = this.getBukkitEntity();
+        final org.bukkit.util.Vector velocity = bukkit.getVelocity();
+        final Location target = exit.clone();
+        if (this instanceof EntityInsentient) {
+            ((EntityInsentient) this).unleash(true, false); // as teleportTo: no duped leads
+        }
+        this.mount(null);
+        if (this.passenger != null) this.passenger.mount(null);
+        this.world.kill(this);
+        to.athenaRunOnTickThread(new Runnable() {
+            public void run() {
+                if (to.athenaUnloaded) return;
+                Entity entity = EntityTypes.createEntityByName(type, to);
+                if (entity == null) return;
+                entity.readFromNBT(data);
+                entity.dimension = to.dimension;
+                entity.portalCooldown = cooldown;
+                entity.lastPortalPos = portalPos;
+                entity.lastPortalVec = portalVec;
+                entity.teleportDirection = direction;
+                boolean before = to.chunkProviderServer.forceChunkLoad;
+                to.chunkProviderServer.forceChunkLoad = true;
+                try {
+                    target.setWorld(to.getWorld());
+                    if (portal) {
+                        to.getTravelAgent().adjustExit(entity, target, velocity);
+                    }
+                    entity.setPositionRotation(target.getX(), target.getY(), target.getZ(), target.getYaw(), target.getPitch());
+                    entity.motX = velocity.getX();
+                    entity.motY = velocity.getY();
+                    entity.motZ = velocity.getZ();
+                    to.addEntity(entity);
+                } finally {
+                    to.chunkProviderServer.forceChunkLoad = before;
+                }
+                bukkit.setHandle(entity);
+                entity.bukkitEntity = bukkit;
+            }
+        });
+    }
+    // Athena end
+
     public float getExplosionResistance(Explosion explosion, World world, BlockPosition blockposition, IBlockData iblockdata) {
         return iblockdata.getBlock().getExplosionResistance(this);
     }
