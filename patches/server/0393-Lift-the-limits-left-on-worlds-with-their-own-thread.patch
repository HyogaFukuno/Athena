From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: glacier <hyouga.dev@gmail.com>
Date: Mon, 2 Nov 2026 22:46:20 +0900
Subject: [PATCH] Lift the limits left on worlds with their own threads

Vanilla commands (and command blocks) run on the server thread while every
world thread waits between two ticks (AthenaWorldThread.runWithWorldsStopped):
they swap MinecraftServer.worldServer for the whole server and may touch any
world, so two threads running them at once broke each other. One typed in a
world on its own thread is handed to the server thread; a world that does not
stop within five seconds leaves the command not run, and the sender is told.
While the worlds wait the server thread counts as every world's own.

Entities other than players move between worlds ticked by different threads in
two steps, as players do: written out and removed on the old world's thread,
made again on the new one's and given the Bukkit entity.

hidePlayer and showPlayer keep the hidden set thread-safe and do the tracker's
part on the viewer's world thread, so a world may hide its spectators from
players in other worlds; a new profile re-registers each viewer there too.

Each scoreboard holds its own lock in every method, scores change under it, a
team's members are a concurrent set and lists come back as copies, so plugins
may change one scoreboard from several threads.

A player respawning from a world on its own thread no longer reads the main
world's chunks (or a bed's) from that thread: it takes the main world's spawn
as set and is lifted out of blocks on arrival. The thread check found it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/src/main/java/net/minecraft/server/AthenaWorldThread.java b/src/main/java/net/minecraft/server/AthenaWorldThread.java
index c6d2fce018c5264ddfcbec5781d1e7a1cc488e09..2ba354d1b53cb01a8b5b176b54db9f1e21f10e4e 100644
--- a/src/main/java/net/minecraft/server/AthenaWorldThread.java
+++ b/src/main/java/net/minecraft/server/AthenaWorldThread.java
@@ -127,6 +127,87 @@ public final class AthenaWorldThread extends Thread {
         }
     }
 
+    // ---- running something with every world thread stopped ----
+
+    /** World threads started and not yet finished. */
+    private static final java.util.concurrent.atomic.AtomicInteger alive = new java.util.concurrent.atomic.AtomicInteger();
+    /** Set while the server thread runs something with the world threads stopped. */
+    private static volatile Stop stop;
+
+    private static final class Stop {
+        final java.util.Set<AthenaWorldThread> arrived = java.util.concurrent.ConcurrentHashMap.newKeySet();
+        final java.util.concurrent.CountDownLatch release = new java.util.concurrent.CountDownLatch(1);
+    }
+
+    /** Whether any world ticks on a thread of its own. */
+    public static boolean anyRunning() {
+        return alive.get() > 0;
+    }
+
+    /** Whether the calling thread is the server thread inside runWithWorldsStopped. */
+    public static boolean worldsStopped() {
+        return stop != null && MinecraftServer.getServer().isMainThread();
+    }
+
+    /**
+     * On the server thread: runs {@code task} while every world thread waits between two of its
+     * ticks, so the task may touch any world, as everything could before worlds had threads. Vanilla
+     * commands run so: they swap MinecraftServer.worldServer for the whole server and touch every
+     * world. A world thread that does not reach the end of its tick within {@code timeoutMillis}
+     * (a stall) leaves the task not run.
+     *
+     * @return null once the task ran; else the name of the world whose thread did not stop
+     */
+    public static String runWithWorldsStopped(Runnable task, long timeoutMillis) {
+        org.spigotmc.AsyncCatcher.catchOp("stop the world threads");
+        if (stop != null || alive.get() == 0) {
+            task.run();
+            return null;
+        }
+        MinecraftServer server = MinecraftServer.getServer();
+        java.util.List<AthenaWorldThread> threads = new java.util.ArrayList<AthenaWorldThread>();
+        for (WorldServer world : server.worlds) {
+            AthenaWorldThread thread = world.athenaThread;
+            if (thread != null && thread.isAlive() && !thread.failed()) threads.add(thread);
+        }
+        Stop current = new Stop();
+        stop = current;
+        try {
+            for (AthenaWorldThread thread : threads) java.util.concurrent.locks.LockSupport.unpark(thread);
+            long deadline = System.nanoTime() + TimeUnit.MILLISECONDS.toNanos(timeoutMillis);
+            for (AthenaWorldThread thread : threads) {
+                while (!current.arrived.contains(thread) && thread.isAlive() && !thread.failed()) {
+                    if (System.nanoTime() > deadline) {
+                        return thread.world.getWorldData().getName();
+                    }
+                    java.util.concurrent.locks.LockSupport.parkNanos(100_000L);
+                }
+            }
+            task.run();
+            return null;
+        } finally {
+            stop = null;
+            current.release.countDown();
+        }
+    }
+
+    /** At the top of the loop: waits while the server thread runs something with the world threads stopped. */
+    private void waitIfStopped() {
+        Stop current = stop;
+        if (current == null) return;
+        current.arrived.add(this);
+        boolean interrupted = false;
+        while (true) {
+            try {
+                current.release.await();
+                break;
+            } catch (InterruptedException e) {
+                interrupted = true;
+            }
+        }
+        if (interrupted) Thread.currentThread().interrupt();
+    }
+
     /** Queues {@code task} to run on this thread before its next tick. */
     void post(Runnable task) {
         this.tasks.add(task);
@@ -147,9 +228,11 @@ public final class AthenaWorldThread extends Thread {
 
     @Override
     public void run() {
+        alive.incrementAndGet();
         long next = System.nanoTime();
         try {
             while (this.running) {
+                this.waitIfStopped();
                 long now = System.nanoTime();
                 if (now < next) {
                     java.util.concurrent.locks.LockSupport.parkNanos(next - now);
@@ -192,6 +275,8 @@ public final class AthenaWorldThread extends Thread {
             // the server thread takes the world back; until then nothing ticks it
             final AthenaWorldThread self = this;
             MinecraftServer.getServer().processQueue.add(() -> self.world.athenaRecoverFailedThread(self));
+        } finally {
+            alive.decrementAndGet();
         }
     }
 
