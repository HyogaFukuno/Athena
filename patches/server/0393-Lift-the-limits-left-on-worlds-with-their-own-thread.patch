@@ -0,0 +1,60 @@
+package net.minecraft.server;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertSame;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Random;
+import java.util.concurrent.atomic.AtomicReference;
+
+import org.junit.Test;
+
+/** One scoreboard changed from several threads at once, as the main one is by worlds on their own threads. */
+public class AthenaScoreboardThreadsTest {
+
+    @Test
+    public void manyThreadsKeepItConsistent() throws InterruptedException {
+        final Scoreboard board = new Scoreboard();
+        final ScoreboardObjective objective = board.registerObjective("o", new ScoreboardBaseCriteria("athena_threads_test"));
+        for (int t = 0; t < 8; t++) board.createTeam("t" + t);
+        final AtomicReference<Throwable> failure = new AtomicReference<Throwable>();
+        List<Thread> threads = new ArrayList<Thread>();
+        for (int n = 0; n < 6; n++) {
+            final Random random = new Random(n);
+            final int me = n;
+            threads.add(new Thread(() -> {
+                try {
+                    for (int i = 0; i < 20000; i++) {
+                        String player = "p" + me + "_" + random.nextInt(40);
+                        switch (random.nextInt(6)) {
+                            case 0: board.addPlayerToTeam(player, "t" + random.nextInt(8)); break;
+                            case 1: board.removePlayerFromTeam(player); break;
+                            case 2: board.getPlayerScoreForObjective(player, objective).addScore(1); break;
+                            case 3: board.resetPlayerScores(player, null); break;
+                            case 4: for (ScoreboardTeam team : board.getTeams()) for (String s : team.getPlayerNameSet()) s.length(); break;
+                            default: for (ScoreboardScore score : board.getScoresForObjective(objective)) score.getScore(); break;
+                        }
+                    }
+                } catch (Throwable throwable) {
+                    failure.compareAndSet(null, throwable);
+                }
+            }));
+        }
+        for (Thread thread : threads) thread.start();
+        for (Thread thread : threads) thread.join();
+        if (failure.get() != null) throw new AssertionError(failure.get());
+
+        // every player's team lists the player, and no team lists a player it does not have
+        int members = 0;
+        for (ScoreboardTeam team : board.getTeams()) {
+            for (String player : team.getPlayerNameSet()) {
+                assertSame(team, board.getPlayerTeam(player));
+                members++;
+            }
+        }
+        int players = 0;
+        for (int n = 0; n < 6; n++) for (int p = 0; p < 40; p++) if (board.getPlayerTeam("p" + n + "_" + p) != null) players++;
+        assertEquals(players, members);
+    }
+}
