+package net.minecraft.server;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.After;
+import org.junit.Before;
+import org.junit.Test;
+
+/** AthenaGuard's combat bounds that do not need a world: the reach's lookback and the aim. */
+public class AthenaGuardCombatTest {
+
+    private boolean savedEnforce, savedKick;
+
+    @Before
+    public void enforce() {
+        this.savedEnforce = AthenaGuard.enforce;
+        this.savedKick = AthenaGuard.kick;
+        AthenaGuard.enforce = true;
+        AthenaGuard.kick = false;
+    }
+
+    @After
+    public void restore() {
+        AthenaGuard.enforce = this.savedEnforce;
+        AthenaGuard.kick = this.savedKick;
+    }
+
+    // a player's box with its feet at (x, y, z)
+    private static double[] box(double x, double y, double z) {
+        return new double[] { x - 0.3, y, z - 0.3, x + 0.3, y + 1.8, z + 0.3 };
+    }
+
+    private static final double EYE = 1.62;
+
+    @Test
+    public void theLookbackCoversTheTrackerTheInterpolationAndTheRoundTrip() {
+        assertEquals(7, AthenaGuard.reachLookback(0));
+        assertEquals(8, AthenaGuard.reachLookback(1));
+        assertEquals(9, AthenaGuard.reachLookback(54)); // 11-05, Kurono: 6 ticks, and hit just past the reach
+        assertEquals(9, AthenaGuard.reachLookback(61));
+        assertEquals(20, AthenaGuard.reachLookback(AthenaGuard.MAX_LAG_MILLIS));
+    }
+
+    @Test
+    public void aTargetAheadIsOnTheLineOfSight() {
+        // yaw 0 looks along +z
+        assertTrue(AthenaGuard.aimOff(0, EYE, 0, box(0, 0, 3), 0.0F, 0.0F) <= 0.0D);
+        assertTrue(AthenaGuard.aimOff(0, EYE, 0, box(1, 0, 3), 0.0F, 10.0F) < AthenaGuard.MAX_AIM_OFF);
+    }
+
+    @Test
+    public void aTargetBesideOrBehindIsNot() {
+        assertTrue(AthenaGuard.aimOff(0, EYE, 0, box(3, 0, 0), 0.0F, 0.0F) > AthenaGuard.MAX_AIM_OFF);
+        assertTrue(AthenaGuard.aimOff(0, EYE, 0, box(0, 0, -3), 0.0F, 0.0F) > AthenaGuard.MAX_AIM_OFF);
+    }
+
+    @Test
+    public void theTargetMayBeAimedAtWhereverItStoodInTheLookback() {
+        // knocked about: now beside the attacker (+x), a few ticks ago ahead of it (+z), where it was seen
+        double[] boxes = new double[12];
+        System.arraycopy(box(2, 0, 0), 0, boxes, 0, 6);
+        System.arraycopy(box(0, 0, 3), 0, boxes, 6, 6);
+
+        assertTrue(AthenaGuard.aimOff(0, EYE, 0, boxes, 1, 0.0F, 0.0F) > AthenaGuard.MAX_AIM_OFF);
+        assertTrue(AthenaGuard.aimOff(0, EYE, 0, boxes, 2, 0.0F, 0.0F) <= AthenaGuard.MAX_AIM_OFF);
+        // behind it all along is still off
+        System.arraycopy(box(0, 0, -3), 0, boxes, 6, 6);
+        assertTrue(AthenaGuard.aimOff(0, EYE, 0, boxes, 2, 0.0F, 0.0F) > AthenaGuard.MAX_AIM_OFF);
+    }
+
+    @Test
+    public void aHitAfterATurnIsCheckedAgainstTheLookItWasMadeAlong() {
+        // 11-05, Kurono: hit 64 and 88 degrees off the server's look - the look of the tick before.
+        // The client turned onto the target (+x, yaw -90) and hit in the same tick; the look comes after.
+        AthenaGuard guard = new AthenaGuard(null);
+        double[] target = box(3, 0, 0);
+
+        assertTrue(AthenaGuard.aimOff(0, EYE, 0, target, 0.0F, 0.0F) > AthenaGuard.MAX_AIM_OFF);
+        guard.athenaAimPending(0, EYE, 0, target);
+        assertTrue(guard.aimPending());
+        assertTrue(guard.aimOkLater(-90.0F, 0.0F));
+        assertFalse(guard.aimPending());
+        // a yaw that has gone round more than once is the same look
+        guard.athenaAimPending(0, EYE, 0, target);
+        assertTrue(guard.aimOkLater(-90.0F + 720.0F, 0.0F));
+    }
+
+    @Test
+    public void aHitBehindIsDroppedWhenTheLookStaysAway() {
+        AthenaGuard guard = new AthenaGuard(null);
+
+        guard.athenaAimPending(0, EYE, 0, box(0, 0, -3));
+        assertFalse(guard.aimOkLater(0.0F, 0.0F)); // the packet brought no new look, or one still away
+        assertFalse(guard.aimPending());
+        assertTrue(guard.aimOkLater(0.0F, 0.0F)); // nothing waits any more
+    }
+
+    @Test
+    public void whenOnlyLoggingTheHitIsNeverDropped() {
+        AthenaGuard.enforce = false;
+        AthenaGuard guard = new AthenaGuard(null);
+
+        guard.athenaAimPending(0, EYE, 0, box(0, 0, -3));
+        assertTrue(guard.aimOkLater(0.0F, 0.0F));
+    }
+}
