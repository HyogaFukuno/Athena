@@ -299,6 +296,44 @@ public final class AthenaGuard {
         return true;
     }
 
+    /** The time banked by a packet that arrived at now; false for the first, which has nothing to compare with. */
+    boolean arrive(long now) {
+        if (this.lastFlyingNanos == 0L) {
+            this.lastFlyingNanos = now;
+            // A new connection starts with a full bank. Through the proxy the client's first packets
+            // on this server arrive together: those it sent while the proxy switched it over, held
+            // up until the server took it. Without the bank a dozen of them was a clock 250 ms fast.
+            this.balanceMillis = 1000.0D;
+            return false;
+        }
+
+        double elapsed = (now - this.lastFlyingNanos) / 1.0E6D;
+
+        this.lastFlyingNanos = now;
+        this.gaps[this.gapHead] = (int) Math.min(elapsed, 99999.0D);
+        this.gapHead = (this.gapHead + 1) % this.gaps.length;
+        if (elapsed > 1000.0D) {
+            // A stall: the packets the client sent meanwhile were held up on the way, and arrive
+            // together right after it - one per 50 ms it lasted, more than the capped bank pays for.
+            // The burst may spend the whole stall, but only while it lasts: the bank is capped again
+            // after it. A client that holds its packets back to send them at once moves no faster
+            // than one sending them on time; each still stands for one tick of movement.
+            this.stallMillis = Math.min(elapsed, 30000.0D);
+            this.stallUntilNanos = now + (long) (Math.min(this.stallMillis, 5000.0D) * 1.0E6D);
+        }
+        this.balanceMillis += elapsed - 50.0D + elapsed * 0.003D; // 0.3% drift allowance
+        double cap = now - this.stallUntilNanos < 0L ? Math.max(1000.0D, this.stallMillis) : 1000.0D;
+        if (this.balanceMillis > cap) {
+            this.balanceMillis = cap;
+        }
+        return true;
+    }
+
+    /** What the client has banked, ms; for AthenaGuardTimerTest. */
+    double athenaBalance() {
+        return this.balanceMillis;
+    }
+
     private String timerContext() {
