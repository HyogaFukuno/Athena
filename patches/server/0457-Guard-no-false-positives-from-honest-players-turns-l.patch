+    /** Whether an attack is waiting for the look of the next movement packet. */
+    boolean aimPending() {
+        return this.aimPending;
+    }
+
+    /**
+     * The look the client sent after the attack it waits for - its yaw and pitch at the attack, or the
+     * last look when the packet has none (it did not turn). Whether the attack lands, when enforcing.
+     */
+    boolean aimOkLater(float yaw, float pitch) {
+        if (!this.aimPending) {
+            return true;
         }
+        this.aimPending = false;
+        double off = aimOff(this.aimEyeX, this.aimEyeY, this.aimEyeZ, this.aimBoxes, this.aimBoxCount, yaw, pitch);
 
+        if (off > MAX_AIM_OFF) {
+            this.flag(5, "aim", "hit %s %.0f degrees off the line of sight", this.aimTarget, off);
+            return !enforce;
+        }
         return true;
     }
 
+    /** The attack test for AthenaGuardCombatTest: an attack from this eye on this box that waits for its look. */
+    void athenaAimPending(double eyeX, double eyeY, double eyeZ, double[] box) {
+        this.aimPending = true;
+        this.aimEyeX = eyeX; this.aimEyeY = eyeY; this.aimEyeZ = eyeZ;
+        System.arraycopy(box, 0, this.aimBoxes, 0, 6);
+        this.aimBoxCount = 1;
+        this.aimTarget = "target";
+    }
+
+    /** How far off the line of sight a hit may be, past what the box itself covers. */
+    static final double MAX_AIM_OFF = 60.0D;
+
+    /**
+     * The smallest aimOff of the first count boxes in boxes (6 values each): the attacker aimed at the
+     * target where it saw it, which is any of the positions the reach looks back over - not the
+     * nearest one. Checked against the nearest only, a target several players piled onto from above,
+     * knocked about between their hits, was hit 60 to 94 degrees off the look.
+     */
+    static double aimOff(double eyeX, double eyeY, double eyeZ, double[] boxes, int count, float yawDegrees, float pitchDegrees) {
+        double least = Double.MAX_VALUE;
+        double[] box = new double[6];
+
+        for (int i = 0; i < count; ++i) {
+            System.arraycopy(boxes, i * 6, box, 0, 6);
+            least = Math.min(least, aimOff(eyeX, eyeY, eyeZ, box, yawDegrees, pitchDegrees));
+        }
+        return count > 0 ? least : 0.0D;
+    }
+
+    /**
+     * The angle from the line of sight to the box's centre, less the angle the box itself covers, in
+     * degrees; 0 for a box under half a block away. Generous: it only has to catch a hit on something
+     * beside or behind the attacker.
+     */
+    static double aimOff(double eyeX, double eyeY, double eyeZ, double[] box, float yawDegrees, float pitchDegrees) {
+        double cx = (box[0] + box[3]) / 2.0D - eyeX;
+        double cy = (box[1] + box[4]) / 2.0D - eyeY;
+        double cz = (box[2] + box[5]) / 2.0D - eyeZ;
+        double len = Math.sqrt(cx * cx + cy * cy + cz * cz);
+
+        if (len <= 0.5D) {
+            return 0.0D;
+        }
+        float yaw = yawDegrees * 0.017453292F;
+        float pitch = pitchDegrees * 0.017453292F;
+        double lx = -Math.sin(yaw) * Math.cos(pitch);
+        double ly = -Math.sin(pitch);
+        double lz = Math.cos(yaw) * Math.cos(pitch);
+        double cos = (lx * cx + ly * cy + lz * cz) / len;
+        double angle = Math.toDegrees(Math.acos(Math.max(-1.0D, Math.min(1.0D, cos))));
+        double halfDiag = Math.sqrt((box[3] - box[0]) * (box[3] - box[0]) + (box[4] - box[1]) * (box[4] - box[1]) + (box[5] - box[2]) * (box[5] - box[2])) / 2.0D + 0.1D;
+        double cover = Math.toDegrees(Math.atan(halfDiag / len));
+
+        return angle - cover;
+    }
+
+    /**
+     * How many ticks back the target may have stood where the attacker saw it. The attacker's screen
+     * shows the server's position of another player late by: up to 2 ticks before the tracker sends it
+     * (players are sent every other tick, EntityTracker), the way to the client, the 3 ticks the client
+     * takes to move the player there (EntityOtherPlayerMP's interpolation), and up to a tick until its
+     * next attack - and the attack takes the way back. 7 ticks and the round trip. With 4 and the round
+     * trip a sprinting target, or one knocked back, was hit just past the reach.
+     */
+    static int reachLookback(int ping) {
+        return Math.min(20, 7 + lagTicks(ping + 49));
+    }
+
     private static double distanceToBox(double x, double y, double z, double minX, double minY, double minZ, double maxX, double maxY, double maxZ) {
         double dx = x < minX ? minX - x : (x > maxX ? x - maxX : 0.0D);
         double dy = y < minY ? minY - y : (y > maxY ? y - maxY : 0.0D);
