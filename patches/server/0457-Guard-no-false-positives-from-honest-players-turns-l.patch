diff --git a/src/test/java/net/minecraft/server/AthenaGuardRiseTest.java b/src/test/java/net/minecraft/server/AthenaGuardRiseTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..ff18b63a6270d314a1cd21b3128f14c614e3eb79
--- /dev/null
+++ b/src/test/java/net/minecraft/server/AthenaGuardRiseTest.java
@@ -0,0 +1,110 @@
+package net.minecraft.server;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNotEquals;
+
+import org.junit.After;
+import org.junit.Before;
+import org.junit.Test;
+
+/**
+ * Two fly false positives from honest players (2026-11-07), driven through AthenaGuard.evaluate with
+ * the world probes' answers spelled out: a jump whose ground the probes found in the middle of the
+ * rise, and the first move after a teleport that came in the middle of a jump.
+ */
+public class AthenaGuardRiseTest {
+
+    private static final double JUMP = 0.41999998688697815D;
+    private static final double GRAVITY = 0.08D;
+    private static final double DRAG = 0.9800000190734863D;
+
+    private boolean savedEnforce, savedKick;
+
+    @Before
+    public void enforce() {
+        this.savedEnforce = AthenaGuard.enforce;
+        this.savedKick = AthenaGuard.kick;
+        AthenaGuard.enforce = true;
+        AthenaGuard.kick = false;
+        AthenaGuard.enabled = true;
+        AthenaGuard.movement = true;
+    }
+
+    @After
+    public void restore() {
+        AthenaGuard.enforce = this.savedEnforce;
+        AthenaGuard.kick = this.savedKick;
+    }
+
+    /** One tick in the open: no wall, no liquid, no knockback. */
+    private static int move(AthenaGuard guard, double dy, boolean groundNow, boolean maybeGround) {
+        return guard.evaluate(1, 0.0D, dy, groundNow, maybeGround, !maybeGround || groundNow, false, 0.6D, false, false, false, false, 0.0D);
+    }
+
+    private static AthenaGuard standing() {
+        AthenaGuard guard = new AthenaGuard(null);
+
+        guard.athenaSeed(0.0D, 0.0D, true, true, true, 0.6D);
+        for (int i = 0; i < 4; ++i) {
+            assertEquals(0, move(guard, 0.0D, true, true));
+        }
+        return guard;
+    }
+
+    @Test
+    public void aJumpWhoseRiseTheProbesTookForGroundGoesOnRising() {
+        // Kurono (1.7, against a wall): +0.420, +0.333, +0.248 - found on the ground there - then +0.165,
+        // "at most 0.000"
+        AthenaGuard guard = standing();
+        double v1 = JUMP, v2 = (v1 - GRAVITY) * DRAG, v3 = (v2 - GRAVITY) * DRAG, v4 = (v3 - GRAVITY) * DRAG;
+
+        assertEquals(0, move(guard, v1, false, false));
+        assertEquals(0, move(guard, v2, false, false));
+        assertEquals(0, move(guard, v3, true, true)); // ground at the end of a free rise
+        assertEquals(0, move(guard, v4, false, false));
+    }
+
+    @Test
+    public void aRiseInTheAirIsNoJump() {
+        // the free rise ends in the air: a second jump from it is still a fly
+        AthenaGuard guard = standing();
+        double v1 = JUMP, v2 = (v1 - GRAVITY) * DRAG, v3 = (v2 - GRAVITY) * DRAG;
+
+        assertEquals(0, move(guard, v1, false, false));
+        assertEquals(0, move(guard, v2, false, false));
+        assertEquals(0, move(guard, v3, true, true));
+        assertNotEquals(0, move(guard, JUMP, false, false));
+    }
+
+    @Test
+    public void aStepUpWhileLandingStillEndsOnTheGround() {
+        // falling onto a slab's edge: the move collides going down and steps up, and ends on the ground,
+        // free to jump
+        AthenaGuard guard = standing();
+        double v1 = JUMP, v = v1;
+
+        assertEquals(0, move(guard, v1, false, false));
+        for (int i = 0; i < 8; ++i) {
+            v = (v - GRAVITY) * DRAG;
+            assertEquals(0, move(guard, v, false, false));
+        }
+        assertEquals(0, move(guard, 0.5D, true, true)); // stepped up onto the slab
+        assertEquals(0, move(guard, JUMP, false, false));
+    }
+
+    @Test
+    public void aTeleportInTheMiddleOfAJumpGoesOnRising() {
+        // HaniwaCho, arriving at the deathmatch arena: the packet seeded after the teleport was a jump
+        // over 4 ticks (+0.420), then +0.333 - "at most 0.024", from 0.42 / 4
+        AthenaGuard guard = new AthenaGuard(null);
+
+        guard.athenaSeed(0.0D, AthenaGuard.seedVy(JUMP, 4), false, false, false, 0.6D);
+        assertEquals(0, move(guard, (JUMP - GRAVITY) * DRAG, false, false));
+    }
+
+    @Test
+    public void aFallIsSeededFromItsAverage() {
+        assertEquals(-0.25D, AthenaGuard.seedVy(-1.0D, 4), 1.0E-9D);
+        assertEquals(JUMP, AthenaGuard.seedVy(JUMP, 4), 1.0E-9D);
+    }
+}
diff --git a/src/test/java/net/minecraft/server/AthenaGuardTimerTest.java b/src/test/java/net/minecraft/server/AthenaGuardTimerTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..2654ddad10a337787c22a8957a9b37e543cd8dbf
--- /dev/null
+++ b/src/test/java/net/minecraft/server/AthenaGuardTimerTest.java
@@ -0,0 +1,103 @@
+package net.minecraft.server;
+
+import static org.junit.Assert.assertTrue;
+
+import org.junit.Test;
+
+/**
+ * AthenaGuard's timer bank (arrive): a client is flagged once it is 250 ms ahead of real time. Honest
+ * clients whose packets were held up on the way - by a stall, or by the proxy while it switched them
+ * over - arrive in bursts, and must not be; a clock that runs fast must still be.
+ */
+public class AthenaGuardTimerTest {
+
+    private static final long MS = 1_000_000L;
+
+    private long now = 1_000_000_000L;
+    private double lowest = Double.MAX_VALUE;
+
+    private void arrive(AthenaGuard guard, long gapMillis) {
+        this.now += gapMillis * MS;
+        if (guard.arrive(this.now)) {
+            this.lowest = Math.min(this.lowest, guard.athenaBalance());
+        }
+    }
+
+    private void steady(AthenaGuard guard, int packets, long gapMillis) {
+        for (int i = 0; i < packets; ++i) {
+            this.arrive(guard, gapMillis);
+        }
+    }
+
+    @Test
+    public void onTimeIsNeverAhead() {
+        AthenaGuard guard = new AthenaGuard(null);
+        this.steady(guard, 2000, 50);
+        assertTrue(this.lowest > -250.0D);
+    }
+
+    @Test
+    public void theBurstAfterAStallIsPaidForByTheStall() {
+        // 11-07, Kurono: a burst of at least 25 packets with no gap between them, after a stall
+        AthenaGuard guard = new AthenaGuard(null);
+        this.steady(guard, 200, 50);
+        for (long stall : new long[] { 1500, 3000, 8000 }) {
+            this.arrive(guard, stall);
+            this.steady(guard, (int) (stall / 50) - 1, 0);
+            this.steady(guard, 200, 50);
+        }
+        assertTrue("lowest " + this.lowest, this.lowest > -250.0D);
+    }
+
+    @Test
+    public void aStallWhoseBurstComesInPiecesIsPaidForToo() {
+        AthenaGuard guard = new AthenaGuard(null);
+        this.steady(guard, 200, 50);
+        this.arrive(guard, 4000);
+        for (int i = 0; i < 8; ++i) {
+            this.steady(guard, 10, 0);
+            this.arrive(guard, 120);
+        }
+        this.steady(guard, 200, 50);
+        assertTrue("lowest " + this.lowest, this.lowest > -250.0D);
+    }
+
+    @Test
+    public void theFirstPacketsOnANewConnectionMayComeTogether() {
+        // 11-15, HaniwaCho: just joined through the proxy, a dozen packets at once
+        AthenaGuard guard = new AthenaGuard(null);
+        this.arrive(guard, 0);
+        this.steady(guard, 15, 0);
+        this.steady(guard, 200, 50);
+        assertTrue("lowest " + this.lowest, this.lowest > -250.0D);
+    }
+
+    @Test
+    public void aFastClockIsStillCaught() {
+        AthenaGuard guard = new AthenaGuard(null);
+        this.steady(guard, 200, 50);
+        this.steady(guard, 600, 40); // 25% fast
+        assertTrue("lowest " + this.lowest, this.lowest < -250.0D);
+    }
+
+    @Test
+    public void aStallBuysNoFastClockAfterItsBurst() {
+        AthenaGuard guard = new AthenaGuard(null);
+        this.steady(guard, 200, 50);
+        this.arrive(guard, 5000);
+        this.steady(guard, 99, 0);
+        this.steady(guard, 600, 40);
+        assertTrue("lowest " + this.lowest, this.lowest < -250.0D);
+    }
+
+    @Test
+    public void standingStillLongDoesNotBankForLater() {
+        // a stall that no burst follows: the bank is capped again once the burst would be over
+        AthenaGuard guard = new AthenaGuard(null);
+        this.steady(guard, 200, 50);
+        this.arrive(guard, 10000);
+        this.steady(guard, 200, 50);
+        this.steady(guard, 60, 0);
+        assertTrue("lowest " + this.lowest, this.lowest < -250.0D);
+    }
+}
